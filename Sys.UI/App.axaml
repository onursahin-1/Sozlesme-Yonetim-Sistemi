<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sys.UI.App"
             xmlns:local="using:Sys.UI"
             RequestedThemeVariant="Light">
             <!--
               RequestedThemeVariant="Light" (eskiden "Default" idi):
               Uygulamanın tüm özel renkleri (beyaz kartlar, #F5F5F5 paneller, siyah
               yazılar, renkli durum rozetleri) açık tema varsayımıyla yazıldı. "Default"
               sistem temasını takip ettiği için, kullanıcının işletim sistemi koyu moddaysa
               tema varsayılanı olan açık renkli yazılar bizim beyaz kartlarımızın üzerine
               düşüyor ve okunamaz hale geliyordu. Temayı sabitlemek bu sorun sınıfını
               kökten çözer.
             -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <!--
          Gövde yazı tipi. Liste virgülle ayrılmış bir yedekleme zinciri: sistemde
          yoksa sıradakine düşer. Segoe UI Variable, Windows 11'in modern arayüz fontu;
          Inter ise pakette gömülü olduğu için her ortamda garantili son duraktır.
        -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, avares://Avalonia.Fonts.Inter/Assets#Inter"/>
        </Style>

        <!--
          Başlık yazı tipi: Bahnschrift (Microsoft'un DIN 1451 uyarlaması, Windows 10+
          ile birlikte gelir). Geometrik ve endüstriyel karakteri Fakir logosunun
          harf yapısıyla örtüşüyor; gövde fontundan ayrışarak hiyerarşi kuruyor.
          Bulunamazsa Segoe UI'ya düşer.
        -->
        <Style Selector="TextBlock.display">
            <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI Variable Display, Segoe UI"/>
        </Style>

        <!-- Küçük büyük-harf etiketlerde harf aralığı açılınca okunaklılık belirgin artar -->
        <Style Selector="TextBlock.sectionLabel">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A8578"/>
            <Setter Property="LetterSpacing" Value="0.8"/>
        </Style>

        <!--
          ORTAK BUTON STİLİ — Classes="flat"

          Sorun: Fluent teması, :pointerover durumunda butonun ContentPresenter'ındaki
          Background ve Foreground değerlerini kendi tema renkleriyle eziyor. Butona
          doğrudan Background/Foreground vermek bu ezmeyi güvenilir şekilde engellemiyor;
          sonuç olarak renkli butonlar fare üzerine gelince görünmez oluyordu.

          Çözüm: Butonun kendi gövdesi tamamen şeffaf ve çerçevesiz. Renk ve yazı, butonun
          İÇİNDEKİ Border ve TextBlock'a veriliyor — bunlar yerel değer olduğu için tema
          hiçbir durumda üzerlerine yazamaz. Hover/basılı geri bildirimi renk değişimiyle
          değil, opaklıkla veriliyor; böylece buton hiçbir durumda kaybolamaz.

          Kullanımı:
              <Button Classes="flat" Command="...">
                  <Border Background="#2D6EA8" CornerRadius="4" Padding="12,6">
                      <TextBlock Text="Kaydet" Foreground="White"/>
                  </Border>
              </Button>

          Bu stil eskiden her ekranda ayrı ayrı tanımlanıyordu; tek yere alındı.
        -->
        <Style Selector="Button.flat">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.flat /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.flat:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.flat:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.flat:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.flat:pointerover">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.flat:pressed">
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="Button.flat:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>

        <!--
          Künye/detay ekranlarındaki etiket-değer ikilisi.
          Etiket küçük, gri ve büyük harf; değer koyu ve normal boyutta. Amaç, gözün
          önce değerleri taraması, etiketin yalnızca bağlam vermesi.
        -->
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#8A94A6"/>
        </Style>
        <Style Selector="TextBlock.fieldValue">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1A2E4A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!--
          Durum kartı butonu: içeriği tamamen kendi Border'ından gelir, buton gövdesi
          şeffaftır. "flat" ile aynı mantık; farkı, devre dışıyken de okunur kalması —
          Müdür rolünde bazı kartlar tıklanamaz ama sayıyı yine göstermeleri gerekiyor.
        -->
        <Style Selector="Button.statCard">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.statCard /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.statCard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.statCard:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.statCard:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.statCard:pointerover">
            <Setter Property="Opacity" Value="0.88"/>
        </Style>
        <!-- Tıklanamayan kart soluklaşmaz: sayı hâlâ okunmalı, sadece imleç değişmez. -->
        <Style Selector="Button.statCard:disabled">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>

        <!-- Alan bazlı form doğrulama mesajlarının ortak görünümü -->
        <Style Selector="TextBlock.fieldError">
            <Setter Property="Foreground" Value="#D14343"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="2,-4,0,0"/>
        </Style>
    </Application.Styles>
</Application>
