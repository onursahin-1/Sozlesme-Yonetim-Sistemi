<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sys.UI.ViewModels"
             x:Class="Sys.UI.Views.ContractDetailView"
             x:DataType="vm:ContractDetailViewModel">

	<!-- Renkli butonlar Classes="flat" kullanır; stil tanımı App.axaml içindedir. -->
	<Grid RowDefinitions="Auto,Auto,*" Margin="24">

		<StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
			<Button Classes="flat" HorizontalAlignment="Left" IsVisible="{Binding ShowBackButton}" Command="{Binding BackCommand}">
				<Border Background="#6B7280" CornerRadius="4" Padding="10,4">
					<TextBlock Text="← Geri" Foreground="White" FontSize="12"/>
				</Border>
			</Button>
			<TextBlock Text="Sözleşme Görüntüle" FontSize="22" FontWeight="Bold"/>
		</StackPanel>

		<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
			<TextBlock Text="Sözleşme Seç:" VerticalAlignment="Center"/>
			<ComboBox Width="360"
                      ItemsSource="{Binding AvailableContracts}"
                      SelectedItem="{Binding SelectedContract}"
                      DisplayMemberBinding="{Binding Title}"/>

			<!-- PDF üretip sistemin görüntüleyicisinde açar; yazdırma oradan yapılır -->
			<Button Classes="flat" VerticalAlignment="Center"
                    IsVisible="{Binding CanPrint}"
                    Click="OnPrintClick"
                    ToolTip.Tip="Sözleşme künyesini PDF olarak kaydeder ve açar">
				<Border Background="#2D6EA8" CornerRadius="4" Padding="12,6">
					<TextBlock Text="🖨 Yazdır" Foreground="White" FontSize="12"/>
				</Border>
			</Button>
		</StackPanel>

		<ScrollViewer Grid.Row="2">
			<StackPanel Spacing="16">

				<TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

				<!--
				  Künye kartı: başlık + sözleşme no + durum rozeti, altında iki sütunlu
				  etiket/değer ızgarası. Etiketler küçük, gri ve büyük harf; değerler
				  koyu. Böylece göz önce değerleri tarıyor, etiket sadece bağlam veriyor.
				-->
				<Border IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}"
						Background="White" BorderBrush="#D0D8E4" BorderThickness="1"
						CornerRadius="10" Padding="20">
					<StackPanel Spacing="14">

						<Grid ColumnDefinitions="*,Auto">
							<StackPanel Grid.Column="0" Spacing="3">
								<TextBlock Text="{Binding DetailTitle}" FontSize="19" FontWeight="Bold"
										   Foreground="#1A2E4A" TextWrapping="Wrap"/>
								<TextBlock Text="{Binding DetailNo}" FontSize="12" Foreground="#8A94A6"/>
							</StackPanel>
							<Border Grid.Column="1" VerticalAlignment="Top" Margin="12,2,0,0"
									Background="{Binding DetailStatusBgHex}" CornerRadius="10" Padding="10,4">
								<TextBlock Text="{Binding DetailStatus}" Foreground="{Binding DetailStatusColorHex}"
										   FontSize="11" FontWeight="Bold"/>
							</Border>
						</Grid>

						<Border Background="#EDF1F6" Height="1"/>

						<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
							  ColumnSpacing="24" RowSpacing="14">

							<StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="FİRMA"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailCompany}"/>
							</StackPanel>
							<StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="SAP CARİ"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailSapCariKodu}"/>
							</StackPanel>

							<StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="VERGİ NO"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailTaxNo}"/>
							</StackPanel>
							<StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="TÜR"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailType}"/>
							</StackPanel>

							<StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="BEDEL"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailTotal}"/>
							</StackPanel>
							<StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="KALAN GÜN"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailRemainingDays}"/>
							</StackPanel>

							<StackPanel Grid.Row="3" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="BAŞLANGIÇ"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailStart}"/>
							</StackPanel>
							<StackPanel Grid.Row="3" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="BİTİŞ"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailEnd}"/>
							</StackPanel>

							<StackPanel Grid.Row="4" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="TALEP EDEN"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailRequester}"/>
							</StackPanel>
							<StackPanel Grid.Row="4" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="DEPARTMAN"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailDepartment}"/>
							</StackPanel>

							<StackPanel Grid.Row="5" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="ÖDEME PERİYODU"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailPeriod}"/>
							</StackPanel>
						</Grid>

					</StackPanel>
				</Border>

				<!--
				  İki sütunlu yerleşim: süreç adımları dar bir içerik olduğu için tam genişlikte
				  kartta yanı boş kalıyordu. Solda sabit genişlikte zaman çizelgesi, sağda
				  kalemler/dosyalar/geçmiş bölümleri. Böylece dikey kaydırma da azalıyor.
				-->
				<Grid ColumnDefinitions="330,*" ColumnSpacing="16">

					<StackPanel Grid.Column="0" VerticalAlignment="Top">
					<!--
					  Süreç adımları: sözleşmenin akıştaki yerini tek bakışta gösterir.
					  Bu bölüm eskiden ayrı duran "Aşama Geçmişi" listesinin yerini aldı;
					  ikisi aynı onay zincirini anlatıp birbiriyle çelişebiliyordu. Artık
					  tek zaman çizelgesi var ve gerçek ApprovalLog kayıtlarından besleniyor:
					  onaylar yeşil, redler kırmızı, en altta sözleşmenin bugünkü durumu.
					-->
					<Border IsVisible="{Binding Steps.Count}"
							Background="White" BorderBrush="#D0D8E4" BorderThickness="1"
							CornerRadius="10" Padding="20">
						<StackPanel Spacing="12">
							<TextBlock Text="SÜREÇ ADIMLARI" FontSize="10" FontWeight="Bold" Foreground="#8A94A6"/>

							<ItemsControl ItemsSource="{Binding Steps}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:ContractStepViewModel">
										<Grid ColumnDefinitions="Auto,*">

											<!-- Daire + alttaki bağlayıcı çizgi -->
											<Grid Grid.Column="0" RowDefinitions="Auto,*" Width="22">
												<Border Grid.Row="0" Width="18" Height="18" CornerRadius="9"
														Background="{Binding IconBgHex}"
														BorderBrush="{Binding IconBorderHex}" BorderThickness="1.5"
														HorizontalAlignment="Center">
													<TextBlock Text="{Binding Icon}" FontSize="10" FontWeight="Bold"
															   Foreground="{Binding IconColorHex}"
															   HorizontalAlignment="Center" VerticalAlignment="Center"/>
												</Border>
												<Border Grid.Row="1" Width="2" MinHeight="14"
														Background="{Binding ConnectorColorHex}"
														HorizontalAlignment="Center"/>
											</Grid>

											<StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
												<TextBlock Text="{Binding Label}" FontSize="12.5"
														   Foreground="{Binding LabelColorHex}"
														   FontWeight="{Binding LabelWeight}"
														   TextWrapping="Wrap"/>
												<TextBlock Text="{Binding DateText}" FontSize="10.5" Foreground="#9CA3AF"
													   IsVisible="{Binding HasDate}"/>
												<TextBlock Text="{Binding Note}" FontSize="11" Foreground="#7A5C10"
														   FontStyle="Italic" TextWrapping="Wrap"
														   IsVisible="{Binding HasNote}"/>
											</StackPanel>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>
					</StackPanel>

					<StackPanel Grid.Column="1" Spacing="16">
					<Border IsVisible="{Binding Items.Count}"
							Background="White" BorderBrush="#D0D8E4" BorderThickness="1"
							CornerRadius="10" Padding="20">
						<StackPanel Spacing="10">
							<TextBlock Text="KALEMLER" FontSize="10" FontWeight="Bold" Foreground="#8A94A6"/>

							<!-- Sütun başlıkları: rakamların neyi ifade ettiği belli olsun -->
							<Grid ColumnDefinitions="2*,Auto,*,*" ColumnSpacing="12">
								<TextBlock Grid.Column="0" Text="Açıklama" FontSize="11" FontWeight="Bold" Foreground="#8A94A6"/>
								<TextBlock Grid.Column="1" Text="Miktar" FontSize="11" FontWeight="Bold" Foreground="#8A94A6" Width="70" TextAlignment="Right"/>
								<TextBlock Grid.Column="2" Text="Birim Fiyat" FontSize="11" FontWeight="Bold" Foreground="#8A94A6" TextAlignment="Right"/>
								<TextBlock Grid.Column="3" Text="Tutar" FontSize="11" FontWeight="Bold" Foreground="#8A94A6" TextAlignment="Right"/>
							</Grid>
							<Border Background="#EDF1F6" Height="1"/>

							<ItemsControl ItemsSource="{Binding Items}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border BorderBrush="#EDF1F6" BorderThickness="0,0,0,1" Padding="0,7">
											<Grid ColumnDefinitions="2*,Auto,*,*" ColumnSpacing="12">
												<TextBlock Grid.Column="0" Text="{Binding Description}" FontSize="12.5"
														   Foreground="#1A2E4A" TextWrapping="Wrap"/>
												<TextBlock Grid.Column="1" FontSize="12.5" Foreground="#4B5563"
														   Width="70" TextAlignment="Right">
													<Run Text="{Binding Quantity}"/>
													<Run Text=" "/>
													<Run Text="{Binding Unit}"/>
												</TextBlock>
												<TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:N2}}"
														   FontSize="12.5" Foreground="#4B5563" TextAlignment="Right"/>
												<TextBlock Grid.Column="3" Text="{Binding LineTotal, StringFormat={}{0:N2}}"
														   FontSize="12.5" Foreground="#1A2E4A" FontWeight="Bold" TextAlignment="Right"/>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>

					<Border IsVisible="{Binding Attachments.Count}"
							Background="White" BorderBrush="#D0D8E4" BorderThickness="1"
							CornerRadius="10" Padding="20">
						<StackPanel Spacing="10">
						<TextBlock Text="DOSYALAR" FontSize="10" FontWeight="Bold" Foreground="#8A94A6"/>
						<ItemsControl ItemsSource="{Binding Attachments}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4">
										<Grid ColumnDefinitions="*,Auto,Auto,Auto">
											<TextBlock Grid.Column="0" Text="{Binding FileName}" VerticalAlignment="Center"/>
											<Button Grid.Column="1" Content="Aç" Margin="0,0,4,0"
	                                                Command="{Binding $parent[UserControl].((vm:ContractDetailViewModel)DataContext).OpenAttachmentCommand}"
	                                                CommandParameter="{Binding}"/>
											<Button Grid.Column="2" Content="İndir" Margin="0,0,4,0"
	                                                Click="OnDownloadAttachmentClick"/>
											<Button Classes="flat" Grid.Column="3" IsVisible="{Binding $parent[UserControl].((vm:ContractDetailViewModel)DataContext).CanDeleteAttachments}" Click="OnDeleteAttachmentClick">
												<Border Background="#A32D2D" CornerRadius="4" Padding="12,6">
													<TextBlock Text="Sil" Foreground="White"/>
												</Border>
											</Button>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						</StackPanel>
					</Border>

					<Border IsVisible="{Binding Revisions.Count}"
							Background="White" BorderBrush="#D0D8E4" BorderThickness="1"
							CornerRadius="10" Padding="20">
						<StackPanel Spacing="10">
						<TextBlock Text="REVİZYON GEÇMİŞİ" FontSize="10" FontWeight="Bold" Foreground="#8A94A6"/>
						<ItemsControl ItemsSource="{Binding Revisions}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4">
										<StackPanel Spacing="2">
											<TextBlock FontWeight="Bold" Text="{Binding ChangeType}"/>
											<TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/>
											<TextBlock Foreground="#555555">
												<Run Text="Önceki Bedel: "/>
												<Run Text="{Binding PreviousTotalAmount, StringFormat={}{0:N2}}"/>
												<Run Text=" TL"/>
											</TextBlock>
											<TextBlock Text="{Binding PreviousEndDate, StringFormat='Önceki Bitiş: {0:dd.MM.yyyy}'}"
	                                                   Foreground="#555555"
	                                                   IsVisible="{Binding PreviousEndDate, Converter={x:Static ObjectConverters.IsNotNull}}"/>
											<TextBlock Text="{Binding ChangedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" FontSize="11" Foreground="Gray"/>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						</StackPanel>
					</Border>

					<Border IsVisible="{Binding Terminations.Count}"
							Background="White" BorderBrush="#D0D8E4" BorderThickness="1"
							CornerRadius="10" Padding="20">
						<StackPanel Spacing="10">
						<TextBlock Text="FESİH GEÇMİŞİ" FontSize="10" FontWeight="Bold" Foreground="#8A94A6"/>
						<ItemsControl ItemsSource="{Binding Terminations}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4">
										<StackPanel Spacing="2">
											<TextBlock FontWeight="Bold" Text="{Binding TerminationType}"/>
											<TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/>
											<TextBlock Text="{Binding TerminationDate, StringFormat='Fesih Tarihi: {0:dd.MM.yyyy}'}" Foreground="#555555"/>
											<TextBlock Foreground="#555555"
	                                                   IsVisible="{Binding CompensationAmount, Converter={x:Static ObjectConverters.IsNotNull}}">
												<Run Text="Tazminat: "/>
												<Run Text="{Binding CompensationAmount, StringFormat={}{0:N2}}"/>
												<Run Text=" TL — "/>
												<Run Text="{Binding CompensationDirection}"/>
											</TextBlock>
											<TextBlock Text="{Binding RequestedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" FontSize="11" Foreground="Gray"/>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						</StackPanel>
					</Border>
					</StackPanel>

				</Grid>

			</StackPanel>
		</ScrollViewer>

	</Grid>
</UserControl>