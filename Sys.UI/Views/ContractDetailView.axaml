<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sys.UI.ViewModels"
             x:Class="Sys.UI.Views.ContractDetailView"
             x:DataType="vm:ContractDetailViewModel">

	<!--
	  Classes="flat": butonun gövdesi şeffaf kalır, renk/yazı içindeki Border ve
	  TextBlock'tan gelir. Fluent teması :pointerover durumunda ContentPresenter'ın
	  renklerini ezdiği için doğrudan butona renk vermek hover'da butonu görünmez kılıyordu.
	-->
	<UserControl.Styles>
		<Style Selector="Button.flat">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.flat /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="0"/>
		</Style>
		<Style Selector="Button.flat:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Button.flat:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Button.flat:pointerover">
			<Setter Property="Opacity" Value="0.85"/>
		</Style>
		<Style Selector="Button.flat:pressed">
			<Setter Property="Opacity" Value="0.7"/>
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,Auto,*" Margin="24">

		<StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
			<Button Content="← Geri" FontSize="12" HorizontalAlignment="Left"
                    Background="#6B7280" Foreground="White" Padding="10,4" CornerRadius="4"
                    IsVisible="{Binding ShowBackButton}"
                    Command="{Binding BackCommand}">
				<Button.Styles>
					<Style Selector="Button:pointerover /template/ ContentPresenter">
						<Setter Property="Background" Value="#4B5563"/>
						<Setter Property="TextBlock.Foreground" Value="White"/>
					</Style>
				</Button.Styles>
			</Button>
			<TextBlock Text="Sözleşme Görüntüle" FontSize="22" FontWeight="Bold"/>
		</StackPanel>

		<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
			<TextBlock Text="Sözleşme Seç:" VerticalAlignment="Center"/>
			<ComboBox Width="360"
                      ItemsSource="{Binding AvailableContracts}"
                      SelectedItem="{Binding SelectedContract}"
                      DisplayMemberBinding="{Binding Title}"/>

			<!-- PDF üretip sistemin görüntüleyicisinde açar; yazdırma oradan yapılır -->
			<Button Classes="flat" VerticalAlignment="Center"
                    IsVisible="{Binding CanPrint}"
                    Click="OnPrintClick"
                    ToolTip.Tip="Sözleşme künyesini PDF olarak kaydeder ve açar">
				<Border Background="#2D6EA8" CornerRadius="4" Padding="12,6">
					<TextBlock Text="🖨 Yazdır" Foreground="White" FontSize="12"/>
				</Border>
			</Button>
		</StackPanel>

		<ScrollViewer Grid.Row="2">
			<StackPanel Spacing="16">

				<TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

				<Border IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}"
        Background="#F5F5F5" CornerRadius="8" Padding="16">
					<StackPanel Spacing="8">
						<TextBlock Text="{Binding DetailTitle}" FontSize="18" FontWeight="Bold" Foreground="Black"/>
						<TextBlock Text="{Binding DetailNo}" FontSize="12" Foreground="#555555"/>
						<TextBlock Text="{Binding DetailPeriod}" Foreground="Black" IsVisible="{Binding DetailPeriod, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						<TextBlock Text="{Binding DetailRequester}" Foreground="Black" IsVisible="{Binding DetailRequester, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						<TextBlock Text="{Binding DetailCompany}" Foreground="Black"/>
						<TextBlock Text="{Binding DetailStatus}" Foreground="Black"/>
						<TextBlock Text="{Binding DetailTotal}" Foreground="Black"/>
						<TextBlock Text="{Binding DetailStart}" Foreground="Black"/>
						<TextBlock Text="{Binding DetailEnd}" Foreground="Black"/>
					</StackPanel>
				</Border>

				<StackPanel IsVisible="{Binding Items.Count}">
					<TextBlock Text="Kalemler" FontWeight="Bold" Margin="0,0,0,8"/>
					<ItemsControl ItemsSource="{Binding Items}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4">
									<Grid ColumnDefinitions="2*,*,*,*">
										<TextBlock Grid.Column="0" Text="{Binding Description}"/>
										<TextBlock Grid.Column="1" Text="{Binding Quantity}"/>
										<TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:N2}}"/>
										<TextBlock Grid.Column="3" Text="{Binding LineTotal, StringFormat={}{0:N2}}"/>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<StackPanel IsVisible="{Binding Attachments.Count}">
					<TextBlock Text="Dosyalar" FontWeight="Bold" Margin="0,0,0,8"/>
					<ItemsControl ItemsSource="{Binding Attachments}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4">
									<Grid ColumnDefinitions="*,Auto,Auto,Auto">
										<TextBlock Grid.Column="0" Text="{Binding FileName}" VerticalAlignment="Center"/>
										<Button Grid.Column="1" Content="Aç" Margin="0,0,4,0"
                                                Command="{Binding $parent[UserControl].((vm:ContractDetailViewModel)DataContext).OpenAttachmentCommand}"
                                                CommandParameter="{Binding}"/>
										<Button Grid.Column="2" Content="İndir" Margin="0,0,4,0"
                                                Click="OnDownloadAttachmentClick"/>
										<Button Grid.Column="3" Content="Sil" Background="#A32D2D" Foreground="White"
                                                IsVisible="{Binding $parent[UserControl].((vm:ContractDetailViewModel)DataContext).CanDeleteAttachments}"
                                                Click="OnDeleteAttachmentClick">
											<Button.Styles>
												<Style Selector="Button:pointerover /template/ ContentPresenter">
													<Setter Property="Background" Value="#821F1F"/>
													<Setter Property="TextBlock.Foreground" Value="White"/>
												</Style>
											</Button.Styles>
										</Button>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<StackPanel IsVisible="{Binding ApprovalLogs.Count}">
					<TextBlock Text="Aşama Geçmişi" FontWeight="Bold" Margin="0,0,0,8"/>
					<ItemsControl ItemsSource="{Binding ApprovalLogs}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4">
									<StackPanel Spacing="2">
										<TextBlock FontWeight="Bold">
											<Run Text="{Binding StepNumber}"/>
											<Run Text=". Adım — "/>
											<Run Text="{Binding StepName}"/>
											<Run Text=" — "/>
											<Run Text="{Binding Decision}"/>
										</TextBlock>
										<TextBlock Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" FontStyle="Italic"/>
										<TextBlock Text="{Binding ActionDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" FontSize="11" Foreground="Gray"/>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<StackPanel IsVisible="{Binding Revisions.Count}">
					<TextBlock Text="Revizyon Geçmişi" FontWeight="Bold" Margin="0,0,0,8"/>
					<ItemsControl ItemsSource="{Binding Revisions}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4">
									<StackPanel Spacing="2">
										<TextBlock FontWeight="Bold" Text="{Binding ChangeType}"/>
										<TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/>
										<TextBlock Foreground="#555555">
											<Run Text="Önceki Bedel: "/>
											<Run Text="{Binding PreviousTotalAmount, StringFormat={}{0:N2}}"/>
											<Run Text=" TL"/>
										</TextBlock>
										<TextBlock Text="{Binding PreviousEndDate, StringFormat='Önceki Bitiş: {0:dd.MM.yyyy}'}"
                                                   Foreground="#555555"
                                                   IsVisible="{Binding PreviousEndDate, Converter={x:Static ObjectConverters.IsNotNull}}"/>
										<TextBlock Text="{Binding ChangedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" FontSize="11" Foreground="Gray"/>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<StackPanel IsVisible="{Binding Terminations.Count}">
					<TextBlock Text="Fesih Geçmişi" FontWeight="Bold" Margin="0,0,0,8"/>
					<ItemsControl ItemsSource="{Binding Terminations}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4">
									<StackPanel Spacing="2">
										<TextBlock FontWeight="Bold" Text="{Binding TerminationType}"/>
										<TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/>
										<TextBlock Text="{Binding TerminationDate, StringFormat='Fesih Tarihi: {0:dd.MM.yyyy}'}" Foreground="#555555"/>
										<TextBlock Foreground="#555555"
                                                   IsVisible="{Binding CompensationAmount, Converter={x:Static ObjectConverters.IsNotNull}}">
											<Run Text="Tazminat: "/>
											<Run Text="{Binding CompensationAmount, StringFormat={}{0:N2}}"/>
											<Run Text=" TL — "/>
											<Run Text="{Binding CompensationDirection}"/>
										</TextBlock>
										<TextBlock Text="{Binding RequestedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" FontSize="11" Foreground="Gray"/>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

			</StackPanel>
		</ScrollViewer>

	</Grid>
</UserControl>