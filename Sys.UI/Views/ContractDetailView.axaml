<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Sys.UI.Localization"
             xmlns:conv="using:Sys.UI.Converters"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:domain="using:Sys.Domain"
             x:Class="Sys.UI.Views.ContractDetailView"
             x:DataType="vm:ContractDetailViewModel">

	<UserControl.Styles>
		<Style Selector="ComboBox">
			<Setter Property="Padding" Value="11,8"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
			<Setter Property="Background" Value="{DynamicResource SurfaceInput}"/>
		</Style>
		<Style Selector="TextBlock.tableHead">
			<Setter Property="FontSize" Value="10"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMutedAlt}"/>
			<Setter Property="LetterSpacing" Value="0.5"/>
		</Style>
		<Style Selector="TextBlock.summaryLabel">
			<Setter Property="FontSize" Value="9.5"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMutedAlt}"/>
			<Setter Property="LetterSpacing" Value="0.6"/>
		</Style>
	</UserControl.Styles>

	<!-- Renkli butonlar Classes="flat" kullanır; stil tanımı App.axaml içindedir. -->
	<Grid RowDefinitions="Auto,*" Margin="0,0,20,0">

		<!-- ==================== ÜST: SEÇİM ÇUBUĞU ==================== -->
		<!-- Başlık burada tekrar yazılmıyor; kabuk (ShellView) zaten üstte gösteriyor. -->
		<Border Grid.Row="0" Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
				CornerRadius="12" Padding="18,14" Margin="0,0,0,16">
			<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

				<Button Grid.Column="0" Classes="flat" VerticalAlignment="Center"
						IsVisible="{Binding ShowBackButton}" Command="{Binding BackCommand}">
					<Border Background="{DynamicResource SurfaceButton}" BorderBrush="{DynamicResource BorderInput}" BorderThickness="1"
							CornerRadius="7" Padding="12,7">
						<TextBlock Text="{Binding [Det.Back], Source={x:Static loc:Strings.Current}}" Foreground="{DynamicResource TextLabel}" FontSize="11.5"/>
					</Border>
				</Button>

				<!--
				  Seçici tam genişliğe yayılıyor: sabit genişlikte kaldığında geniş
				  ekranda çubuğun ortasında küçücük duruyor ve uzun sözleşme adları
				  kırpılıyordu. Yazı boyutu da çubuğun ana öğesi olduğu için büyütüldü.
				-->
				<StackPanel Grid.Column="1" Spacing="6">
					<TextBlock Classes="summaryLabel" Text="{Binding [Det.ViewedContract], Source={x:Static loc:Strings.Current}}"/>

					<!--
					  Arama kutusu açılır listenin YANINDA, içinde değil: liste artık
					  tüm sözleşmeleri değil aramaya uyan ilk kayıtları getiriyor, bu
					  yüzden arama listeyi açmadan önce yapılabilmeli.
					-->
					<Grid ColumnDefinitions="220,*" ColumnSpacing="10">
						<TextBox Grid.Column="0" Text="{Binding PickerSearchText}"
								 FontSize="13" Padding="12,11" CornerRadius="8"
								 BorderBrush="{DynamicResource BorderInput}" Background="{DynamicResource SurfaceInput}"
								 PlaceholderText="{Binding [Det.SearchWatermark], Source={x:Static loc:Strings.Current}}"/>

						<ComboBox Grid.Column="1" HorizontalAlignment="Stretch" FontSize="14" Padding="14,11"
								  ItemsSource="{Binding AvailableContracts}"
								  SelectedItem="{Binding SelectedContract}"
								  PlaceholderText="{Binding [Det.PickerPlaceholder], Source={x:Static loc:Strings.Current}}">
							<ComboBox.ItemTemplate>
								<DataTemplate x:DataType="domain:Contract">
									<TextBlock TextTrimming="CharacterEllipsis" FontSize="14">
										<Run Text="{Binding Title}"/>
										<Run Text="  ·  " Foreground="{DynamicResource TextFaintAlt}"/>
										<Run Text="{Binding CompanyName}" Foreground="{DynamicResource TextMuted}"/>
									</TextBlock>
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</Grid>
				</StackPanel>

				<!--
				  İki ayrı işlem: "Yazdır" belgeyi doğrudan yazıcıya gönderir,
				  "PDF Kaydet" ise dosya olarak diske yazar. Eskiden tek bir "Yazdır"
				  butonu vardı ve aslında yalnızca kaydedip görüntüleyicide açıyordu.
				-->
				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
							VerticalAlignment="Bottom" IsVisible="{Binding CanPrint}">

					<!--
					  Yenile: bu sözleşmenin verisiyle dolu yeni bir dönem talebi açar.
					  Yazdırma butonlarının solunda duruyor çünkü çıktı almaktan farklı,
					  sözleşmenin akışını ilerleten bir eylem.
					-->
					<Button Classes="flat" IsVisible="{Binding CanRenew}" Command="{Binding RenewCommand}"
							ToolTip.Tip="{Binding [Doc.RenewHint], Source={x:Static loc:Strings.Current}}">
						<Border Background="{DynamicResource SuccessSoftBgAlt2}" BorderBrush="{DynamicResource SuccessSoftBorderAlt}" BorderThickness="1"
								CornerRadius="8" Padding="16,10">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Path Stroke="{DynamicResource SuccessText}" StrokeThickness="1.7" Fill="Transparent"
									  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
									  Data="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z M14 3v5h5 M12 12v5 M9.5 14.5h5"/>
								<TextBlock Text="{Binding [Doc.Renew], Source={x:Static loc:Strings.Current}}" Foreground="{DynamicResource SuccessText}" FontSize="13"
										   FontWeight="SemiBold" VerticalAlignment="Center"/>
							</StackPanel>
						</Border>
					</Button>

					<Button Classes="flat" Command="{Binding PrintCommand}"
							ToolTip.Tip="{Binding [Doc.PrintHint], Source={x:Static loc:Strings.Current}}">
						<Border Background="{DynamicResource AccentSolid}" CornerRadius="8" Padding="16,11">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Path Stroke="{DynamicResource TextOnAccent}" StrokeThickness="1.7" Fill="Transparent"
									  Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"
									  Data="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2M6 14h12v8H6z"/>
								<TextBlock Text="{Binding [Doc.Print], Source={x:Static loc:Strings.Current}}" Foreground="{DynamicResource TextOnAccent}" FontSize="13"
										   FontWeight="SemiBold" VerticalAlignment="Center"/>
							</StackPanel>
						</Border>
					</Button>

					<Button Classes="flat" Click="OnExportPdfClick"
							ToolTip.Tip="{Binding [Doc.SavePdfHint], Source={x:Static loc:Strings.Current}}">
						<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderStrongAlt}" BorderThickness="1"
								CornerRadius="8" Padding="16,10">
							<TextBlock Text="{Binding [Doc.SavePdf], Source={x:Static loc:Strings.Current}}" Foreground="{DynamicResource TextBody}" FontSize="13"
									   VerticalAlignment="Center"/>
						</Border>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<!-- ==================== GÖVDE ==================== -->
		<Grid Grid.Row="1" ColumnSpacing="20">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" MinWidth="520"/>
				<ColumnDefinition Width="310"/>
			</Grid.ColumnDefinitions>

			<!-- ========== SOL: KÜNYE VE BÖLÜMLER ========== -->
			<ScrollViewer Grid.Column="0">
				<StackPanel Spacing="16" Margin="0,0,4,24">

					<Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
							Background="{DynamicResource DangerSoftBg}" BorderBrush="{DynamicResource DangerSoftBorder}" BorderThickness="1"
							CornerRadius="10" Padding="14,11">
						<TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerTextAlt}"
								   FontSize="12.5" TextWrapping="Wrap"/>
					</Border>

					<TextBlock Text="{Binding [Det.PickFromAbove], Source={x:Static loc:Strings.Current}}"
							   Foreground="{DynamicResource TextFaintAlt}" FontSize="13" Margin="2,20,0,0"
							   IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNull}}"/>

					<!--
					  Künye kartı: başlık + sözleşme no + durum rozeti, altında iki sütunlu
					  etiket/değer ızgarası. Etiketler küçük, gri ve büyük harf; değerler
					  koyu. Böylece göz önce değerleri tarıyor, etiket sadece bağlam veriyor.
					-->
					<Border IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}"
							Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
							CornerRadius="12" Padding="24,20">
						<StackPanel Spacing="18">

							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
								<StackPanel Grid.Column="0" Spacing="3">
									<TextBlock Classes="display" Text="{Binding DetailTitle}" FontSize="20"
											   FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
									<TextBlock FontSize="12" Foreground="{DynamicResource TextMuted}">
										<Run Text="{Binding DetailNo}"/>
										<Run Text="  ·  "/>
										<Run Text="{Binding DetailCompany}"/>
									</TextBlock>
								</StackPanel>
								<Border Grid.Column="1" VerticalAlignment="Top" Margin="0,3,0,0"
										Background="{Binding DetailStatusBgHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}" CornerRadius="10" Padding="11,4">
									<TextBlock Text="{Binding DetailStatus}" Foreground="{Binding DetailStatusColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
											   FontSize="11" FontWeight="Bold"/>
								</Border>
							</Grid>

							<!--
							  Yenileme bilgisi künyenin hemen altında: bir sözleşmenin
							  önceki döneminin olup olmadığı, koşullarını değerlendirirken
							  ilk bakılması gereken şeylerden biri.
							-->
							<Border IsVisible="{Binding IsRenewal}"
									Background="{DynamicResource SuccessSoftBgFaint2}" BorderBrush="{DynamicResource SuccessBorderFaint}" BorderThickness="1"
									CornerRadius="8" Padding="12,9">
								<StackPanel Orientation="Horizontal" Spacing="9">
									<Path Stroke="{DynamicResource SuccessText}" StrokeThickness="1.7" Fill="Transparent"
										  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"
										  Data="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z M14 3v5h5"/>
									<TextBlock Text="{Binding RenewalSourceText}" FontSize="11.5"
											   Foreground="{DynamicResource SuccessTextAlt}" TextWrapping="Wrap" VerticalAlignment="Center"/>
								</StackPanel>
							</Border>

							<Border Background="{DynamicResource SurfaceDivider}" Height="1"/>

							<Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto"
								  ColumnSpacing="20" RowSpacing="16">

								<StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
									<TextBlock Classes="fieldLabel" Text="{Binding [Field.Type], Source={x:Static loc:Strings.Current}}"/>
									<TextBlock Classes="fieldValue" Text="{Binding DetailType}"/>
								</StackPanel>
								<StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
									<TextBlock Classes="fieldLabel" Text="{Binding [Field.TaxNo], Source={x:Static loc:Strings.Current}}"/>
									<TextBlock Classes="fieldValue" Text="{Binding DetailTaxNo}"/>
								</StackPanel>
								<StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
									<TextBlock Classes="fieldLabel" Text="{Binding [Doc.SapCode], Source={x:Static loc:Strings.Current}}"/>
									<TextBlock Classes="fieldValue" Text="{Binding DetailSapCariKodu}"/>
								</StackPanel>

								<StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
									<TextBlock Classes="fieldLabel" Text="{Binding [Field.StartDate], Source={x:Static loc:Strings.Current}}"/>
									<TextBlock Classes="fieldValue" Text="{Binding DetailStart}"/>
								</StackPanel>
								<StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
									<TextBlock Classes="fieldLabel" Text="{Binding [Field.EndDate], Source={x:Static loc:Strings.Current}}"/>
									<TextBlock Classes="fieldValue" Text="{Binding DetailEnd}"/>
								</StackPanel>
								<StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
									<TextBlock Classes="fieldLabel" Text="{Binding [Field.PaymentPeriod], Source={x:Static loc:Strings.Current}}"/>
									<TextBlock Classes="fieldValue" Text="{Binding DetailPeriod}"/>
								</StackPanel>

								<StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
									<TextBlock Classes="fieldLabel" Text="{Binding [Field.Requester], Source={x:Static loc:Strings.Current}}"/>
									<TextBlock Classes="fieldValue" Text="{Binding DetailRequester}"/>
								</StackPanel>
								<StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
									<TextBlock Classes="fieldLabel" Text="{Binding [Doc.Department], Source={x:Static loc:Strings.Current}}"/>
									<TextBlock Classes="fieldValue" Text="{Binding DetailDepartment}"/>
								</StackPanel>
							</Grid>
						</StackPanel>
					</Border>

					<!-- ========== KALEMLER ========== -->
					<Border IsVisible="{Binding Items.Count}"
							Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
							CornerRadius="12" Padding="24,20">
						<StackPanel Spacing="12">
							<TextBlock Classes="display" Text="{Binding [Field.Items], Source={x:Static loc:Strings.Current}}" FontSize="15.5"
									   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>

							<Grid ColumnDefinitions="2*,90,*,*" ColumnSpacing="12">
								<TextBlock Grid.Column="0" Classes="tableHead" Text="{Binding [Field.Description], Source={x:Static loc:Strings.Current}}"/>
								<TextBlock Grid.Column="1" Classes="tableHead" Text="{Binding [Field.Quantity], Source={x:Static loc:Strings.Current}}" TextAlignment="Right"/>
								<TextBlock Grid.Column="2" Classes="tableHead" Text="{Binding [Field.UnitPrice], Source={x:Static loc:Strings.Current}}" TextAlignment="Right"/>
								<TextBlock Grid.Column="3" Classes="tableHead" Text="{Binding [Field.LineTotal], Source={x:Static loc:Strings.Current}}" TextAlignment="Right"/>
							</Grid>
							<Border Background="{DynamicResource SurfaceDivider}" Height="1"/>

							<ItemsControl ItemsSource="{Binding Items}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="domain:ContractItem">
										<Border BorderBrush="{DynamicResource SurfaceSoft}" BorderThickness="0,0,0,1" Padding="0,9">
											<Grid ColumnDefinitions="2*,90,*,*" ColumnSpacing="12">
												<TextBlock Grid.Column="0" Text="{Binding Description}" FontSize="12.5"
														   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
												<TextBlock Grid.Column="1" FontSize="12.5" Foreground="{DynamicResource TextLabel}"
														   TextAlignment="Right">
													<Run Text="{Binding Quantity}"/>
													<Run Text=" "/>
													<Run Text="{Binding Unit}"/>
												</TextBlock>
												<TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:N2}}"
														   FontSize="12.5" Foreground="{DynamicResource TextLabel}" TextAlignment="Right"/>
												<TextBlock Grid.Column="3" Text="{Binding LineTotal, StringFormat={}{0:N2}}"
														   FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"
														   TextAlignment="Right"/>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>

					<!-- ========== DOSYALAR ========== -->
					<Border IsVisible="{Binding Attachments.Count}"
							Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
							CornerRadius="12" Padding="24,20">
						<StackPanel Spacing="12">
							<TextBlock Classes="display" Text="{Binding [Field.Files], Source={x:Static loc:Strings.Current}}" FontSize="15.5"
									   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
							<ItemsControl ItemsSource="{Binding Attachments}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="domain:Attachment">
										<Border Background="{DynamicResource SurfaceSubtle}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
												CornerRadius="9" Padding="13,10" Margin="0,0,0,7">
											<Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="9">
												<Path Grid.Column="0" Stroke="{DynamicResource AccentBase}" StrokeThickness="1.7"
													  Fill="Transparent" Width="16" Height="16" Stretch="Uniform"
													  VerticalAlignment="Center"
													  Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6"/>
												<TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12.5"
														   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
														   TextTrimming="CharacterEllipsis"/>
												<Button Grid.Column="2" Classes="flat" VerticalAlignment="Center"
														Command="{Binding $parent[UserControl].((vm:ContractDetailViewModel)DataContext).OpenAttachmentCommand}"
														CommandParameter="{Binding}">
													<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderInput}" BorderThickness="1"
															CornerRadius="6" Padding="11,5">
														<TextBlock Text="{Binding [Field.Open], Source={x:Static loc:Strings.Current}}" Foreground="{DynamicResource TextBody}" FontSize="11.5"/>
													</Border>
												</Button>
												<Button Grid.Column="3" Classes="flat" VerticalAlignment="Center"
														Click="OnDownloadAttachmentClick">
													<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderInput}" BorderThickness="1"
															CornerRadius="6" Padding="11,5">
														<TextBlock Text="{Binding [Det.Download], Source={x:Static loc:Strings.Current}}" Foreground="{DynamicResource TextBody}" FontSize="11.5"/>
													</Border>
												</Button>
												<Button Grid.Column="4" Classes="flat" VerticalAlignment="Center"
														IsVisible="{Binding $parent[UserControl].((vm:ContractDetailViewModel)DataContext).CanDeleteAttachments}"
														Click="OnDeleteAttachmentClick">
													<Border Background="{DynamicResource DangerSoftBg}" BorderBrush="{DynamicResource DangerSoftBorder}" BorderThickness="1"
															CornerRadius="6" Padding="11,5">
														<TextBlock Text="{Binding [Det.Delete], Source={x:Static loc:Strings.Current}}" Foreground="{DynamicResource DangerBase}" FontSize="11.5"/>
													</Border>
												</Button>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>

					<!-- ========== İHLAL GEÇMİŞİ ========== -->
					<!--
					  İhlal kayıtları veritabanına yazılıyor ama hiçbir ekranda
					  gösterilmiyordu: sözleşme "İhlal Mevcut" durumuna geçiyor, ihlalin
					  ne olduğu ise hiçbir yerden okunamıyordu.
					-->
					<Border IsVisible="{Binding Violations.Count}"
							Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
							CornerRadius="12" Padding="24,20">
						<StackPanel Spacing="12">
							<TextBlock Classes="display" Text="{Binding [Det.ViolationHistory], Source={x:Static loc:Strings.Current}}" FontSize="15.5"
									   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
							<ItemsControl ItemsSource="{Binding Violations}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:ViolationRowViewModel">
										<Border Background="{Binding CardBgHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}" BorderBrush="{Binding CardBorderHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
												BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,8">
											<StackPanel Spacing="6">
												<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
													<TextBlock Grid.Column="0" Text="{Binding ViolationType}" FontSize="12.5"
															   FontWeight="SemiBold" Foreground="{Binding TitleColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
															   VerticalAlignment="Center" TextWrapping="Wrap"/>
													<Border Grid.Column="1" Background="{Binding StatusBgHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
															CornerRadius="9" Padding="9,2" VerticalAlignment="Center">
														<TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
																   FontSize="10" FontWeight="Bold"/>
													</Border>
													<TextBlock Grid.Column="2" Text="{Binding ReportedAtText}"
															   FontSize="10.5" Foreground="{DynamicResource TextFaintAlt}" VerticalAlignment="Center"/>
												</Grid>

												<TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextLabel}"
														   TextWrapping="Wrap" IsVisible="{Binding HasDescription}"/>
												<TextBlock Text="{Binding ViolationDateText}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>

												<!-- Nasıl giderildiği: bildirimin kendisi kadar önemli bir kayıt -->
												<Border IsVisible="{Binding HasResolution}"
														Background="{DynamicResource SuccessSoftBg}" BorderBrush="{DynamicResource SuccessSoftBorder}" BorderThickness="1"
														CornerRadius="7" Padding="10,7" Margin="0,2,0,0">
													<TextBlock Text="{Binding ResolutionText}" FontSize="11.5"
															   Foreground="{DynamicResource SuccessBase}" TextWrapping="Wrap"/>
												</Border>

												<Button Classes="flat" HorizontalAlignment="Left" Margin="0,2,0,0"
														IsVisible="{Binding CanResolve}"
														Click="OnResolveViolationClick">
													<Border Background="{DynamicResource SuccessSoftBg}" BorderBrush="{DynamicResource SuccessSoftBorder}" BorderThickness="1"
															CornerRadius="7" Padding="12,6">
														<TextBlock Text="{Binding [Det.MarkResolved], Source={x:Static loc:Strings.Current}}" Foreground="{DynamicResource SuccessBase}"
																   FontSize="11.5" FontWeight="SemiBold"/>
													</Border>
												</Button>
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>

					<!-- ========== REVİZYON GEÇMİŞİ ========== -->
					<Border IsVisible="{Binding Revisions.Count}"
							Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
							CornerRadius="12" Padding="24,20">
						<StackPanel Spacing="12">
							<TextBlock Classes="display" Text="{Binding [Det.RevisionHistory], Source={x:Static loc:Strings.Current}}" FontSize="15.5"
									   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
							<!--
							  Sonuç rozeti: bu kayıtlar birer TALEP. Reddedilmiş bir bedel
							  değişikliği de eskiden gerçekleşmiş gibi listede duruyordu.
							-->
							<ItemsControl ItemsSource="{Binding Revisions}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:RevisionRowViewModel">
										<Border Background="{Binding CardBgHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}" BorderBrush="{Binding CardBorderHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
												BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,8">
											<StackPanel Spacing="6">
												<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
													<TextBlock Grid.Column="0" Text="{Binding ChangeType}" FontSize="12.5"
															   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
															   VerticalAlignment="Center" TextWrapping="Wrap"/>
													<Border Grid.Column="1" Background="{Binding OutcomeBgHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
															CornerRadius="9" Padding="9,2" VerticalAlignment="Center">
														<TextBlock Text="{Binding OutcomeLabel}" Foreground="{Binding OutcomeColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
																   FontSize="10" FontWeight="Bold"/>
													</Border>
													<TextBlock Grid.Column="2" Text="{Binding ChangedAtText}"
															   FontSize="10.5" Foreground="{DynamicResource TextFaintAlt}" VerticalAlignment="Center"/>
												</Grid>

												<TextBlock Text="{Binding Reason}" FontSize="12" Foreground="{DynamicResource TextLabel}"
														   TextWrapping="Wrap" IsVisible="{Binding HasReason}"/>

												<WrapPanel>
													<TextBlock Text="{Binding PreviousAmountText}" FontSize="11"
															   Foreground="{DynamicResource TextMuted}" Margin="0,0,16,0"/>
													<TextBlock Text="{Binding PreviousEndDateText}" FontSize="11"
															   Foreground="{DynamicResource TextMuted}" Margin="0,0,16,0"
															   IsVisible="{Binding HasPreviousEndDate}"/>
													<TextBlock Text="{Binding PreviousCompanyText}" FontSize="11"
															   Foreground="{DynamicResource TextMuted}" Margin="0,0,16,0"
															   IsVisible="{Binding HasPreviousCompany}"/>
													<TextBlock Text="{Binding PreviousPaymentPeriodText}" FontSize="11"
															   Foreground="{DynamicResource TextMuted}"
															   IsVisible="{Binding HasPreviousPaymentPeriod}"/>
												</WrapPanel>
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>

					<!-- ========== FESİH GEÇMİŞİ ========== -->
					<Border IsVisible="{Binding Terminations.Count}"
							Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
							CornerRadius="12" Padding="24,20">
						<StackPanel Spacing="12">
							<TextBlock Classes="display" Text="{Binding [Det.TerminationHistory], Source={x:Static loc:Strings.Current}}" FontSize="15.5"
									   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
							<!-- Reddedilmiş bir fesih talebi de sözleşme feshedilmiş gibi duruyordu -->
							<ItemsControl ItemsSource="{Binding Terminations}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:TerminationRowViewModel">
										<Border Background="{Binding CardBgHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}" BorderBrush="{Binding CardBorderHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
												BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,8">
											<StackPanel Spacing="6">
												<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
													<TextBlock Grid.Column="0" Text="{Binding TerminationType}" FontSize="12.5"
															   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
															   VerticalAlignment="Center" TextWrapping="Wrap"/>
													<Border Grid.Column="1" Background="{Binding OutcomeBgHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
															CornerRadius="9" Padding="9,2" VerticalAlignment="Center">
														<TextBlock Text="{Binding OutcomeLabel}" Foreground="{Binding OutcomeColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
																   FontSize="10" FontWeight="Bold"/>
													</Border>
													<TextBlock Grid.Column="2" Text="{Binding RequestedAtText}"
															   FontSize="10.5" Foreground="{DynamicResource TextFaintAlt}" VerticalAlignment="Center"/>
												</Grid>

												<TextBlock Text="{Binding Reason}" FontSize="12" Foreground="{DynamicResource TextLabel}"
														   TextWrapping="Wrap" IsVisible="{Binding HasReason}"/>

												<WrapPanel>
													<TextBlock Text="{Binding TerminationDateText}" FontSize="11"
															   Foreground="{DynamicResource TextMuted}" Margin="0,0,16,0"/>
													<TextBlock Text="{Binding CompensationText}" FontSize="11"
															   Foreground="{DynamicResource TextMuted}" IsVisible="{Binding HasCompensation}"/>
												</WrapPanel>
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>

				</StackPanel>
			</ScrollViewer>

			<!-- ========== SAĞ: ÖZET VE SÜREÇ ========== -->
			<!--
			  Sağ panel kendi ScrollViewer'ında: zaman çizelgesi uzun sözleşmelerde
			  ekrandan taşabiliyor, ama sol içerikle birlikte kaymaması gerekiyor.
			-->
			<ScrollViewer Grid.Column="1"
						  IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}">
				<StackPanel Spacing="14" Margin="0,0,0,24">

					<!-- Sözleşmenin sayısal künyesi: en çok bakılan üç değer -->
					<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
							CornerRadius="12" Padding="18,16">
						<StackPanel Spacing="14">
							<TextBlock Classes="sectionLabel" Text="{Binding [Form.Summary], Source={x:Static loc:Strings.Current}}"/>

							<StackPanel Spacing="3">
								<TextBlock Classes="summaryLabel" Text="{Binding [List.ColAmount], Source={x:Static loc:Strings.Current}}"/>
								<TextBlock Classes="display" Text="{Binding DetailTotal}" FontSize="21"
										   FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
							</StackPanel>

							<Border Background="{DynamicResource SurfaceDivider}" Height="1"/>

							<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
								<StackPanel Grid.Column="0" Spacing="3">
									<TextBlock Classes="summaryLabel" Text="{Binding [Det.DaysLeft], Source={x:Static loc:Strings.Current}}"/>
									<TextBlock Text="{Binding DetailRemainingDays}" FontSize="13"
											   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
								</StackPanel>
								<StackPanel Grid.Column="1" Spacing="3">
									<TextBlock Classes="summaryLabel" Text="{Binding [Field.EndDate], Source={x:Static loc:Strings.Current}}"/>
									<TextBlock Text="{Binding DetailEnd}" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
								</StackPanel>
							</Grid>
						</StackPanel>
					</Border>

					<!--
					  Süreç adımları: sözleşmenin akıştaki yerini tek bakışta gösterir.
					  Bu bölüm eskiden ayrı duran "Aşama Geçmişi" listesinin yerini aldı;
					  ikisi aynı onay zincirini anlatıp birbiriyle çelişebiliyordu. Artık
					  tek zaman çizelgesi var ve gerçek ApprovalLog kayıtlarından besleniyor:
					  onaylar yeşil, redler kırmızı, en altta sözleşmenin bugünkü durumu.
					-->
					<Border IsVisible="{Binding Steps.Count}"
							Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
							CornerRadius="12" Padding="18,16">
						<StackPanel Spacing="12">
							<TextBlock Classes="sectionLabel" Text="{Binding [Doc.ProcessSteps], Source={x:Static loc:Strings.Current}}"/>

							<ItemsControl ItemsSource="{Binding Steps}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:ContractStepViewModel">
										<Grid ColumnDefinitions="Auto,*">

											<!-- Daire + alttaki bağlayıcı çizgi -->
											<Grid Grid.Column="0" RowDefinitions="Auto,*" Width="22">
												<Border Grid.Row="0" Width="18" Height="18" CornerRadius="9"
														Background="{Binding IconBgHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
														BorderBrush="{Binding IconBorderHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}" BorderThickness="1.5"
														HorizontalAlignment="Center">
													<TextBlock Text="{Binding Icon}" FontSize="10" FontWeight="Bold"
															   Foreground="{Binding IconColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
															   HorizontalAlignment="Center" VerticalAlignment="Center"/>
												</Border>
												<Border Grid.Row="1" Width="2" MinHeight="14"
														Background="{Binding ConnectorColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
														HorizontalAlignment="Center"/>
											</Grid>

											<StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
												<TextBlock Text="{Binding Label}" FontSize="12.5"
														   Foreground="{Binding LabelColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
														   FontWeight="{Binding LabelWeight}"
														   TextWrapping="Wrap"/>
												<TextBlock Text="{Binding DateText}" FontSize="10.5" Foreground="{DynamicResource TextFaintAlt}"
														   IsVisible="{Binding HasDate}"/>
												<TextBlock Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource WarningTextAlt}"
														   FontStyle="Italic" TextWrapping="Wrap"
														   IsVisible="{Binding HasNote}"/>
											</StackPanel>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>

				</StackPanel>
			</ScrollViewer>
		</Grid>
	</Grid>
</UserControl>
