<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Sys.UI.Converters"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="700"
             x:Class="Sys.UI.Views.UserManagementView"
             x:DataType="vm:UserManagementViewModel">

	<Design.DataContext>
		<vm:UserManagementViewModel />
	</Design.DataContext>

	<UserControl.Styles>
		<Style Selector="TextBox">
			<Setter Property="Padding" Value="11,9"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
			<Setter Property="Background" Value="{DynamicResource SurfaceInput}"/>
		</Style>
		<Style Selector="TextBox:focus">
			<Setter Property="Background" Value="{DynamicResource SurfaceInputFocus}"/>
		</Style>
		<Style Selector="ComboBox">
			<Setter Property="Padding" Value="11,8"/>
			<Setter Property="FontSize" Value="12.5"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
			<Setter Property="Background" Value="{DynamicResource SurfaceInput}"/>
		</Style>
		<Style Selector="TextBlock.formLabel">
			<Setter Property="FontSize" Value="11.5"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextLabel}"/>
			<Setter Property="Margin" Value="0,0,0,5"/>
		</Style>
		<Style Selector="TextBlock.filterLabel">
			<Setter Property="FontSize" Value="10"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMutedAlt}"/>
			<Setter Property="LetterSpacing" Value="0.5"/>
			<Setter Property="Margin" Value="0,0,0,5"/>
		</Style>
	</UserControl.Styles>

	<!-- Renkli butonlar Classes="flat" kullanır; stil tanımı App.axaml içindedir. -->
	<ScrollViewer>
		<StackPanel Margin="0,0,20,24" Spacing="14">

			<TextBlock Text="{DynamicResource Common.Loading}" Foreground="{DynamicResource TextFaintAlt}" FontSize="12.5"
					   IsVisible="{Binding IsLoading}"/>

			<Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
					Background="{DynamicResource DangerSoftBg}" BorderBrush="{DynamicResource DangerSoftBorder}" BorderThickness="1"
					CornerRadius="10" Padding="14,11">
				<TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerTextAlt}"
						   FontSize="12.5" TextWrapping="Wrap"/>
			</Border>

			<Border IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
					Background="{DynamicResource SuccessSoftBgAlt}" BorderBrush="{DynamicResource SuccessSoftBorder}" BorderThickness="1"
					CornerRadius="10" Padding="14,11">
				<TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource SuccessBase}"
						   FontSize="12.5" TextWrapping="Wrap"/>
			</Border>

			<StackPanel IsVisible="{Binding !IsLoading}" Spacing="14">

				<!-- ========== BEKLEYEN ŞİFRE TALEPLERİ ========== -->
				<!-- Giriş ekranındaki "Şifremi unuttum" akışından gelen talepler -->
				<Border IsVisible="{Binding HasResetRequests}"
						Background="{DynamicResource WarningSoftBgAlt}" BorderBrush="{DynamicResource WarningSoftBorder}" BorderThickness="1"
						CornerRadius="12" Padding="20,16">
					<StackPanel Spacing="10">
						<TextBlock Text="{Binding ResetRequestHeader}" FontSize="13"
								   FontWeight="SemiBold" Foreground="{DynamicResource WarningTextAlt}"/>
						<TextBlock Text="{DynamicResource Usr.ResetHint}"
								   FontSize="11.5" Foreground="{DynamicResource WarningDeepAlt}" TextWrapping="Wrap"/>

						<ItemsControl ItemsSource="{Binding ResetRequests}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:ResetRequestRowViewModel">
									<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource WarningBorderFaint}" BorderThickness="1"
											CornerRadius="9" Padding="13,10" Margin="0,4,0,0">
										<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
											<StackPanel Grid.Column="0" Spacing="2">
												<TextBlock Text="{Binding DisplayText}" Foreground="{DynamicResource TextPrimary}"
														   FontSize="12.5" TextWrapping="Wrap"/>
												<TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource TextFaintAlt}" FontSize="10.5"/>
											</StackPanel>
											<Button Grid.Column="1" Classes="flat" VerticalAlignment="Center"
													Command="{Binding $parent[UserControl].((vm:UserManagementViewModel)DataContext).DismissResetRequestCommand}"
													CommandParameter="{Binding}"
													ToolTip.Tip="{DynamicResource Usr.CloseRequestHint}">
												<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderInput}" BorderThickness="1"
														CornerRadius="7" Padding="12,6">
													<TextBlock Text="{DynamicResource Usr.Close}" Foreground="{DynamicResource TextLabel}" FontSize="11.5"/>
												</Border>
											</Button>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Border>

				<!-- ========== ARAMA, FİLTRE, YENİ KULLANICI ========== -->
				<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
						CornerRadius="12" Padding="20,16">
					<Grid ColumnDefinitions="*,180,150,Auto,Auto" ColumnSpacing="12">

						<StackPanel Grid.Column="0">
							<TextBlock Classes="filterLabel" Text="{DynamicResource Usr.Search}"/>
							<Border Background="{DynamicResource SurfaceInput}" BorderBrush="{DynamicResource BorderInput}" BorderThickness="1" CornerRadius="8">
								<Grid ColumnDefinitions="Auto,*">
									<Path Grid.Column="0" Stroke="{DynamicResource TextFaintAlt}" StrokeThickness="2" Fill="Transparent"
										  Width="13" Height="13" Stretch="Uniform" Margin="11,0,0,0"
										  VerticalAlignment="Center"
										  Data="M11 11L15 15M12.5 7.5A5 5 0 1 1 2.5 7.5a5 5 0 0 1 10 0z"/>
									<TextBox Grid.Column="1" Text="{Binding SearchText}"
											 PlaceholderText="{DynamicResource Usr.SearchPlaceholder}"
											 Background="Transparent" BorderThickness="0" Padding="9,8" FontSize="12.5"/>
								</Grid>
							</Border>
						</StackPanel>

						<StackPanel Grid.Column="1">
							<TextBlock Classes="filterLabel" Text="{DynamicResource Usr.Role}"/>
							<ComboBox HorizontalAlignment="Stretch"
									  ItemsSource="{Binding RoleFilterOptions}" SelectedItem="{Binding SelectedRoleFilter}"/>
						</StackPanel>

						<StackPanel Grid.Column="2">
							<TextBlock Classes="filterLabel" Text="{DynamicResource Usr.Status}"/>
							<ComboBox HorizontalAlignment="Stretch"
									  ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}"/>
						</StackPanel>

						<Button Grid.Column="3" Classes="flat" VerticalAlignment="Bottom"
								IsVisible="{Binding HasActiveFilters}" Command="{Binding ClearFiltersCommand}">
							<Border Background="{DynamicResource SurfaceButton}" BorderBrush="{DynamicResource BorderInput}" BorderThickness="1"
									CornerRadius="8" Padding="14,10">
								<TextBlock Text="{DynamicResource Audit.Clear}" Foreground="{DynamicResource TextLabel}" FontSize="12.5"/>
							</Border>
						</Button>

						<Button Grid.Column="4" Classes="flat" VerticalAlignment="Bottom"
								Command="{Binding ToggleNewUserFormCommand}">
							<Border Background="{DynamicResource AccentSolid}" CornerRadius="8" Padding="16,10">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<Path Stroke="{DynamicResource TextOnAccent}" StrokeThickness="2" StrokeLineCap="Round" Fill="Transparent"
										  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
										  Data="M12 5v14M5 12h14"/>
									<TextBlock Text="{DynamicResource Usr.NewUser}" Foreground="{DynamicResource TextOnAccent}" FontSize="12.5"
											   FontWeight="SemiBold" VerticalAlignment="Center"/>
								</StackPanel>
							</Border>
						</Button>
					</Grid>
				</Border>

				<!-- ========== YENİ KULLANICI FORMU ========== -->
				<Border IsVisible="{Binding ShowNewUserForm}"
						Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource AccentSoftBorder}" BorderThickness="1"
						CornerRadius="12" Padding="24,20">
					<StackPanel Spacing="16">

						<StackPanel Spacing="1">
							<TextBlock Classes="display" Text="{DynamicResource Usr.NewUser}" FontSize="15.5"
									   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
							<TextBlock Text="{DynamicResource Usr.RequiredHint}"
									   FontSize="11" Foreground="{DynamicResource TextFaintAlt}"/>
						</StackPanel>
						<Border Background="{DynamicResource SurfaceDivider}" Height="1"/>

						<Grid ColumnDefinitions="*,*" ColumnSpacing="18">
							<StackPanel Grid.Column="0">
								<TextBlock Classes="formLabel">
									<Run Text="{DynamicResource Usr.Username}"/>
									<Run Text=" *" Foreground="{DynamicResource DangerText}"/>
								</TextBlock>
								<TextBox Text="{Binding NewUsername}"/>
							</StackPanel>
							<StackPanel Grid.Column="1">
								<TextBlock Classes="formLabel">
									<Run Text="{DynamicResource Usr.FullName}"/>
									<Run Text=" *" Foreground="{DynamicResource DangerText}"/>
								</TextBlock>
								<TextBox Text="{Binding NewFullName}"/>
							</StackPanel>
						</Grid>

						<Grid ColumnDefinitions="*,*" ColumnSpacing="18">
							<StackPanel Grid.Column="0">
								<TextBlock Classes="formLabel" Text="{DynamicResource Usr.Department}"/>
								<TextBox Text="{Binding NewDepartment}" PlaceholderText="{DynamicResource Usr.Optional}"/>
							</StackPanel>
							<StackPanel Grid.Column="1">
								<TextBlock Classes="formLabel">
									<Run Text="{DynamicResource Usr.Role}"/>
									<Run Text=" *" Foreground="{DynamicResource DangerText}"/>
								</TextBlock>
								<!--
								  Enum doğrudan bağlanınca "SYB", "Mudur" gibi ham adlar
								  görünüyordu; artık etiketli seçenekler bağlanıyor.
								-->
								<ComboBox HorizontalAlignment="Stretch"
										  ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding NewRoleOption}">
									<ComboBox.ItemTemplate>
										<DataTemplate x:DataType="vm:RoleOption">
											<TextBlock Text="{Binding Label}"/>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</StackPanel>
						</Grid>

						<StackPanel MaxWidth="360" HorizontalAlignment="Left">
							<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
								<TextBlock Grid.Column="0" Classes="formLabel" Margin="0">
									<Run Text="{DynamicResource Usr.TempPassword}"/>
									<Run Text=" *" Foreground="{DynamicResource DangerText}"/>
								</TextBlock>
								<!-- Şifre yazarken Caps Lock uyarısı; diğer şifre ekranlarıyla aynı -->
								<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"
											VerticalAlignment="Center" IsVisible="{Binding ShowNewUserCapsWarning}">
									<Path Fill="{DynamicResource DangerBase}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Data="M12 3L19 10.5H15.5V15H8.5V10.5H5ZM8.5 17.5H15.5V21H8.5Z"/>
									<TextBlock Text="{DynamicResource Pwd.CapsLock}" FontSize="11" Foreground="{DynamicResource DangerBase}" VerticalAlignment="Center"/>
								</StackPanel>
							</Grid>
							<TextBox Text="{Binding NewPassword}" PasswordChar="•" PlaceholderText="{DynamicResource Usr.PasswordPlaceholder}"
									 KeyUp="OnNewUserPasswordKeyUp" GotFocus="OnNewUserPasswordFocus"
									 LostFocus="OnNewUserPasswordLostFocus"/>
						</StackPanel>

						<StackPanel Orientation="Horizontal" Spacing="10">
							<Button Classes="flat" IsEnabled="{Binding !IsBusy}" Command="{Binding CreateUserCommand}">
								<Border Background="{DynamicResource AccentSolid}" CornerRadius="8" Padding="18,10">
									<TextBlock Text="{DynamicResource Usr.Create}" Foreground="{DynamicResource TextOnAccent}" FontSize="13" FontWeight="SemiBold"/>
								</Border>
							</Button>
							<Button Classes="flat" Command="{Binding ToggleNewUserFormCommand}">
								<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderInput}" BorderThickness="1"
										CornerRadius="8" Padding="18,9">
									<TextBlock Text="{DynamicResource Form.Cancel}" Foreground="{DynamicResource TextLabel}" FontSize="13"/>
								</Border>
							</Button>
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- ========== KULLANICI LİSTESİ ========== -->
				<TextBlock Text="{Binding CountText}" Classes="sectionLabel" Margin="2,4,0,0"/>

				<StackPanel Spacing="10" Margin="0,20,0,0" IsVisible="{Binding IsEmpty}">
					<TextBlock Text="{DynamicResource Usr.NoMatch}" Foreground="{DynamicResource TextMuted}"
							   FontSize="13" HorizontalAlignment="Center"/>
					<Button Classes="flat" HorizontalAlignment="Center"
							IsVisible="{Binding HasActiveFilters}" Command="{Binding ClearFiltersCommand}">
						<Border Background="{DynamicResource SurfaceButton}" BorderBrush="{DynamicResource BorderButton}" BorderThickness="1"
								CornerRadius="8" Padding="14,7">
							<TextBlock Text="{DynamicResource Common.ClearFilters}" Foreground="{DynamicResource TextBody}" FontSize="12"/>
						</Border>
					</Button>
				</StackPanel>

				<ItemsControl ItemsSource="{Binding Users}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:UserRowViewModel">
							<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
									CornerRadius="11" Padding="18,14" Margin="0,0,0,8">
								<StackPanel Spacing="12">

									<Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">

										<!-- Baş harf rozeti -->
										<Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
												Background="{DynamicResource SurfaceButton}" VerticalAlignment="Center">
											<TextBlock Text="{Binding Initials}" FontSize="13.5" FontWeight="Bold"
													   Foreground="{DynamicResource TextLabel}"
													   HorizontalAlignment="Center" VerticalAlignment="Center"/>
										</Border>

										<StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="13.5"
														   Foreground="{DynamicResource TextPrimary}"/>
												<!-- Kendi hesabın: hangi satırın sana ait olduğu belli olsun -->
												<Border IsVisible="{Binding IsSelf}" Background="{DynamicResource BorderFaintBlue}"
														CornerRadius="8" Padding="7,1" VerticalAlignment="Center">
													<TextBlock Text="{DynamicResource Usr.You}" Foreground="{DynamicResource AccentBase}" FontSize="10" FontWeight="Bold"/>
												</Border>
											</StackPanel>
											<TextBlock FontSize="11.5" Foreground="{DynamicResource TextMuted}">
												<Run Text="{Binding Username}"/>
												<Run Text="  ·  "/>
												<Run Text="{Binding RoleLabel}"/>
												<Run Text="  ·  "/>
												<Run Text="{Binding DepartmentText}"/>
											</TextBlock>
										</StackPanel>

										<Border Grid.Column="2" Background="{Binding StatusBgHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}" CornerRadius="10"
												Padding="11,4" VerticalAlignment="Center">
											<TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
													   FontSize="10.5" FontWeight="Bold"/>
										</Border>

										<StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
													VerticalAlignment="Center">
											<Button Classes="flat"
													Command="{Binding $parent[UserControl].((vm:UserManagementViewModel)DataContext).ToggleResetPasswordCommand}"
													CommandParameter="{Binding}">
												<Border Background="{DynamicResource SurfaceButton}" BorderBrush="{DynamicResource BorderInput}" BorderThickness="1"
														CornerRadius="7" Padding="12,6">
													<TextBlock Text="{DynamicResource Usr.ResetPassword}" Foreground="{DynamicResource TextBody}" FontSize="11.5"/>
												</Border>
											</Button>

											<!--
											  Yönetici kendi hesabını devre dışı bırakamaz; servis de
											  engelliyor. Buton gösterilip hata vermek yerine gizleniyor.
											-->
											<Button Classes="flat" IsVisible="{Binding CanToggleDisabled}"
													Command="{Binding $parent[UserControl].((vm:UserManagementViewModel)DataContext).ToggleDisabledCommand}"
													CommandParameter="{Binding}">
												<Border Background="{Binding ToggleButtonBgHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}" BorderThickness="1"
														BorderBrush="{Binding ToggleButtonBorderHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
														CornerRadius="7" Padding="12,6">
													<TextBlock Text="{Binding ToggleButtonLabel}"
															   Foreground="{Binding ToggleButtonFgHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}" FontSize="11.5"/>
												</Border>
											</Button>
										</StackPanel>
									</Grid>

									<!-- Satır içi şifre sıfırlama -->
									<Border IsVisible="{Binding IsResettingPassword}"
											Background="{DynamicResource SurfaceSubtle}" BorderBrush="{DynamicResource BorderInput}" BorderThickness="1"
											CornerRadius="9" Padding="14,12">
										<StackPanel Spacing="8">
											<StackPanel Orientation="Horizontal" Spacing="12">
												<TextBlock Text="{DynamicResource Usr.SetNewPassword}" FontSize="11.5" FontWeight="SemiBold"
														   Foreground="{DynamicResource TextLabel}" VerticalAlignment="Center"/>
												<!--
												  Uyarı satırın kendi durumundan besleniyor: kutu DataTemplate
												  içinde tekrar ettiği için x:Name ile tek bir öğeye erişilemiyor.
												-->
												<StackPanel Orientation="Horizontal" Spacing="5"
															VerticalAlignment="Center" IsVisible="{Binding ShowCapsWarning}">
													<Path Fill="{DynamicResource DangerBase}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Data="M12 3L19 10.5H15.5V15H8.5V10.5H5ZM8.5 17.5H15.5V21H8.5Z"/>
													<TextBlock Text="{DynamicResource Pwd.CapsLock}" FontSize="11" Foreground="{DynamicResource DangerBase}" VerticalAlignment="Center"/>
												</StackPanel>
											</StackPanel>
											<StackPanel Orientation="Horizontal" Spacing="10">
												<TextBox Width="260" Text="{Binding NewPasswordText}"
														 PasswordChar="•" PlaceholderText="{DynamicResource Usr.PasswordPlaceholder}"
														 KeyUp="OnResetPasswordKeyUp" GotFocus="OnResetPasswordFocus"
														 LostFocus="OnResetPasswordLostFocus"/>
												<Button Classes="flat" VerticalAlignment="Center"
														Command="{Binding $parent[UserControl].((vm:UserManagementViewModel)DataContext).ConfirmResetPasswordCommand}"
														CommandParameter="{Binding}">
													<Border Background="{DynamicResource AccentSolid}" CornerRadius="8" Padding="16,9">
														<TextBlock Text="{DynamicResource Usr.Save}" Foreground="{DynamicResource TextOnAccent}" FontSize="12.5"
																   FontWeight="SemiBold"/>
													</Border>
												</Button>
												<Button Classes="flat" VerticalAlignment="Center"
														Command="{Binding $parent[UserControl].((vm:UserManagementViewModel)DataContext).ToggleResetPasswordCommand}"
														CommandParameter="{Binding}">
													<TextBlock Text="{DynamicResource Form.Cancel}" Foreground="{DynamicResource TextMuted}" FontSize="11.5"
															   VerticalAlignment="Center"/>
												</Button>
											</StackPanel>
										</StackPanel>
									</Border>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

			</StackPanel>
		</StackPanel>
	</ScrollViewer>

</UserControl>
