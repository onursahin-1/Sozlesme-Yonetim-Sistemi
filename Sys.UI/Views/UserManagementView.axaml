<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Sys.UI.Views.UserManagementView"
             x:DataType="vm:UserManagementViewModel">

	<Design.DataContext>
		<vm:UserManagementViewModel />
	</Design.DataContext>

	<!--
	  RENKLİ BUTONLAR HAKKINDA:
	  Avalonia'nın Fluent teması, farenin buton üzerine gelmesi (:pointerover) durumunda
	  butonun ContentPresenter'ının Background ve Foreground değerlerini kendi tema
	  renkleriyle eziyor. Butona doğrudan Background/Foreground vermek ya da
	  Button.Styles ile :pointerover stili tanımlamak bu ezmeyi güvenilir şekilde
	  engellemiyordu (buton hover'da görünmez oluyordu).

	  Çözüm: Butonun kendi gövdesini tamamen şeffaf/çerçevesiz yapıyoruz ve rengi
	  butonun İÇİNDEKİ Border'a, yazı rengini de İÇİNDEKİ TextBlock'a veriyoruz.
	  Bunlar yerel (local) değer olduğu için tema hiçbir durumda üzerlerine yazamaz;
	  böylece buton hover'da da normal, basılıyken de aynı görünür.
	-->
	<UserControl.Styles>
		<!-- Şeffaf gövdeli buton: tüm renk işini içindeki Border yapar. -->
		<Style Selector="Button.flat">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<!-- Hover/basılı durumda gövde yine şeffaf kalsın; geri bildirimi opaklıkla veriyoruz. -->
		<Style Selector="Button.flat /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="0"/>
		</Style>
		<Style Selector="Button.flat:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Button.flat:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Button.flat:pointerover">
			<Setter Property="Opacity" Value="0.85"/>
		</Style>
		<Style Selector="Button.flat:pressed">
			<Setter Property="Opacity" Value="0.7"/>
		</Style>
		<Style Selector="Button.flat:disabled">
			<Setter Property="Opacity" Value="0.5"/>
		</Style>
	</UserControl.Styles>

	<ScrollViewer>
		<StackPanel Margin="0,0,20,20" Spacing="12">

			<TextBlock Text="Yükleniyor..." IsVisible="{Binding IsLoading}"/>

			<TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"
					   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
			<TextBlock Text="{Binding SuccessMessage}" Foreground="Green" TextWrapping="Wrap"
					   IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

			<StackPanel IsVisible="{Binding !IsLoading}" Spacing="12">

				<Button Classes="flat" HorizontalAlignment="Left"
						Command="{Binding ToggleNewUserFormCommand}">
					<Border Background="#2D6EA8" CornerRadius="4" Padding="12,6">
						<TextBlock Text="+ Yeni Kullanıcı" Foreground="White"/>
					</Border>
				</Button>

				<!-- Yeni kullanıcı formu -->
				<Border IsVisible="{Binding ShowNewUserForm}" Background="#F5F5F5" CornerRadius="8" Padding="16">
					<StackPanel Spacing="8" MaxWidth="420">
						<TextBlock Text="Kullanıcı Adı *" FontWeight="Bold" Foreground="Black"/>
						<TextBox Text="{Binding NewUsername}" Background="White" Foreground="Black"/>

						<TextBlock Text="Ad Soyad *" FontWeight="Bold" Foreground="Black" Margin="0,8,0,0"/>
						<TextBox Text="{Binding NewFullName}" Background="White" Foreground="Black"/>

						<TextBlock Text="Departman" FontWeight="Bold" Foreground="Black" Margin="0,8,0,0"/>
						<TextBox Text="{Binding NewDepartment}" Background="White" Foreground="Black" PlaceholderText="Opsiyonel"/>

						<TextBlock Text="Rol *" FontWeight="Bold" Foreground="Black" Margin="0,8,0,0"/>
						<ComboBox ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding NewRole}"
								  Background="White" Foreground="Black" HorizontalAlignment="Stretch"/>

						<TextBlock Text="Geçici Şifre *" FontWeight="Bold" Foreground="Black" Margin="0,8,0,0"/>
						<TextBox Text="{Binding NewPassword}" Background="White" Foreground="Black" PasswordChar="•" PlaceholderText="En az 6 karakter"/>

						<Button Classes="flat" Margin="0,12,0,0" HorizontalAlignment="Left"
								IsEnabled="{Binding !IsBusy}"
								Command="{Binding CreateUserCommand}">
							<Border Background="#2D6EA8" CornerRadius="4" Padding="16,8">
								<TextBlock Text="Kullanıcı Oluştur" Foreground="White"/>
							</Border>
						</Button>
					</StackPanel>
				</Border>

				<!-- Kullanıcı listesi -->
				<ItemsControl ItemsSource="{Binding Users}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:UserRowViewModel">
							<Border Background="White" BorderBrush="#D0D8E4" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
								<StackPanel Spacing="6">
									<Grid ColumnDefinitions="*,Auto">
										<StackPanel Grid.Column="0">
											<TextBlock FontWeight="Bold" FontSize="14" Foreground="Black">
												<Run Text="{Binding FullName}"/>
												<Run Text=" ("/>
												<Run Text="{Binding Username}"/>
												<Run Text=")"/>
											</TextBlock>
											<TextBlock FontSize="11" Foreground="#888">
												<Run Text="{Binding RoleLabel}"/>
												<Run Text=" · "/>
												<Run Text="{Binding Department}"/>
											</TextBlock>
										</StackPanel>
										<Border Grid.Column="1" Background="{Binding StatusBgHex}" CornerRadius="10" Padding="8,3">
											<TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColorHex}" FontSize="11" FontWeight="Bold"/>
										</Border>
									</Grid>

									<StackPanel Orientation="Horizontal" Spacing="8">
										<Button Classes="flat"
												Command="{Binding $parent[UserControl].((vm:UserManagementViewModel)DataContext).ToggleResetPasswordCommand}"
												CommandParameter="{Binding}">
											<Border Background="#4B5563" CornerRadius="4" Padding="10,4">
												<TextBlock Text="Şifre Sıfırla" Foreground="White" FontSize="11"/>
											</Border>
										</Button>
										<Button Classes="flat"
												Command="{Binding $parent[UserControl].((vm:UserManagementViewModel)DataContext).ToggleDisabledCommand}"
												CommandParameter="{Binding}">
											<Border Background="{Binding ToggleButtonBgHex}" CornerRadius="4" Padding="10,4">
												<TextBlock Text="{Binding ToggleButtonLabel}" Foreground="White" FontSize="11"/>
											</Border>
										</Button>
									</StackPanel>

									<StackPanel IsVisible="{Binding IsResettingPassword}" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
										<TextBox Width="220" Text="{Binding NewPasswordText}" Background="White" Foreground="Black"
												 PasswordChar="•" PlaceholderText="Yeni şifre (en az 6 karakter)"/>
										<Button Classes="flat" VerticalAlignment="Center"
												Command="{Binding $parent[UserControl].((vm:UserManagementViewModel)DataContext).ConfirmResetPasswordCommand}"
												CommandParameter="{Binding}">
											<Border Background="#2D6EA8" CornerRadius="4" Padding="14,6">
												<TextBlock Text="Kaydet" Foreground="White"/>
											</Border>
										</Button>
									</StackPanel>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

			</StackPanel>
		</StackPanel>
	</ScrollViewer>

</UserControl>