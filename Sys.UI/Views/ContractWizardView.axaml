<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:domain="using:Sys.Domain"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="760"
             x:Class="Sys.UI.Views.ContractWizardView"
             x:DataType="vm:ContractWizardViewModel">

	<Design.DataContext>
		<vm:ContractWizardViewModel />
	</Design.DataContext>

	<UserControl.Styles>
		<!-- Form stilleri bu ekranla sınırlı; global TextBox stili diğer ekranları da değiştirirdi. -->
		<Style Selector="TextBlock.formLabel">
			<Setter Property="FontSize" Value="11.5"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="#5B6472"/>
			<Setter Property="Margin" Value="0,0,0,5"/>
		</Style>
		<Style Selector="TextBlock.formHint">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="#A3ABB8"/>
			<Setter Property="Margin" Value="2,5,0,0"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
		<Style Selector="TextBox">
			<Setter Property="Padding" Value="11,9"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderBrush" Value="#DFE5EE"/>
			<Setter Property="Background" Value="#FBFCFE"/>
		</Style>
		<Style Selector="TextBox:focus">
			<Setter Property="Background" Value="White"/>
		</Style>
		<Style Selector="ComboBox">
			<Setter Property="Padding" Value="11,8"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderBrush" Value="#DFE5EE"/>
			<Setter Property="Background" Value="#FBFCFE"/>
		</Style>
		<Style Selector="DatePicker">
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderBrush" Value="#DFE5EE"/>
			<Setter Property="Background" Value="#FBFCFE"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
		</Style>

		<Style Selector="TextBlock.summaryLabel">
			<Setter Property="FontSize" Value="9.5"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="#93A4BC"/>
			<Setter Property="LetterSpacing" Value="0.6"/>
		</Style>
		<Style Selector="TextBlock.summaryValue">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="#1A2E4A"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
		<Style Selector="TextBlock.summaryEmpty">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="#C4CBD6"/>
		</Style>
		<Style Selector="TextBlock.tableHead">
			<Setter Property="FontSize" Value="10"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="#93A4BC"/>
			<Setter Property="LetterSpacing" Value="0.5"/>
		</Style>
	</UserControl.Styles>

	<!--
	  Solda içinde bulunulan adımın formu, sağda kaydırmayla kaybolmayan adım
	  göstergesi, canlı özet ve gezinme butonları. Sağ panel ScrollViewer'ın dışında.
	-->
	<Grid ColumnSpacing="22" Margin="0,0,20,0">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" MinWidth="500"/>
			<ColumnDefinition Width="300"/>
		</Grid.ColumnDefinitions>

		<!-- ==================== SOL: ADIM İÇERİĞİ ==================== -->
		<ScrollViewer Grid.Column="0">
			<StackPanel Spacing="16" Margin="0,0,4,24">

				<!-- Kısa özet; ayrıntılı mesaj ilgili alanın altında gösteriliyor -->
				<Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
						Background="#FDECEA" BorderBrush="#F0C9C1" BorderThickness="1"
						CornerRadius="10" Padding="14,11">
					<TextBlock Text="{Binding ErrorMessage}" Foreground="#9B3B25"
							   FontSize="12.5" TextWrapping="Wrap"/>
				</Border>

				<!-- ==================== ADIM 1 ==================== -->
				<Border IsVisible="{Binding IsStep1}"
						Background="White" BorderBrush="#E3E7EE" BorderThickness="1"
						CornerRadius="12" Padding="24,20">
					<StackPanel Spacing="18">

						<StackPanel Spacing="1">
							<TextBlock Classes="display" Text="Temel Bilgiler" FontSize="15.5"
									   FontWeight="SemiBold" Foreground="#1A2E4A"/>
							<TextBlock Text="Yıldızlı (*) alanlar zorunludur." FontSize="11" Foreground="#A3ABB8"/>
						</StackPanel>
						<Border Background="#EDF1F6" Height="1"/>

						<StackPanel>
							<TextBlock Classes="formLabel">
								<Run Text="SÖZLEŞMESİ OLUŞTURULACAK TALEP"/>
								<Run Text=" *" Foreground="#D14343"/>
							</TextBlock>
							<ComboBox ItemsSource="{Binding PendingRequests}" SelectedItem="{Binding SelectedRequest}"
									  HorizontalAlignment="Stretch">
								<ComboBox.ItemTemplate>
									<DataTemplate x:DataType="domain:Contract">
										<TextBlock>
											<Run Text="{Binding Title}"/>
											<Run Text="  ·  "/>
											<Run Text="{Binding CompanyName}"/>
										</TextBlock>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
							<TextBlock Classes="fieldError" Text="{Binding RequestError}"
									   IsVisible="{Binding RequestError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
							<TextBlock Classes="formHint" Text="Bekleyen talep yok."
									   IsVisible="{Binding !PendingRequests.Count}"/>
						</StackPanel>

						<Grid ColumnDefinitions="*,*" ColumnSpacing="18">
							<StackPanel Grid.Column="0">
								<TextBlock Classes="formLabel">
									<Run Text="BAŞLANGIÇ TARİHİ"/>
									<Run Text=" *" Foreground="#D14343"/>
								</TextBlock>
								<DatePicker SelectedDate="{Binding StartDate}"/>
								<TextBlock Classes="fieldError" Text="{Binding StartDateError}"
										   IsVisible="{Binding StartDateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
							</StackPanel>
							<StackPanel Grid.Column="1">
								<TextBlock Classes="formLabel">
									<Run Text="BİTİŞ TARİHİ"/>
									<Run Text=" *" Foreground="#D14343"/>
								</TextBlock>
								<DatePicker SelectedDate="{Binding EndDate}"/>
								<TextBlock Classes="fieldError" Text="{Binding EndDateError}"
										   IsVisible="{Binding EndDateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
							</StackPanel>
						</Grid>

						<Grid ColumnDefinitions="*,*" ColumnSpacing="18">
							<StackPanel Grid.Column="0">
								<TextBlock Classes="formLabel">
									<Run Text="ÖDEME PERİYODU"/>
									<Run Text=" *" Foreground="#D14343"/>
								</TextBlock>
								<ComboBox ItemsSource="{Binding PaymentPeriodOptions}"
										  SelectedItem="{Binding SelectedPaymentPeriod}" HorizontalAlignment="Stretch"/>
								<TextBlock Classes="fieldError" Text="{Binding PaymentPeriodError}"
										   IsVisible="{Binding PaymentPeriodError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
							</StackPanel>
							<StackPanel Grid.Column="1">
								<TextBlock Classes="formLabel" Text="FİRMA TÜRÜ"/>
								<ComboBox ItemsSource="{Binding CompanyTypeOptions}"
										  SelectedItem="{Binding SelectedCompanyType}" HorizontalAlignment="Stretch"/>
							</StackPanel>
						</Grid>

						<StackPanel>
							<TextBlock Classes="formLabel">
								<Run Text="SAP CARİ KODU"/>
								<Run Text=" *" Foreground="#D14343"/>
							</TextBlock>
							<TextBox Text="{Binding SapCariKodu}" PlaceholderText="C-XXXXX"/>
							<TextBlock Classes="fieldError" Text="{Binding SapCariKoduError}"
									   IsVisible="{Binding SapCariKoduError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- ==================== ADIM 2 ==================== -->
				<Border IsVisible="{Binding IsStep2}"
						Background="White" BorderBrush="#E3E7EE" BorderThickness="1"
						CornerRadius="12" Padding="24,20">
					<StackPanel Spacing="16">

						<StackPanel Spacing="1">
							<TextBlock Classes="display" Text="Bedel Kalemleri" FontSize="15.5"
									   FontWeight="SemiBold" Foreground="#1A2E4A"/>
							<TextBlock Text="Sözleşmenin toplam bedeli bu kalemlerden hesaplanır."
									   FontSize="11" Foreground="#A3ABB8"/>
						</StackPanel>
						<Border Background="#EDF1F6" Height="1"/>

						<!--
						  Reddedilip geri dönmüş bir talep ikinci kez sözleşmeye dönüştürülürken
						  form eskiden boş açılıyordu; kaydedilince kalemler eskilerin üzerine
						  ekleniyor ve bu ekranda hiç görünmüyordu.
						-->
						<Border IsVisible="{Binding IsRecreate}"
								Background="#FFF7E6" BorderBrush="#E8C989" BorderThickness="1"
								CornerRadius="10" Padding="14,11">
							<TextBlock Text="{Binding RecreateNotice}" FontSize="12"
									   Foreground="#7A5C10" TextWrapping="Wrap"/>
						</Border>

						<!-- Sütun başlıkları: hangi kutunun ne olduğu yazmıyordu -->
						<Grid ColumnDefinitions="*,80,110,130,Auto" ColumnSpacing="8" Margin="0,2,0,0">
							<TextBlock Grid.Column="0" Classes="tableHead" Text="TANIM"/>
							<TextBlock Grid.Column="1" Classes="tableHead" Text="MİKTAR"/>
							<TextBlock Grid.Column="2" Classes="tableHead" Text="BİRİM"/>
							<TextBlock Grid.Column="3" Classes="tableHead" Text="BİRİM FİYAT" TextAlignment="Right"/>
							<TextBlock Grid.Column="4" Classes="tableHead" Text="" Width="34"/>
						</Grid>

						<ItemsControl ItemsSource="{Binding Items}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:ContractItemRowViewModel">
									<Grid ColumnDefinitions="*,80,110,130,Auto" ColumnSpacing="8" Margin="0,0,0,8">
										<TextBox Grid.Column="0" PlaceholderText="Kalem tanımı" Text="{Binding Description}"/>
										<TextBox Grid.Column="1" Text="{Binding QuantityText}" TextAlignment="Right"/>
										<ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
												  ItemsSource="{Binding Source={x:Static vm:ContractItemRowViewModel.UnitOptions}}"
												  SelectedItem="{Binding Unit}"/>
										<TextBox Grid.Column="3" Text="{Binding UnitPriceText}" TextAlignment="Right"
												 LostFocus="OnAmountLostFocus" TextChanged="OnAmountTextChanged"/>
										<Button Grid.Column="4" Classes="flat" Command="{Binding RemoveCommand}"
												ToolTip.Tip="Kalemi sil" VerticalAlignment="Center">
											<Border Background="#FDECEA" BorderBrush="#F0C9C1" BorderThickness="1"
													CornerRadius="7" Width="34" Height="34">
												<Path Stroke="#A32D2D" StrokeThickness="1.8" StrokeLineCap="Round"
													  Fill="Transparent" Width="12" Height="12" Stretch="Uniform"
													  HorizontalAlignment="Center" VerticalAlignment="Center"
													  Data="M6 6L18 18M18 6L6 18"/>
											</Border>
										</Button>
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<Button Classes="flat" HorizontalAlignment="Left" Command="{Binding AddItemCommand}">
							<Border Background="#EEF1F6" BorderBrush="#C9D3E0" BorderThickness="1"
									CornerRadius="8" Padding="14,8">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<Path Stroke="#3D4654" StrokeThickness="2" StrokeLineCap="Round"
										  Fill="Transparent" Width="12" Height="12" Stretch="Uniform"
										  VerticalAlignment="Center" Data="M12 5v14M5 12h14"/>
									<TextBlock Text="Kalem Ekle" Foreground="#3D4654" FontSize="12.5"
											   VerticalAlignment="Center"/>
								</StackPanel>
							</Border>
						</Button>

						<Border Background="#EDF1F6" Height="1"/>

						<!-- Para birimi kalem bazında değil sözleşme bazında seçilir; kur dönüşümü yapılmaz. -->
						<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
							<TextBlock Grid.Column="0" Text="Para Birimi" FontSize="12" Foreground="#5B6472"
									   FontWeight="SemiBold" VerticalAlignment="Center"/>
							<ComboBox Grid.Column="1" Width="140" HorizontalAlignment="Left"
									  ItemsSource="{Binding CurrencyOptions}" SelectedItem="{Binding SelectedCurrency}"/>
							<StackPanel Grid.Column="2" Spacing="1" HorizontalAlignment="Right">
								<TextBlock Classes="summaryLabel" Text="TOPLAM" TextAlignment="Right"/>
								<TextBlock Classes="display" Text="{Binding ToplamText}" FontSize="21"
										   FontWeight="Bold" Foreground="#1A2E4A" TextAlignment="Right"/>
							</StackPanel>
						</Grid>
					</StackPanel>
				</Border>

				<!-- ==================== ADIM 3 ==================== -->
				<StackPanel IsVisible="{Binding IsStep3}" Spacing="16">

					<!--
					  Talebe daha önce yüklenmiş dosyalar. Kalemlerin aksine bunlar silinmiyor
					  (fiziksel dosyalar diskte duruyor), yalnızca gösteriliyor — SYB'nin aynı
					  dosyayı ikinci kez yükleyip sözleşmeye kopya eklememesi için.
					-->
					<Border IsVisible="{Binding HasExistingAttachments}"
							Background="#FFF7E6" BorderBrush="#E8C989" BorderThickness="1"
							CornerRadius="10" Padding="14,12">
						<StackPanel Spacing="7">
							<TextBlock Text="ZATEN EKLİ DOSYALAR" FontSize="10" FontWeight="Bold" Foreground="#7A5C10"/>
							<TextBlock Text="Bu dosyalar önceki denemede yüklendi ve sözleşmede kalmaya devam edecek. Aynı dosyayı tekrar eklemeyin."
									   FontSize="11" Foreground="#7A5C10" TextWrapping="Wrap"/>
							<ItemsControl ItemsSource="{Binding ExistingAttachments}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="domain:Attachment">
										<TextBlock Text="{Binding FileName}" FontSize="12"
												   Foreground="#5C4409" Margin="0,2"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>

					<Border Background="White" BorderBrush="#E3E7EE" BorderThickness="1"
							CornerRadius="12" Padding="24,20">
						<StackPanel Spacing="18">

							<StackPanel Spacing="1">
								<TextBlock Classes="display" Text="Belgeler" FontSize="15.5"
										   FontWeight="SemiBold" Foreground="#1A2E4A"/>
								<TextBlock Text="Sözleşme metni, ekleri ve teminat belgeleri."
										   FontSize="11" Foreground="#A3ABB8"/>
							</StackPanel>
							<Border Background="#EDF1F6" Height="1"/>

							<!-- Sözleşme dosyası -->
							<StackPanel Spacing="8">
								<Grid ColumnDefinitions="*,Auto">
									<TextBlock Grid.Column="0" Classes="formLabel" Text="SÖZLEŞME DOSYASI" Margin="0"/>
									<Button Grid.Column="1" Classes="flat" Click="OnPickSozlesmeFileClick">
										<Border Background="#EEF1F6" BorderBrush="#C9D3E0" BorderThickness="1"
												CornerRadius="7" Padding="12,6">
											<TextBlock Text="+ Dosya Ekle" Foreground="#3D4654" FontSize="11.5"/>
										</Border>
									</Button>
								</Grid>
								<TextBlock Classes="formHint" Text="Henüz dosya eklenmedi." Margin="0"
										   IsVisible="{Binding !SozlesmeFileNames.Count}"/>
								<ItemsControl ItemsSource="{Binding SozlesmeFileNames}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Background="#F5F9FD" BorderBrush="#C4DCF2" BorderThickness="1"
													CornerRadius="8" Padding="12,9" Margin="0,0,0,6">
												<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
													<Path Grid.Column="0" Stroke="#2D6EA8" StrokeThickness="1.8"
														  Fill="Transparent" Width="15" Height="15" Stretch="Uniform"
														  VerticalAlignment="Center"
														  Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6"/>
													<TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12"
															   Foreground="#1A2E4A" VerticalAlignment="Center"
															   TextTrimming="CharacterEllipsis"/>
													<Button Grid.Column="2" Classes="flat" VerticalAlignment="Center"
															Command="{Binding $parent[UserControl].((vm:ContractWizardViewModel)DataContext).RemoveSozlesmeFileCommand}"
															CommandParameter="{Binding}">
														<TextBlock Text="Kaldır" Foreground="#A32D2D" FontSize="11"/>
													</Button>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>

							<!-- Ekler -->
							<StackPanel Spacing="8">
								<Grid ColumnDefinitions="*,Auto">
									<TextBlock Grid.Column="0" Classes="formLabel" Text="EKLER" Margin="0"/>
									<Button Grid.Column="1" Classes="flat" Click="OnPickEkFileClick">
										<Border Background="#EEF1F6" BorderBrush="#C9D3E0" BorderThickness="1"
												CornerRadius="7" Padding="12,6">
											<TextBlock Text="+ Dosya Ekle" Foreground="#3D4654" FontSize="11.5"/>
										</Border>
									</Button>
								</Grid>
								<TextBlock Classes="formHint" Text="Henüz dosya eklenmedi." Margin="0"
										   IsVisible="{Binding !EkFileNames.Count}"/>
								<ItemsControl ItemsSource="{Binding EkFileNames}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Background="#F5F9FD" BorderBrush="#C4DCF2" BorderThickness="1"
													CornerRadius="8" Padding="12,9" Margin="0,0,0,6">
												<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
													<Path Grid.Column="0" Stroke="#2D6EA8" StrokeThickness="1.8"
														  Fill="Transparent" Width="15" Height="15" Stretch="Uniform"
														  VerticalAlignment="Center"
														  Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6"/>
													<TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12"
															   Foreground="#1A2E4A" VerticalAlignment="Center"
															   TextTrimming="CharacterEllipsis"/>
													<Button Grid.Column="2" Classes="flat" VerticalAlignment="Center"
															Command="{Binding $parent[UserControl].((vm:ContractWizardViewModel)DataContext).RemoveEkFileCommand}"
															CommandParameter="{Binding}">
														<TextBlock Text="Kaldır" Foreground="#A32D2D" FontSize="11"/>
													</Button>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>

							<!-- Teminat -->
							<StackPanel Spacing="8">
								<Grid ColumnDefinitions="*,Auto">
									<TextBlock Grid.Column="0" Classes="formLabel" Text="TEMİNAT" Margin="0"/>
									<Button Grid.Column="1" Classes="flat" Click="OnPickTeminatFileClick">
										<Border Background="#EEF1F6" BorderBrush="#C9D3E0" BorderThickness="1"
												CornerRadius="7" Padding="12,6">
											<TextBlock Text="+ Dosya Ekle" Foreground="#3D4654" FontSize="11.5"/>
										</Border>
									</Button>
								</Grid>
								<TextBlock Classes="formHint" Text="Henüz dosya eklenmedi." Margin="0"
										   IsVisible="{Binding !TeminatFileNames.Count}"/>
								<ItemsControl ItemsSource="{Binding TeminatFileNames}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Background="#F5F9FD" BorderBrush="#C4DCF2" BorderThickness="1"
													CornerRadius="8" Padding="12,9" Margin="0,0,0,6">
												<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
													<Path Grid.Column="0" Stroke="#2D6EA8" StrokeThickness="1.8"
														  Fill="Transparent" Width="15" Height="15" Stretch="Uniform"
														  VerticalAlignment="Center"
														  Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6"/>
													<TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12"
															   Foreground="#1A2E4A" VerticalAlignment="Center"
															   TextTrimming="CharacterEllipsis"/>
													<Button Grid.Column="2" Classes="flat" VerticalAlignment="Center"
															Command="{Binding $parent[UserControl].((vm:ContractWizardViewModel)DataContext).RemoveTeminatFileCommand}"
															CommandParameter="{Binding}">
														<TextBlock Text="Kaldır" Foreground="#A32D2D" FontSize="11"/>
													</Button>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</StackPanel>
					</Border>

					<Border IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
							Background="#E6F4E7" BorderBrush="#A9D6B0" BorderThickness="1"
							CornerRadius="10" Padding="14,11">
						<TextBlock Text="{Binding SuccessMessage}" Foreground="#1A6B2A"
								   FontSize="12.5" TextWrapping="Wrap"/>
					</Border>
				</StackPanel>

			</StackPanel>
		</ScrollViewer>

		<!-- ==================== SAĞ: ADIMLAR + ÖZET + GEZİNME ==================== -->
		<StackPanel Grid.Column="1" Spacing="14" VerticalAlignment="Top" Margin="0,0,0,24">

			<Button Classes="flat" HorizontalAlignment="Left" IsVisible="{Binding ShowBackButton}"
					Command="{Binding BackCommand}">
				<Border Background="#EEF1F6" BorderBrush="#DFE5EE" BorderThickness="1"
						CornerRadius="7" Padding="12,6">
					<TextBlock Text="← Sözleşmeler" Foreground="#5B6472" FontSize="11.5"/>
				</Border>
			</Button>

			<!-- Dikey adım göstergesi: tamamlananlar yeşil onay, bulunulan adım mavi -->
			<Border Background="White" BorderBrush="#E3E7EE" BorderThickness="1"
					CornerRadius="12" Padding="18,16">
				<StackPanel Spacing="14">
					<TextBlock Classes="sectionLabel" Text="ADIMLAR"/>
					<ItemsControl ItemsSource="{Binding Steps}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:WizardStepViewModel">
								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="11" Margin="0,0,0,12">
									<Border Grid.Column="0" Width="24" Height="24" CornerRadius="12"
											Background="{Binding CircleBgHex}"
											BorderBrush="{Binding CircleBorderHex}" BorderThickness="1.5"
											VerticalAlignment="Top">
										<TextBlock Text="{Binding NumberText}" Foreground="{Binding NumberColorHex}"
												   FontSize="11" FontWeight="Bold"
												   HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
										<TextBlock Text="{Binding Label}" FontSize="12.5"
												   Foreground="{Binding LabelColorHex}"
												   FontWeight="{Binding LabelWeight}" TextWrapping="Wrap"/>
										<TextBlock Text="{Binding Hint}" FontSize="10.5" Foreground="#A3ABB8"
												   TextWrapping="Wrap" IsVisible="{Binding ShowHint}"/>
									</StackPanel>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</Border>

			<!-- Canlı özet: seçilen talep, süre ve oluşan bedel her adımda görünür kalır -->
			<Border Background="White" BorderBrush="#E3E7EE" BorderThickness="1"
					CornerRadius="12" Padding="18,16">
				<StackPanel Spacing="14">
					<TextBlock Classes="sectionLabel" Text="ÖZET"/>

					<StackPanel Spacing="3">
						<TextBlock Classes="summaryLabel" Text="TALEP"/>
						<StackPanel IsVisible="{Binding SelectedRequest, Converter={x:Static ObjectConverters.IsNotNull}}"
									Spacing="1">
							<TextBlock Classes="summaryValue" Text="{Binding SelectedRequest.Title}"/>
							<TextBlock Text="{Binding SelectedRequest.CompanyName}" FontSize="11.5" Foreground="#8A94A6"
									   TextWrapping="Wrap"/>
						</StackPanel>
						<TextBlock Classes="summaryEmpty" Text="Henüz seçilmedi"
								   IsVisible="{Binding SelectedRequest, Converter={x:Static ObjectConverters.IsNull}}"/>
					</StackPanel>

					<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
						<StackPanel Grid.Column="0" Spacing="3">
							<TextBlock Classes="summaryLabel" Text="BAŞLANGIÇ"/>
							<TextBlock Classes="summaryValue" FontSize="12"
									   Text="{Binding StartDate, StringFormat='{}{0:dd.MM.yyyy}'}"
									   IsVisible="{Binding StartDate, Converter={x:Static ObjectConverters.IsNotNull}}"/>
							<TextBlock Classes="summaryEmpty" Text="—"
									   IsVisible="{Binding StartDate, Converter={x:Static ObjectConverters.IsNull}}"/>
						</StackPanel>
						<StackPanel Grid.Column="1" Spacing="3">
							<TextBlock Classes="summaryLabel" Text="BİTİŞ"/>
							<TextBlock Classes="summaryValue" FontSize="12"
									   Text="{Binding EndDate, StringFormat='{}{0:dd.MM.yyyy}'}"
									   IsVisible="{Binding EndDate, Converter={x:Static ObjectConverters.IsNotNull}}"/>
							<TextBlock Classes="summaryEmpty" Text="—"
									   IsVisible="{Binding EndDate, Converter={x:Static ObjectConverters.IsNull}}"/>
						</StackPanel>
					</Grid>

					<Border Background="#EDF1F6" Height="1"/>

					<Grid ColumnDefinitions="*,Auto">
						<StackPanel Grid.Column="0" Spacing="3">
							<TextBlock Classes="summaryLabel" Text="TOPLAM BEDEL"/>
							<TextBlock Text="{Binding Items.Count, StringFormat='{}{0} kalem'}"
									   FontSize="11" Foreground="#A3ABB8"/>
						</StackPanel>
						<TextBlock Grid.Column="1" Classes="display" Text="{Binding ToplamText}"
								   FontSize="17" FontWeight="Bold" Foreground="#1A2E4A"
								   VerticalAlignment="Center"/>
					</Grid>
				</StackPanel>
			</Border>

			<!-- Gezinme: kaydırmayla kaybolmasın diye sağ panelde sabit -->
			<StackPanel Spacing="8">
				<Button Classes="flat" HorizontalAlignment="Stretch" IsVisible="{Binding !IsStep3}"
						Command="{Binding NextStepCommand}">
					<Border Background="#2D6EA8" CornerRadius="9" Padding="18,12">
						<TextBlock Text="İleri →" Foreground="White" FontSize="13" FontWeight="SemiBold"
								   HorizontalAlignment="Center"/>
					</Border>
				</Button>

				<Button Classes="flat" HorizontalAlignment="Stretch" IsVisible="{Binding IsStep3}"
						Command="{Binding SubmitCommand}" IsEnabled="{Binding !IsSubmitting}">
					<Border Background="#1A6B2A" CornerRadius="9" Padding="18,12">
						<TextBlock Text="Sözleşmeyi Kaydet" Foreground="White" FontSize="13" FontWeight="SemiBold"
								   HorizontalAlignment="Center"/>
					</Border>
				</Button>

				<Button Classes="flat" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsStep1}"
						Command="{Binding PreviousStepCommand}">
					<Border Background="White" BorderBrush="#DFE5EE" BorderThickness="1"
							CornerRadius="9" Padding="18,11">
						<TextBlock Text="← Geri" Foreground="#5B6472" FontSize="12.5"
								   HorizontalAlignment="Center"/>
					</Border>
				</Button>
			</StackPanel>

		</StackPanel>
	</Grid>

</UserControl>
