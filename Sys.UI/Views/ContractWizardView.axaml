<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:domain="using:Sys.Domain"
             xmlns:conv="using:Sys.UI.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
             x:Class="Sys.UI.Views.ContractWizardView"
             x:DataType="vm:ContractWizardViewModel">

	<Design.DataContext>
		<vm:ContractWizardViewModel />
	</Design.DataContext>

	<!-- Alan bazlı hata mesajları ilgili kutunun hemen altında gösterilir (Classes="fieldError"). -->
	<ScrollViewer Margin="0,0,20,20">
		<StackPanel Spacing="14" MaxWidth="700">

			<Button Classes="flat" HorizontalAlignment="Left" IsVisible="{Binding ShowBackButton}" Command="{Binding BackCommand}">
				<Border Background="#6B7280" CornerRadius="4" Padding="10,4">
					<TextBlock Text="← Geri" Foreground="White" FontSize="12"/>
				</Border>
			</Button>

			<!-- Adım göstergesi: aktif adım koyu mavi/kalın, diğerleri gri gösterilir -->
			<StackPanel Orientation="Horizontal" Spacing="4">
				<TextBlock Text="1. Temel Bilgiler" FontWeight="Bold" Padding="8,4"
						   Foreground="{Binding IsStep1, Converter={x:Static conv:BoolBrushConverter.StepIndicator}}"/>
				<TextBlock Text=" → " VerticalAlignment="Center" Foreground="#9CA3AF"/>
				<TextBlock Text="2. Bedel Kalemleri" FontWeight="Bold" Padding="8,4"
						   Foreground="{Binding IsStep2, Converter={x:Static conv:BoolBrushConverter.StepIndicator}}"/>
				<TextBlock Text=" → " VerticalAlignment="Center" Foreground="#9CA3AF"/>
				<TextBlock Text="3. Belgeler ve Gönder" FontWeight="Bold" Padding="8,4"
						   Foreground="{Binding IsStep3, Converter={x:Static conv:BoolBrushConverter.StepIndicator}}"/>
			</StackPanel>

			<!-- Kısa özet; ayrıntılı mesaj ilgili alanın altında gösteriliyor -->
			<TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

			<!-- ADIM 1 -->
			<StackPanel IsVisible="{Binding IsStep1}" Spacing="10">
				<TextBlock Text="Sözleşmesi oluşturulacak onaylı talebi seçin:"/>
				<ComboBox ItemsSource="{Binding PendingRequests}" SelectedItem="{Binding SelectedRequest}" HorizontalAlignment="Stretch">
					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="domain:Contract">
							<TextBlock>
								<Run Text="{Binding Title}"/>
								<Run Text=" — "/>
								<Run Text="{Binding CompanyName}"/>
							</TextBlock>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
				<TextBlock Classes="fieldError" Text="{Binding RequestError}"
                           IsVisible="{Binding RequestError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
				<TextBlock Text="Bekleyen talep yok." IsVisible="{Binding !PendingRequests.Count}" Foreground="Gray"/>

				<TextBlock Text="Başlangıç Tarihi *" FontWeight="Bold" Margin="0,10,0,0"/>
				<DatePicker SelectedDate="{Binding StartDate}"/>
				<TextBlock Classes="fieldError" Text="{Binding StartDateError}"
                           IsVisible="{Binding StartDateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

				<TextBlock Text="Bitiş Tarihi *" FontWeight="Bold" Margin="0,10,0,0"/>
				<DatePicker SelectedDate="{Binding EndDate}"/>
				<TextBlock Classes="fieldError" Text="{Binding EndDateError}"
                           IsVisible="{Binding EndDateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

				<TextBlock Text="Ödeme Periyodu *" FontWeight="Bold" Margin="0,10,0,0"/>
				<ComboBox ItemsSource="{Binding PaymentPeriodOptions}" SelectedItem="{Binding SelectedPaymentPeriod}" HorizontalAlignment="Stretch"/>
				<TextBlock Classes="fieldError" Text="{Binding PaymentPeriodError}"
                           IsVisible="{Binding PaymentPeriodError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

				<TextBlock Text="SAP Cari Kodu *" FontWeight="Bold" Margin="0,10,0,0"/>
				<TextBox Text="{Binding SapCariKodu}" PlaceholderText="C-XXXXX"/>
				<TextBlock Classes="fieldError" Text="{Binding SapCariKoduError}"
                           IsVisible="{Binding SapCariKoduError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

				<TextBlock Text="Firma Türü" FontWeight="Bold" Margin="0,10,0,0"/>
				<ComboBox ItemsSource="{Binding CompanyTypeOptions}" SelectedItem="{Binding SelectedCompanyType}" HorizontalAlignment="Stretch"/>
			</StackPanel>

			<!-- ADIM 2 -->
			<StackPanel IsVisible="{Binding IsStep2}" Spacing="10">
				<TextBlock Text="Bedel kalemlerini girin:"/>

				<ItemsControl ItemsSource="{Binding Items}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:ContractItemRowViewModel">
							<Grid ColumnDefinitions="3*,Auto,Auto,Auto,Auto" Margin="0,0,0,6">
								<TextBox Grid.Column="0" PlaceholderText="Tanım" Text="{Binding Description}" Margin="0,0,4,0"/>
								<TextBox Grid.Column="1" Width="60" Text="{Binding QuantityText}" Margin="0,0,4,0"/>
								<TextBox Grid.Column="2" Width="70" Text="{Binding Unit}" Margin="0,0,4,0"/>
								<TextBox Grid.Column="3" Width="100" Margin="0,0,4,0" Text="{Binding UnitPriceText}"
										 LostFocus="OnAmountLostFocus" TextChanged="OnAmountTextChanged"/>
								<Button Grid.Column="4" Content="Sil" Command="{Binding RemoveCommand}"/>
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<Button Content="+ Kalem Ekle" Command="{Binding AddItemCommand}"/>

				<TextBlock FontWeight="Bold" FontSize="16">
					<Run Text="Toplam: "/>
					<Run Text="{Binding ToplamText}"/>
				</TextBlock>
			</StackPanel>

			<!-- ADIM 3 -->
			<StackPanel IsVisible="{Binding IsStep3}" Spacing="14">
				<StackPanel Spacing="6">
					<TextBlock Text="Sözleşme Dosyası"/>
					<Button Content="📎 Dosya Ekle" Click="OnPickSozlesmeFileClick"/>
					<ItemsControl ItemsSource="{Binding SozlesmeFileNames}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Grid ColumnDefinitions="*,Auto" Margin="0,2">
									<TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
									<Button Grid.Column="1" Content="Kaldır" FontSize="11"
											Command="{Binding $parent[UserControl].((vm:ContractWizardViewModel)DataContext).RemoveSozlesmeFileCommand}"
											CommandParameter="{Binding}"/>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<StackPanel Spacing="6">
					<TextBlock Text="Ekler"/>
					<Button Content="📎 Dosya Ekle" Click="OnPickEkFileClick"/>
					<ItemsControl ItemsSource="{Binding EkFileNames}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Grid ColumnDefinitions="*,Auto" Margin="0,2">
									<TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
									<Button Grid.Column="1" Content="Kaldır" FontSize="11"
											Command="{Binding $parent[UserControl].((vm:ContractWizardViewModel)DataContext).RemoveEkFileCommand}"
											CommandParameter="{Binding}"/>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<StackPanel Spacing="6">
					<TextBlock Text="Teminat"/>
					<Button Content="📎 Dosya Ekle" Click="OnPickTeminatFileClick"/>
					<ItemsControl ItemsSource="{Binding TeminatFileNames}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Grid ColumnDefinitions="*,Auto" Margin="0,2">
									<TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
									<Button Grid.Column="1" Content="Kaldır" FontSize="11"
											Command="{Binding $parent[UserControl].((vm:ContractWizardViewModel)DataContext).RemoveTeminatFileCommand}"
											CommandParameter="{Binding}"/>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<TextBlock Text="{Binding SuccessMessage}" Foreground="Green" TextWrapping="Wrap"/>

				<Button Content="Sözleşmeyi Kaydet" Command="{Binding SubmitCommand}" IsEnabled="{Binding !IsSubmitting}"/>
			</StackPanel>

			<!-- Gezinme butonları -->
			<StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
				<Button Content="Geri" Command="{Binding PreviousStepCommand}" IsEnabled="{Binding !IsStep1}"/>
				<Button Content="İleri" Command="{Binding NextStepCommand}" IsVisible="{Binding !IsStep3}"/>
			</StackPanel>

		</StackPanel>
	</ScrollViewer>

</UserControl>