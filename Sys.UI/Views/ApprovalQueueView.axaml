<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sys.UI.ViewModels"
             x:Class="Sys.UI.Views.ApprovalQueueView"
             x:DataType="vm:ApprovalQueueViewModel">

	<Grid ColumnDefinitions="320,*" Margin="24">

		<!--
		  Sol: bekleyen sözleşmeler listesi.
		  DockPanel kullanılıyor (eskiden StackPanel'di): StackPanel çocuklarına sınırsız
		  yükseklik verdiği için ListBox tüm kayıtlar kadar uzuyor ve kendi kaydırma
		  çubuğu hiç devreye girmiyordu — çok kayıt olduğunda alttakiler erişilemiyordu.
		  DockPanel'in son çocuğu kalan alanı doldurur, böylece ListBox kendi içinde kayar.
		-->
		<DockPanel Grid.Column="0" Margin="0,0,16,0">
			<Button DockPanel.Dock="Top" Classes="flat" HorizontalAlignment="Left" Margin="0,0,0,10"
					IsVisible="{Binding ShowBackButton}" Command="{Binding BackCommand}">
				<Border Background="#6B7280" CornerRadius="4" Padding="10,4">
					<TextBlock Text="← Geri" Foreground="White" FontSize="12"/>
				</Border>
			</Button>
			<!-- Başlık burada tekrar yazılmıyor: kabuk (ShellView) zaten sayfa başlığını
			     üstte gösteriyordu, ikisi birden görününce başlık iki kez yazılmış oluyordu. -->
			<TextBlock DockPanel.Dock="Top" Text="Onay bekleyen sözleşme yok."
					   IsVisible="{Binding !PendingContracts.Count}" Foreground="Gray"/>
			<ListBox ItemsSource="{Binding PendingContracts}"
                     SelectedItem="{Binding SelectedContract}">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<StackPanel Spacing="2" Margin="0,4">
							<TextBlock Text="{Binding Title}" FontWeight="Bold"/>
							<TextBlock Text="{Binding CompanyName}" FontSize="11" Foreground="Gray"/>
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</DockPanel>

		<!-- Sağ: seçilen sözleşmenin detayı ve karar paneli -->
		<ScrollViewer Grid.Column="1">
			<StackPanel Spacing="16">

				<TextBlock Text="Detayları görmek için soldan bir sözleşme seçin."
                           IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNull}}"
                           Foreground="Gray"/>

				<TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
				<TextBlock Text="{Binding SuccessMessage}" Foreground="Green"
                           IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

				<!-- Künye kartı: sözleşme detay ekranıyla aynı düzen ve stiller -->
				<Border IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}"
						Background="White" BorderBrush="#D0D8E4" BorderThickness="1"
						CornerRadius="10" Padding="20">
					<StackPanel Spacing="14">

						<StackPanel Spacing="3">
							<TextBlock Text="{Binding DetailTitle}" FontSize="19" FontWeight="Bold"
									   Foreground="#1A2E4A" TextWrapping="Wrap"/>
							<TextBlock Text="{Binding DetailNo}" FontSize="12" Foreground="#8A94A6"/>
						</StackPanel>

						<Border Background="#EDF1F6" Height="1"/>

						<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto"
							  ColumnSpacing="24" RowSpacing="14">

							<StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="FİRMA"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailCompany}"/>
							</StackPanel>
							<StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="DURUM"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailStatus}"/>
							</StackPanel>

							<StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="BEDEL"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailTotal}"/>
							</StackPanel>
							<StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="ÖDEME PERİYODU"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailPeriod}"/>
							</StackPanel>

							<StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="BAŞLANGIÇ"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailStart}"/>
							</StackPanel>
							<StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="BİTİŞ"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailEnd}"/>
							</StackPanel>

							<StackPanel Grid.Row="3" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="TALEP EDEN"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailRequester}"/>
							</StackPanel>
						</Grid>

					</StackPanel>
				</Border>

				<Border IsVisible="{Binding IsPendingTermination}"
                        Background="#FBE4E4" BorderBrush="#A32D2D" BorderThickness="1" CornerRadius="8" Padding="16">
					<StackPanel Spacing="4">
						<TextBlock Text="⚠ BU BİR FESİH TALEBİDİR" FontWeight="Bold" Foreground="#A32D2D"/>
						<TextBlock Text="{Binding TerminationInfo}" Foreground="Black" TextWrapping="Wrap"/>
					</StackPanel>
				</Border>

				<Border IsVisible="{Binding HasRevisionHistory}"
                        Background="#FFF3CD" BorderBrush="#B06A00" BorderThickness="1" CornerRadius="8" Padding="16">
					<StackPanel Spacing="4">
						<TextBlock Text="ℹ BU BİR DEĞİŞİKLİK (REVİZYON) ONAYIDIR" FontWeight="Bold" Foreground="#B06A00"/>
						<TextBlock Text="{Binding RevisionInfo}" Foreground="Black" TextWrapping="Wrap"/>
					</StackPanel>
				</Border>

				<StackPanel IsVisible="{Binding Items.Count}">
					<TextBlock Text="Kalemler" FontWeight="Bold" Margin="0,0,0,8"/>
					<ItemsControl ItemsSource="{Binding Items}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4">
									<Grid ColumnDefinitions="2*,*,*,*">
										<TextBlock Grid.Column="0" Text="{Binding Description}"/>
										<TextBlock Grid.Column="1" Text="{Binding Quantity}"/>
										<TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:N2}}"/>
										<TextBlock Grid.Column="3" Text="{Binding LineTotal, StringFormat={}{0:N2}}"/>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<StackPanel IsVisible="{Binding Attachments.Count}">
					<TextBlock Text="Dosyalar" FontWeight="Bold" Margin="0,0,0,8"/>
					<ItemsControl ItemsSource="{Binding Attachments}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4">
									<Grid ColumnDefinitions="*,Auto">
										<TextBlock Grid.Column="0" Text="{Binding FileName}" VerticalAlignment="Center"/>
										<Button Grid.Column="1" Content="Aç"
												Command="{Binding $parent[UserControl].((vm:ApprovalQueueViewModel)DataContext).OpenAttachmentCommand}"
												CommandParameter="{Binding}"/>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<StackPanel IsVisible="{Binding IsSybFinalCheck}" Spacing="6">
					<TextBlock Text="SYB Son Kontrol Listesi" FontWeight="Bold"/>
					<ItemsControl ItemsSource="{Binding ChecklistItems}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,2"/>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<StackPanel IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="8">
					<TextBlock Text="Not (opsiyonel, özellikle reddederken açıklama girin):" FontWeight="Bold"/>
					<TextBox Text="{Binding Note}" AcceptsReturn="True" Height="70" TextWrapping="Wrap"/>
					<StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
						<Button Classes="flat" Click="OnApproveClick" IsEnabled="{Binding AllChecked}">
							<Border Background="#16A34A" CornerRadius="4" Padding="16,8">
								<TextBlock Text="Onayla" Foreground="White"/>
							</Border>
						</Button>
						<Button Classes="flat" Click="OnRejectClick">
							<Border Background="#DC2626" CornerRadius="4" Padding="16,8">
								<TextBlock Text="Reddet" Foreground="White"/>
							</Border>
						</Button>
					</StackPanel>
				</StackPanel>

			</StackPanel>
		</ScrollViewer>

	</Grid>
</UserControl>