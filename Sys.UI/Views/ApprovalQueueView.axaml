<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Sys.UI.Localization"
             xmlns:conv="using:Sys.UI.Converters"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:domain="using:Sys.Domain"
             x:Class="Sys.UI.Views.ApprovalQueueView"
             x:DataType="vm:ApprovalQueueViewModel">

	<UserControl.Styles>
		<!-- Kart zaten görsel birim; ListBoxItem'ın kendi dolgusu/vurgusu kaldırılıyor. -->
		<Style Selector="ListBox">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="0"/>
		</Style>
		<Style Selector="ListBoxItem">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0"/>
		</Style>
		<Style Selector="ListBoxItem /template/ ContentPresenter">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="CornerRadius" Value="9"/>
		</Style>

		<Style Selector="TextBox">
			<Setter Property="Padding" Value="11,9"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
			<Setter Property="Background" Value="{DynamicResource SurfaceInput}"/>
		</Style>
		<Style Selector="TextBox:focus">
			<Setter Property="Background" Value="{DynamicResource SurfaceInputFocus}"/>
		</Style>

		<Style Selector="TextBlock.tableHead">
			<Setter Property="FontSize" Value="10"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMutedAlt}"/>
			<Setter Property="LetterSpacing" Value="0.5"/>
		</Style>
		<Style Selector="TextBlock.summaryLabel">
			<Setter Property="FontSize" Value="9.5"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMutedAlt}"/>
			<Setter Property="LetterSpacing" Value="0.6"/>
		</Style>
		<Style Selector="CheckBox">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
		</Style>
	</UserControl.Styles>

	<!--
	  Üç sütun: solda kuyruk, ortada sözleşmenin detayı, sağda karar paneli.
	  Karar kontrolleri (kontrol listesi, not, Onayla/Reddet) eskiden detayın EN ALTINDA
	  duruyordu; uzun sözleşmelerde kullanıcı karar vermek için sonuna kadar kaydırmak
	  zorundaydı. Sağ panel kendi kaydırma alanında olduğu için artık hep görünür.
	-->
	<Grid ColumnSpacing="18" Margin="0,0,20,0">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="300"/>
			<ColumnDefinition Width="*" MinWidth="420"/>
			<ColumnDefinition Width="310"/>
		</Grid.ColumnDefinitions>

		<!-- ========== SOL: KUYRUK ========== -->
		<!--
		  DockPanel kullanılıyor (eskiden StackPanel'di): StackPanel çocuklarına sınırsız
		  yükseklik verdiği için ListBox tüm kayıtlar kadar uzuyor ve kendi kaydırma
		  çubuğu hiç devreye girmiyordu. DockPanel'in son çocuğu kalan alanı doldurur.
		-->
		<DockPanel Grid.Column="0">

			<Button DockPanel.Dock="Top" Classes="flat" HorizontalAlignment="Left" Margin="0,0,0,12"
					IsVisible="{Binding ShowBackButton}" Command="{Binding BackCommand}">
				<Border Background="{DynamicResource SurfaceButton}" BorderBrush="{DynamicResource BorderInput}" BorderThickness="1"
						CornerRadius="7" Padding="12,6">
					<TextBlock Text="{Binding [Queue.BackToContracts], Source={x:Static loc:Strings.Current}}" Foreground="{DynamicResource TextLabel}" FontSize="11.5"/>
				</Border>
			</Button>

			<!-- Başlık burada tekrar yazılmıyor: kabuk (ShellView) zaten sayfa başlığını
			     üstte gösteriyordu, ikisi birden görününce başlık iki kez yazılmış oluyordu. -->
			<Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="2,0,2,10">
				<TextBlock Grid.Column="0" Classes="summaryLabel" Text="{Binding [Queue.Queue], Source={x:Static loc:Strings.Current}}" VerticalAlignment="Center"/>
				<!-- Rozet toplam bekleyen sayısını gösterir, o sayfadakini değil -->
				<Border Grid.Column="1" Background="{DynamicResource BorderFaintBlue}" CornerRadius="9" Padding="8,2">
					<TextBlock Text="{Binding TotalCount}" Foreground="{DynamicResource AccentBase}"
							   FontSize="11" FontWeight="Bold"/>
				</Border>
			</Grid>

			<!-- Sayfalama: kuyruk uzadıkça alttaki kayıtlar erişilemez kalıyordu -->
			<Border DockPanel.Dock="Bottom" IsVisible="{Binding ShowPager}" Margin="0,10,0,0">
				<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
					<Button Classes="flat" IsEnabled="{Binding CanGoPrevious}" Command="{Binding PreviousPageCommand}">
						<Border Background="{DynamicResource SurfaceButton}" BorderBrush="{DynamicResource BorderButton}" BorderThickness="1"
								CornerRadius="6" Padding="10,5">
							<TextBlock Text="‹" Foreground="{DynamicResource TextBody}" FontSize="12"/>
						</Border>
					</Button>
					<TextBlock Text="{Binding PageInfoText}" VerticalAlignment="Center"
							   FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
					<Button Classes="flat" IsEnabled="{Binding CanGoNext}" Command="{Binding NextPageCommand}">
						<Border Background="{DynamicResource SurfaceButton}" BorderBrush="{DynamicResource BorderButton}" BorderThickness="1"
								CornerRadius="6" Padding="10,5">
							<TextBlock Text="›" Foreground="{DynamicResource TextBody}" FontSize="12"/>
						</Border>
					</Button>
				</StackPanel>
			</Border>

			<Border DockPanel.Dock="Top" IsVisible="{Binding !PendingContracts.Count}"
					Background="{DynamicResource SurfaceSubtle}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
					CornerRadius="10" Padding="16,20">
				<TextBlock Text="{Binding [Queue.Empty], Source={x:Static loc:Strings.Current}}" Foreground="{DynamicResource TextFaintAlt}"
						   FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
			</Border>

			<ListBox ItemsSource="{Binding PendingContracts}"
                     SelectedItem="{Binding SelectedContract}">
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="domain:Contract">
						<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
								CornerRadius="9" Padding="13,11" Margin="0,0,0,7">
							<StackPanel Spacing="4">
								<TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5"
										   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
								<TextBlock Text="{Binding CompanyName}" FontSize="11" Foreground="{DynamicResource TextMuted}"
										   TextWrapping="Wrap"/>

								<!-- Tekrar inceleme olduğu, kayda tıklamadan önce de görünmeli -->
								<Border IsVisible="{Binding WasRejected}" Background="{DynamicResource DangerSoftBg}"
										CornerRadius="8" Padding="8,2" HorizontalAlignment="Left" Margin="0,3,0,0">
									<TextBlock Text="{Binding [Queue.WasRejectedShort], Source={x:Static loc:Strings.Current}}" Foreground="{DynamicResource DangerBase}"
											   FontSize="10" FontWeight="Bold"/>
								</Border>
							</StackPanel>
						</Border>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</DockPanel>

		<!-- ========== ORTA: SÖZLEŞME DETAYI ========== -->
		<ScrollViewer Grid.Column="1">
			<StackPanel Spacing="16" Margin="0,0,4,24">

				<TextBlock Text="{Binding [Queue.PickFromQueue], Source={x:Static loc:Strings.Current}}"
						   IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNull}}"
						   Foreground="{DynamicResource TextFaintAlt}" FontSize="13" Margin="2,20,0,0"/>

				<!--
				  Bağlam kutuları en üstte: kararı verecek kişinin önce bunu görmesi gerekiyor.
				  (Fesih talebi mi, revizyon mu, daha önce reddedilmiş mi?)
				-->
				<Border IsVisible="{Binding HasPreviousRejection}"
						Background="{DynamicResource DangerSoftBg}" BorderBrush="{DynamicResource DangerSoftBorder}" BorderThickness="1"
						CornerRadius="11" Padding="18,15">
					<StackPanel Spacing="5">
						<TextBlock Text="{Binding [Queue.WasRejected], Source={x:Static loc:Strings.Current}}" FontSize="11"
								   FontWeight="Bold" Foreground="{DynamicResource DangerBase}" LetterSpacing="0.5"/>
						<TextBlock Text="{Binding PreviousRejectionInfo}" Foreground="{DynamicResource DangerDeep}"
								   FontSize="12.5" TextWrapping="Wrap"/>
					</StackPanel>
				</Border>

				<Border IsVisible="{Binding IsPendingTermination}"
						Background="{DynamicResource DangerSoftBg}" BorderBrush="{DynamicResource DangerSoftBorder}" BorderThickness="1"
						CornerRadius="11" Padding="18,15">
					<StackPanel Spacing="5">
						<TextBlock Text="{Binding [Queue.IsTermination], Source={x:Static loc:Strings.Current}}" FontSize="11"
								   FontWeight="Bold" Foreground="{DynamicResource DangerBase}" LetterSpacing="0.5"/>
						<TextBlock Text="{Binding TerminationInfo}" Foreground="{DynamicResource DangerDeep}"
								   FontSize="12.5" TextWrapping="Wrap"/>
					</StackPanel>
				</Border>

				<Border IsVisible="{Binding HasRevisionHistory}"
						Background="{DynamicResource WarningSoftBg}" BorderBrush="{DynamicResource WarningSoftBorder}" BorderThickness="1"
						CornerRadius="11" Padding="18,15">
					<StackPanel Spacing="5">
						<TextBlock Text="{Binding [Queue.IsRevision], Source={x:Static loc:Strings.Current}}" FontSize="11"
								   FontWeight="Bold" Foreground="{DynamicResource WarningBase}" LetterSpacing="0.5"/>
						<TextBlock Text="{Binding RevisionInfo}" Foreground="{DynamicResource WarningDeep}"
								   FontSize="12.5" TextWrapping="Wrap"/>
					</StackPanel>
				</Border>

				<!-- Künye kartı: sözleşme detay ekranıyla aynı düzen ve stiller -->
				<Border IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}"
						Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
						CornerRadius="12" Padding="24,20">
					<StackPanel Spacing="18">

						<StackPanel Spacing="3">
							<TextBlock Classes="display" Text="{Binding DetailTitle}" FontSize="19"
									   FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
							<TextBlock FontSize="12" Foreground="{DynamicResource TextMuted}">
								<Run Text="{Binding DetailNo}"/>
								<Run Text="  ·  "/>
								<Run Text="{Binding DetailCompany}"/>
							</TextBlock>
						</StackPanel>

						<Border Background="{DynamicResource SurfaceDivider}" Height="1"/>

						<!--
						  "DURUM" alanı kaldırıldı: bu ekrandaki her kayıt zaten "Onay
						  Bekliyor" durumunda, satır hiçbir bilgi taşımıyordu. Yerine
						  kontrol listesinin doğrulamayı istediği alanlar geldi.
						-->
						<Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto"
							  ColumnSpacing="20" RowSpacing="16">

							<StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="{Binding [Field.Type], Source={x:Static loc:Strings.Current}}"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailType}"/>
							</StackPanel>
							<StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="{Binding [Field.TaxNo], Source={x:Static loc:Strings.Current}}"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailTaxNo}"/>
							</StackPanel>
							<StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="{Binding [Field.SapCode], Source={x:Static loc:Strings.Current}}"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailSapCariKodu}"/>
							</StackPanel>

							<StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="{Binding [Field.StartDate], Source={x:Static loc:Strings.Current}}"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailStart}"/>
							</StackPanel>
							<StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="{Binding [Field.EndDate], Source={x:Static loc:Strings.Current}}"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailEnd}"/>
							</StackPanel>
							<StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="{Binding [Field.PaymentPeriod], Source={x:Static loc:Strings.Current}}"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailPeriod}"/>
							</StackPanel>

							<StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="{Binding [Field.Requester], Source={x:Static loc:Strings.Current}}"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailRequester}"/>
							</StackPanel>
							<StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="{Binding [Field.CompanyType], Source={x:Static loc:Strings.Current}}"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailCompanyType}"/>
							</StackPanel>
							<StackPanel Grid.Row="2" Grid.Column="2" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="{Binding [Field.RequestRefNo], Source={x:Static loc:Strings.Current}}"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailRefNo}"/>
							</StackPanel>
						</Grid>
					</StackPanel>
				</Border>

				<!--
				  Kapsam: onaycının "ne onaylıyorum" sorusunun cevabı. Ekranda kalemler
				  vardı ama işin tanımı hiç görünmüyordu.
				-->
				<Border IsVisible="{Binding HasDescription}"
						Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
						CornerRadius="12" Padding="24,20">
					<StackPanel Spacing="10">
						<TextBlock Classes="display" Text="{Binding [Field.Scope], Source={x:Static loc:Strings.Current}}" FontSize="15.5"
								   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
						<TextBlock Text="{Binding DetailDescription}" FontSize="12.5"
								   Foreground="{DynamicResource TextBody}" TextWrapping="Wrap" LineHeight="19"/>
					</StackPanel>
				</Border>

				<!-- Kalemler: onaycının en çok baktığı bölüm, sütun başlıklı tablo -->
				<Border IsVisible="{Binding Items.Count}"
						Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
						CornerRadius="12" Padding="24,20">
					<StackPanel Spacing="12">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Grid.Column="0" Classes="display" Text="{Binding [Field.Items], Source={x:Static loc:Strings.Current}}" FontSize="15.5"
									   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
							<StackPanel Grid.Column="1" Spacing="1">
								<TextBlock Classes="summaryLabel" Text="{Binding [Field.TotalAmount], Source={x:Static loc:Strings.Current}}" TextAlignment="Right"/>
								<TextBlock Classes="display" Text="{Binding DetailTotal}" FontSize="17"
										   FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextAlignment="Right"/>
							</StackPanel>
						</Grid>

						<Grid ColumnDefinitions="2*,90,*,*" ColumnSpacing="12">
							<TextBlock Grid.Column="0" Classes="tableHead" Text="{Binding [Field.Description], Source={x:Static loc:Strings.Current}}"/>
							<TextBlock Grid.Column="1" Classes="tableHead" Text="{Binding [Field.Quantity], Source={x:Static loc:Strings.Current}}" TextAlignment="Right"/>
							<TextBlock Grid.Column="2" Classes="tableHead" Text="{Binding [Field.UnitPrice], Source={x:Static loc:Strings.Current}}" TextAlignment="Right"/>
							<TextBlock Grid.Column="3" Classes="tableHead" Text="{Binding [Field.LineTotal], Source={x:Static loc:Strings.Current}}" TextAlignment="Right"/>
						</Grid>
						<Border Background="{DynamicResource SurfaceDivider}" Height="1"/>

						<ItemsControl ItemsSource="{Binding Items}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="domain:ContractItem">
									<Border BorderBrush="{DynamicResource SurfaceSoft}" BorderThickness="0,0,0,1" Padding="0,9">
										<Grid ColumnDefinitions="2*,90,*,*" ColumnSpacing="12">
											<TextBlock Grid.Column="0" Text="{Binding Description}" FontSize="12.5"
													   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
											<TextBlock Grid.Column="1" FontSize="12.5" Foreground="{DynamicResource TextLabel}"
													   TextAlignment="Right">
												<Run Text="{Binding Quantity}"/>
												<Run Text=" "/>
												<Run Text="{Binding Unit}"/>
											</TextBlock>
											<TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:N2}}"
													   FontSize="12.5" Foreground="{DynamicResource TextLabel}" TextAlignment="Right"/>
											<TextBlock Grid.Column="3" Text="{Binding LineTotal, StringFormat={}{0:N2}}"
													   FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"
													   TextAlignment="Right"/>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Border>

				<!--
				  İhlal sicili. Fesih kontrol listesindeki "devam eden ihlal durumu
				  kontrol edildi" maddesi bu bölüm olmadan doğrulanamıyordu; "Haklı Fesih
				  (İhlal Nedeniyle)" onaylanırken de dayanağın görülmesi gerekiyor.
				-->
				<Border IsVisible="{Binding HasViolations}"
						Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
						CornerRadius="12" Padding="24,20">
					<StackPanel Spacing="12">
						<TextBlock Classes="display" Text="{Binding [Queue.ViolationRecord], Source={x:Static loc:Strings.Current}}" FontSize="15.5"
								   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
						<ItemsControl ItemsSource="{Binding Violations}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:ViolationRowViewModel">
									<Border Background="{Binding CardBgHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}" BorderBrush="{Binding CardBorderHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
											BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,8">
										<StackPanel Spacing="5">
											<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
												<TextBlock Grid.Column="0" Text="{Binding ViolationType}" FontSize="12.5"
														   FontWeight="SemiBold" Foreground="{Binding TitleColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
														   VerticalAlignment="Center" TextWrapping="Wrap"/>
												<Border Grid.Column="1" Background="{Binding StatusBgHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
														CornerRadius="9" Padding="9,2" VerticalAlignment="Center">
													<TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
															   FontSize="10" FontWeight="Bold"/>
												</Border>
												<TextBlock Grid.Column="2" Text="{Binding ReportedAtText}"
														   FontSize="10.5" Foreground="{DynamicResource TextFaintAlt}" VerticalAlignment="Center"/>
											</Grid>
											<TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextLabel}"
													   TextWrapping="Wrap" IsVisible="{Binding HasDescription}"/>
											<TextBlock Text="{Binding ViolationDateText}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
											<TextBlock Text="{Binding ResolutionText}" FontSize="11" Foreground="{DynamicResource SuccessBase}"
													   TextWrapping="Wrap" IsVisible="{Binding HasResolution}"/>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Border>

				<!-- Dosyalar -->
				<Border IsVisible="{Binding Attachments.Count}"
						Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
						CornerRadius="12" Padding="24,20">
					<StackPanel Spacing="12">
						<TextBlock Classes="display" Text="{Binding [Field.Files], Source={x:Static loc:Strings.Current}}" FontSize="15.5"
								   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
						<!--
						  Kategori rozeti: kontrol listesi sözleşme dosyası ile ek/teminat
						  belgelerini ayrı ayrı soruyor, ama liste düz dosya adlarından
						  ibaretti ve hangi dosyanın ne olduğu görülemiyordu.
						-->
						<ItemsControl ItemsSource="{Binding Attachments}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:AttachmentRowViewModel">
									<Border Background="{DynamicResource SurfaceSubtle}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
											CornerRadius="9" Padding="13,10" Margin="0,0,0,7">
										<Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
											<Path Grid.Column="0" Stroke="{DynamicResource AccentBase}" StrokeThickness="1.7"
												  Fill="Transparent" Width="16" Height="16" Stretch="Uniform"
												  VerticalAlignment="Center"
												  Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6"/>
											<Border Grid.Column="1" Background="{Binding CategoryBgHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
													CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
												<TextBlock Text="{Binding CategoryLabel}" Foreground="{Binding CategoryColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
														   FontSize="10" FontWeight="Bold"/>
											</Border>
											<TextBlock Grid.Column="2" Text="{Binding FileName}" FontSize="12.5"
													   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
													   TextTrimming="CharacterEllipsis"/>
											<Button Grid.Column="3" Classes="flat" VerticalAlignment="Center"
													Command="{Binding $parent[UserControl].((vm:ApprovalQueueViewModel)DataContext).OpenAttachmentCommand}"
													CommandParameter="{Binding RawAttachment}">
												<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderInput}" BorderThickness="1"
														CornerRadius="6" Padding="12,5">
													<TextBlock Text="{Binding [Field.Open], Source={x:Static loc:Strings.Current}}" Foreground="{DynamicResource TextBody}" FontSize="11.5"/>
												</Border>
											</Button>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Border>

			</StackPanel>
		</ScrollViewer>

		<!-- ========== SAĞ: KARAR PANELİ ========== -->
		<ScrollViewer Grid.Column="2"
					  IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}">
			<StackPanel Spacing="14" Margin="0,0,0,24">

				<Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
						Background="{DynamicResource DangerSoftBg}" BorderBrush="{DynamicResource DangerSoftBorder}" BorderThickness="1"
						CornerRadius="10" Padding="14,11">
					<TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerTextAlt}"
							   FontSize="12.5" TextWrapping="Wrap"/>
				</Border>

				<Border IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
						Background="{DynamicResource SuccessSoftBg}" BorderBrush="{DynamicResource SuccessSoftBorder}" BorderThickness="1"
						CornerRadius="10" Padding="14,11">
					<TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource SuccessBase}"
							   FontSize="12.5" TextWrapping="Wrap"/>
				</Border>

				<!--
				  Kontrol listesi yalnızca SYB Son Kontrol aşamasında (Stage 1) çıkar.
				  İlerleme çubuğu ve sayaç eklendi: "Onayla" butonu liste bitmeden pasif
				  kalıyor ve eskiden bunun sebebi hiçbir yerde yazmıyordu.
				-->
				<Border IsVisible="{Binding IsSybFinalCheck}"
						Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
						CornerRadius="12" Padding="18,16">
					<StackPanel Spacing="12">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Grid.Column="0" Classes="sectionLabel" Text="{Binding ChecklistTitle}"
									   VerticalAlignment="Center"/>
							<TextBlock Grid.Column="1" Text="{Binding ChecklistProgressText}"
									   FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBase}"
									   VerticalAlignment="Center"/>
						</Grid>

						<!-- İlerleme çubuğu: dolgu genişliği orandan hesaplanıyor -->
						<Border Background="{DynamicResource SurfaceDivider}" CornerRadius="3" Height="5" HorizontalAlignment="Left"
								Width="262">
							<Border Background="{DynamicResource AccentSolid}" CornerRadius="3" Height="5" HorizontalAlignment="Left"
									Width="{Binding ChecklistRatio, Converter={x:Static vm:RatioToWidthConverter.Instance}, ConverterParameter=262}"/>
						</Border>

						<ItemsControl ItemsSource="{Binding ChecklistItems}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:ChecklistItemViewModel">
									<CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}"
											  Margin="0,3"/>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Border>

				<!-- Not + karar butonları -->
				<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
						CornerRadius="12" Padding="18,16">
					<StackPanel Spacing="12">
						<TextBlock Classes="sectionLabel" Text="{Binding [Queue.Decision], Source={x:Static loc:Strings.Current}}"/>

						<StackPanel Spacing="5">
							<TextBlock Text="{Binding [Field.Note], Source={x:Static loc:Strings.Current}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextLabel}"/>
							<TextBox Text="{Binding Note}" AcceptsReturn="True" Height="90" TextWrapping="Wrap"
									 PlaceholderText="{Binding [Queue.NotePlaceholder], Source={x:Static loc:Strings.Current}}"/>
						</StackPanel>

						<Button Classes="flat" HorizontalAlignment="Stretch"
								Click="OnApproveClick" IsEnabled="{Binding AllChecked}">
							<Border Background="{DynamicResource SuccessBrightSolid}" CornerRadius="9" Padding="18,12">
								<TextBlock Text="{Binding ApproveButtonText}" Foreground="{DynamicResource TextOnAccent}" FontSize="13"
										   FontWeight="SemiBold" HorizontalAlignment="Center"/>
							</Border>
						</Button>

						<TextBlock IsVisible="{Binding ShowChecklistWarning}"
								   Text="{Binding [Queue.ChecklistRequired], Source={x:Static loc:Strings.Current}}"
								   FontSize="11" Foreground="{DynamicResource WarningBase}" TextWrapping="Wrap"/>

						<Button Classes="flat" HorizontalAlignment="Stretch" Click="OnRejectClick">
							<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource DangerBorderStrong}" BorderThickness="1"
									CornerRadius="9" Padding="18,11">
								<TextBlock Text="{Binding RejectButtonText}" Foreground="{DynamicResource DangerBase}" FontSize="13"
										   FontWeight="SemiBold" HorizontalAlignment="Center"/>
							</Border>
						</Button>
					</StackPanel>
				</Border>

			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
