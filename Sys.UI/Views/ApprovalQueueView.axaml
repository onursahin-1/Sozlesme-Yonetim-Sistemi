<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sys.UI.ViewModels"
             x:Class="Sys.UI.Views.ApprovalQueueView"
             x:DataType="vm:ApprovalQueueViewModel">

	<Grid ColumnDefinitions="320,*" Margin="24">

		<!-- Sol: bekleyen sözleşmeler listesi -->
		<StackPanel Grid.Column="0" Margin="0,0,16,0">
			<Button Content="← Geri" FontSize="12" HorizontalAlignment="Left" Margin="0,0,0,10"
                    Background="#6B7280" Foreground="White" Padding="10,4" CornerRadius="4"
                    IsVisible="{Binding ShowBackButton}"
                    Command="{Binding BackCommand}">
				<Button.Styles>
					<Style Selector="Button:pointerover /template/ ContentPresenter">
						<Setter Property="Background" Value="#4B5563"/>
						<Setter Property="TextBlock.Foreground" Value="White"/>
					</Style>
				</Button.Styles>
			</Button>
			<TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
			<TextBlock Text="Onay bekleyen sözleşme yok." IsVisible="{Binding !PendingContracts.Count}" Foreground="Gray"/>
			<ListBox ItemsSource="{Binding PendingContracts}"
                     SelectedItem="{Binding SelectedContract}">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<StackPanel Spacing="2" Margin="0,4">
							<TextBlock Text="{Binding Title}" FontWeight="Bold"/>
							<TextBlock Text="{Binding CompanyName}" FontSize="11" Foreground="Gray"/>
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</StackPanel>

		<!-- Sağ: seçilen sözleşmenin detayı ve karar paneli -->
		<ScrollViewer Grid.Column="1">
			<StackPanel Spacing="16">

				<TextBlock Text="Detayları görmek için soldan bir sözleşme seçin."
                           IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNull}}"
                           Foreground="Gray"/>

				<TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
				<TextBlock Text="{Binding SuccessMessage}" Foreground="Green"
                           IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

				<Border IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Background="#F5F5F5" CornerRadius="8" Padding="16">
					<StackPanel Spacing="8">
						<TextBlock Text="{Binding DetailTitle}" FontSize="18" FontWeight="Bold" Foreground="Black"/>
						<TextBlock Text="{Binding DetailNo}" FontSize="12" Foreground="#555555"/>
						<TextBlock Text="{Binding DetailPeriod}" Foreground="Black" IsVisible="{Binding DetailPeriod, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						<TextBlock Text="{Binding DetailRequester}" Foreground="Black" IsVisible="{Binding DetailRequester, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						<TextBlock Text="{Binding DetailCompany}" Foreground="Black"/>
						<TextBlock Text="{Binding DetailStatus}" Foreground="Black"/>
						<TextBlock Text="{Binding DetailTotal}" Foreground="Black"/>
						<TextBlock Text="{Binding DetailStart}" Foreground="Black"/>
						<TextBlock Text="{Binding DetailEnd}" Foreground="Black"/>
					</StackPanel>
				</Border>

				<Border IsVisible="{Binding IsPendingTermination}"
                        Background="#FBE4E4" BorderBrush="#A32D2D" BorderThickness="1" CornerRadius="8" Padding="16">
					<StackPanel Spacing="4">
						<TextBlock Text="⚠ BU BİR FESİH TALEBİDİR" FontWeight="Bold" Foreground="#A32D2D"/>
						<TextBlock Text="{Binding TerminationInfo}" Foreground="Black" TextWrapping="Wrap"/>
					</StackPanel>
				</Border>

				<Border IsVisible="{Binding HasRevisionHistory}"
                        Background="#FFF3CD" BorderBrush="#B06A00" BorderThickness="1" CornerRadius="8" Padding="16">
					<StackPanel Spacing="4">
						<TextBlock Text="ℹ BU BİR DEĞİŞİKLİK (REVİZYON) ONAYIDIR" FontWeight="Bold" Foreground="#B06A00"/>
						<TextBlock Text="{Binding RevisionInfo}" Foreground="Black" TextWrapping="Wrap"/>
					</StackPanel>
				</Border>

				<StackPanel IsVisible="{Binding Items.Count}">
					<TextBlock Text="Kalemler" FontWeight="Bold" Margin="0,0,0,8"/>
					<ItemsControl ItemsSource="{Binding Items}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4">
									<Grid ColumnDefinitions="2*,*,*,*">
										<TextBlock Grid.Column="0" Text="{Binding Description}"/>
										<TextBlock Grid.Column="1" Text="{Binding Quantity}"/>
										<TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:N2}}"/>
										<TextBlock Grid.Column="3" Text="{Binding LineTotal, StringFormat={}{0:N2}}"/>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<StackPanel IsVisible="{Binding Attachments.Count}">
					<TextBlock Text="Dosyalar" FontWeight="Bold" Margin="0,0,0,8"/>
					<ItemsControl ItemsSource="{Binding Attachments}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4">
									<Grid ColumnDefinitions="*,Auto">
										<TextBlock Grid.Column="0" Text="{Binding FileName}" VerticalAlignment="Center"/>
										<Button Grid.Column="1" Content="Aç"
												Command="{Binding $parent[UserControl].((vm:ApprovalQueueViewModel)DataContext).OpenAttachmentCommand}"
												CommandParameter="{Binding}"/>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<StackPanel IsVisible="{Binding IsSybFinalCheck}" Spacing="6">
					<TextBlock Text="SYB Son Kontrol Listesi" FontWeight="Bold"/>
					<ItemsControl ItemsSource="{Binding ChecklistItems}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,2"/>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<StackPanel IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="8">
					<TextBlock Text="Not (opsiyonel, özellikle reddederken açıklama girin):" FontWeight="Bold"/>
					<TextBox Text="{Binding Note}" AcceptsReturn="True" Height="70" TextWrapping="Wrap"/>
					<StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
						<Button Content="Onayla" Background="#16A34A" Foreground="White" Padding="16,8"
                                Click="OnApproveClick" IsEnabled="{Binding AllChecked}"/>
						<Button Content="Reddet" Background="#DC2626" Foreground="White" Padding="16,8"
                                Click="OnRejectClick"/>
					</StackPanel>
				</StackPanel>

			</StackPanel>
		</ScrollViewer>

	</Grid>
</UserControl>