<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Sys.UI.Converters"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="Sys.UI.Views.ShellView"
             x:DataType="vm:ShellViewModel">

	<Design.DataContext>
		<vm:ShellViewModel />
	</Design.DataContext>

	<!--
	  Classes="flat": butonun kendi gövdesi şeffaf kalır, renk/yazı içindeki Border ve
	  TextBlock'tan gelir. Fluent teması :pointerover durumunda ContentPresenter'ın
	  renklerini ezdiği için, doğrudan butona renk vermek hover'da butonu görünmez kılıyordu.
	-->
	<!-- Panel: bildirim listesi ana içeriğin ÜSTÜNDE açılabilsin diye katmanlı yerleşim -->
	<Panel>
	<DockPanel>
		<Border DockPanel.Dock="Top" Background="{DynamicResource ShellTopBarBg}" Padding="24,12">
			<Grid ColumnDefinitions="*,Auto">
				<!--
				  Kurum logosu. Beyaz ve şeffaf arka planlı sürüm kullanılıyor, koyu
				  çubuğun üzerine doğrudan oturuyor. Yükseklikten sınırlandırılıyor ki
				  çubuğun yüksekliği logonun oranına göre değişmesin.
				-->
				<Image Grid.Column="0" Source="avares://Sys.UI/Assets/fakir-logo-white.png"
					   Height="34" Stretch="Uniform" HorizontalAlignment="Left"
					   VerticalAlignment="Center" Margin="8,0,0,0"/>
				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

					<!--
					  Tema geçişi. Tek bir düğme; iki seçenekli bir liste yerine anahtar
					  kullanıldı çünkü seçenek sayısı iki ve mevcut durum ikonun kendisinden
					  okunuyor: güneş görünüyorsa "açığa geç", ay görünüyorsa "koyuya geç".
					-->
					<Button Classes="flat" VerticalAlignment="Center"
							Command="{Binding ToggleThemeCommand}"
							ToolTip.Tip="{Binding ThemeToggleTooltip}">
						<Panel Width="38" Height="38" Background="Transparent">
							<Border Background="{DynamicResource ShellTopBarChip}" CornerRadius="8" Width="34" Height="34"/>

							<!-- Ay: koyu moda geçmeyi önerir (şu an açık tema) -->
							<Path IsVisible="{Binding !IsDarkTheme}"
								  Fill="{DynamicResource ShellTopBarIcon}" Width="16" Height="16" Stretch="Uniform"
								  HorizontalAlignment="Center" VerticalAlignment="Center"
								  Data="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>

							<!-- Güneş: açık moda geçmeyi önerir (şu an koyu tema) -->
							<Path IsVisible="{Binding IsDarkTheme}"
								  Stroke="{DynamicResource ShellTopBarIcon}" StrokeThickness="2"
								  StrokeLineCap="Round" Fill="Transparent"
								  Width="17" Height="17" Stretch="Uniform"
								  HorizontalAlignment="Center" VerticalAlignment="Center"
								  Data="M12 4V2M12 22v-2M4 12H2M22 12h-2M6.3 6.3L4.9 4.9M19.1 19.1l-1.4-1.4M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0z"/>
						</Panel>
					</Button>

					<!--
					  Bildirim zili. Emoji yerine vektör çizim kullanılıyor: emoji gösterimi
					  sisteme göre değişiyor ve çubuğun geri kalanıyla uyumsuz duruyordu.
					  Path her ortamda aynı çiziliyor ve rengi kontrol edilebiliyor.
					-->
					<Button Classes="flat" VerticalAlignment="Center"
                            IsVisible="{Binding ShowNotificationBell}"
                            Command="{Binding ToggleNotificationPanelCommand}"
                            ToolTip.Tip="Bildirimler">
						<!-- Background="Transparent": tüm kutu hit-test edilebilir olsun diye -->
						<Panel Width="38" Height="38" Background="Transparent">
							<Border Background="{DynamicResource ShellTopBarChip}" CornerRadius="8" Width="34" Height="34"/>
							<Path Fill="{DynamicResource ShellTopBarIcon}" Width="17" Height="17" Stretch="Uniform"
								  HorizontalAlignment="Center" VerticalAlignment="Center"
								  Data="M12 2a6 6 0 0 0-6 6v3.6L4.2 14.4A1 1 0 0 0 5 16h14a1 1 0 0 0 .8-1.6L18 11.6V8a6 6 0 0 0-6-6zm0 19a2.6 2.6 0 0 0 2.5-2h-5a2.6 2.6 0 0 0 2.5 2z"/>
							<Border Background="{DynamicResource DangerBrightSolid}" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0"
                                    IsVisible="{Binding HasUnreadNotifications}">
								<TextBlock Text="{Binding UnreadCountText}" Foreground="{DynamicResource TextOnAccent}" FontSize="9.5" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
						</Panel>
					</Button>

					<!-- İnce ayırıcı: zil ile kullanıcı bloğunu görsel olarak ayırır -->
					<Border Width="1" Height="22" Background="{DynamicResource ShellTopBarDivider}" Margin="4,0,8,0"
							VerticalAlignment="Center"/>

					<!--
					  Kullanıcı bloğu: baş harf avatarı + ad + rol tek bir düğmede toplandı.
					  Rol eskiden çubukta ayrı bir metindi; kullanıcıyla ilişkili olduğu belli
					  değildi ve sağ tarafı üç ayrı parçaya bölüyordu.
					-->
					<Button Classes="flat" VerticalAlignment="Center"
							Command="{Binding ToggleUserMenuCommand}">
						<Border Background="{DynamicResource ShellTopBarChip}" BorderBrush="{DynamicResource ShellTopBarChipBorder}" BorderThickness="1"
								CornerRadius="8" Padding="7,5,12,5">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentBaseAlt}">
									<TextBlock Text="{Binding UserInitials}" Foreground="{DynamicResource TextOnAccent}"
											   FontSize="11.5" FontWeight="Bold" LetterSpacing="0.3"
											   HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
								<StackPanel VerticalAlignment="Center" Spacing="1">
									<TextBlock Text="{Binding CurrentUser.FullName}" Foreground="{DynamicResource TextOnAccent}"
											   FontSize="12.5" FontWeight="SemiBold"/>
									<TextBlock Text="{Binding RoleLabel}" Foreground="{DynamicResource ShellTopBarSubtle}" FontSize="10.5"/>
								</StackPanel>
								<Path Stroke="{DynamicResource ShellTopBarSubtle}" StrokeThickness="2"
									  StrokeLineCap="Round" StrokeJoin="Round"
									  Width="10" Height="6" Stretch="Uniform"
									  VerticalAlignment="Center" Margin="2,2,0,0"
									  Data="M6 9L12 15L18 9"/>
							</StackPanel>
						</Border>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<ListBox DockPanel.Dock="Left" Width="220"
                 ItemsSource="{Binding NavItems}"
                 SelectedItem="{Binding SelectedNavItem}">
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="vm:NavItem">
					<Grid ColumnDefinitions="*,Auto" Margin="8,4">
						<TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"/>
						<Border Grid.Column="1" Background="{DynamicResource DangerStrongSolid}" CornerRadius="10" Padding="7,2" MinWidth="20"
                                IsVisible="{Binding ShowBadge}" HorizontalAlignment="Right">
							<TextBlock Text="{Binding Count}" Foreground="{DynamicResource TextOnAccent}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
						</Border>
					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<DockPanel>
			<TextBlock DockPanel.Dock="Top" Text="{Binding CurrentPageTitle}" FontSize="20" FontWeight="Bold"
					   Margin="20,20,20,10"
					   IsVisible="{Binding CurrentPageTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
			<ContentControl Content="{Binding CurrentPageContent}" Margin="20,0,20,20"/>
		</DockPanel>
	</DockPanel>

	<!--
	  Panel açıkken ekranın kalanına tıklamak paneli kapatır.
	  Classes="flat" KULLANILMIYOR: o stil ContentPresenter'ın arka planını Transparent
	  yaptığı için yüzey tıklamayı yakalamazdı. Burada tüm durumlarda neredeyse görünmez
	  ama hit-test edilebilir bir arka plan (#01000000) veriliyor.
	-->
	<Button IsVisible="{Binding IsNotificationPanelOpen}"
            Command="{Binding CloseNotificationPanelCommand}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            BorderThickness="0" CornerRadius="0" Cursor="Arrow">
		<Button.Styles>
			<Style Selector="Button /template/ ContentPresenter">
				<Setter Property="Background" Value="{DynamicResource ShadowFaint}"/>
			</Style>
			<Style Selector="Button:pointerover /template/ ContentPresenter">
				<Setter Property="Background" Value="{DynamicResource ShadowFaint}"/>
			</Style>
			<Style Selector="Button:pressed /template/ ContentPresenter">
				<Setter Property="Background" Value="{DynamicResource ShadowFaint}"/>
			</Style>
		</Button.Styles>
	</Button>

	<!-- Kullanıcı menüsü açıkken ekranın kalanına tıklamak menüyü kapatır -->
	<Button IsVisible="{Binding IsUserMenuOpen}"
            Command="{Binding CloseUserMenuCommand}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            BorderThickness="0" CornerRadius="0" Cursor="Arrow">
		<Button.Styles>
			<Style Selector="Button /template/ ContentPresenter">
				<Setter Property="Background" Value="{DynamicResource ShadowFaint}"/>
			</Style>
			<Style Selector="Button:pointerover /template/ ContentPresenter">
				<Setter Property="Background" Value="{DynamicResource ShadowFaint}"/>
			</Style>
			<Style Selector="Button:pressed /template/ ContentPresenter">
				<Setter Property="Background" Value="{DynamicResource ShadowFaint}"/>
			</Style>
		</Button.Styles>
	</Button>

	<!-- Kullanıcı menüsü: adın altında, sağ üstte açılır -->
	<Border IsVisible="{Binding IsUserMenuOpen}"
			HorizontalAlignment="Right" VerticalAlignment="Top"
			Margin="0,68,24,0" MinWidth="210"
			Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource AccentFaint}" BorderThickness="1" CornerRadius="8"
			BoxShadow="0 6 20 0 #33000000">
		<StackPanel Margin="6">

			<Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
					Command="{Binding OpenChangePasswordCommand}">
				<Border Background="Transparent" CornerRadius="5" Padding="12,9">
					<StackPanel Orientation="Horizontal" Spacing="10">
						<TextBlock Text="🔑" FontSize="12" VerticalAlignment="Center"/>
						<TextBlock Text="Şifre Değiştir" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" VerticalAlignment="Center"/>
					</StackPanel>
				</Border>
			</Button>

			<Border Background="{DynamicResource SurfaceDivider}" Height="1" Margin="8,4"/>

			<Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
					Command="{Binding LogoutCommand}">
				<Border Background="Transparent" CornerRadius="5" Padding="12,9">
					<StackPanel Orientation="Horizontal" Spacing="10">
						<TextBlock Text="⏻" FontSize="12" Foreground="{DynamicResource DangerBase}" VerticalAlignment="Center"/>
						<TextBlock Text="Çıkış Yap" Foreground="{DynamicResource DangerBase}" FontSize="12.5" VerticalAlignment="Center"/>
					</StackPanel>
				</Border>
			</Button>

		</StackPanel>
	</Border>

	<!-- Bildirim paneli: zilin altında, sağ üstte açılır -->
	<Border IsVisible="{Binding IsNotificationPanelOpen}"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,68,24,0" Width="400" MaxHeight="480"
            Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderInput}" BorderThickness="1" CornerRadius="12"
            BoxShadow="0 10 30 0 #26000000" ClipToBounds="True">
		<DockPanel>
			<Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceSubtle}" Padding="18,13"
                    BorderBrush="{DynamicResource BorderFaint}" BorderThickness="0,0,0,1">
				<StackPanel Spacing="9">
					<TextBlock Text="{Binding NotificationPanelTitle}" FontSize="13.5" FontWeight="SemiBold"
							   Foreground="{DynamicResource TextPrimary}"/>

					<!-- Toplu eylemler başlığın altında: üstte yan yana sıkışıyorlardı -->
					<StackPanel Orientation="Horizontal" Spacing="8"
								IsVisible="{Binding !HasNoNotifications}">
						<Button Classes="flat" IsVisible="{Binding HasUnreadNotifications}"
								Command="{Binding MarkAllNotificationsReadCommand}">
							<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderInput}" BorderThickness="1"
									CornerRadius="7" Padding="10,5">
								<TextBlock Text="Tümünü okundu işaretle" FontSize="11" Foreground="{DynamicResource AccentBase}"/>
							</Border>
						</Button>
						<Button Classes="flat" IsVisible="{Binding HasReadNotifications}"
								Command="{Binding DeleteReadNotificationsCommand}"
								ToolTip.Tip="Okunmuş bildirimlerin hepsini siler">
							<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderInput}" BorderThickness="1"
									CornerRadius="7" Padding="10,5">
								<TextBlock Text="Okunanları sil" FontSize="11" Foreground="{DynamicResource DangerBase}"/>
							</Border>
						</Button>
					</StackPanel>
				</StackPanel>
			</Border>

			<StackPanel DockPanel.Dock="Top" Spacing="6" Margin="18,28"
						IsVisible="{Binding HasNoNotifications}">
				<TextBlock Text="Henüz bildiriminiz yok." Foreground="{DynamicResource TextMuted}" FontSize="12.5"
						   HorizontalAlignment="Center"/>
				<TextBlock Text="Onay, red ve yaklaşan bitiş uyarıları burada görünür."
						   Foreground="{DynamicResource TextFaintAlt}" FontSize="11" HorizontalAlignment="Center"
						   TextAlignment="Center" TextWrapping="Wrap"/>
			</StackPanel>

			<ScrollViewer>
				<ItemsControl ItemsSource="{Binding Notifications}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:NotificationRowViewModel">
							<Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).OpenNotificationCommand}"
                                    CommandParameter="{Binding}">
								<Border Background="{Binding RowBackgroundHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}" Padding="0,11"
                                        BorderBrush="{DynamicResource SurfaceSoft}" BorderThickness="0,0,0,1">
									<Grid ColumnDefinitions="3,Auto,*,Auto" ColumnSpacing="10" Margin="0,0,14,0">

										<!-- Okunmamışı belli eden sol şerit; okunmuşta şeffaf ama yer kaplıyor -->
										<Border Grid.Column="0" Width="3" Background="{Binding UnreadStripHex}"
												VerticalAlignment="Stretch"/>

										<!--
										  Tür göstergesi renkli nokta. Emoji her Windows sürümünde
										  farklı çiziliyor ve satır yüksekliğini bozuyordu.
										-->
										<Border Grid.Column="1" Width="8" Height="8" CornerRadius="4"
												Background="{Binding TypeColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
												VerticalAlignment="Top" Margin="8,6,0,0"/>

										<StackPanel Grid.Column="2" Spacing="3">
											<TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" FontSize="12.5"
                                                       FontWeight="{Binding TitleWeight}" TextWrapping="Wrap"/>
											<TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextLabel}" FontSize="11.5"
													   TextWrapping="Wrap"/>
											<TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource TextFaintAlt}" FontSize="10.5"/>
										</StackPanel>

										<!-- Silme yalnızca okunmuş bildirimlerde görünür.
										     İç içe buton: tıklama dış satır butonuna geçmez. -->
										<Button Grid.Column="3" Classes="flat" VerticalAlignment="Top" Margin="8,0,0,0"
                                                IsVisible="{Binding IsRead}"
                                                Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).DeleteNotificationCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Bu bildirimi sil">
											<Border Background="Transparent" Width="22" Height="22" CornerRadius="11">
												<Path Stroke="{DynamicResource TextFaintAlt}" StrokeThickness="1.6" StrokeLineCap="Round"
													  Fill="Transparent" Width="9" Height="9" Stretch="Uniform"
													  HorizontalAlignment="Center" VerticalAlignment="Center"
													  Data="M6 6L18 18M18 6L6 18"/>
											</Border>
										</Button>
									</Grid>
								</Border>
							</Button>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</DockPanel>
	</Border>
	</Panel>

</UserControl>