<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="Sys.UI.Views.ShellView"
             x:DataType="vm:ShellViewModel">

	<Design.DataContext>
		<vm:ShellViewModel />
	</Design.DataContext>

	<!--
	  Classes="flat": butonun kendi gövdesi şeffaf kalır, renk/yazı içindeki Border ve
	  TextBlock'tan gelir. Fluent teması :pointerover durumunda ContentPresenter'ın
	  renklerini ezdiği için, doğrudan butona renk vermek hover'da butonu görünmez kılıyordu.
	-->
	<!-- Panel: bildirim listesi ana içeriğin ÜSTÜNDE açılabilsin diye katmanlı yerleşim -->
	<Panel>
	<DockPanel>
		<Border DockPanel.Dock="Top" Background="#1A2E4A" Padding="24,12">
			<Grid ColumnDefinitions="*,Auto">
				<!--
				  Kurum logosu. Beyaz ve şeffaf arka planlı sürüm kullanılıyor, koyu
				  çubuğun üzerine doğrudan oturuyor. Yükseklikten sınırlandırılıyor ki
				  çubuğun yüksekliği logonun oranına göre değişmesin.
				-->
				<Image Grid.Column="0" Source="avares://Sys.UI/Assets/fakir-logo-white.png"
					   Height="34" Stretch="Uniform" HorizontalAlignment="Left"
					   VerticalAlignment="Center" Margin="8,0,0,0"/>
				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
					<TextBlock Text="{Binding RoleLabel}" Foreground="#CADCFC" VerticalAlignment="Center"/>

					<!-- Bildirim zili: okunmamış sayısı sağ üstte kırmızı rozet olarak görünür -->
					<Button Classes="flat" VerticalAlignment="Center"
                            IsVisible="{Binding ShowNotificationBell}"
                            Command="{Binding ToggleNotificationPanelCommand}"
                            ToolTip.Tip="Bildirimler">
						<!-- Background="Transparent": zilin sadece glif alanına değil, tüm
						     kutusuna tıklanabilsin diye hit-test yüzeyi oluşturur. -->
						<Panel Width="30" Height="26" Background="Transparent">
							<TextBlock Text="🔔" FontSize="17" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
							<Border Background="#DC2626" CornerRadius="9" MinWidth="18" Height="16" Padding="4,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    IsVisible="{Binding HasUnreadNotifications}">
								<TextBlock Text="{Binding UnreadCountText}" Foreground="White" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
						</Panel>
					</Button>

					<!--
					  Kullanıcı menüsü: ada tıklayınca şifre değiştirme ve çıkış seçenekleri
					  açılır. Bunlar birer "bölüm" olmadığı için sol menüde yer almıyorlar.
					-->
					<Button Classes="flat" VerticalAlignment="Center"
							Command="{Binding ToggleUserMenuCommand}">
						<Border Background="#22FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1"
								CornerRadius="4" Padding="12,5">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<TextBlock Text="{Binding CurrentUser.FullName}" Foreground="White"
										   FontSize="12" VerticalAlignment="Center"/>
								<TextBlock Text="⌄" Foreground="#CADCFC" FontSize="12"
										   VerticalAlignment="Center" Margin="0,-4,0,0"/>
							</StackPanel>
						</Border>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<ListBox DockPanel.Dock="Left" Width="220"
                 ItemsSource="{Binding NavItems}"
                 SelectedItem="{Binding SelectedNavItem}">
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="vm:NavItem">
					<Grid ColumnDefinitions="*,Auto" Margin="8,4">
						<TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"/>
						<Border Grid.Column="1" Background="#DC2626" CornerRadius="10" Padding="7,2" MinWidth="20"
                                IsVisible="{Binding ShowBadge}" HorizontalAlignment="Right">
							<TextBlock Text="{Binding Count}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
						</Border>
					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<DockPanel>
			<TextBlock DockPanel.Dock="Top" Text="{Binding CurrentPageTitle}" FontSize="20" FontWeight="Bold"
					   Margin="20,20,20,10"
					   IsVisible="{Binding CurrentPageTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
			<ContentControl Content="{Binding CurrentPageContent}" Margin="20,0,20,20"/>
		</DockPanel>
	</DockPanel>

	<!--
	  Panel açıkken ekranın kalanına tıklamak paneli kapatır.
	  Classes="flat" KULLANILMIYOR: o stil ContentPresenter'ın arka planını Transparent
	  yaptığı için yüzey tıklamayı yakalamazdı. Burada tüm durumlarda neredeyse görünmez
	  ama hit-test edilebilir bir arka plan (#01000000) veriliyor.
	-->
	<Button IsVisible="{Binding IsNotificationPanelOpen}"
            Command="{Binding CloseNotificationPanelCommand}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            BorderThickness="0" CornerRadius="0" Cursor="Arrow">
		<Button.Styles>
			<Style Selector="Button /template/ ContentPresenter">
				<Setter Property="Background" Value="#01000000"/>
			</Style>
			<Style Selector="Button:pointerover /template/ ContentPresenter">
				<Setter Property="Background" Value="#01000000"/>
			</Style>
			<Style Selector="Button:pressed /template/ ContentPresenter">
				<Setter Property="Background" Value="#01000000"/>
			</Style>
		</Button.Styles>
	</Button>

	<!-- Kullanıcı menüsü açıkken ekranın kalanına tıklamak menüyü kapatır -->
	<Button IsVisible="{Binding IsUserMenuOpen}"
            Command="{Binding CloseUserMenuCommand}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            BorderThickness="0" CornerRadius="0" Cursor="Arrow">
		<Button.Styles>
			<Style Selector="Button /template/ ContentPresenter">
				<Setter Property="Background" Value="#01000000"/>
			</Style>
			<Style Selector="Button:pointerover /template/ ContentPresenter">
				<Setter Property="Background" Value="#01000000"/>
			</Style>
			<Style Selector="Button:pressed /template/ ContentPresenter">
				<Setter Property="Background" Value="#01000000"/>
			</Style>
		</Button.Styles>
	</Button>

	<!-- Kullanıcı menüsü: adın altında, sağ üstte açılır -->
	<Border IsVisible="{Binding IsUserMenuOpen}"
			HorizontalAlignment="Right" VerticalAlignment="Top"
			Margin="0,52,16,0" MinWidth="200"
			Background="White" BorderBrush="#B9C6D8" BorderThickness="1" CornerRadius="8"
			BoxShadow="0 6 20 0 #33000000">
		<StackPanel Margin="6">

			<Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
					Command="{Binding OpenChangePasswordCommand}">
				<Border Background="Transparent" CornerRadius="5" Padding="12,9">
					<StackPanel Orientation="Horizontal" Spacing="10">
						<TextBlock Text="🔑" FontSize="12" VerticalAlignment="Center"/>
						<TextBlock Text="Şifre Değiştir" Foreground="#1A2E4A" FontSize="12.5" VerticalAlignment="Center"/>
					</StackPanel>
				</Border>
			</Button>

			<Border Background="#EDF1F6" Height="1" Margin="8,4"/>

			<Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
					Command="{Binding LogoutCommand}">
				<Border Background="Transparent" CornerRadius="5" Padding="12,9">
					<StackPanel Orientation="Horizontal" Spacing="10">
						<TextBlock Text="⏻" FontSize="12" Foreground="#A32D2D" VerticalAlignment="Center"/>
						<TextBlock Text="Çıkış Yap" Foreground="#A32D2D" FontSize="12.5" VerticalAlignment="Center"/>
					</StackPanel>
				</Border>
			</Button>

		</StackPanel>
	</Border>

	<!-- Bildirim paneli: zilin altında, sağ üstte açılır -->
	<Border IsVisible="{Binding IsNotificationPanelOpen}"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,52,16,0" Width="380" MaxHeight="460"
            Background="White" BorderBrush="#B9C6D8" BorderThickness="1" CornerRadius="8"
            BoxShadow="0 6 20 0 #33000000">
		<DockPanel>
			<Border DockPanel.Dock="Top" Background="#F2F5F9" CornerRadius="8,8,0,0" Padding="14,10"
                    BorderBrush="#E1E7EF" BorderThickness="0,0,0,1">
				<Grid ColumnDefinitions="*,Auto,Auto">
					<TextBlock Grid.Column="0" Text="Bildirimler" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
					<Button Grid.Column="1" Classes="flat" Margin="0,0,10,0"
                            IsVisible="{Binding HasUnreadNotifications}"
                            Command="{Binding MarkAllNotificationsReadCommand}">
						<TextBlock Text="Tümünü okundu işaretle" FontSize="11" Foreground="#2D6EA8"/>
					</Button>
					<Button Grid.Column="2" Classes="flat"
                            IsVisible="{Binding HasReadNotifications}"
                            Command="{Binding DeleteReadNotificationsCommand}"
                            ToolTip.Tip="Okunmuş bildirimlerin hepsini siler">
						<TextBlock Text="Okunanları sil" FontSize="11" Foreground="#A32D2D"/>
					</Button>
				</Grid>
			</Border>

			<TextBlock DockPanel.Dock="Top" Text="Henüz bildiriminiz yok." Foreground="Gray"
                       Margin="14,20" HorizontalAlignment="Center"
                       IsVisible="{Binding HasNoNotifications}"/>

			<ScrollViewer>
				<ItemsControl ItemsSource="{Binding Notifications}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:NotificationRowViewModel">
							<Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).OpenNotificationCommand}"
                                    CommandParameter="{Binding}">
								<Border Background="{Binding RowBackgroundHex}" Padding="14,10"
                                        BorderBrush="#EDF1F6" BorderThickness="0,0,0,1">
									<Grid ColumnDefinitions="Auto,*,Auto">
										<TextBlock Grid.Column="0" Text="{Binding TypeIcon}" FontSize="15"
                                                   Margin="0,0,10,0" VerticalAlignment="Top"/>
										<StackPanel Grid.Column="1" Spacing="2">
											<TextBlock Text="{Binding Title}" Foreground="Black" FontSize="12"
                                                       FontWeight="{Binding TitleWeight}"/>
											<TextBlock Text="{Binding Message}" Foreground="#444" FontSize="11" TextWrapping="Wrap"/>
											<TextBlock Text="{Binding TimeText}" Foreground="#999" FontSize="10"/>
										</StackPanel>

										<!-- Silme yalnızca okunmuş bildirimlerde görünür.
										     İç içe buton: tıklama dış satır butonuna geçmez. -->
										<Button Grid.Column="2" Classes="flat" VerticalAlignment="Top" Margin="8,0,0,0"
                                                IsVisible="{Binding IsRead}"
                                                Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).DeleteNotificationCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Bu bildirimi sil">
											<Border Background="Transparent" Width="20" Height="20" CornerRadius="10">
												<TextBlock Text="✕" FontSize="11" Foreground="#8A94A6"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
											</Border>
										</Button>
									</Grid>
								</Border>
							</Button>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</DockPanel>
	</Border>
	</Panel>

</UserControl>