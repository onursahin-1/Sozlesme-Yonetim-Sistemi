<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Sys.UI.Views.AuditLogView"
             x:DataType="vm:AuditLogViewModel">

	<Design.DataContext>
		<vm:AuditLogViewModel />
	</Design.DataContext>

	<DockPanel Margin="24">
		<TextBlock DockPanel.Dock="Top" Text="İşlem Geçmişi" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

		<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
			<StackPanel>
				<TextBlock Text="Kullanıcı" FontSize="11" Foreground="Gray"/>
				<ComboBox Width="200" ItemsSource="{Binding UserOptions}" SelectedItem="{Binding SelectedUser}"/>
			</StackPanel>
			<StackPanel>
				<TextBlock Text="Başlangıç Tarihi" FontSize="11" Foreground="Gray"/>
				<DatePicker SelectedDate="{Binding StartDate}"/>
			</StackPanel>
			<StackPanel>
				<TextBlock Text="Bitiş Tarihi" FontSize="11" Foreground="Gray"/>
				<DatePicker SelectedDate="{Binding EndDate}"/>
			</StackPanel>
			<StackPanel VerticalAlignment="Bottom">
				<Button Classes="flat" Command="{Binding ClearDateFilterCommand}">
					<Border Background="#2D6EA8" CornerRadius="4" Padding="10,4">
						<TextBlock Text="Tarih Filtresini Temizle" Foreground="White"/>
					</Border>
				</Button>
			</StackPanel>
		</StackPanel>

		<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="12" Margin="0,12,0,0" HorizontalAlignment="Right">
			<Button Classes="flat" Command="{Binding PreviousPageCommand}">
				<Border Background="#2D6EA8" CornerRadius="4" Padding="10,4">
					<TextBlock Text="◀ Önceki" Foreground="White"/>
				</Border>
			</Button>
			<TextBlock Text="{Binding PageInfoText}" VerticalAlignment="Center" FontSize="12"/>
			<Button Classes="flat" Command="{Binding NextPageCommand}">
				<Border Background="#2D6EA8" CornerRadius="4" Padding="10,4">
					<TextBlock Text="Sonraki ▶" Foreground="White"/>
				</Border>
			</Button>
		</StackPanel>

		<TextBlock DockPanel.Dock="Top" Text="Yükleniyor..." IsVisible="{Binding IsLoading}"/>
		<TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="Red"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

		<ScrollViewer>
			<ItemsControl ItemsSource="{Binding FilteredLogs}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:AuditLogRowViewModel">
						<Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8">
							<Grid ColumnDefinitions="140,160,180,*">
								<TextBlock Grid.Column="0" Text="{Binding DateText}" FontSize="12"/>
								<TextBlock Grid.Column="1" Text="{Binding UserText}" FontSize="12" FontWeight="Bold"/>
								<TextBlock Grid.Column="2" Text="{Binding ActionText}" FontSize="12"/>
								<TextBlock Grid.Column="3" Text="{Binding DetailText}" FontSize="12" Foreground="#555" TextWrapping="Wrap"/>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</DockPanel>

</UserControl>