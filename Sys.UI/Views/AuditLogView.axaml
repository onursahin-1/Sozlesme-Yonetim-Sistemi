<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Sys.UI.Converters"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="700"
             x:Class="Sys.UI.Views.AuditLogView"
             x:DataType="vm:AuditLogViewModel">

	<Design.DataContext>
		<vm:AuditLogViewModel />
	</Design.DataContext>

	<UserControl.Styles>
		<Style Selector="ComboBox">
			<Setter Property="Padding" Value="11,8"/>
			<Setter Property="FontSize" Value="12.5"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
			<Setter Property="Background" Value="{DynamicResource SurfaceInput}"/>
		</Style>
		<Style Selector="DatePicker">
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
			<Setter Property="Background" Value="{DynamicResource SurfaceInput}"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
		</Style>
		<Style Selector="TextBlock.filterLabel">
			<Setter Property="FontSize" Value="10"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMutedAlt}"/>
			<Setter Property="LetterSpacing" Value="0.5"/>
			<Setter Property="Margin" Value="0,0,0,5"/>
		</Style>
		<Style Selector="TextBlock.tableHead">
			<Setter Property="FontSize" Value="10"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMutedAlt}"/>
			<Setter Property="LetterSpacing" Value="0.5"/>
		</Style>
	</UserControl.Styles>

	<!-- Başlık burada tekrar yazılmıyor; kabuk (ShellView) zaten üstte gösteriyor. -->
	<DockPanel Margin="0,0,20,0">

		<!-- ========== FİLTRELER ========== -->
		<Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
				CornerRadius="12" Padding="20,16" Margin="0,0,0,14">
			<Grid ColumnDefinitions="*,*,*,*,Auto,Auto" ColumnSpacing="14">

				<StackPanel Grid.Column="0">
					<TextBlock Classes="filterLabel" Text="KULLANICI"/>
					<ComboBox HorizontalAlignment="Stretch"
							  ItemsSource="{Binding UserOptions}" SelectedItem="{Binding SelectedUser}"/>
				</StackPanel>

				<!--
				  İşlem türü filtresi: denetimde "tüm şifre sıfırlamaları" ya da "tüm ek
				  silmeleri" gibi sorular en sık sorulanlar; kullanıcı ve tarih tek başına
				  yetmiyordu.
				-->
				<StackPanel Grid.Column="1">
					<TextBlock Classes="filterLabel" Text="İŞLEM TÜRÜ"/>
					<ComboBox HorizontalAlignment="Stretch"
							  ItemsSource="{Binding ActionOptions}" SelectedItem="{Binding SelectedAction}"/>
				</StackPanel>

				<StackPanel Grid.Column="2">
					<TextBlock Classes="filterLabel" Text="BAŞLANGIÇ"/>
					<DatePicker SelectedDate="{Binding StartDate}"/>
				</StackPanel>

				<StackPanel Grid.Column="3">
					<TextBlock Classes="filterLabel" Text="BİTİŞ"/>
					<DatePicker SelectedDate="{Binding EndDate}"/>
				</StackPanel>

				<Button Grid.Column="4" Classes="flat" VerticalAlignment="Bottom"
						IsVisible="{Binding HasActiveFilters}" Command="{Binding ClearFiltersCommand}">
					<Border Background="{DynamicResource SurfaceButton}" BorderBrush="{DynamicResource BorderInput}" BorderThickness="1"
							CornerRadius="8" Padding="14,10">
						<TextBlock Text="Temizle" Foreground="{DynamicResource TextLabel}" FontSize="12.5"/>
					</Border>
				</Button>

				<!--
				  Denetim çıktısı çoğunlukla dışarıya (iç denetim, mali müşavir)
				  veriliyor; filtrelenmiş kayıtların TAMAMI aktarılır, görünen sayfa değil.
				-->
				<Button Grid.Column="5" Classes="flat" VerticalAlignment="Bottom"
						Click="OnExportExcelClick"
						ToolTip.Tip="Filtrelenmiş kayıtları Excel dosyası olarak kaydeder">
					<Border Background="{DynamicResource SuccessSoftBgAlt}" BorderBrush="{DynamicResource SuccessSoftBorder}" BorderThickness="1"
							CornerRadius="8" Padding="14,10">
						<StackPanel Orientation="Horizontal" Spacing="7">
							<Path Stroke="{DynamicResource SuccessBase}" StrokeThickness="1.8" Fill="Transparent"
								  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"
								  Data="M12 3v12M12 15l-4.5-4.5M12 15l4.5-4.5M4 17v2.5A1.5 1.5 0 0 0 5.5 21h13a1.5 1.5 0 0 0 1.5-1.5V17"/>
							<TextBlock Text="Excel" Foreground="{DynamicResource SuccessBase}" FontSize="12.5"
									   FontWeight="SemiBold" VerticalAlignment="Center"/>
						</StackPanel>
					</Border>
				</Button>
			</Grid>
		</Border>

		<!-- ========== SAYFALAMA ========== -->
		<Border DockPanel.Dock="Bottom" Margin="0,14,0,20">
			<StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
				<Button Classes="flat" IsEnabled="{Binding CanGoPrevious}" Command="{Binding PreviousPageCommand}">
					<Border Background="{DynamicResource SurfaceButton}" BorderBrush="{DynamicResource BorderButton}" BorderThickness="1"
							CornerRadius="8" Padding="14,7">
						<TextBlock Text="‹ Önceki" Foreground="{DynamicResource TextBody}" FontSize="12"/>
					</Border>
				</Button>
				<TextBlock Text="{Binding PageInfoText}" VerticalAlignment="Center"
						   FontSize="12" Foreground="{DynamicResource TextMuted}"/>
				<Button Classes="flat" IsEnabled="{Binding CanGoNext}" Command="{Binding NextPageCommand}">
					<Border Background="{DynamicResource SurfaceButton}" BorderBrush="{DynamicResource BorderButton}" BorderThickness="1"
							CornerRadius="8" Padding="14,7">
						<TextBlock Text="Sonraki ›" Foreground="{DynamicResource TextBody}" FontSize="12"/>
					</Border>
				</Button>
			</StackPanel>
		</Border>

		<TextBlock DockPanel.Dock="Top" Text="Yükleniyor..." Foreground="{DynamicResource TextFaintAlt}" FontSize="12.5"
				   Margin="2,4,0,0" IsVisible="{Binding IsLoading}"/>

		<Border DockPanel.Dock="Top" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
				Background="{DynamicResource DangerSoftBg}" BorderBrush="{DynamicResource DangerSoftBorder}" BorderThickness="1"
				CornerRadius="10" Padding="14,11" Margin="0,0,0,12">
			<TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerTextAlt}"
					   FontSize="12.5" TextWrapping="Wrap"/>
		</Border>

		<StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,30,0,0" IsVisible="{Binding IsEmpty}">
			<TextBlock Text="Bu filtrelerle eşleşen işlem kaydı bulunamadı." Foreground="{DynamicResource TextMuted}"
					   FontSize="13" HorizontalAlignment="Center"/>
			<Button Classes="flat" HorizontalAlignment="Center"
					IsVisible="{Binding HasActiveFilters}" Command="{Binding ClearFiltersCommand}">
				<Border Background="{DynamicResource SurfaceButton}" BorderBrush="{DynamicResource BorderButton}" BorderThickness="1"
						CornerRadius="8" Padding="14,7">
					<TextBlock Text="Filtreleri temizle" Foreground="{DynamicResource TextBody}" FontSize="12"/>
				</Border>
			</Button>
		</StackPanel>

		<!-- ========== KAYIT TABLOSU ========== -->
		<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
				CornerRadius="12" ClipToBounds="True" IsVisible="{Binding !IsEmpty}">
			<DockPanel>

				<!-- Sütun başlıkları -->
				<Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceSubtle}"
						BorderBrush="{DynamicResource BorderFaint}" BorderThickness="0,0,0,1" Padding="0,12">
					<Grid ColumnDefinitions="4,120,240,210,*" ColumnSpacing="14" Margin="18,0,20,0">
						<TextBlock Grid.Column="1" Classes="tableHead" Text="TARİH"/>
						<TextBlock Grid.Column="2" Classes="tableHead" Text="KULLANICI"/>
						<TextBlock Grid.Column="3" Classes="tableHead" Text="İŞLEM"/>
						<TextBlock Grid.Column="4" Classes="tableHead" Text="AYRINTI"/>
					</Grid>
				</Border>

				<ScrollViewer>
					<ItemsControl ItemsSource="{Binding FilteredLogs}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:AuditLogRowViewModel">
								<Border BorderBrush="{DynamicResource SurfaceSoft}" BorderThickness="0,0,0,1" Padding="0,13">
									<Grid ColumnDefinitions="4,120,240,210,*" ColumnSpacing="14" Margin="18,0,20,0">

										<!--
										  Sol kenardaki ince şerit. Nötr kayıtlarda neredeyse
										  görünmez; yalnızca sonucu olan işlemlerde renkleniyor.
										-->
										<Border Grid.Column="0" Width="4" CornerRadius="2"
												Background="{Binding ActionStripHex}"
												VerticalAlignment="Stretch"/>

										<StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
											<TextBlock Text="{Binding DateText}" FontSize="12.5"
													   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
											<TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource TextFaintAlt}"/>
										</StackPanel>

										<!-- Baş harf rozeti: uzun listede kullanıcı değişimini göz hemen yakalıyor -->
										<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="9"
													VerticalAlignment="Center">
											<Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource SurfaceButton}">
												<TextBlock Text="{Binding UserInitials}" FontSize="10.5" FontWeight="Bold"
														   Foreground="{DynamicResource TextLabel}"
														   HorizontalAlignment="Center" VerticalAlignment="Center"/>
											</Border>
											<TextBlock Text="{Binding UserText}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"
													   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
										</StackPanel>

										<!-- İşlem rozeti: rengi kategorisinden geliyor -->
										<Border Grid.Column="3" Background="{Binding ActionBgHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
												CornerRadius="9" Padding="11,4" HorizontalAlignment="Left"
												VerticalAlignment="Center">
											<TextBlock Text="{Binding ActionText}" Foreground="{Binding ActionColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
													   FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
										</Border>

										<TextBlock Grid.Column="4" Text="{Binding DetailText}" FontSize="12.5"
												   Foreground="{DynamicResource TextLabel}" TextWrapping="Wrap"
												   VerticalAlignment="Center" IsVisible="{Binding HasDetail}"/>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</DockPanel>
		</Border>
	</DockPanel>

</UserControl>
