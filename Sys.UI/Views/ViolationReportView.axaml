<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Sys.UI.Converters"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:domain="using:Sys.Domain"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="760"
             x:Class="Sys.UI.Views.ViolationReportView"
             x:DataType="vm:ViolationReportViewModel">

	<UserControl.Styles>
		<!-- Form stilleri bu ekranla sınırlı; global TextBox stili diğer ekranları da değiştirirdi. -->
		<Style Selector="TextBlock.formLabel">
			<Setter Property="FontSize" Value="11.5"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextLabel}"/>
			<Setter Property="Margin" Value="0,0,0,5"/>
		</Style>
		<Style Selector="TextBlock.formHint">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="{DynamicResource TextFaintAlt}"/>
			<Setter Property="Margin" Value="2,5,0,0"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
		<Style Selector="TextBox">
			<Setter Property="Padding" Value="11,9"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
			<Setter Property="Background" Value="{DynamicResource SurfaceInput}"/>
		</Style>
		<Style Selector="TextBox:focus">
			<Setter Property="Background" Value="{DynamicResource SurfaceInputFocus}"/>
		</Style>
		<Style Selector="ComboBox">
			<Setter Property="Padding" Value="11,8"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
			<Setter Property="Background" Value="{DynamicResource SurfaceInput}"/>
		</Style>
		<Style Selector="DatePicker">
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
			<Setter Property="Background" Value="{DynamicResource SurfaceInput}"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
		</Style>

		<Style Selector="TextBlock.summaryLabel">
			<Setter Property="FontSize" Value="9.5"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMutedAlt}"/>
			<Setter Property="LetterSpacing" Value="0.6"/>
		</Style>
		<Style Selector="TextBlock.summaryValue">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
	</UserControl.Styles>

	<!-- Solda form, sağda sözleşmenin künyesi ve önceki ihlalleri -->
	<Grid ColumnSpacing="22" Margin="0,0,20,0">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" MinWidth="460"/>
			<ColumnDefinition Width="300"/>
		</Grid.ColumnDefinitions>

		<!-- ========== SOL: FORM ========== -->
		<ScrollViewer Grid.Column="0">
			<StackPanel Spacing="16" Margin="0,0,4,24">

				<!--
				  İhlal bildiriminin onay süreci YOK: kaydedildiği anda sözleşme "İhlal
				  Mevcut" durumuna geçiyor. Diğer taleplerden farkı bu ve kullanıcının
				  bunu bilmesi gerekiyor.
				-->
				<Border Background="{DynamicResource DangerSoftBg}" BorderBrush="{DynamicResource DangerSoftBorder}" BorderThickness="1"
						CornerRadius="10" Padding="16,13">
					<StackPanel Spacing="3">
						<TextBlock Text="İhlal bildirimi onaya gitmez, anında geçerli olur" FontSize="13"
								   FontWeight="SemiBold" Foreground="{DynamicResource DangerBase}"/>
						<TextBlock Text="Kaydettiğinizde sözleşme &quot;İhlal Mevcut&quot; durumuna geçer ve SYB'ye bildirim gönderilir. Kayıt sözleşmenin geçmişinde kalıcıdır."
								   FontSize="11.5" Foreground="{DynamicResource DangerTextAlt}" TextWrapping="Wrap"/>
					</StackPanel>
				</Border>

				<Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
						Background="{DynamicResource DangerSoftBg}" BorderBrush="{DynamicResource DangerSoftBorder}" BorderThickness="1"
						CornerRadius="10" Padding="14,11">
					<TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerTextAlt}"
							   FontSize="12.5" TextWrapping="Wrap"/>
				</Border>

				<Border IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
						Background="{DynamicResource SuccessSoftBg}" BorderBrush="{DynamicResource SuccessSoftBorder}" BorderThickness="1"
						CornerRadius="10" Padding="14,11">
					<TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource SuccessBase}"
							   FontSize="12.5" TextWrapping="Wrap"/>
				</Border>

				<!-- ===== 1 · SÖZLEŞME VE İHLAL ===== -->
				<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
						CornerRadius="12" Padding="24,20">
					<StackPanel Spacing="18">

						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
							<Border Grid.Column="0" Width="26" Height="26" CornerRadius="8"
									Background="{DynamicResource DangerSolid}" VerticalAlignment="Center">
								<TextBlock Text="1" Foreground="{DynamicResource TextOnAccent}" FontSize="13" FontWeight="Bold"
										   HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
								<TextBlock Classes="display" Text="Sözleşme ve İhlal" FontSize="15.5"
										   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
								<TextBlock Text="Yıldızlı (*) alanlar zorunludur." FontSize="11" Foreground="{DynamicResource TextFaintAlt}"/>
							</StackPanel>
						</Grid>
						<Border Background="{DynamicResource SurfaceDivider}" Height="1"/>

						<StackPanel>
							<TextBlock Classes="formLabel">
								<Run Text="İLGİLİ SÖZLEŞME"/>
								<Run Text=" *" Foreground="{DynamicResource DangerText}"/>
							</TextBlock>
							<ComboBox HorizontalAlignment="Stretch"
									  ItemsSource="{Binding AvailableContracts}"
									  SelectedItem="{Binding SelectedContract}"
									  PlaceholderText="Sözleşme seçin...">
								<ComboBox.ItemTemplate>
									<DataTemplate x:DataType="domain:Contract">
										<TextBlock TextTrimming="CharacterEllipsis">
											<Run Text="{Binding Title}"/>
											<Run Text="  ·  " Foreground="{DynamicResource TextFaintAlt}"/>
											<Run Text="{Binding CompanyName}" Foreground="{DynamicResource TextMuted}"/>
										</TextBlock>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
							<TextBlock Classes="fieldError" Text="{Binding ContractError}"
									   IsVisible="{Binding ContractError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
							<TextBlock Classes="formHint" Text="İhlal bildirilebilecek uygun sözleşme yok."
									   IsVisible="{Binding !AvailableContracts.Count}"/>
						</StackPanel>

						<Grid ColumnDefinitions="*,*" ColumnSpacing="18">
							<StackPanel Grid.Column="0">
								<TextBlock Classes="formLabel">
									<Run Text="İHLAL TÜRÜ"/>
									<Run Text=" *" Foreground="{DynamicResource DangerText}"/>
								</TextBlock>
								<ComboBox HorizontalAlignment="Stretch"
										  ItemsSource="{Binding ViolationTypes}"
										  SelectedItem="{Binding SelectedViolationType}"/>
							</StackPanel>
							<StackPanel Grid.Column="1">
								<TextBlock Classes="formLabel">
									<Run Text="İHLAL TARİHİ"/>
									<Run Text=" *" Foreground="{DynamicResource DangerText}"/>
								</TextBlock>
								<DatePicker SelectedDate="{Binding ViolationDate}"/>
								<TextBlock Classes="fieldError" Text="{Binding DateError}"
										   IsVisible="{Binding DateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
							</StackPanel>
						</Grid>

						<StackPanel>
							<TextBlock Classes="formLabel">
								<Run Text="AÇIKLAMA"/>
								<Run Text=" *" Foreground="{DynamicResource DangerText}"/>
							</TextBlock>
							<TextBox Text="{Binding Description}" AcceptsReturn="True" Height="120"
									 TextWrapping="Wrap" AcceptsTab="False"
									 PlaceholderText="İhlalin ayrıntılı açıklaması, belge referansları, kanıtlar..."/>
							<TextBlock Classes="fieldError" Text="{Binding DescriptionError}"
									   IsVisible="{Binding DescriptionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
							<TextBlock Classes="formHint"
									   Text="Bu metin sözleşme geçmişinde kalıcı olarak saklanır ve fesih kararına dayanak oluşturabilir."/>
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- ===== 2 · DESTEKLEYİCİ BELGE ===== -->
				<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
						CornerRadius="12" Padding="24,20">
					<StackPanel Spacing="16">

						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
							<Border Grid.Column="0" Width="26" Height="26" CornerRadius="8"
									Background="{DynamicResource DangerSolid}" VerticalAlignment="Center">
								<TextBlock Text="2" Foreground="{DynamicResource TextOnAccent}" FontSize="13" FontWeight="Bold"
										   HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
								<TextBlock Classes="display" Text="Destekleyici Belge" FontSize="15.5"
										   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
								<TextBlock Text="İsteğe bağlı — yazışma, tutanak, fotoğraf veya rapor."
										   FontSize="11" Foreground="{DynamicResource TextFaintAlt}"/>
							</StackPanel>
						</Grid>

						<Border IsVisible="{Binding SelectedFileName, Converter={x:Static StringConverters.IsNullOrEmpty}}"
								Background="{DynamicResource SurfaceInputAlt}" BorderBrush="{DynamicResource BorderInput}" BorderThickness="1"
								CornerRadius="10" Padding="24,20">
							<StackPanel Spacing="12" HorizontalAlignment="Center">
								<Path Stroke="{DynamicResource TextDisabledSoft}" StrokeThickness="1.6" Fill="Transparent"
									  Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center"
									  Data="M12 16V4M12 4L7.5 8.5M12 4l4.5 4.5M4 16v2.5A1.5 1.5 0 0 0 5.5 20h13a1.5 1.5 0 0 0 1.5-1.5V16"/>
								<Button Classes="flat" HorizontalAlignment="Center" Click="OnPickFileClick">
									<Border Background="{DynamicResource SurfaceButton}" BorderBrush="{DynamicResource BorderStrongAlt}" BorderThickness="1"
											CornerRadius="8" Padding="18,9">
										<TextBlock Text="Dosya Seç" Foreground="{DynamicResource TextBody}" FontSize="12.5"
												   FontWeight="SemiBold"/>
									</Border>
								</Button>
							</StackPanel>
						</Border>

						<Border IsVisible="{Binding SelectedFileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
								Background="{DynamicResource SurfaceSubtleBlue}" BorderBrush="{DynamicResource AccentSoftBorder}" BorderThickness="1"
								CornerRadius="10" Padding="14,12">
							<Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
								<Path Grid.Column="0" Stroke="{DynamicResource AccentBase}" StrokeThickness="1.8" Fill="Transparent"
									  Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center"
									  Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6"/>
								<TextBlock Grid.Column="1" Text="{Binding SelectedFileName}" FontSize="12.5"
										   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
										   TextTrimming="CharacterEllipsis"/>
								<Button Grid.Column="2" Classes="flat" Click="OnPickFileClick" VerticalAlignment="Center">
									<TextBlock Text="Değiştir" Foreground="{DynamicResource AccentBase}" FontSize="11.5"/>
								</Button>
								<Button Grid.Column="3" Classes="flat" Command="{Binding ClearFileCommand}" VerticalAlignment="Center">
									<TextBlock Text="Kaldır" Foreground="{DynamicResource DangerBase}" FontSize="11.5"/>
								</Button>
							</Grid>
						</Border>
					</StackPanel>
				</Border>

			</StackPanel>
		</ScrollViewer>

		<!-- ========== SAĞ: SÖZLEŞME VE ÖNCEKİ İHLALLER ========== -->
		<ScrollViewer Grid.Column="1">
			<StackPanel Spacing="14" Margin="0,0,0,24">

				<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
						CornerRadius="12" Padding="18,16">
					<StackPanel Spacing="14">
						<TextBlock Classes="sectionLabel" Text="İLGİLİ SÖZLEŞME"/>

						<StackPanel IsVisible="{Binding SelectedContract, Converter={x:Static ObjectConverters.IsNotNull}}"
									Spacing="14">
							<StackPanel Spacing="2">
								<TextBlock Classes="summaryValue" Text="{Binding CurrentTitle}" FontWeight="SemiBold"/>
								<TextBlock FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap">
									<Run Text="{Binding CurrentNo}"/>
									<Run Text="  ·  "/>
									<Run Text="{Binding CurrentCompany}"/>
								</TextBlock>
							</StackPanel>

							<Border Background="{DynamicResource SurfaceDivider}" Height="1"/>

							<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
								<StackPanel Grid.Column="0" Spacing="3">
									<TextBlock Classes="summaryLabel" Text="BAŞLANGIÇ"/>
									<TextBlock Text="{Binding CurrentStartText}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"/>
								</StackPanel>
								<StackPanel Grid.Column="1" Spacing="3">
									<TextBlock Classes="summaryLabel" Text="BİTİŞ"/>
									<TextBlock Text="{Binding CurrentEndText}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"/>
								</StackPanel>
							</Grid>
						</StackPanel>

						<TextBlock Text="Soldan bir sözleşme seçin." FontSize="12.5" Foreground="{DynamicResource TextDisabledAlt}"
								   IsVisible="{Binding SelectedContract, Converter={x:Static ObjectConverters.IsNull}}"/>
					</StackPanel>
				</Border>

				<!--
				  Sözleşmenin sicili: aynı ihlalin ikinci kez bildirilmesini önler ve
				  bildirimi yapan, firmanın geçmişini görerek karar verir.
				-->
				<Border IsVisible="{Binding HasExistingViolations}"
						Background="{DynamicResource DangerSoftBgFaint}" BorderBrush="{DynamicResource DangerBorderFaint}" BorderThickness="1"
						CornerRadius="12" Padding="18,16">
					<StackPanel Spacing="12">
						<TextBlock Classes="sectionLabel" Text="ÖNCEKİ İHLALLER" Foreground="{DynamicResource DangerMuted}"/>
						<ItemsControl ItemsSource="{Binding ExistingViolations}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:ViolationRowViewModel">
									<StackPanel Spacing="3" Margin="0,0,0,10">
										<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
											<TextBlock Grid.Column="0" Text="{Binding ViolationType}" FontSize="12"
													   FontWeight="SemiBold" Foreground="{Binding TitleColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
													   TextWrapping="Wrap"/>
											<Border Grid.Column="1" Background="{Binding StatusBgHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
													CornerRadius="8" Padding="7,1" VerticalAlignment="Top">
												<TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
														   FontSize="9.5" FontWeight="Bold"/>
											</Border>
										</Grid>
										<TextBlock Text="{Binding ViolationDateText}" FontSize="10.5"
												   Foreground="{DynamicResource DangerMuted}"/>
									</StackPanel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Border>

				<Button Classes="flat" HorizontalAlignment="Stretch"
						IsVisible="{Binding SelectedContract, Converter={x:Static ObjectConverters.IsNotNull}}"
						IsEnabled="{Binding !IsBusy}" Click="OnSubmitClick">
					<Border Background="{DynamicResource DangerSolid}" CornerRadius="9" Padding="18,12">
						<TextBlock Text="İhlali Bildir" Foreground="{DynamicResource TextOnAccent}" FontSize="13"
								   FontWeight="SemiBold" HorizontalAlignment="Center"/>
					</Border>
				</Button>

			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
