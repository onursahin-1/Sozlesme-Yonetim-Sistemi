<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
             x:Class="Sys.UI.Views.ChangePasswordView"
             x:DataType="vm:ChangePasswordViewModel">

	<Design.DataContext>
		<vm:ChangePasswordViewModel />
	</Design.DataContext>

	<ScrollViewer>
		<StackPanel Margin="0,0,20,20" Spacing="10" MaxWidth="420" HorizontalAlignment="Left">

			<Border Background="#F5F5F5" CornerRadius="8" Padding="16">
				<StackPanel Spacing="8">

					<TextBlock Text="Şifrenizi değiştirmek için önce mevcut şifrenizi girin."
                               Foreground="#555555" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>

					<TextBlock Text="Mevcut Şifre *" FontWeight="Bold" Foreground="Black"/>
					<TextBox Text="{Binding CurrentPassword}" Background="White" Foreground="Black" PasswordChar="•"/>
					<TextBlock Classes="fieldError" Text="{Binding CurrentPasswordError}"
                               IsVisible="{Binding CurrentPasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

					<TextBlock Text="Yeni Şifre *" FontWeight="Bold" Foreground="Black" Margin="0,8,0,0"/>
					<TextBox Text="{Binding NewPassword}" Background="White" Foreground="Black" PasswordChar="•"
                             PlaceholderText="En az 6 karakter"/>
					<TextBlock Classes="fieldError" Text="{Binding NewPasswordError}"
                               IsVisible="{Binding NewPasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

					<TextBlock Text="Yeni Şifre (Tekrar) *" FontWeight="Bold" Foreground="Black" Margin="0,8,0,0"/>
					<TextBox Text="{Binding NewPasswordRepeat}" Background="White" Foreground="Black" PasswordChar="•"/>
					<TextBlock Classes="fieldError" Text="{Binding RepeatError}"
                               IsVisible="{Binding RepeatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

					<Button Classes="flat" HorizontalAlignment="Left" Margin="0,14,0,0"
                            IsEnabled="{Binding !IsBusy}"
                            Command="{Binding SubmitCommand}">
						<Border Background="#2D6EA8" CornerRadius="4" Padding="16,8">
							<TextBlock Text="{Binding SubmitButtonText}" Foreground="White"/>
						</Border>
					</Button>

				</StackPanel>
			</Border>

			<TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
			<TextBlock Text="{Binding SuccessMessage}" Foreground="Green" TextWrapping="Wrap"
                       IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

		</StackPanel>
	</ScrollViewer>

</UserControl>
