<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Sys.UI.Localization"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:conv="using:Sys.UI.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="560"
             x:Class="Sys.UI.Views.ChangePasswordView"
             x:DataType="vm:ChangePasswordViewModel">

	<Design.DataContext>
		<vm:ChangePasswordViewModel />
	</Design.DataContext>

	<UserControl.Styles>
		<Style Selector="TextBox">
			<Setter Property="Padding" Value="11,9"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
			<Setter Property="Background" Value="{DynamicResource SurfaceInput}"/>
		</Style>
		<Style Selector="TextBox:focus">
			<Setter Property="Background" Value="{DynamicResource SurfaceInputFocus}"/>
		</Style>
		<Style Selector="TextBlock.formLabel">
			<Setter Property="FontSize" Value="11.5"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextLabel}"/>
		</Style>
		<Style Selector="TextBlock.rule">
			<Setter Property="FontSize" Value="11.5"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>

		<!--
		  Yerleşim iki modda farklı, bu yüzden ikisi de STİLDE tanımlı: Avalonia'da
		  öğe üzerine doğrudan yazılan değer stili ezer, biri yerel biri stil olsaydı
		  zorunlu mod hiç uygulanmazdı.

		  Kabuk içinden açıldığında sola yaslı — diğer ekranlarla aynı hizada durmalı.
		  Zorunlu değişimde ise ekran tek başına: sol menü yok, başka içerik yok.
		  Sola yaslı bırakılsa geniş ekranda sağ taraf boş kalıp ekran yarım görünürdü.
		-->
		<Style Selector="StackPanel.page">
			<Setter Property="HorizontalAlignment" Value="Left"/>
			<Setter Property="Margin" Value="0,0,20,24"/>
		</Style>
		<Style Selector="StackPanel.page.forced">
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="20,36,20,36"/>
		</Style>
	</UserControl.Styles>

	<ScrollViewer>
		<StackPanel Classes="page" Classes.forced="{Binding IsForced}"
					Spacing="14" MaxWidth="760">

			<!--
			  Zorunlu değişim bandı. Kullanıcı bu ekrana giriş yaptıktan hemen sonra,
			  kendi isteğiyle değil düşürüldüğü için burada NEDEN burada olduğunu
			  okuması gerekiyor; aksi halde "şifremi neden soruyor" diye takılır.
			-->
			<Border IsVisible="{Binding IsForced}"
					Background="{DynamicResource WarningSoftBg}" BorderBrush="{DynamicResource WarningSoftBorder}" BorderThickness="1"
					CornerRadius="10" Padding="16,13">
				<StackPanel Spacing="4">
					<TextBlock Text="{Binding [Pwd.ForcedTitle], Source={x:Static loc:Strings.Current}}"
							   FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource WarningText}"/>
					<TextBlock FontSize="11.5" Foreground="{DynamicResource WarningText}" TextWrapping="Wrap"
							   Text="{Binding [Pwd.ForcedSubtitle], Source={x:Static loc:Strings.Current}}"/>

					<!-- Yanlış hesaba girmiş ya da geçici şifreyi hatırlamayan biri
					     uygulamayı kapatmak zorunda kalmasın. -->
					<Button Classes="flat" HorizontalAlignment="Left" Margin="0,4,0,0"
							Command="{Binding ForcedLogoutCommand}">
						<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource WarningSoftBorder}" BorderThickness="1"
								CornerRadius="7" Padding="12,6">
							<TextBlock Text="{Binding [Pwd.BackToLogin], Source={x:Static loc:Strings.Current}}" Foreground="{DynamicResource WarningText}" FontSize="11.5"/>
						</Border>
					</Button>
				</StackPanel>
			</Border>

			<!-- Bu ekran sol menüde olmadığı için dönüş yolu buradan sağlanıyor (Esc de çalışır) -->
			<Button Classes="flat" HorizontalAlignment="Left"
					IsVisible="{Binding ShowBackButton}"
					Command="{Binding BackCommand}"
					ToolTip.Tip="{Binding [Pwd.BackHint], Source={x:Static loc:Strings.Current}}">
				<Border Background="{DynamicResource SurfaceButton}" BorderBrush="{DynamicResource BorderInput}" BorderThickness="1"
						CornerRadius="7" Padding="12,6">
					<TextBlock Text="{Binding [Pwd.Back], Source={x:Static loc:Strings.Current}}" Foreground="{DynamicResource TextLabel}" FontSize="11.5"/>
				</Border>
			</Button>

			<Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
					Background="{DynamicResource DangerSoftBgFaint3}" BorderBrush="{DynamicResource DangerSoftBorderAlt}" BorderThickness="1"
					CornerRadius="10" Padding="14,11">
				<TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerTextAlt}"
						   FontSize="12.5" TextWrapping="Wrap"/>
			</Border>

			<Border IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
					Background="{DynamicResource SuccessSoftBgAlt}" BorderBrush="{DynamicResource SuccessSoftBorder}" BorderThickness="1"
					CornerRadius="10" Padding="14,11">
				<TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource SuccessBase}"
						   FontSize="12.5" TextWrapping="Wrap"/>
			</Border>

			<!-- Solda form, sağda şifre kuralları -->
			<Grid ColumnDefinitions="*,260" ColumnSpacing="18">

				<Border Grid.Column="0" Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
						CornerRadius="12" Padding="24,20">
					<StackPanel Spacing="18">

						<StackPanel Spacing="1">
							<TextBlock Classes="display" Text="{Binding [Pwd.Title], Source={x:Static loc:Strings.Current}}" FontSize="15.5"
									   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
							<TextBlock Text="{Binding [Pwd.Subtitle], Source={x:Static loc:Strings.Current}}"
									   FontSize="11" Foreground="{DynamicResource TextFaintAlt}"/>
						</StackPanel>
						<Border Background="{DynamicResource SurfaceDivider}" Height="1"/>

						<StackPanel>
							<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
								<TextBlock Grid.Column="0" Classes="formLabel">
									<Run Text="{Binding [Pwd.Current], Source={x:Static loc:Strings.Current}}"/>
									<Run Text=" *" Foreground="{DynamicResource DangerText}"/>
								</TextBlock>
								<StackPanel Grid.Column="1" x:Name="CapsWarnCurrent" IsVisible="False"
											Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
									<Path Fill="{DynamicResource DangerBase}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Data="M12 3L19 10.5H15.5V15H8.5V10.5H5ZM8.5 17.5H15.5V21H8.5Z"/>
									<TextBlock Text="{Binding [Pwd.CapsLock], Source={x:Static loc:Strings.Current}}" FontSize="11" Foreground="{DynamicResource DangerBase}" VerticalAlignment="Center"/>
								</StackPanel>
							</Grid>
							<TextBox x:Name="CurrentPasswordBox" Text="{Binding CurrentPassword}" PasswordChar="•"
									 KeyUp="OnPasswordKeyUp" GotFocus="OnPasswordFocusChanged" LostFocus="OnPasswordLostFocus"/>
							<TextBlock Classes="fieldError" Text="{Binding CurrentPasswordError}"
									   IsVisible="{Binding CurrentPasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						</StackPanel>

						<Border Background="{DynamicResource SurfaceDivider}" Height="1"/>

						<StackPanel>
							<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
								<TextBlock Grid.Column="0" Classes="formLabel">
									<Run Text="{Binding [Pwd.New], Source={x:Static loc:Strings.Current}}"/>
									<Run Text=" *" Foreground="{DynamicResource DangerText}"/>
								</TextBlock>
								<StackPanel Grid.Column="1" x:Name="CapsWarnNew" IsVisible="False"
											Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
									<Path Fill="{DynamicResource DangerBase}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Data="M12 3L19 10.5H15.5V15H8.5V10.5H5ZM8.5 17.5H15.5V21H8.5Z"/>
									<TextBlock Text="{Binding [Pwd.CapsLock], Source={x:Static loc:Strings.Current}}" FontSize="11" Foreground="{DynamicResource DangerBase}" VerticalAlignment="Center"/>
								</StackPanel>
							</Grid>
							<TextBox x:Name="NewPasswordBox" Text="{Binding NewPassword}" PasswordChar="•"
									 PlaceholderText="{Binding MinLengthRule}"
									 KeyUp="OnPasswordKeyUp" GotFocus="OnPasswordFocusChanged" LostFocus="OnPasswordLostFocus"/>
							<TextBlock Classes="fieldError" Text="{Binding NewPasswordError}"
									   IsVisible="{Binding NewPasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						</StackPanel>

						<StackPanel>
							<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
								<TextBlock Grid.Column="0" Classes="formLabel">
									<Run Text="{Binding [Pwd.Repeat], Source={x:Static loc:Strings.Current}}"/>
									<Run Text=" *" Foreground="{DynamicResource DangerText}"/>
								</TextBlock>
								<StackPanel Grid.Column="1" x:Name="CapsWarnRepeat" IsVisible="False"
											Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
									<Path Fill="{DynamicResource DangerBase}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Data="M12 3L19 10.5H15.5V15H8.5V10.5H5ZM8.5 17.5H15.5V21H8.5Z"/>
									<TextBlock Text="{Binding [Pwd.CapsLock], Source={x:Static loc:Strings.Current}}" FontSize="11" Foreground="{DynamicResource DangerBase}" VerticalAlignment="Center"/>
								</StackPanel>
							</Grid>
							<TextBox x:Name="RepeatPasswordBox" Text="{Binding NewPasswordRepeat}" PasswordChar="•"
									 KeyUp="OnPasswordKeyUp" GotFocus="OnPasswordFocusChanged" LostFocus="OnPasswordLostFocus"/>
							<TextBlock Classes="fieldError" Text="{Binding RepeatError}"
									   IsVisible="{Binding RepeatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						</StackPanel>

						<Button Classes="flat" HorizontalAlignment="Left" Margin="0,2,0,0"
								IsEnabled="{Binding !IsBusy}" Command="{Binding SubmitCommand}">
							<Border Background="{DynamicResource AccentSolid}" CornerRadius="8" Padding="20,11">
								<TextBlock Text="{Binding SubmitButtonText}" Foreground="{DynamicResource TextOnAccent}"
										   FontSize="13" FontWeight="SemiBold"/>
							</Border>
						</Button>
					</StackPanel>
				</Border>

				<!--
				  Kurallar formun yanında duruyor: kullanıcı şifreyi yazarken neyin
				  beklendiğini görüyor, hata mesajını beklemesi gerekmiyor.
				-->
				<Border Grid.Column="1" Background="{DynamicResource SurfaceSubtle}" BorderBrush="{DynamicResource BorderInput}" BorderThickness="1"
						CornerRadius="12" Padding="18,16" VerticalAlignment="Top">
					<StackPanel Spacing="10">
						<TextBlock Classes="sectionLabel" Text="{Binding [Pwd.RulesTitle], Source={x:Static loc:Strings.Current}}"/>

						<!--
						  Kurallar yazdıkça işaretleniyor. Eskiden sabit metindi ve kural
						  metni PasswordPolicy'den kopuktu; kural değişse ekran sessizce
						  yanlış bilgi vermeye devam ederdi. Artık uzunluk metni de
						  ViewModel üzerinden politikadan geliyor.
						-->
						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
							<Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
								  Fill="{Binding RuleLengthOk, Converter={x:Static conv:BoolToBrushConverter.Rule}}"
								  Data="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/>
							<TextBlock Grid.Column="1" Classes="rule" Text="{Binding MinLengthRule}"/>
						</Grid>
						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
							<Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
								  Fill="{Binding RuleLetterOk, Converter={x:Static conv:BoolToBrushConverter.Rule}}"
								  Data="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/>
							<TextBlock Grid.Column="1" Classes="rule" Text="{Binding [Pwd.RuleLetter], Source={x:Static loc:Strings.Current}}"/>
						</Grid>
						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
							<Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
								  Fill="{Binding RuleDigitOk, Converter={x:Static conv:BoolToBrushConverter.Rule}}"
								  Data="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/>
							<TextBlock Grid.Column="1" Classes="rule" Text="{Binding [Pwd.RuleDigit], Source={x:Static loc:Strings.Current}}"/>
						</Grid>
						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
							<Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
								  Fill="{Binding RuleRepeatOk, Converter={x:Static conv:BoolToBrushConverter.Rule}}"
								  Data="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/>
							<TextBlock Grid.Column="1" Classes="rule" Text="{Binding [Pwd.RuleMatch], Source={x:Static loc:Strings.Current}}"/>
						</Grid>

						<TextBlock Classes="rule" Text="{Binding [Pwd.RuleDifferent], Source={x:Static loc:Strings.Current}}" Margin="20,0,0,0"/>

						<Border Background="{DynamicResource SurfaceDivider}" Height="1" Margin="0,2,0,0"/>

						<TextBlock Classes="rule"
								   Text="{Binding [Pwd.NoteSession], Source={x:Static loc:Strings.Current}}"/>
						<TextBlock Classes="rule"
								   Text="{Binding [Pwd.NoteForgot], Source={x:Static loc:Strings.Current}}"/>
					</StackPanel>
				</Border>
			</Grid>

		</StackPanel>
	</ScrollViewer>

</UserControl>
