<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="560"
             x:Class="Sys.UI.Views.ChangePasswordView"
             x:DataType="vm:ChangePasswordViewModel">

	<Design.DataContext>
		<vm:ChangePasswordViewModel />
	</Design.DataContext>

	<UserControl.Styles>
		<Style Selector="TextBox">
			<Setter Property="Padding" Value="11,9"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderBrush" Value="#DFE5EE"/>
			<Setter Property="Background" Value="#FBFCFE"/>
		</Style>
		<Style Selector="TextBox:focus">
			<Setter Property="Background" Value="White"/>
		</Style>
		<Style Selector="TextBlock.formLabel">
			<Setter Property="FontSize" Value="11.5"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="#5B6472"/>
		</Style>
		<Style Selector="TextBlock.rule">
			<Setter Property="FontSize" Value="11.5"/>
			<Setter Property="Foreground" Value="#8A94A6"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
	</UserControl.Styles>

	<ScrollViewer>
		<StackPanel Margin="0,0,20,24" Spacing="14" MaxWidth="760" HorizontalAlignment="Left">

			<!-- Bu ekran sol menüde olmadığı için dönüş yolu buradan sağlanıyor (Esc de çalışır) -->
			<Button Classes="flat" HorizontalAlignment="Left"
					Command="{Binding BackCommand}"
					ToolTip.Tip="Esc tuşuyla da dönebilirsiniz">
				<Border Background="#EEF1F6" BorderBrush="#DFE5EE" BorderThickness="1"
						CornerRadius="7" Padding="12,6">
					<TextBlock Text="← Geri" Foreground="#5B6472" FontSize="11.5"/>
				</Border>
			</Button>

			<Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
					Background="#FBEBE9" BorderBrush="#EFC9C4" BorderThickness="1"
					CornerRadius="10" Padding="14,11">
				<TextBlock Text="{Binding ErrorMessage}" Foreground="#9B3B25"
						   FontSize="12.5" TextWrapping="Wrap"/>
			</Border>

			<Border IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
					Background="#E9F4EB" BorderBrush="#A9D6B0" BorderThickness="1"
					CornerRadius="10" Padding="14,11">
				<TextBlock Text="{Binding SuccessMessage}" Foreground="#1A6B2A"
						   FontSize="12.5" TextWrapping="Wrap"/>
			</Border>

			<!-- Solda form, sağda şifre kuralları -->
			<Grid ColumnDefinitions="*,260" ColumnSpacing="18">

				<Border Grid.Column="0" Background="White" BorderBrush="#E3E7EE" BorderThickness="1"
						CornerRadius="12" Padding="24,20">
					<StackPanel Spacing="18">

						<StackPanel Spacing="1">
							<TextBlock Classes="display" Text="Şifre Değiştir" FontSize="15.5"
									   FontWeight="SemiBold" Foreground="#1A2E4A"/>
							<TextBlock Text="Kimliğinizi doğrulamak için önce mevcut şifrenizi girin."
									   FontSize="11" Foreground="#A3ABB8"/>
						</StackPanel>
						<Border Background="#EDF1F6" Height="1"/>

						<StackPanel>
							<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
								<TextBlock Grid.Column="0" Classes="formLabel">
									<Run Text="MEVCUT ŞİFRE"/>
									<Run Text=" *" Foreground="#D14343"/>
								</TextBlock>
								<StackPanel Grid.Column="1" x:Name="CapsWarnCurrent" IsVisible="False"
											Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
									<Path Fill="#A32D2D" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Data="M12 3L19 10.5H15.5V15H8.5V10.5H5ZM8.5 17.5H15.5V21H8.5Z"/>
									<TextBlock Text="Caps Lock açık" FontSize="11" Foreground="#A32D2D" VerticalAlignment="Center"/>
								</StackPanel>
							</Grid>
							<TextBox x:Name="CurrentPasswordBox" Text="{Binding CurrentPassword}" PasswordChar="•"
									 KeyUp="OnPasswordKeyUp" GotFocus="OnPasswordFocusChanged" LostFocus="OnPasswordLostFocus"/>
							<TextBlock Classes="fieldError" Text="{Binding CurrentPasswordError}"
									   IsVisible="{Binding CurrentPasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						</StackPanel>

						<Border Background="#EDF1F6" Height="1"/>

						<StackPanel>
							<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
								<TextBlock Grid.Column="0" Classes="formLabel">
									<Run Text="YENİ ŞİFRE"/>
									<Run Text=" *" Foreground="#D14343"/>
								</TextBlock>
								<StackPanel Grid.Column="1" x:Name="CapsWarnNew" IsVisible="False"
											Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
									<Path Fill="#A32D2D" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Data="M12 3L19 10.5H15.5V15H8.5V10.5H5ZM8.5 17.5H15.5V21H8.5Z"/>
									<TextBlock Text="Caps Lock açık" FontSize="11" Foreground="#A32D2D" VerticalAlignment="Center"/>
								</StackPanel>
							</Grid>
							<TextBox x:Name="NewPasswordBox" Text="{Binding NewPassword}" PasswordChar="•"
									 PlaceholderText="En az 6 karakter"
									 KeyUp="OnPasswordKeyUp" GotFocus="OnPasswordFocusChanged" LostFocus="OnPasswordLostFocus"/>
							<TextBlock Classes="fieldError" Text="{Binding NewPasswordError}"
									   IsVisible="{Binding NewPasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						</StackPanel>

						<StackPanel>
							<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
								<TextBlock Grid.Column="0" Classes="formLabel">
									<Run Text="YENİ ŞİFRE (TEKRAR)"/>
									<Run Text=" *" Foreground="#D14343"/>
								</TextBlock>
								<StackPanel Grid.Column="1" x:Name="CapsWarnRepeat" IsVisible="False"
											Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
									<Path Fill="#A32D2D" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Data="M12 3L19 10.5H15.5V15H8.5V10.5H5ZM8.5 17.5H15.5V21H8.5Z"/>
									<TextBlock Text="Caps Lock açık" FontSize="11" Foreground="#A32D2D" VerticalAlignment="Center"/>
								</StackPanel>
							</Grid>
							<TextBox x:Name="RepeatPasswordBox" Text="{Binding NewPasswordRepeat}" PasswordChar="•"
									 KeyUp="OnPasswordKeyUp" GotFocus="OnPasswordFocusChanged" LostFocus="OnPasswordLostFocus"/>
							<TextBlock Classes="fieldError" Text="{Binding RepeatError}"
									   IsVisible="{Binding RepeatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						</StackPanel>

						<Button Classes="flat" HorizontalAlignment="Left" Margin="0,2,0,0"
								IsEnabled="{Binding !IsBusy}" Command="{Binding SubmitCommand}">
							<Border Background="#2D6EA8" CornerRadius="8" Padding="20,11">
								<TextBlock Text="{Binding SubmitButtonText}" Foreground="White"
										   FontSize="13" FontWeight="SemiBold"/>
							</Border>
						</Button>
					</StackPanel>
				</Border>

				<!--
				  Kurallar formun yanında duruyor: kullanıcı şifreyi yazarken neyin
				  beklendiğini görüyor, hata mesajını beklemesi gerekmiyor.
				-->
				<Border Grid.Column="1" Background="#F7F9FC" BorderBrush="#DFE5EE" BorderThickness="1"
						CornerRadius="12" Padding="18,16" VerticalAlignment="Top">
					<StackPanel Spacing="10">
						<TextBlock Classes="sectionLabel" Text="ŞİFRE KURALLARI"/>
						<TextBlock Classes="rule" Text="• En az 6 karakter olmalı"/>
						<TextBlock Classes="rule" Text="• Mevcut şifrenizden farklı olmalı"/>
						<TextBlock Classes="rule" Text="• İki alana da aynı şekilde yazılmalı"/>

						<Border Background="#EDF1F6" Height="1" Margin="0,2,0,0"/>

						<TextBlock Classes="rule"
								   Text="Şifreniz değiştikten sonra oturumunuz açık kalır; bir dahaki girişte yeni şifrenizi kullanın."/>
						<TextBlock Classes="rule"
								   Text="Şifrenizi hatırlamıyorsanız giriş ekranındaki &quot;Şifremi unuttum&quot; ile yöneticiye talep gönderebilirsiniz."/>
					</StackPanel>
				</Border>
			</Grid>

		</StackPanel>
	</ScrollViewer>

</UserControl>
