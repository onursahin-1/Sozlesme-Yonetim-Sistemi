<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Sys.UI.Localization"
             xmlns:conv="using:Sys.UI.Converters"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="Sys.UI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

	<Design.DataContext>
		<vm:DashboardViewModel />
	</Design.DataContext>

	<!--
	  Panelin amacı "kaç sözleşme var" değil, "ne yapmam gerekiyor" sorusuna cevap
	  vermek. Bu yüzden en üstte durum sayıları, hemen altında kullanıcının kendi
	  aksiyonunu bekleyen işler, sonra portföy istatistikleri geliyor.
	-->
	<UserControl.Styles>
		<!-- Kart: beyaz zemin, ince çerçeve, yumuşak köşe — uygulama genelindeki dil -->
		<Style Selector="Border.card">
			<Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderCard}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="18"/>
		</Style>
		<Style Selector="TextBlock.cardTitle">
			<Setter Property="FontSize" Value="10.5"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
			<Setter Property="LetterSpacing" Value="0.8"/>
		</Style>
	</UserControl.Styles>

	<ScrollViewer>
		<StackPanel Margin="0,20,20,24" Spacing="18">

			<TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"
					   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

			<TextBlock Text="{Binding [Common.Loading], Source={x:Static loc:Strings.Current}}" Foreground="Gray" IsVisible="{Binding IsLoading}"/>

			<StackPanel IsVisible="{Binding !IsLoading}" Spacing="18">

				<!-- Karşılama -->
				<StackPanel Spacing="2">
					<TextBlock Classes="display" Text="{Binding GreetingText}" FontSize="22"
							   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
					<TextBlock Text="{Binding TodayText}" FontSize="12.5" Foreground="{DynamicResource TextMuted}"/>
				</StackPanel>

				<!--
				  Durum kartları: ikon rozetleri kaldırıldı. Rengi artık ince bir dikey şerit
				  ve sayı taşıyor; zemin ilgili rengin çok açık bir tonu. Sayılar başlık
				  fontuyla (Bahnschrift) yazılıyor — rakamları geniş ve eşit aralıklı olduğu
				  için sayı gösteriminde gövde fontundan belirgin şekilde daha iyi duruyor.
				-->
				<UniformGrid Columns="4">
					<Button Classes="statCard" Margin="0,0,12,0"
							Command="{Binding FilterCardCommand}" CommandParameter="yururlukte"
							IsEnabled="{Binding YururlukteCardClickable}">
						<Border Background="{DynamicResource SuccessSoftBgFaint}" BorderBrush="{DynamicResource BorderSoftBlue}" BorderThickness="1"
								CornerRadius="10" Padding="16,15">
							<Grid ColumnDefinitions="Auto,*">
								<!-- İkon yerine ince renkli şerit: rengi taşır, gürültü yapmaz -->
								<Border Grid.Column="0" Width="3" CornerRadius="2"
										Background="{DynamicResource SuccessSolid}" Margin="0,2,14,2"/>
								<StackPanel Grid.Column="1" Spacing="3">
									<TextBlock Classes="display" Text="{Binding Yururlukte}"
											   FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBase}"
											   LetterSpacing="-0.5"/>
									<TextBlock Text="{Binding [Status.Live], Source={x:Static loc:Strings.Current}}" FontSize="12.5" FontWeight="SemiBold"
											   Foreground="{DynamicResource TextBody}"/>
									<TextBlock Text="{Binding [Dash.LiveSubtitle], Source={x:Static loc:Strings.Current}}" FontSize="10.5" Foreground="{DynamicResource TextFaint}"/>
								</StackPanel>
							</Grid>
						</Border>
					</Button>

					<Button Classes="statCard" Margin="0,0,12,0"
							Command="{Binding FilterCardCommand}" CommandParameter="onay_bekliyor"
							IsEnabled="{Binding OnayBekliyorCardClickable}">
						<Border Background="{DynamicResource SurfaceSubtleBlue}" BorderBrush="{DynamicResource BorderSoftBlue}" BorderThickness="1"
								CornerRadius="10" Padding="16,15">
							<Grid ColumnDefinitions="Auto,*">
								<!-- İkon yerine ince renkli şerit: rengi taşır, gürültü yapmaz -->
								<Border Grid.Column="0" Width="3" CornerRadius="2"
										Background="{DynamicResource AccentSolid}" Margin="0,2,14,2"/>
								<StackPanel Grid.Column="1" Spacing="3">
									<TextBlock Classes="display" Text="{Binding OnayBekliyor}"
											   FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource AccentBase}"
											   LetterSpacing="-0.5"/>
									<TextBlock Text="{Binding [Status.PendingApproval], Source={x:Static loc:Strings.Current}}" FontSize="12.5" FontWeight="SemiBold"
											   Foreground="{DynamicResource TextBody}"/>
									<TextBlock Text="{Binding [Dash.PendingSubtitle], Source={x:Static loc:Strings.Current}}" FontSize="10.5" Foreground="{DynamicResource TextFaint}"/>
								</StackPanel>
							</Grid>
						</Border>
					</Button>

					<Button Classes="statCard" Margin="0,0,12,0"
							Command="{Binding FilterCardCommand}" CommandParameter="uyari"
							IsEnabled="{Binding UyariCardClickable}">
						<Border Background="{DynamicResource WarningSoftBgFaint}" BorderBrush="{DynamicResource BorderSoftBlue}" BorderThickness="1"
								CornerRadius="10" Padding="16,15">
							<Grid ColumnDefinitions="Auto,*">
								<!-- İkon yerine ince renkli şerit: rengi taşır, gürültü yapmaz -->
								<Border Grid.Column="0" Width="3" CornerRadius="2"
										Background="{DynamicResource WarningSolid}" Margin="0,2,14,2"/>
								<StackPanel Grid.Column="1" Spacing="3">
									<TextBlock Classes="display" Text="{Binding Uyari}"
											   FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource WarningBase}"
											   LetterSpacing="-0.5"/>
									<TextBlock Text="{Binding [Dash.ExpiryWarning], Source={x:Static loc:Strings.Current}}" FontSize="12.5" FontWeight="SemiBold"
											   Foreground="{DynamicResource TextBody}"/>
									<TextBlock Text="{Binding [Dash.ExpiryWarningSubtitle], Source={x:Static loc:Strings.Current}}" FontSize="10.5" Foreground="{DynamicResource TextFaint}"/>
								</StackPanel>
							</Grid>
						</Border>
					</Button>

					<Button Classes="statCard"
							Command="{Binding FilterCardCommand}" CommandParameter="ihlal"
							IsEnabled="{Binding IhlalCardClickable}">
						<Border Background="{DynamicResource DangerSoftBgAlt}" BorderBrush="{DynamicResource BorderSoftBlue}" BorderThickness="1"
								CornerRadius="10" Padding="16,15">
							<Grid ColumnDefinitions="Auto,*">
								<!-- İkon yerine ince renkli şerit: rengi taşır, gürültü yapmaz -->
								<Border Grid.Column="0" Width="3" CornerRadius="2"
										Background="{DynamicResource DangerSolid}" Margin="0,2,14,2"/>
								<StackPanel Grid.Column="1" Spacing="3">
									<!--
									  Kart artık SÖZLEŞME değil AÇIK İHLAL sayısını gösteriyor:
									  bir sözleşmede birden fazla açık ihlal olabilir ve kart "1"
									  derken aslında üç iş bekliyor olabilirdi. Alt satır kaç
									  sözleşmeye yayıldığını söylüyor.
									-->
									<TextBlock Classes="display" Text="{Binding OpenViolations}"
											   FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource DangerBase}"
											   LetterSpacing="-0.5"/>
									<TextBlock Text="{Binding [Dash.OpenViolations], Source={x:Static loc:Strings.Current}}" FontSize="12.5" FontWeight="SemiBold"
											   Foreground="{DynamicResource TextBody}"/>
									<TextBlock Text="{Binding IhlalSubtitle}" FontSize="10.5"
											   Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap"/>
								</StackPanel>
							</Grid>
						</Border>
					</Button>
				</UniformGrid>

				<!--
				  Sizi bekleyen işler: panelin en önemli kutusu. Kullanıcı "onay bekliyor: 7"
				  gördüğünde bunun kaçının KENDİSİNİ beklediğini bilmiyordu.
				-->
				<Border Classes="card" IsVisible="{Binding HasPendingWork}">
					<StackPanel Spacing="12">
						<TextBlock Classes="cardTitle" Text="{Binding [Dash.PendingWork], Source={x:Static loc:Strings.Current}}"/>
						<ItemsControl ItemsSource="{Binding PendingWork}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:PendingWorkRowViewModel">
									<Button Classes="flat" HorizontalAlignment="Stretch"
											HorizontalContentAlignment="Stretch" Margin="0,0,0,8"
											Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).OpenPendingWorkCommand}"
											CommandParameter="{Binding}">
										<Border Background="{DynamicResource SurfaceSubtle}" BorderBrush="{DynamicResource BorderSoftBlue}" BorderThickness="1"
												CornerRadius="8" Padding="14,12">
											<Grid ColumnDefinitions="Auto,*,Auto">
												<Border Grid.Column="0" Background="{Binding ColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
														Width="4" CornerRadius="2" Margin="0,0,14,0"/>
												<StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
													<TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
															   Foreground="{DynamicResource TextPrimary}"/>
													<TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextMuted}"
															   TextWrapping="Wrap"/>
													<!--
													  Bekleme süresi: "12 iş bekliyor" ile "12 iş
													  bekliyor, en eskisi 21 gündür" arasında dağlar
													  kadar fark var. İlki liste uzunluğu, ikincisi
													  gecikme uyarısı.
													-->
													<TextBlock Text="{Binding WaitingText}" FontSize="10.5"
															   FontWeight="SemiBold"
															   Foreground="{Binding WaitingColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
															   IsVisible="{Binding HasWaitingInfo}"
															   Margin="0,2,0,0"/>
												</StackPanel>
												<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
															VerticalAlignment="Center">
													<Border Background="{Binding ColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}" CornerRadius="11"
															MinWidth="26" Height="22" Padding="8,0">
														<TextBlock Text="{Binding CountText}" Foreground="{DynamicResource TextOnAccent}"
																   FontSize="12" FontWeight="Bold"
																   HorizontalAlignment="Center" VerticalAlignment="Center"/>
													</Border>
													<TextBlock Text="›" FontSize="17" Foreground="{DynamicResource TextDisabled}"
															   VerticalAlignment="Center"/>
												</StackPanel>
											</Grid>
										</Border>
									</Button>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Border>

				<!-- Portföy istatistikleri: yalnızca genel görünürlüğü olan roller -->
				<Grid ColumnDefinitions="*,*" ColumnSpacing="14" IsVisible="{Binding ShowPortfolioStats}">

					<Border Grid.Column="0" Classes="card">
						<StackPanel Spacing="12">
							<TextBlock Classes="cardTitle" Text="{Binding [Dash.TotalValue], Source={x:Static loc:Strings.Current}}"/>
							<TextBlock Text="{Binding [Dash.NoLiveContracts], Source={x:Static loc:Strings.Current}}" FontSize="12" Foreground="{DynamicResource TextFaint}"
									   IsVisible="{Binding !HasActiveValue}"/>
							<ItemsControl ItemsSource="{Binding ActiveValue}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:CurrencyTotalRowViewModel">
										<StackPanel Spacing="1" Margin="0,0,0,10">
											<TextBlock Text="{Binding AmountText}" FontSize="19" FontWeight="Bold"
													   Foreground="{DynamicResource TextPrimary}"/>
											<TextBlock Text="{Binding CountText}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
										</StackPanel>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<TextBlock Text="{Binding [Dash.NoCurrencyConversion], Source={x:Static loc:Strings.Current}}"
									   FontSize="10.5" Foreground="{DynamicResource TextDisabled}" TextWrapping="Wrap"/>
						</StackPanel>
					</Border>

					<Border Grid.Column="1" Classes="card">
						<StackPanel Spacing="12">
							<StackPanel Spacing="2">
								<TextBlock Classes="cardTitle" Text="{Binding [Dash.ThisMonth], Source={x:Static loc:Strings.Current}}"/>
								<TextBlock Text="{Binding MonthLabel}" FontSize="11" Foreground="{DynamicResource TextDisabled}"/>
							</StackPanel>

							<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
								<TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Dash.NewRequest], Source={x:Static loc:Strings.Current}}" FontSize="12.5" Foreground="{DynamicResource TextBodyAlt}"/>
								<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MonthNewRequests}"
										   FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>

								<TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [Dash.Activated], Source={x:Static loc:Strings.Current}}" FontSize="12.5" Foreground="{DynamicResource TextBodyAlt}"/>
								<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MonthActivated}"
										   FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SuccessBase}"/>

								<TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [Dash.Terminated], Source={x:Static loc:Strings.Current}}" FontSize="12.5" Foreground="{DynamicResource TextBodyAlt}"/>
								<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MonthTerminated}"
										   FontSize="15" FontWeight="Bold" Foreground="{DynamicResource DangerBase}"/>
							</Grid>
						</StackPanel>
					</Border>

				</Grid>

				<!--
				  Bitiş takvimi (30/60/90) kaldırıldı: "Bitiş Uyarısı" kartı ve aşağıdaki
				  liste zaten aynı bilgiyi veriyordu, takvim üçüncü tekrardı. 60/90 günlük
				  dilimler de bugün yapılacak bir işe karşılık gelmiyordu.
				-->
				<Grid ColumnDefinitions="340,*" ColumnSpacing="14">

					<!--
					  Tür dağılımı artık TIKLANABİLİR: bir türe basınca sözleşme listesi
					  o türe filtrelenmiş olarak açılıyor. Eskiden yalnızca sayı
					  gösteriyordu ve hiçbir aksiyona bağlanmıyordu.
					-->
					<Border Grid.Column="0" Classes="card" VerticalAlignment="Top"
							IsVisible="{Binding HasTypeBreakdown}">
						<StackPanel Spacing="12">
							<!--
							  Başlık "yürürlükteki" diyor çünkü sorgu yalnızca Aktif/Uyarı/İhlal
							  durumundakileri sayıyor. Yalnızca "TÜR DAĞILIMI" yazdığında, onay
							  zincirinde bekleyen bir sözleşmesini burada bulamayan kullanıcı
							  kartın çalışmadığını sanıyordu.
							-->
							<TextBlock Classes="cardTitle" Text="{Binding [Dash.TypeBreakdown], Source={x:Static loc:Strings.Current}}"/>
							<ItemsControl ItemsSource="{Binding TypeBreakdown}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:TypeBreakdownRowViewModel">
										<Button Classes="flat" HorizontalAlignment="Stretch"
												HorizontalContentAlignment="Stretch" Margin="0,0,0,8"
												ToolTip.Tip="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).TypeRowTooltip}"
												IsHitTestVisible="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).TypeRowsClickable}"
												Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).OpenTypeCommand}"
												CommandParameter="{Binding}">
											<StackPanel Spacing="4">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="{Binding Type}" FontSize="12"
															   Foreground="{DynamicResource TextBodyAlt}"/>
													<TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="12"
															   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
												</Grid>
												<!-- Çubuk, en yüksek değere oranlanır (0..1) -->
												<Border Background="{DynamicResource SurfaceDivider}" Height="6" CornerRadius="3">
													<Border Background="{DynamicResource AccentSolid}" Height="6" CornerRadius="3"
															HorizontalAlignment="Left"
															Width="{Binding BarRatio, Converter={x:Static vm:RatioToWidthConverter.Instance}, ConverterParameter=280}"/>
												</Border>
											</StackPanel>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>

					<StackPanel Grid.Column="1" Spacing="14">

						<Border Classes="card">
							<StackPanel Spacing="12">
								<TextBlock Classes="cardTitle" Text="{Binding [Dash.UpcomingEndings], Source={x:Static loc:Strings.Current}}"/>
								<TextBlock Text="{Binding [Dash.NoUpcoming], Source={x:Static loc:Strings.Current}}"
										   FontSize="12" Foreground="{DynamicResource TextFaint}"
										   IsVisible="{Binding !UpcomingEndings.Count}"/>
								<ItemsControl ItemsSource="{Binding UpcomingEndings}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:DashboardUpcomingRowViewModel">
											<Button Classes="flat" HorizontalAlignment="Stretch"
													HorizontalContentAlignment="Stretch" Margin="0,0,0,6"
													Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).OpenUpcomingCommand}"
													CommandParameter="{Binding}">
												<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
														CornerRadius="8" Padding="12,10">
													<Grid ColumnDefinitions="*,Auto">
														<StackPanel Grid.Column="0" Spacing="2">
															<TextBlock Text="{Binding Title}" FontSize="12.5"
																	   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
															<TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}">
																<Run Text="{Binding RefNoText}"/>
																<Run Text=" · "/>
																<Run Text="{Binding CompanyName}"/>
															</TextBlock>
														</StackPanel>
														<StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"
																	HorizontalAlignment="Right">
															<TextBlock Text="{Binding GunKalanText}"
																	   FontSize="11.5" FontWeight="SemiBold"
																	   Foreground="{DynamicResource WarningBase}"
																	   HorizontalAlignment="Right"/>

															<!--
															  Yenileme rozeti YALNIZCA yenilenmişlerde çıkar.
															  "Yenilenmedi" rozeti de denendi ama listedeki her
															  satırda kırmızı bir etiket belirdiği için gürültü
															  yapıyordu; rozetin yokluğu zaten "yenilenmedi"
															  anlamına geliyor.
															-->
															<Border Background="{DynamicResource SuccessSoftBgAlt2}" BorderBrush="{DynamicResource SuccessSoftBorderAlt}"
																	BorderThickness="1" CornerRadius="9"
																	Padding="8,2" HorizontalAlignment="Right"
																	IsVisible="{Binding IsRenewed}">
																<TextBlock Text="{Binding [Dash.Renewed], Source={x:Static loc:Strings.Current}}" FontSize="10"
																		   FontWeight="SemiBold" Foreground="{DynamicResource SuccessText}"/>
															</Border>
														</StackPanel>
													</Grid>
												</Border>
											</Button>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>

						<!--
						  Son aktiviteler kimin ne yaptığını isim isim gösterdiği için
						  "İşlem Geçmişi" ekranıyla aynı yetki sınırına tabidir: yalnızca Müdür.
						-->
						<Border Classes="card" IsVisible="{Binding ShowRecentActivity}">
							<StackPanel Spacing="12">
								<TextBlock Classes="cardTitle" Text="{Binding [Dash.RecentActivity], Source={x:Static loc:Strings.Current}}"/>
								<ItemsControl ItemsSource="{Binding RecentActivity}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:AuditLogRowViewModel">
											<Border BorderBrush="{DynamicResource SurfaceDivider}" BorderThickness="0,0,0,1" Padding="0,8">
												<Grid ColumnDefinitions="*,Auto">
													<StackPanel Grid.Column="0" Spacing="2">
														<TextBlock Text="{Binding ActionText}" FontSize="12.5"
																   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
														<TextBlock Text="{Binding DetailText}" FontSize="11"
																   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
													</StackPanel>
													<StackPanel Grid.Column="1" Spacing="2" Margin="12,0,0,0">
														<TextBlock Text="{Binding UserText}" FontSize="11"
																   Foreground="{DynamicResource TextBodyAlt}" HorizontalAlignment="Right"/>
														<TextBlock Text="{Binding ActionDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
																   FontSize="10.5" Foreground="{DynamicResource TextDisabled}"
																   HorizontalAlignment="Right"/>
													</StackPanel>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>

					</StackPanel>
				</Grid>

			</StackPanel>
		</StackPanel>
	</ScrollViewer>

</UserControl>
