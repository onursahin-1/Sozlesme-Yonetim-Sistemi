<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Sys.UI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

	<Design.DataContext>
		<vm:DashboardViewModel />
	</Design.DataContext>

	<ScrollViewer>
		<StackPanel Margin="20" Spacing="12">
			<TextBlock Text="Yükleniyor..." IsVisible="{Binding IsLoading}"/>

			<TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"
					   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

			<!-- Durum kartları: tıklanabilenler ilgili listeye o filtre uygulanmış şekilde götürür -->
			<UniformGrid Columns="4" IsVisible="{Binding !IsLoading}">
				<Button Background="#E6F4E7" CornerRadius="8" Margin="6" Padding="16" HorizontalAlignment="Stretch"
						Command="{Binding FilterCardCommand}" CommandParameter="aktif"
						IsEnabled="{Binding AktifCardClickable}">
					<Button.Styles>
						<Style Selector="Button:pointerover /template/ ContentPresenter">
							<Setter Property="Background" Value="#D2ECD4"/>
						</Style>
						<Style Selector="Button:disabled /template/ ContentPresenter">
							<Setter Property="Background" Value="#E6F4E7"/>
						</Style>
					</Button.Styles>
					<StackPanel HorizontalAlignment="Left">
						<TextBlock Text="Aktif" FontSize="12" Foreground="#555"/>
						<TextBlock Text="{Binding Aktif}" FontSize="28" FontWeight="Bold" Foreground="#1A6B2A"/>
					</StackPanel>
				</Button>
				<Button Background="#D6E9F8" CornerRadius="8" Margin="6" Padding="16" HorizontalAlignment="Stretch"
						Command="{Binding FilterCardCommand}" CommandParameter="onay_bekliyor"
						IsEnabled="{Binding OnayBekliyorCardClickable}">
					<Button.Styles>
						<Style Selector="Button:pointerover /template/ ContentPresenter">
							<Setter Property="Background" Value="#C2DFF3"/>
						</Style>
					</Button.Styles>
					<StackPanel HorizontalAlignment="Left">
						<TextBlock Text="Onay Bekliyor" FontSize="12" Foreground="#555"/>
						<TextBlock Text="{Binding OnayBekliyor}" FontSize="28" FontWeight="Bold" Foreground="#2D6EA8"/>
					</StackPanel>
				</Button>
				<Button Background="#FFF3CD" CornerRadius="8" Margin="6" Padding="16" HorizontalAlignment="Stretch"
						Command="{Binding FilterCardCommand}" CommandParameter="uyari"
						IsEnabled="{Binding UyariCardClickable}">
					<Button.Styles>
						<Style Selector="Button:pointerover /template/ ContentPresenter">
							<Setter Property="Background" Value="#FCE9AF"/>
						</Style>
						<Style Selector="Button:disabled /template/ ContentPresenter">
							<Setter Property="Background" Value="#FFF3CD"/>
						</Style>
					</Button.Styles>
					<StackPanel HorizontalAlignment="Left">
						<TextBlock Text="Bitiş Uyarısı" FontSize="12" Foreground="#555"/>
						<TextBlock Text="{Binding Uyari}" FontSize="28" FontWeight="Bold" Foreground="#B06A00"/>
					</StackPanel>
				</Button>
				<Button Background="#FDECEA" CornerRadius="8" Margin="6" Padding="16" HorizontalAlignment="Stretch"
						Command="{Binding FilterCardCommand}" CommandParameter="ihlal"
						IsEnabled="{Binding IhlalCardClickable}">
					<Button.Styles>
						<Style Selector="Button:pointerover /template/ ContentPresenter">
							<Setter Property="Background" Value="#FAD8D4"/>
						</Style>
						<Style Selector="Button:disabled /template/ ContentPresenter">
							<Setter Property="Background" Value="#FDECEA"/>
						</Style>
					</Button.Styles>
					<StackPanel HorizontalAlignment="Left">
						<TextBlock Text="İhlal" FontSize="12" Foreground="#555"/>
						<TextBlock Text="{Binding Ihlal}" FontSize="28" FontWeight="Bold" Foreground="#A32D2D"/>
					</StackPanel>
				</Button>
			</UniformGrid>

			<!-- Hızlı Aksiyonlar -->
			<ItemsControl ItemsSource="{Binding QuickActions}" IsVisible="{Binding !IsLoading}" Margin="0,4,0,0">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Horizontal" Spacing="8"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:DashboardQuickActionItem">
						<Button Content="{Binding Label}" Background="#2D6EA8" Foreground="White" Padding="12,6" CornerRadius="4"
								Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).QuickActionCommand}"
								CommandParameter="{Binding NavKey}">
							<Button.Styles>
								<Style Selector="Button:pointerover /template/ ContentPresenter">
									<Setter Property="Background" Value="#1F5686"/>
									<Setter Property="TextBlock.Foreground" Value="White"/>
								</Style>
							</Button.Styles>
						</Button>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<!-- Yaklaşan Bitişler -->
			<StackPanel Spacing="6" IsVisible="{Binding !IsLoading}">
				<TextBlock Text="Yaklaşan Bitişler (30 gün içinde)" FontWeight="Bold" FontSize="14" Margin="0,14,0,0"/>
				<TextBlock Text="Önümüzdeki 30 gün içinde sona erecek sözleşme yok." Foreground="Gray" FontSize="12"
						   IsVisible="{Binding !UpcomingEndings.Count}"/>
				<ItemsControl ItemsSource="{Binding UpcomingEndings}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:DashboardUpcomingRowViewModel">
							<Button HorizontalAlignment="Stretch" Background="White" BorderBrush="#D0D8E4" BorderThickness="1"
									CornerRadius="6" Padding="10,8" Margin="0,0,0,6"
									Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).OpenUpcomingCommand}"
									CommandParameter="{Binding}">
								<Button.Styles>
									<Style Selector="Button:pointerover /template/ ContentPresenter">
										<Setter Property="Background" Value="#F3F6FA"/>
									</Style>
								</Button.Styles>
								<Grid ColumnDefinitions="*,Auto">
									<StackPanel Grid.Column="0" HorizontalAlignment="Left">
										<TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" Foreground="Black"/>
										<TextBlock FontSize="11" Foreground="#888">
											<Run Text="{Binding RefNoText}"/>
											<Run Text=" · "/>
											<Run Text="{Binding CompanyName}"/>
										</TextBlock>
									</StackPanel>
									<TextBlock Grid.Column="1" Text="{Binding GunKalanText}" FontSize="11" Foreground="#B06A00" VerticalAlignment="Center"/>
								</Grid>
							</Button>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>

			<!-- Son Aktiviteler: yalnızca Müdür'de görünür ("İşlem Geçmişi" ekranıyla aynı sınır) -->
			<StackPanel Spacing="4" IsVisible="{Binding ShowRecentActivity}">
				<TextBlock Text="Son Aktiviteler" FontWeight="Bold" FontSize="14" Margin="0,14,0,0"/>
				<TextBlock Text="Henüz bir aktivite yok." Foreground="Gray" FontSize="12"
						   IsVisible="{Binding !RecentActivity.Count}"/>
				<ItemsControl ItemsSource="{Binding RecentActivity}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:AuditLogRowViewModel">
							<Grid ColumnDefinitions="Auto,*" Margin="0,0,0,4">
								<TextBlock Grid.Column="0" Text="{Binding DateText}" FontSize="11" Foreground="Gray" Margin="0,0,10,0" VerticalAlignment="Top"/>
								<TextBlock Grid.Column="1" FontSize="11" TextWrapping="Wrap">
									<Run Text="{Binding UserText}" FontWeight="Bold"/>
									<Run Text=" — "/>
									<Run Text="{Binding ActionText}"/>
								</TextBlock>
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</StackPanel>
	</ScrollViewer>

</UserControl>