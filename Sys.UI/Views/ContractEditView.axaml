<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Sys.UI.Localization"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:domain="using:Sys.Domain"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="760"
             x:Class="Sys.UI.Views.ContractEditView"
             x:DataType="vm:ContractEditViewModel">

	<UserControl.Styles>
		<!-- Form stilleri bu ekranla sınırlı; global TextBox stili diğer ekranları da değiştirirdi. -->
		<Style Selector="TextBlock.formLabel">
			<Setter Property="FontSize" Value="11.5"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextLabel}"/>
			<Setter Property="Margin" Value="0,0,0,5"/>
		</Style>

		<!--
		  Kutunun altındaki "Mevcut: …" satırı. Eskiden ekranda yalnızca boş "Yeni …"
		  kutuları vardı; kullanıcı neyi neyle değiştirdiğini görmeden yazıyordu.
		-->
		<Style Selector="TextBlock.currentValue">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
			<Setter Property="Margin" Value="2,5,0,0"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>

		<Style Selector="TextBox">
			<Setter Property="Padding" Value="11,9"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
			<Setter Property="Background" Value="{DynamicResource SurfaceInput}"/>
		</Style>
		<Style Selector="TextBox:focus">
			<Setter Property="Background" Value="{DynamicResource SurfaceInputFocus}"/>
		</Style>
		<Style Selector="ComboBox">
			<Setter Property="Padding" Value="11,8"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
			<Setter Property="Background" Value="{DynamicResource SurfaceInput}"/>
		</Style>
		<Style Selector="DatePicker">
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
			<Setter Property="Background" Value="{DynamicResource SurfaceInput}"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
		</Style>

		<Style Selector="TextBlock.summaryLabel">
			<Setter Property="FontSize" Value="9.5"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMutedAlt}"/>
			<Setter Property="LetterSpacing" Value="0.6"/>
		</Style>
		<Style Selector="TextBlock.summaryValue">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
	</UserControl.Styles>

	<!-- Solda form, sağda seçilen sözleşmenin mevcut künyesi ve gönder butonu -->
	<Grid ColumnSpacing="22" Margin="0,0,20,0">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" MinWidth="460"/>
			<ColumnDefinition Width="300"/>
		</Grid.ColumnDefinitions>

		<!-- ========== SOL: FORM ========== -->
		<ScrollViewer Grid.Column="0">
			<StackPanel Spacing="16" Margin="0,0,4,24">

				<!-- Bu ekranın en kritik bilgisi: değişiklik doğrudan uygulanmıyor -->
				<Border Background="{DynamicResource WarningSoftBg}" BorderBrush="{DynamicResource WarningSoftBorder}" BorderThickness="1"
						CornerRadius="10" Padding="16,13">
					<StackPanel Spacing="3">
						<TextBlock Text="{Binding [Edit.GoesToApproval], Source={x:Static loc:Strings.Current}}" FontSize="13"
								   FontWeight="SemiBold" Foreground="{DynamicResource WarningTextAlt}"/>
						<TextBlock Text="{Binding [Edit.ApprovalNotice], Source={x:Static loc:Strings.Current}}"
								   FontSize="11.5" Foreground="{DynamicResource WarningTextAlt}" TextWrapping="Wrap"/>
					</StackPanel>
				</Border>

				<Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
						Background="{DynamicResource DangerSoftBg}" BorderBrush="{DynamicResource DangerSoftBorder}" BorderThickness="1"
						CornerRadius="10" Padding="14,11">
					<TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerTextAlt}"
							   FontSize="12.5" TextWrapping="Wrap"/>
				</Border>

				<Border IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
						Background="{DynamicResource SuccessSoftBg}" BorderBrush="{DynamicResource SuccessSoftBorder}" BorderThickness="1"
						CornerRadius="10" Padding="14,11">
					<TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource SuccessBase}"
							   FontSize="12.5" TextWrapping="Wrap"/>
				</Border>

				<!-- ===== 1 · SÖZLEŞME VE DEĞİŞİKLİK TÜRÜ ===== -->
				<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
						CornerRadius="12" Padding="24,20">
					<StackPanel Spacing="18">

						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
							<Border Grid.Column="0" Width="26" Height="26" CornerRadius="8"
									Background="{DynamicResource WarningSolid}" VerticalAlignment="Center">
								<TextBlock Text="1" Foreground="{DynamicResource TextOnAccent}" FontSize="13" FontWeight="Bold"
										   HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
								<TextBlock Classes="display" Text="{Binding [Edit.TypeSection], Source={x:Static loc:Strings.Current}}" FontSize="15.5"
										   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
								<TextBlock Text="{Binding [Form.RequiredHint], Source={x:Static loc:Strings.Current}}" FontSize="11" Foreground="{DynamicResource TextFaintAlt}"/>
							</StackPanel>
						</Grid>
						<Border Background="{DynamicResource SurfaceDivider}" Height="1"/>

						<StackPanel>
							<TextBlock Classes="formLabel">
								<Run Text="{Binding [Edit.Contract], Source={x:Static loc:Strings.Current}}"/>
								<Run Text=" *" Foreground="{DynamicResource DangerText}"/>
							</TextBlock>
							<ComboBox HorizontalAlignment="Stretch"
									  ItemsSource="{Binding AvailableContracts}"
									  SelectedItem="{Binding SelectedContract}"
									  PlaceholderText="{Binding [Edit.PickerPlaceholder], Source={x:Static loc:Strings.Current}}">
								<ComboBox.ItemTemplate>
									<DataTemplate x:DataType="domain:Contract">
										<TextBlock TextTrimming="CharacterEllipsis">
											<Run Text="{Binding Title}"/>
											<Run Text="  ·  " Foreground="{DynamicResource TextFaintAlt}"/>
											<Run Text="{Binding CompanyName}" Foreground="{DynamicResource TextMuted}"/>
										</TextBlock>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
							<TextBlock Classes="fieldError" Text="{Binding ContractError}"
									   IsVisible="{Binding ContractError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
							<TextBlock Classes="currentValue" Text="{Binding [Edit.NoEligible], Source={x:Static loc:Strings.Current}}"
									   IsVisible="{Binding !AvailableContracts.Count}"/>
						</StackPanel>

						<StackPanel IsVisible="{Binding SelectedContract, Converter={x:Static ObjectConverters.IsNotNull}}">
							<TextBlock Classes="formLabel">
								<Run Text="{Binding [Edit.WhatChanges], Source={x:Static loc:Strings.Current}}"/>
								<Run Text=" *" Foreground="{DynamicResource DangerText}"/>
							</TextBlock>
							<ComboBox HorizontalAlignment="Stretch"
									  ItemsSource="{Binding ChangeTypes}"
									  SelectedItem="{Binding SelectedChangeType}"/>
						</StackPanel>

						<StackPanel IsVisible="{Binding SelectedContract, Converter={x:Static ObjectConverters.IsNotNull}}">
							<TextBlock Classes="formLabel">
								<Run Text="{Binding [Edit.Reason], Source={x:Static loc:Strings.Current}}"/>
								<Run Text=" *" Foreground="{DynamicResource DangerText}"/>
							</TextBlock>
							<TextBox Text="{Binding Reason}" AcceptsReturn="True" Height="100" TextWrapping="Wrap"
									 AcceptsTab="False"
									 PlaceholderText="{Binding [Edit.ReasonPlaceholder], Source={x:Static loc:Strings.Current}}"/>
							<TextBlock Classes="fieldError" Text="{Binding ReasonError}"
									   IsVisible="{Binding ReasonError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- ===== 2 · YENİ DEĞERLER ===== -->
				<Border IsVisible="{Binding SelectedContract, Converter={x:Static ObjectConverters.IsNotNull}}"
						Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
						CornerRadius="12" Padding="24,20">
					<StackPanel Spacing="18">

						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
							<Border Grid.Column="0" Width="26" Height="26" CornerRadius="8"
									Background="{DynamicResource WarningSolid}" VerticalAlignment="Center">
								<TextBlock Text="2" Foreground="{DynamicResource TextOnAccent}" FontSize="13" FontWeight="Bold"
										   HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
								<TextBlock Classes="display" Text="{Binding [Edit.NewValues], Source={x:Static loc:Strings.Current}}" FontSize="15.5"
										   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
								<TextBlock Text="{Binding [Edit.OnlyChangedHint], Source={x:Static loc:Strings.Current}}"
										   FontSize="11" Foreground="{DynamicResource TextFaintAlt}"/>
							</StackPanel>
						</Grid>
						<Border Background="{DynamicResource SurfaceDivider}" Height="1"/>

						<Grid ColumnDefinitions="*,*" ColumnSpacing="18">
							<StackPanel Grid.Column="0">
								<TextBlock Classes="formLabel" Text="{Binding NewAmountLabel}"/>
								<TextBox Text="{Binding NewTotalAmountText}" PlaceholderText="{Binding [Req.AmountPlaceholder], Source={x:Static loc:Strings.Current}}"
										 LostFocus="OnAmountLostFocus" TextChanged="OnAmountTextChanged"/>
								<TextBlock Classes="fieldError" Text="{Binding AmountError}"
										   IsVisible="{Binding AmountError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
								<TextBlock Classes="currentValue">
									<Run Text="{Binding [Edit.Current], Source={x:Static loc:Strings.Current}}"/>
									<Run Text="{Binding CurrentAmountText}" FontWeight="SemiBold"/>
								</TextBlock>
							</StackPanel>
							<StackPanel Grid.Column="1">
								<TextBlock Classes="formLabel" Text="{Binding [Edit.NewEndDate], Source={x:Static loc:Strings.Current}}"/>
								<DatePicker SelectedDate="{Binding NewEndDate}"/>
								<TextBlock Classes="currentValue">
									<Run Text="{Binding [Edit.Current], Source={x:Static loc:Strings.Current}}"/>
									<Run Text="{Binding CurrentEndText}" FontWeight="SemiBold"/>
								</TextBlock>
							</StackPanel>
						</Grid>

						<StackPanel>
							<TextBlock Classes="formLabel" Text="{Binding [Edit.NewScope], Source={x:Static loc:Strings.Current}}"/>
							<TextBox Text="{Binding NewDescription}" AcceptsReturn="True" Height="80"
									 TextWrapping="Wrap" AcceptsTab="False"/>
							<TextBlock Classes="currentValue">
								<Run Text="{Binding [Edit.Current], Source={x:Static loc:Strings.Current}}"/>
								<Run Text="{Binding CurrentDescription}"/>
							</TextBlock>
						</StackPanel>

						<Grid ColumnDefinitions="*,*" ColumnSpacing="18">
							<StackPanel Grid.Column="0">
								<TextBlock Classes="formLabel" Text="{Binding [Edit.NewCompany], Source={x:Static loc:Strings.Current}}"/>
								<TextBox Text="{Binding NewCompanyName}"/>
								<TextBlock Classes="currentValue">
									<Run Text="{Binding [Edit.Current], Source={x:Static loc:Strings.Current}}"/>
									<Run Text="{Binding CurrentCompanyName}" FontWeight="SemiBold"/>
								</TextBlock>
							</StackPanel>
							<StackPanel Grid.Column="1">
								<TextBlock Classes="formLabel" Text="{Binding [Edit.NewTaxNo], Source={x:Static loc:Strings.Current}}"/>
								<TextBox Text="{Binding NewTaxNo}" MaxLength="10"/>
								<TextBlock Classes="currentValue">
									<Run Text="{Binding [Edit.Current], Source={x:Static loc:Strings.Current}}"/>
									<Run Text="{Binding CurrentTaxNo}" FontWeight="SemiBold"/>
								</TextBlock>
							</StackPanel>
						</Grid>

						<StackPanel>
							<TextBlock Classes="formLabel" Text="{Binding [Edit.NewPaymentTerms], Source={x:Static loc:Strings.Current}}"/>
							<TextBox Text="{Binding NewPaymentPeriod}"/>
							<TextBlock Classes="currentValue">
								<Run Text="{Binding [Edit.Current], Source={x:Static loc:Strings.Current}}"/>
								<Run Text="{Binding CurrentPaymentPeriod}" FontWeight="SemiBold"/>
							</TextBlock>
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- ===== 3 · EK BELGE ===== -->
				<Border IsVisible="{Binding SelectedContract, Converter={x:Static ObjectConverters.IsNotNull}}"
						Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
						CornerRadius="12" Padding="24,20">
					<StackPanel Spacing="16">

						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
							<Border Grid.Column="0" Width="26" Height="26" CornerRadius="8"
									Background="{DynamicResource WarningSolid}" VerticalAlignment="Center">
								<TextBlock Text="3" Foreground="{DynamicResource TextOnAccent}" FontSize="13" FontWeight="Bold"
										   HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
								<TextBlock Classes="display" Text="{Binding [Edit.SupportingDoc], Source={x:Static loc:Strings.Current}}" FontSize="15.5"
										   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
								<TextBlock Text="{Binding [Edit.SupportingHint], Source={x:Static loc:Strings.Current}}"
										   FontSize="11" Foreground="{DynamicResource TextFaintAlt}"/>
							</StackPanel>
						</Grid>

						<Border IsVisible="{Binding SelectedFileName, Converter={x:Static StringConverters.IsNullOrEmpty}}"
								Background="{DynamicResource SurfaceInputAlt}" BorderBrush="{DynamicResource BorderInput}" BorderThickness="1"
								CornerRadius="10" Padding="24,20">
							<StackPanel Spacing="12" HorizontalAlignment="Center">
								<Path Stroke="{DynamicResource TextDisabledSoft}" StrokeThickness="1.6" Fill="Transparent"
									  Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center"
									  Data="M12 16V4M12 4L7.5 8.5M12 4l4.5 4.5M4 16v2.5A1.5 1.5 0 0 0 5.5 20h13a1.5 1.5 0 0 0 1.5-1.5V16"/>
								<Button Classes="flat" HorizontalAlignment="Center" Click="OnPickFileClick">
									<Border Background="{DynamicResource SurfaceButton}" BorderBrush="{DynamicResource BorderStrongAlt}" BorderThickness="1"
											CornerRadius="8" Padding="18,9">
										<TextBlock Text="{Binding [Form.ChooseFile], Source={x:Static loc:Strings.Current}}" Foreground="{DynamicResource TextBody}" FontSize="12.5"
												   FontWeight="SemiBold"/>
									</Border>
								</Button>
							</StackPanel>
						</Border>

						<Border IsVisible="{Binding SelectedFileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
								Background="{DynamicResource SurfaceSubtleBlue}" BorderBrush="{DynamicResource AccentSoftBorder}" BorderThickness="1"
								CornerRadius="10" Padding="14,12">
							<Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
								<Path Grid.Column="0" Stroke="{DynamicResource AccentBase}" StrokeThickness="1.8" Fill="Transparent"
									  Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center"
									  Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6"/>
								<TextBlock Grid.Column="1" Text="{Binding SelectedFileName}" FontSize="12.5"
										   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
										   TextTrimming="CharacterEllipsis"/>
								<Button Grid.Column="2" Classes="flat" Click="OnPickFileClick" VerticalAlignment="Center">
									<TextBlock Text="{Binding [Form.Change], Source={x:Static loc:Strings.Current}}" Foreground="{DynamicResource AccentBase}" FontSize="11.5"/>
								</Button>
								<Button Grid.Column="3" Classes="flat" Command="{Binding ClearFileCommand}" VerticalAlignment="Center">
									<TextBlock Text="{Binding [Form.Remove], Source={x:Static loc:Strings.Current}}" Foreground="{DynamicResource DangerBase}" FontSize="11.5"/>
								</Button>
							</Grid>
						</Border>
					</StackPanel>
				</Border>

			</StackPanel>
		</ScrollViewer>

		<!-- ========== SAĞ: MEVCUT KÜNYE + GÖNDER ========== -->
		<ScrollViewer Grid.Column="1">
			<StackPanel Spacing="14" Margin="0,0,0,24">

				<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
						CornerRadius="12" Padding="18,16">
					<StackPanel Spacing="14">
						<TextBlock Classes="sectionLabel" Text="{Binding [Edit.CurrentContract], Source={x:Static loc:Strings.Current}}"/>

						<StackPanel IsVisible="{Binding SelectedContract, Converter={x:Static ObjectConverters.IsNotNull}}"
									Spacing="14">
							<StackPanel Spacing="2">
								<TextBlock Classes="summaryValue" Text="{Binding CurrentTitle}" FontWeight="SemiBold"/>
								<TextBlock FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap">
									<Run Text="{Binding CurrentNo}"/>
									<Run Text="  ·  "/>
									<Run Text="{Binding CurrentCompany}"/>
								</TextBlock>
							</StackPanel>

							<Border Background="{DynamicResource SurfaceDivider}" Height="1"/>

							<StackPanel Spacing="3">
								<TextBlock Classes="summaryLabel" Text="{Binding [List.ColAmount], Source={x:Static loc:Strings.Current}}"/>
								<TextBlock Classes="display" Text="{Binding CurrentAmountText}" FontSize="19"
										   FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
							</StackPanel>

							<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
								<StackPanel Grid.Column="0" Spacing="3">
									<TextBlock Classes="summaryLabel" Text="{Binding [Field.StartDate], Source={x:Static loc:Strings.Current}}"/>
									<TextBlock Text="{Binding CurrentStartText}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"/>
								</StackPanel>
								<StackPanel Grid.Column="1" Spacing="3">
									<TextBlock Classes="summaryLabel" Text="{Binding [Field.EndDate], Source={x:Static loc:Strings.Current}}"/>
									<TextBlock Text="{Binding CurrentEndText}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"/>
								</StackPanel>
							</Grid>

							<StackPanel Spacing="3">
								<TextBlock Classes="summaryLabel" Text="{Binding [Edit.PaymentTerms], Source={x:Static loc:Strings.Current}}"/>
								<TextBlock Text="{Binding CurrentPaymentPeriod}" FontSize="12.5"
										   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
							</StackPanel>
						</StackPanel>

						<TextBlock Text="{Binding [Edit.PickFromLeft], Source={x:Static loc:Strings.Current}}" FontSize="12.5" Foreground="{DynamicResource TextDisabledAlt}"
								   IsVisible="{Binding SelectedContract, Converter={x:Static ObjectConverters.IsNull}}"/>
					</StackPanel>
				</Border>

				<Button Classes="flat" HorizontalAlignment="Stretch"
						IsVisible="{Binding SelectedContract, Converter={x:Static ObjectConverters.IsNotNull}}"
						IsEnabled="{Binding !IsBusy}" Command="{Binding SubmitCommand}">
					<Border Background="{DynamicResource WarningSolid}" CornerRadius="9" Padding="18,12">
						<TextBlock Text="{Binding [Edit.Submit], Source={x:Static loc:Strings.Current}}" Foreground="{DynamicResource TextOnAccent}" FontSize="13"
								   FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap"
								   TextAlignment="Center"/>
					</Border>
				</Button>

			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
