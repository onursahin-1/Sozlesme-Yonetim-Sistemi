<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:conv="using:Sys.UI.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="Sys.UI.Views.ContractListView"
             x:DataType="vm:ContractListViewModel">

	<Design.DataContext>
		<vm:ContractListViewModel />
	</Design.DataContext>

	<UserControl.Styles>
		<!--
		  ListBox'ın kendi öğe kabı (ListBoxItem) varsayılan olarak dolgu, kenarlık ve
		  seçim vurgusu çiziyor; kartların etrafında ikinci bir çerçeve gibi duruyordu.
		  Kart zaten görsel birim olduğu için kap tamamen şeffaf ve dolgusuz yapılıyor.
		-->
		<Style Selector="ListBox">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="0"/>
		</Style>
		<Style Selector="ListBoxItem">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="ListBoxItem /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="CornerRadius" Value="10"/>
		</Style>
		<Style Selector="ListBoxItem:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>

		<!-- Kart içindeki küçük ölçü etiketleri (TÜR / BEDEL / KALAN) -->
		<Style Selector="TextBlock.metricLabel">
			<Setter Property="FontSize" Value="9.5"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextFaintAlt}"/>
			<Setter Property="LetterSpacing" Value="0.6"/>
		</Style>
		<Style Selector="TextBlock.metricValue">
			<Setter Property="FontSize" Value="12.5"/>
			<Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
		</Style>
	</UserControl.Styles>

	<DockPanel>

		<!-- Araç çubuğu: arama solda esner, yenile sağda sabit -->
		<Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,0,12">
			<Border Grid.Column="0" Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderButton}" BorderThickness="1"
					CornerRadius="8" MaxWidth="460" HorizontalAlignment="Left">
				<Grid ColumnDefinitions="Auto,*">
					<!-- Arama ikonu: vektör, her ortamda aynı çizilir -->
					<Path Grid.Column="0" Stroke="{DynamicResource TextFaintAlt}" StrokeThickness="2" Fill="Transparent"
						  Width="14" Height="14" Stretch="Uniform" Margin="12,0,0,0"
						  VerticalAlignment="Center"
						  Data="M11 11L15 15M12.5 7.5A5 5 0 1 1 2.5 7.5a5 5 0 0 1 10 0z"/>
					<TextBox Grid.Column="1" Text="{Binding SearchText}"
							 PlaceholderText="Başlık, firma veya sözleşme numarasına göre ara..."
							 Background="Transparent" BorderThickness="0"
							 Padding="10,9" FontSize="12.5"/>
				</Grid>
			</Border>

			<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

				<!--
				  Tür filtresi. Durum filtresi butonlarından AYRI bir boyut olduğu için
				  onların yanında değil, sağdaki araç çubuğunda duruyor. Seçenekler
				  veriden geliyor; sabit liste kullanılsaydı serbest metin olarak
				  girilmiş bir tür filtreyle hiç bulunamazdı.
				-->
				<ComboBox ItemsSource="{Binding TypeOptions}"
						  SelectedItem="{Binding SelectedType}"
						  MinWidth="150" FontSize="12.5" Padding="12,8"
						  CornerRadius="8" BorderBrush="{DynamicResource BorderButton}"
						  ToolTip.Tip="Sözleşme türüne göre filtrele"/>

				<!--
				  Ekrandaki filtreler aynen uygulanır ama görünen sayfa değil, eşleşen
				  TÜM kayıtlar aktarılır — aktarmanın amacı analiz.
				-->
				<Button Classes="flat" Click="OnExportExcelClick" IsEnabled="{Binding !IsBusy}"
						ToolTip.Tip="Filtrelenmiş listeyi Excel dosyası olarak kaydeder">
					<Border Background="{DynamicResource SuccessSoftBgAlt}" BorderBrush="{DynamicResource SuccessSoftBorder}" BorderThickness="1"
							CornerRadius="8" Padding="12,9">
						<StackPanel Orientation="Horizontal" Spacing="7">
							<Path Stroke="{DynamicResource SuccessBase}" StrokeThickness="1.8" Fill="Transparent"
								  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"
								  Data="M12 3v12M12 15l-4.5-4.5M12 15l4.5-4.5M4 17v2.5A1.5 1.5 0 0 0 5.5 21h13a1.5 1.5 0 0 0 1.5-1.5V17"/>
							<TextBlock Text="Excel" Foreground="{DynamicResource SuccessBase}" FontSize="12.5"
									   FontWeight="SemiBold" VerticalAlignment="Center"/>
						</StackPanel>
					</Border>
				</Button>

				<Button Classes="flat" Command="{Binding RefreshCommand}"
						ToolTip.Tip="Listeyi yenile">
					<Border Background="{DynamicResource SurfaceButton}" BorderBrush="{DynamicResource BorderButton}" BorderThickness="1"
							CornerRadius="8" Padding="12,9">
						<StackPanel Orientation="Horizontal" Spacing="7">
							<Path Stroke="{DynamicResource TextBodyAlt}" StrokeThickness="1.8" Fill="Transparent"
								  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"
								  Data="M20 11a8 8 0 1 1-2.3-5.7M20 4v5h-5"/>
							<TextBlock Text="Yenile" Foreground="{DynamicResource TextBody}" FontSize="12.5" VerticalAlignment="Center"/>
						</StackPanel>
					</Border>
				</Button>
			</StackPanel>
		</Grid>

		<!-- Filtre hapları: seçili olan koyu mavi zeminle vurgulanır -->
		<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,14">
			<Button Classes="flat" Command="{Binding SetFilterCommand}" CommandParameter="tumu">
				<Border CornerRadius="16" Padding="15,7"
						Background="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Background}, ConverterParameter=tumu}">
					<TextBlock Text="Tümü" FontSize="12" FontWeight="SemiBold"
							   Foreground="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Foreground}, ConverterParameter=tumu}"/>
				</Border>
			</Button>
			<Button Classes="flat" Command="{Binding SetFilterCommand}" CommandParameter="aktif">
				<Border CornerRadius="16" Padding="15,7"
						Background="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Background}, ConverterParameter=aktif}">
					<TextBlock Text="Aktif" FontSize="12" FontWeight="SemiBold"
							   Foreground="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Foreground}, ConverterParameter=aktif}"/>
				</Border>
			</Button>
			<Button Classes="flat" Command="{Binding SetFilterCommand}" CommandParameter="onay_bekliyor">
				<Border CornerRadius="16" Padding="15,7"
						Background="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Background}, ConverterParameter=onay_bekliyor}">
					<TextBlock Text="Onay Bekliyor" FontSize="12" FontWeight="SemiBold"
							   Foreground="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Foreground}, ConverterParameter=onay_bekliyor}"/>
				</Border>
			</Button>
			<Button Classes="flat" Command="{Binding SetFilterCommand}" CommandParameter="uyari">
				<Border CornerRadius="16" Padding="15,7"
						Background="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Background}, ConverterParameter=uyari}">
					<TextBlock Text="Uyarı" FontSize="12" FontWeight="SemiBold"
							   Foreground="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Foreground}, ConverterParameter=uyari}"/>
				</Border>
			</Button>
			<Button Classes="flat" Command="{Binding SetFilterCommand}" CommandParameter="ihlal">
				<Border CornerRadius="16" Padding="15,7"
						Background="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Background}, ConverterParameter=ihlal}">
					<TextBlock Text="İhlal" FontSize="12" FontWeight="SemiBold"
							   Foreground="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Foreground}, ConverterParameter=ihlal}"/>
				</Border>
			</Button>

			<!-- Kapatılmış talepler "Tümü"de gizli; yalnızca bu filtreyle görünürler. -->
			<Button Classes="flat" Command="{Binding SetFilterCommand}" CommandParameter="reddedildi">
				<Border CornerRadius="16" Padding="15,7"
						Background="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Background}, ConverterParameter=reddedildi}">
					<TextBlock Text="Reddedilen" FontSize="12" FontWeight="SemiBold"
							   Foreground="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Foreground}, ConverterParameter=reddedildi}"/>
				</Border>
			</Button>

			<Button Classes="flat" Command="{Binding ClearFiltersCommand}"
					IsVisible="{Binding HasActiveFilters}" Margin="4,0,0,0">
				<TextBlock Text="Filtreleri temizle" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
						   VerticalAlignment="Center"/>
			</Button>
		</StackPanel>

		<TextBlock DockPanel.Dock="Top" Text="Yükleniyor..." Foreground="Gray" IsVisible="{Binding IsLoading}"/>
		<TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

		<StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,40,0,0" IsVisible="{Binding IsEmpty}">
			<TextBlock Text="Bu filtrelerle eşleşen sözleşme bulunamadı." Foreground="{DynamicResource TextMuted}"
					   FontSize="13" HorizontalAlignment="Center"/>
			<Button Classes="flat" HorizontalAlignment="Center" Command="{Binding ClearFiltersCommand}"
					IsVisible="{Binding HasActiveFilters}">
				<Border Background="{DynamicResource SurfaceButton}" BorderBrush="{DynamicResource BorderButton}" BorderThickness="1"
						CornerRadius="8" Padding="14,7">
					<TextBlock Text="Filtreleri temizle" Foreground="{DynamicResource TextBody}" FontSize="12"/>
				</Border>
			</Button>
		</StackPanel>

		<!-- Sayfalama çubuğu: yalnızca tek sayfaya sığmayan sonuçlarda görünür -->
		<Border DockPanel.Dock="Bottom" IsVisible="{Binding ShowPager}" Margin="0,14,0,0">
			<StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
				<Button Classes="flat" IsEnabled="{Binding CanGoPrevious}" Command="{Binding PreviousPageCommand}">
					<Border Background="{DynamicResource SurfaceButton}" BorderBrush="{DynamicResource BorderButton}" BorderThickness="1"
							CornerRadius="8" Padding="14,7">
						<TextBlock Text="‹ Önceki" Foreground="{DynamicResource TextBody}" FontSize="12"/>
					</Border>
				</Button>
				<TextBlock Text="{Binding PageInfoText}" VerticalAlignment="Center"
						   FontSize="12" Foreground="{DynamicResource TextMuted}"/>
				<Button Classes="flat" IsEnabled="{Binding CanGoNext}" Command="{Binding NextPageCommand}">
					<Border Background="{DynamicResource SurfaceButton}" BorderBrush="{DynamicResource BorderButton}" BorderThickness="1"
							CornerRadius="8" Padding="14,7">
						<TextBlock Text="Sonraki ›" Foreground="{DynamicResource TextBody}" FontSize="12"/>
					</Border>
				</Button>
			</StackPanel>
		</Border>

		<!--
		  Kart düzeni üç bölgeye ayrıldı: solda kimlik (başlık/no/firma), ortada ölçüler
		  (tür, bedel, kalan gün), sağda durum ve aksiyonlar. Eskiden her şey sola
		  yığılıyor, geniş ekranda kartın sağı bomboş kalıyordu; ölçüler de etiketsiz
		  yan yana durduğu için hangi sayının ne olduğu belli olmuyordu.
		-->
		<ListBox ItemsSource="{Binding FilteredContracts}"
                 SelectedItem="{Binding SelectedContract}"
                 IsVisible="{Binding !IsLoading}">
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="vm:ContractCardViewModel">
					<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
							CornerRadius="10" Padding="16,14" Margin="0,0,0,8">
						<StackPanel Spacing="0">
							<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="20">

								<!-- Kimlik -->
								<StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
									<TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5"
											   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
									<TextBlock FontSize="11.5" Foreground="{DynamicResource TextMuted}">
										<Run Text="{Binding RefNoText}"/>
										<Run Text="  ·  "/>
										<Run Text="{Binding CompanyName}"/>
									</TextBlock>
								</StackPanel>

								<!-- Ölçüler -->
								<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="26"
											VerticalAlignment="Center">
									<StackPanel Spacing="2">
										<TextBlock Classes="metricLabel" Text="TÜR"/>
										<TextBlock Classes="metricValue" Text="{Binding Type}"/>
									</StackPanel>
									<StackPanel Spacing="2">
										<TextBlock Classes="metricLabel" Text="BEDEL"/>
										<TextBlock Classes="metricValue" Text="{Binding BedelText}"
												   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
									</StackPanel>
									<StackPanel Spacing="2">
										<TextBlock Classes="metricLabel" Text="KALAN"/>
										<TextBlock Classes="metricValue" Text="{Binding GunKalanText}"/>
									</StackPanel>
								</StackPanel>

								<!-- Durum + aksiyonlar -->
								<StackPanel Grid.Column="2" Spacing="10" HorizontalAlignment="Right"
											VerticalAlignment="Center">
									<Border Background="{Binding StatusBgHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}" CornerRadius="10" Padding="10,3"
											HorizontalAlignment="Right">
										<TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
												   FontSize="10.5" FontWeight="Bold"/>
									</Border>

									<StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right">
										<Button Classes="flat"
												Command="{Binding $parent[UserControl].((vm:ContractListViewModel)DataContext).ViewDetailsCommand}"
												CommandParameter="{Binding}">
											<Border Background="{DynamicResource SurfaceButton}" BorderBrush="{DynamicResource BorderButton}" BorderThickness="1"
													CornerRadius="6" Padding="12,5">
												<TextBlock Text="Detay" Foreground="{DynamicResource TextBody}" FontSize="11.5"/>
											</Border>
										</Button>
										<Button Classes="flat" IsVisible="{Binding IsEditable}"
												Command="{Binding $parent[UserControl].((vm:ContractListViewModel)DataContext).EditRequestCommand}"
												CommandParameter="{Binding}">
											<Border Background="{DynamicResource AccentSolid}" CornerRadius="6" Padding="12,5">
												<TextBlock Text="Düzenle" Foreground="{DynamicResource TextOnAccent}" FontSize="11.5"/>
											</Border>
										</Button>
										<Button Classes="flat" IsVisible="{Binding CanRejectRequest}"
												Click="OnRejectRequestClick">
											<Border Background="{DynamicResource DangerSoftBg}" BorderBrush="{DynamicResource DangerSoftBorder}" BorderThickness="1"
													CornerRadius="6" Padding="12,5">
												<TextBlock Text="Talebi Reddet" Foreground="{DynamicResource DangerBase}" FontSize="11.5"/>
											</Border>
										</Button>
										<Button Classes="flat" IsVisible="{Binding NeedsContractCreation}"
												Command="{Binding $parent[UserControl].((vm:ContractListViewModel)DataContext).RequestContractCreationCommand}"
												CommandParameter="{Binding}">
											<Border Background="{DynamicResource ProcessSolid}" CornerRadius="6" Padding="12,5">
												<TextBlock Text="Sözleşme Yarat" Foreground="{DynamicResource TextOnAccent}" FontSize="11.5"/>
											</Border>
										</Button>
										<Button Classes="flat" IsVisible="{Binding NeedsSybSonKontrol}"
												Command="{Binding $parent[UserControl].((vm:ContractListViewModel)DataContext).RequestSonKontrolCommand}"
												CommandParameter="{Binding}">
											<Border Background="{DynamicResource WarningSolid}" CornerRadius="6" Padding="12,5">
												<TextBlock Text="Son Kontrol'e Git" Foreground="{DynamicResource TextOnAccent}" FontSize="11.5"/>
											</Border>
										</Button>
									</StackPanel>
								</StackPanel>
							</Grid>

							<!-- Red gerekçesi yalnızca reddedilmiş taleplerde görünür -->
							<Border IsVisible="{Binding IsRejected}" Margin="0,12,0,0"
									Background="{DynamicResource DangerSoftBgFaint2}" BorderBrush="{DynamicResource DangerSoftBorder}" BorderThickness="1"
									CornerRadius="6" Padding="11,8">
								<TextBlock Text="{Binding RejectionNoteText}" FontSize="11.5"
										   Foreground="{DynamicResource DangerTextAlt}" TextWrapping="Wrap"/>
							</Border>
						</StackPanel>
					</Border>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</DockPanel>

</UserControl>
