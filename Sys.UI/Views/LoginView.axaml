<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Sys.UI.Localization"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Sys.UI.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <Design.DataContext>
        <vm:LoginViewModel />
    </Design.DataContext>

    <!--
      Giriş ekranı — sıcak nötr palet (mavi yok).
      Grafit (#1B1A18) marka paneli, kum tonu (#FAF8F4) form zemini, vurgu için
      kehribar (#C8952A). Renk yerine tipografi ve boşlukla hiyerarşi kuruluyor;
      logo siyah-beyaz olduğu için bu palet onunla çakışmıyor, tamamlıyor.
    -->
    <!-- Sol panel oransal: dar ekranda daralır, geniş ekranda büyür.
         Sabit 400 px, geniş monitörde küçücük bir şerit gibi kalıyordu. -->
    <Grid ColumnDefinitions="34*,66*">

        <!-- Sol: marka paneli -->
        <Border Grid.Column="0" MinWidth="360" Background="{DynamicResource ShellBg}">
            <Grid RowDefinitions="*,Auto">

                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="40,0" Spacing="30">

                    <!--
                      Logo beyaz ve şeffaf arka planlı olduğu için doğrudan koyu zeminin
                      üzerine konuyor; arkasına beyaz kart koymak gerekmiyor, hatta
                      koymamak daha temiz duruyor.
                    -->
                    <Image Source="avares://Sys.UI/Assets/fakir-logo-white.png"
                           Width="270" Stretch="Uniform" HorizontalAlignment="Center"/>

                    <StackPanel Spacing="18" HorizontalAlignment="Center">
                        <Border Background="{DynamicResource WarningBright}" Height="2" Width="48" HorizontalAlignment="Center"/>
                        <TextBlock Classes="display" Text="{Binding [Login.BrandTitle], Source={x:Static loc:Strings.Current}}"
                                   Foreground="{DynamicResource ShellTextBright}" FontSize="29" FontWeight="SemiBold"
                                   LineHeight="40" LetterSpacing="1.5"
                                   TextAlignment="Center" HorizontalAlignment="Center"/>
                    </StackPanel>

                </StackPanel>

                <TextBlock Grid.Row="1" Text="Fakir Hausgeräte" Foreground="{DynamicResource LoginBrandFooter}"
                           FontSize="11" LetterSpacing="0.5"
                           HorizontalAlignment="Center" Margin="0,0,0,32"/>
            </Grid>
        </Border>

        <!-- Sağ: giriş formu -->
        <Border Grid.Column="1" Background="{DynamicResource LoginFormBg}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Width="340" Spacing="16">

                <StackPanel Spacing="6" Margin="0,0,0,8">
                    <TextBlock Classes="display" Text="{Binding [Login.Welcome], Source={x:Static loc:Strings.Current}}" FontSize="28" FontWeight="SemiBold"
                               Foreground="{DynamicResource LoginFormText}" LetterSpacing="-0.4"/>
                    <TextBlock Text="{Binding [Login.Subtitle], Source={x:Static loc:Strings.Current}}"
                               FontSize="13" Foreground="{DynamicResource LoginFormMuted}"/>
                </StackPanel>

                <StackPanel Spacing="7">
                    <TextBlock Text="{Binding [Login.Username], Source={x:Static loc:Strings.Current}}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource LoginFormLabel}"/>
                    <TextBox x:Name="UsernameBox" Text="{Binding Username}" KeyDown="OnCredentialKeyDown"
                             Background="{DynamicResource LoginInputBg}" Foreground="{DynamicResource LoginFormText}"
                             BorderBrush="{DynamicResource LoginFormBorder}" BorderThickness="1" CornerRadius="6"
                             Padding="12,10" FontSize="13"
                             PlaceholderText="{Binding [Login.UsernamePlaceholder], Source={x:Static loc:Strings.Current}}"/>
                </StackPanel>

                <StackPanel Spacing="7">
                    <!--
                      Caps Lock uyarısı etiketin sağında, satır içinde duruyor: ayrı bir
                      kutu olarak altta gösterildiğinde formu aşağı itiyor ve gereğinden
                      fazla dikkat çekiyordu. Burada alanın kendi başlığıyla aynı hizada,
                      sadece kutu odaktayken ve kilit açıkken beliriyor.
                    -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding [Login.Password], Source={x:Static loc:Strings.Current}}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource LoginFormLabel}"/>
                        <StackPanel Grid.Column="1" x:Name="CapsLockWarning" IsVisible="False"
                                    Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <Path Fill="{DynamicResource DangerBase}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Data="M12 3L19 10.5H15.5V15H8.5V10.5H5ZM8.5 17.5H15.5V21H8.5Z"/>
                            <TextBlock Text="{Binding [Login.CapsLock], Source={x:Static loc:Strings.Current}}" FontSize="11" Foreground="{DynamicResource DangerBase}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="PasswordBox"
                             Text="{Binding Password}" PasswordChar="•" KeyDown="OnCredentialKeyDown"
                             KeyUp="OnPasswordKeyUp" GotFocus="OnPasswordFocusChanged"
                             Background="{DynamicResource LoginInputBg}" Foreground="{DynamicResource LoginFormText}"
                             BorderBrush="{DynamicResource LoginFormBorder}" BorderThickness="1" CornerRadius="6"
                             Padding="12,10" FontSize="13"
                             PlaceholderText="••••••••"/>
                </StackPanel>

                <Border Background="{DynamicResource DangerSoftBgFaint4}" BorderBrush="{DynamicResource DangerBorderWarm}" BorderThickness="1"
                        CornerRadius="6" Padding="12,10"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerTextAlt}" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <!-- Birincil eylem: grafit dolgu. Renk yerine koyuluk kontrastıyla öne çıkıyor. -->
                <Button Classes="flat" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                        Command="{Binding LoginCommand}"
                        ToolTip.Tip="{Binding [Login.SubmitHint], Source={x:Static loc:Strings.Current}}">
                    <Border Background="{DynamicResource AccentSolid}" CornerRadius="6" Padding="14,12">
                        <TextBlock Text="{Binding [Login.Submit], Source={x:Static loc:Strings.Current}}" Foreground="{DynamicResource TextOnAccent}" FontSize="13.5" FontWeight="SemiBold"
                                   LetterSpacing="0.2" HorizontalAlignment="Center"/>
                    </Border>
                </Button>

                <Button Classes="flat" HorizontalAlignment="Center" Margin="0,2,0,0"
                        Command="{Binding ToggleForgotPasswordCommand}">
                    <TextBlock Text="{Binding [Login.ForgotPassword], Source={x:Static loc:Strings.Current}}" FontSize="12" Foreground="{DynamicResource LoginFormMuted}"/>
                </Button>

                <!-- Şifre sıfırlama talebi: e-posta altyapısı olmadığı için otomatik
                     sıfırlama yerine talep kaydediliyor, Admin karşılıyor. -->
                <Border IsVisible="{Binding ShowForgotPasswordPanel}"
                        Background="{DynamicResource LoginInputBg}" BorderBrush="{DynamicResource LoginFormBorderAlt}" BorderThickness="1"
                        CornerRadius="8" Padding="16" Margin="0,2,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding [Login.ForgotHint], Source={x:Static loc:Strings.Current}}"
                                   FontSize="11.5" Foreground="{DynamicResource LoginFormMuted}" TextWrapping="Wrap" LineHeight="17"/>

                        <TextBox Text="{Binding ForgotUsername}" Background="{DynamicResource LoginInputBg}" Foreground="{DynamicResource LoginFormText}"
                                 BorderBrush="{DynamicResource LoginFormBorder}" BorderThickness="1" CornerRadius="6"
                                 Padding="12,9" FontSize="13"
                                 PlaceholderText="{Binding [Login.ForgotPlaceholder], Source={x:Static loc:Strings.Current}}" KeyDown="OnForgotKeyDown"/>

                        <Button Classes="flat" HorizontalAlignment="Left"
                                IsEnabled="{Binding !IsSubmittingReset}"
                                Command="{Binding SubmitPasswordResetRequestCommand}">
                            <Border Background="{DynamicResource WarningBright}" CornerRadius="6" Padding="16,8">
                                <TextBlock Text="{Binding [Login.SendRequest], Source={x:Static loc:Strings.Current}}" Foreground="{DynamicResource TextOnAccent}" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                        </Button>

                        <Border Background="{DynamicResource SuccessSoftBgWarm}" CornerRadius="6" Padding="11,9"
                                IsVisible="{Binding ForgotMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding ForgotMessage}" FontSize="11.5" Foreground="{DynamicResource SuccessDeep}"
                                       TextWrapping="Wrap" LineHeight="17"/>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>

    </Grid>

</UserControl>
