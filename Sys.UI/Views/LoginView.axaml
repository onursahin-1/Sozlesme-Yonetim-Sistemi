<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Sys.UI.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <Design.DataContext>
        <vm:LoginViewModel />
    </Design.DataContext>

    <!--
      Giriş ekranı — sıcak nötr palet (mavi yok).
      Grafit (#1B1A18) marka paneli, kum tonu (#FAF8F4) form zemini, vurgu için
      kehribar (#C8952A). Renk yerine tipografi ve boşlukla hiyerarşi kuruluyor;
      logo siyah-beyaz olduğu için bu palet onunla çakışmıyor, tamamlıyor.
    -->
    <!-- Sol panel oransal: dar ekranda daralır, geniş ekranda büyür.
         Sabit 400 px, geniş monitörde küçücük bir şerit gibi kalıyordu. -->
    <Grid ColumnDefinitions="34*,66*">

        <!-- Sol: marka paneli -->
        <Border Grid.Column="0" MinWidth="360" Background="#1B1A18">
            <Grid RowDefinitions="*,Auto">

                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="40,0" Spacing="30">

                    <!--
                      Logo beyaz ve şeffaf arka planlı olduğu için doğrudan koyu zeminin
                      üzerine konuyor; arkasına beyaz kart koymak gerekmiyor, hatta
                      koymamak daha temiz duruyor.
                    -->
                    <Image Source="avares://Sys.UI/Assets/fakir-logo-white.png"
                           Width="270" Stretch="Uniform" HorizontalAlignment="Center"/>

                    <StackPanel Spacing="18" HorizontalAlignment="Center">
                        <Border Background="#C8952A" Height="2" Width="48" HorizontalAlignment="Center"/>
                        <TextBlock Classes="display" Text="SÖZLEŞME&#x0a;YÖNETİM SİSTEMİ"
                                   Foreground="#F5F2EC" FontSize="29" FontWeight="SemiBold"
                                   LineHeight="40" LetterSpacing="1.5"
                                   TextAlignment="Center" HorizontalAlignment="Center"/>
                    </StackPanel>

                </StackPanel>

                <TextBlock Grid.Row="1" Text="Fakir Hausgeräte" Foreground="#5C574E"
                           FontSize="11" LetterSpacing="0.5"
                           HorizontalAlignment="Center" Margin="0,0,0,32"/>
            </Grid>
        </Border>

        <!-- Sağ: giriş formu -->
        <Border Grid.Column="1" Background="#FAF8F4">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Width="340" Spacing="16">

                <StackPanel Spacing="6" Margin="0,0,0,8">
                    <TextBlock Classes="display" Text="Hoş geldiniz" FontSize="28" FontWeight="SemiBold"
                               Foreground="#1B1A18" LetterSpacing="-0.4"/>
                    <TextBlock Text="Devam etmek için hesabınıza giriş yapın."
                               FontSize="13" Foreground="#8A8578"/>
                </StackPanel>

                <StackPanel Spacing="7">
                    <TextBlock Text="Kullanıcı Adı" FontSize="12" FontWeight="SemiBold" Foreground="#3D3A34"/>
                    <TextBox x:Name="UsernameBox" Text="{Binding Username}" KeyDown="OnCredentialKeyDown"
                             Background="White" Foreground="#1B1A18"
                             BorderBrush="#DDD8CE" BorderThickness="1" CornerRadius="6"
                             Padding="12,10" FontSize="13"
                             PlaceholderText="kullanici.adi"/>
                </StackPanel>

                <StackPanel Spacing="7">
                    <!--
                      Caps Lock uyarısı etiketin sağında, satır içinde duruyor: ayrı bir
                      kutu olarak altta gösterildiğinde formu aşağı itiyor ve gereğinden
                      fazla dikkat çekiyordu. Burada alanın kendi başlığıyla aynı hizada,
                      sadece kutu odaktayken ve kilit açıkken beliriyor.
                    -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Şifre" FontSize="12" FontWeight="SemiBold" Foreground="#3D3A34"/>
                        <StackPanel Grid.Column="1" x:Name="CapsLockWarning" IsVisible="False"
                                    Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="⇪" FontSize="12" Foreground="#B7791F" VerticalAlignment="Center"/>
                            <TextBlock Text="Caps Lock açık" FontSize="11" Foreground="#B7791F"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="PasswordBox"
                             Text="{Binding Password}" PasswordChar="•" KeyDown="OnCredentialKeyDown"
                             KeyUp="OnPasswordKeyUp" GotFocus="OnPasswordFocusChanged"
                             Background="White" Foreground="#1B1A18"
                             BorderBrush="#DDD8CE" BorderThickness="1" CornerRadius="6"
                             Padding="12,10" FontSize="13"
                             PlaceholderText="••••••••"/>
                </StackPanel>

                <Border Background="#FBEDE9" BorderBrush="#E8C4B8" BorderThickness="1"
                        CornerRadius="6" Padding="12,10"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#9B3B25" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <!-- Birincil eylem: grafit dolgu. Renk yerine koyuluk kontrastıyla öne çıkıyor. -->
                <Button Classes="flat" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                        Command="{Binding LoginCommand}"
                        ToolTip.Tip="Enter tuşuyla da giriş yapabilirsiniz">
                    <Border Background="#1B1A18" CornerRadius="6" Padding="14,12">
                        <TextBlock Text="Giriş Yap" Foreground="#F5F2EC" FontSize="13.5" FontWeight="SemiBold"
                                   LetterSpacing="0.2" HorizontalAlignment="Center"/>
                    </Border>
                </Button>

                <Button Classes="flat" HorizontalAlignment="Center" Margin="0,2,0,0"
                        Command="{Binding ToggleForgotPasswordCommand}">
                    <TextBlock Text="Şifremi unuttum" FontSize="12" Foreground="#8A8578"/>
                </Button>

                <!-- Şifre sıfırlama talebi: e-posta altyapısı olmadığı için otomatik
                     sıfırlama yerine talep kaydediliyor, Admin karşılıyor. -->
                <Border IsVisible="{Binding ShowForgotPasswordPanel}"
                        Background="White" BorderBrush="#E5E0D6" BorderThickness="1"
                        CornerRadius="8" Padding="16" Margin="0,2,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Kullanıcı adınızı girin. Sistem yöneticinize bir sıfırlama talebi iletilecek."
                                   FontSize="11.5" Foreground="#8A8578" TextWrapping="Wrap" LineHeight="17"/>

                        <TextBox Text="{Binding ForgotUsername}" Background="White" Foreground="#1B1A18"
                                 BorderBrush="#DDD8CE" BorderThickness="1" CornerRadius="6"
                                 Padding="12,9" FontSize="13"
                                 PlaceholderText="Kullanıcı adı" KeyDown="OnForgotKeyDown"/>

                        <Button Classes="flat" HorizontalAlignment="Left"
                                IsEnabled="{Binding !IsSubmittingReset}"
                                Command="{Binding SubmitPasswordResetRequestCommand}">
                            <Border Background="#C8952A" CornerRadius="6" Padding="16,8">
                                <TextBlock Text="Talep Gönder" Foreground="#1B1A18" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                        </Button>

                        <Border Background="#EEF2E9" CornerRadius="6" Padding="11,9"
                                IsVisible="{Binding ForgotMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding ForgotMessage}" FontSize="11.5" Foreground="#4A6136"
                                       TextWrapping="Wrap" LineHeight="17"/>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>

    </Grid>

</UserControl>
