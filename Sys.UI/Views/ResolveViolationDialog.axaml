<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sys.UI.Views.ResolveViolationDialog"
        Title="İhlali Gider"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
	<StackPanel Margin="24" Spacing="14">

		<StackPanel Spacing="3">
			<TextBlock x:Name="HeaderText" FontSize="15" FontWeight="SemiBold"
					   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
			<TextBlock x:Name="HintText" FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
		</StackPanel>

		<StackPanel Spacing="6">
			<TextBlock Text="İhlal nasıl giderildi?" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBodyAlt}"/>
			<TextBox x:Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap"
					 Height="110" MaxLength="500"
					 PlaceholderText="Eksik iş tamamlandı, gecikme telafi edildi, tutanak imzalandı..."/>
			<TextBlock x:Name="ErrorText" FontSize="11.5" Foreground="{DynamicResource DangerBase}"
					   IsVisible="False" TextWrapping="Wrap"/>
		</StackPanel>

		<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
			<Button x:Name="CancelButton" Content="Vazgeç" Click="OnCancelClick"/>
			<Button Classes="flat" Click="OnConfirmClick">
				<Border Background="{DynamicResource SuccessSolid}" CornerRadius="4" Padding="14,6">
					<TextBlock Text="Giderildi Olarak İşaretle" Foreground="{DynamicResource TextOnAccent}"/>
				</Border>
			</Button>
		</StackPanel>
	</StackPanel>
</Window>
