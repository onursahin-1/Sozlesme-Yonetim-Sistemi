<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sys.UI.Views.RejectRequestDialog"
        Title="Talebi Reddet"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
	<StackPanel Margin="24" Spacing="14">

		<TextBlock x:Name="HeaderText" FontSize="15" FontWeight="SemiBold"
				   Foreground="#1A2E4A" TextWrapping="Wrap"/>

		<StackPanel Spacing="6">
			<TextBlock Text="Red gerekçesi" FontSize="12" FontWeight="SemiBold" Foreground="#4B5563"/>
			<TextBox x:Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap"
					 Height="110" MaxLength="500"
					 PlaceholderText="Talebin neden reddedildiğini yazın. Bu metin talep sahibine bildirim olarak iletilir."/>
			<TextBlock x:Name="ErrorText" FontSize="11.5" Foreground="#A32D2D"
					   IsVisible="False" TextWrapping="Wrap"/>
		</StackPanel>

		<!--
		  Redde iki anlam yüklenebiliyor: iade (düzeltilip tekrar gönderilebilir) ve
		  kapatma (nihai). Varsayılan iade — geri alınabilir olan seçenek daha güvenli.
		-->
		<Border Background="#F7F9FC" BorderBrush="#DDE3EC" BorderThickness="1"
				CornerRadius="8" Padding="12,10">
			<StackPanel Spacing="4">
				<CheckBox x:Name="AllowResubmitCheck" IsChecked="True"
						  Content="Düzeltilip yeniden gönderilebilir"/>
				<TextBlock x:Name="HintText" FontSize="11.5" Foreground="#8A94A6"
						   TextWrapping="Wrap" Margin="0,0,0,0"/>
			</StackPanel>
		</Border>

		<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
			<Button x:Name="CancelButton" Content="Vazgeç" Click="OnCancelClick"/>
			<Button Classes="flat" Click="OnConfirmClick">
				<Border Background="#A32D2D" CornerRadius="4" Padding="14,6">
					<TextBlock x:Name="ConfirmText" Text="Talebi Reddet" Foreground="White"/>
				</Border>
			</Button>
		</StackPanel>
	</StackPanel>
</Window>
