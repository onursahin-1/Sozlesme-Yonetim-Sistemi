<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sys.UI.Views.RejectRequestDialog"
        Title="Talebi Reddet"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
	<StackPanel Margin="24" Spacing="14">

		<TextBlock x:Name="HeaderText" FontSize="15" FontWeight="SemiBold"
				   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>

		<StackPanel Spacing="6">
			<TextBlock x:Name="NoteLabel" Text="Red gerekçesi" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBodyAlt}"/>
			<TextBox x:Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap"
					 Height="110" MaxLength="500"/>
			<TextBlock x:Name="ErrorText" FontSize="11.5" Foreground="{DynamicResource DangerBase}"
					   IsVisible="False" TextWrapping="Wrap"/>
		</StackPanel>

		<!--
		  Redde iki anlam yüklenebiliyor: iade (düzeltilip tekrar gönderilebilir) ve
		  kapatma (nihai). Varsayılan iade — geri alınabilir olan seçenek daha güvenli.
		-->
		<Border Background="{DynamicResource SurfaceSubtle}" BorderBrush="{DynamicResource BorderButton}" BorderThickness="1"
				CornerRadius="8" Padding="12,10">
			<StackPanel Spacing="4">
				<CheckBox x:Name="AllowResubmitCheck" IsChecked="True"
						  Content="Düzeltilip yeniden gönderilebilir"/>
				<TextBlock x:Name="HintText" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
						   TextWrapping="Wrap" Margin="0,0,0,0"/>
			</StackPanel>
		</Border>

		<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
			<Button x:Name="CancelButton" Content="Vazgeç" Click="OnCancelClick"/>
			<Button Classes="flat" Click="OnConfirmClick">
				<Border Background="{DynamicResource DangerSolid}" CornerRadius="4" Padding="14,6">
					<TextBlock x:Name="ConfirmText" Text="Talebi Reddet" Foreground="{DynamicResource TextOnAccent}"/>
				</Border>
			</Button>
		</StackPanel>
	</StackPanel>
</Window>
