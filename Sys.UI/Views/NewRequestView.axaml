<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="700"
             x:Class="Sys.UI.Views.NewRequestView"
             x:DataType="vm:NewRequestViewModel">

	<Design.DataContext>
		<vm:NewRequestViewModel />
	</Design.DataContext>

	<ScrollViewer>
		<StackPanel Margin="0,0,20,20" Spacing="10" MaxWidth="600">

			<Button Content="← Geri" FontSize="12" HorizontalAlignment="Left"
                    Background="#6B7280" Foreground="White" Padding="10,4" CornerRadius="4"
                    IsVisible="{Binding IsEditMode}"
                    Command="{Binding CancelCommand}">
				<Button.Styles>
					<Style Selector="Button:pointerover /template/ ContentPresenter">
						<Setter Property="Background" Value="#4B5563"/>
						<Setter Property="TextBlock.Foreground" Value="White"/>
					</Style>
				</Button.Styles>
			</Button>

			<TextBlock Text="Talebi Düzenle" FontSize="16" FontWeight="Bold" Foreground="#A32D2D" IsVisible="{Binding IsEditMode}"/>

			<TextBlock Text="SAS / YK Referans No"/>
			<TextBox Text="{Binding RequestRefNo}"/>

			<TextBlock Text="Konu / Başlık *"/>
			<TextBox Text="{Binding Title}"/>

			<TextBlock Text="Sözleşme Türü"/>
			<ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding Type}" HorizontalAlignment="Stretch"/>

			<TextBlock Text="Tahmini Bedel (TL)"/>
			<TextBox Text="{Binding EstimatedAmountText}" LostFocus="OnAmountLostFocus" TextChanged="OnAmountTextChanged"/>

			<TextBlock Text="İşin Tanımı *"/>
			<TextBox Text="{Binding Description}" AcceptsReturn="True" Height="80" TextWrapping="Wrap"/>

			<TextBlock Text="Firma Adı *"/>
			<TextBox Text="{Binding CompanyName}"/>

			<TextBlock Text="Vergi No *"/>
			<TextBox Text="{Binding TaxNo}"/>

			<TextBlock Text="SAP Cari Kodu"/>
			<TextBox Text="{Binding SapCariKodu}" PlaceholderText="C-XXXXX (yoksa boş bırakın)"/>

			<TextBlock Text="Firma Türü"/>
			<ComboBox ItemsSource="{Binding CompanyTypeOptions}" SelectedItem="{Binding SelectedCompanyType}" HorizontalAlignment="Stretch"/>

			<TextBlock Text="Sözleşme Dosyası"/>
			<StackPanel Orientation="Horizontal" Spacing="10">
				<Button Content="Dosya Seç" Click="OnPickFileClick"/>
				<TextBlock Text="{Binding SelectedFileName}" VerticalAlignment="Center" Foreground="Gray"/>
				<Button Content="Kaldır" FontSize="11" Command="{Binding ClearFileCommand}"
                        IsVisible="{Binding SelectedFileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
			</StackPanel>

			<TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"/>
			<TextBlock Text="{Binding SuccessMessage}" Foreground="Green" TextWrapping="Wrap"/>

			<StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
				<Button Content="{Binding SubmitButtonText}" Command="{Binding SubmitCommand}"/>
			</StackPanel>

		</StackPanel>
	</ScrollViewer>

</UserControl>