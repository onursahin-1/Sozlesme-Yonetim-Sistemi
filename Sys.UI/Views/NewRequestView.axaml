<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="760"
             x:Class="Sys.UI.Views.NewRequestView"
             x:DataType="vm:NewRequestViewModel">

	<Design.DataContext>
		<vm:NewRequestViewModel />
	</Design.DataContext>

	<UserControl.Styles>
		<!--
		  Form stilleri bu ekranla sınırlı tutuluyor: TextBox/ComboBox için global bir
		  stil yazmak diğer tüm ekranların girdi kutularını da değiştirirdi.
		-->
		<Style Selector="TextBlock.formLabel">
			<Setter Property="FontSize" Value="11.5"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextLabel}"/>
			<Setter Property="Margin" Value="0,0,0,5"/>
		</Style>
		<Style Selector="TextBlock.formHint">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="{DynamicResource TextFaintAlt}"/>
			<Setter Property="Margin" Value="2,5,0,0"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
		<Style Selector="TextBox">
			<Setter Property="Padding" Value="11,9"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
			<Setter Property="Background" Value="{DynamicResource SurfaceInput}"/>
		</Style>
		<Style Selector="TextBox:focus">
			<Setter Property="Background" Value="{DynamicResource SurfaceInputFocus}"/>
		</Style>
		<Style Selector="ComboBox">
			<Setter Property="Padding" Value="11,8"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
			<Setter Property="Background" Value="{DynamicResource SurfaceInput}"/>
		</Style>

		<!-- Sağ paneldeki özet satırları -->
		<Style Selector="TextBlock.summaryLabel">
			<Setter Property="FontSize" Value="9.5"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMutedAlt}"/>
			<Setter Property="LetterSpacing" Value="0.6"/>
		</Style>
		<Style Selector="TextBlock.summaryValue">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
		<Style Selector="TextBlock.summaryEmpty">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="{DynamicResource TextDisabledAlt}"/>
		</Style>
	</UserControl.Styles>

	<!--
	  İki sütun: solda form, sağda sabit kalan özet paneli. Sağ panel ScrollViewer'ın
	  DIŞINDA olduğu için form kaydırılırken yerinde duruyor; kullanıcı uzun formda
	  aşağı indiğinde ne girdiğini ve sonrasında ne olacağını görmeye devam ediyor.
	-->
	<Grid ColumnSpacing="22" Margin="0,0,20,0">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" MinWidth="460"/>
			<ColumnDefinition Width="300"/>
		</Grid.ColumnDefinitions>

		<!-- ==================== SOL: FORM ==================== -->
		<ScrollViewer Grid.Column="0">
			<StackPanel Spacing="16" Margin="0,0,4,24">

				<!-- Düzenleme modu bandı: sıradan bir talep girişiyle karışmasın -->
				<Border IsVisible="{Binding IsEditMode}"
						Background="{DynamicResource DangerSoftBg}" BorderBrush="{DynamicResource DangerSoftBorder}" BorderThickness="1"
						CornerRadius="10" Padding="16,12">
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
						<StackPanel Grid.Column="0" Spacing="2">
							<TextBlock Text="{DynamicResource Nav.EditRequest}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource DangerBase}"/>
							<TextBlock Text="{DynamicResource Req.EditNotice}"
									   FontSize="11.5" Foreground="{DynamicResource DangerTextAlt}" TextWrapping="Wrap"/>
						</StackPanel>
						<Button Grid.Column="1" Classes="flat" VerticalAlignment="Center" Command="{Binding CancelCommand}">
							<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource DangerSoftBorder}" BorderThickness="1"
									CornerRadius="7" Padding="12,6">
								<TextBlock Text="{DynamicResource Form.CancelBack}" Foreground="{DynamicResource DangerBase}" FontSize="12"/>
							</Border>
						</Button>
					</Grid>
				</Border>

				<!--
				  Yenileme bandı. Form kaynak sözleşmenin verisiyle dolu geldiği için
				  kullanıcının bunun boş bir form OLMADIĞINI bilmesi gerekiyor; aksi
				  halde dolu alanları kendi girdiği sanılabilir. Kaynak sözleşmenin
				  numarası ve bitiş tarihi de burada, hangi dönemi yenilediği açık olsun.
				-->
				<Border IsVisible="{Binding IsRenewal}"
						Background="{DynamicResource SuccessSoftBgAlt2}" BorderBrush="{DynamicResource SuccessSoftBorderAlt}" BorderThickness="1"
						CornerRadius="10" Padding="16,12">
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
						<StackPanel Grid.Column="0" Spacing="3">
							<TextBlock Text="{DynamicResource Req.RenewalTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SuccessText}"/>
							<StackPanel Orientation="Horizontal" Spacing="5">
								<TextBlock Text="{DynamicResource Req.SourceContract}" FontSize="11.5" Foreground="{DynamicResource SuccessTextAlt}"/>
								<TextBlock Text="{Binding RenewalSourceLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessText}"/>
								<TextBlock Text="·" FontSize="11.5" Foreground="{DynamicResource SuccessMuted}"/>
								<TextBlock Text="{DynamicResource Req.EndLabel}" FontSize="11.5" Foreground="{DynamicResource SuccessTextAlt}"/>
								<TextBlock Text="{Binding RenewalSourceEndText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessText}"/>
							</StackPanel>
							<TextBlock Text="{DynamicResource Req.RenewalNotice}"
									   FontSize="11.5" Foreground="{DynamicResource SuccessTextAlt}" TextWrapping="Wrap"/>
						</StackPanel>
						<Button Grid.Column="1" Classes="flat" VerticalAlignment="Center" Command="{Binding CancelCommand}">
							<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource SuccessSoftBorderAlt}" BorderThickness="1"
									CornerRadius="7" Padding="12,6">
								<TextBlock Text="{DynamicResource Form.CancelBack}" Foreground="{DynamicResource SuccessText}" FontSize="12"/>
							</Border>
						</Button>
					</Grid>
				</Border>

				<!-- ============ 1 · TALEP BİLGİLERİ ============ -->
				<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
						CornerRadius="12" Padding="24,20">
					<StackPanel Spacing="18">

						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
							<Border Grid.Column="0" Width="26" Height="26" CornerRadius="8"
									Background="{DynamicResource AccentSolid}" VerticalAlignment="Center">
								<TextBlock Text="1" Foreground="{DynamicResource TextOnAccent}" FontSize="13" FontWeight="Bold"
										   HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
								<TextBlock Classes="display" Text="{DynamicResource Req.RequestInfo}" FontSize="15.5"
										   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
								<TextBlock Text="{DynamicResource Form.RequiredHint}" FontSize="11" Foreground="{DynamicResource TextFaintAlt}"/>
							</StackPanel>
						</Grid>

						<Border Background="{DynamicResource SurfaceDivider}" Height="1"/>

						<Grid ColumnDefinitions="*,*" ColumnSpacing="18">
							<StackPanel Grid.Column="0">
								<TextBlock Classes="formLabel" Text="{DynamicResource Req.Reference}"/>
								<TextBox Text="{Binding RequestRefNo}" PlaceholderText="{DynamicResource Req.ReferencePlaceholder}"/>
							</StackPanel>
							<StackPanel Grid.Column="1">
								<TextBlock Classes="formLabel">
									<Run Text="{DynamicResource Req.ContractType}"/>
									<Run Text=" *" Foreground="{DynamicResource DangerText}"/>
								</TextBlock>
								<ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding Type}"
										  HorizontalAlignment="Stretch"/>
								<TextBlock Classes="fieldError" Text="{Binding TypeError}"
										   IsVisible="{Binding TypeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
							</StackPanel>
						</Grid>

						<StackPanel>
							<TextBlock Classes="formLabel">
								<Run Text="{DynamicResource Req.Subject}"/>
								<Run Text=" *" Foreground="{DynamicResource DangerText}"/>
							</TextBlock>
							<TextBox Text="{Binding Title}" PlaceholderText="{DynamicResource Req.SubjectPlaceholder}"/>
							<TextBlock Classes="fieldError" Text="{Binding TitleError}"
									   IsVisible="{Binding TitleError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						</StackPanel>

						<StackPanel>
							<TextBlock Classes="formLabel" Text="{DynamicResource Req.EstimatedAmount}"/>
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
								<TextBox Grid.Column="0" Text="{Binding EstimatedAmountText}"
										 PlaceholderText="{DynamicResource Req.AmountPlaceholder}"
										 LostFocus="OnAmountLostFocus" TextChanged="OnAmountTextChanged"/>
								<ComboBox Grid.Column="1" Width="128"
										  ItemsSource="{Binding CurrencyOptions}" SelectedItem="{Binding SelectedCurrency}"/>
							</Grid>
							<TextBlock Classes="fieldError" Text="{Binding AmountError}"
									   IsVisible="{Binding AmountError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
							<TextBlock Classes="formHint"
									   Text="{DynamicResource Req.EstimatedHint}"/>
						</StackPanel>

						<StackPanel>
							<TextBlock Classes="formLabel">
								<Run Text="{DynamicResource Req.WorkDescription}"/>
								<Run Text=" *" Foreground="{DynamicResource DangerText}"/>
							</TextBlock>
							<TextBox Text="{Binding Description}" AcceptsReturn="True" Height="120"
									 TextWrapping="Wrap" AcceptsTab="False"
									 PlaceholderText="{DynamicResource Req.WorkPlaceholder}"/>
							<TextBlock Classes="fieldError" Text="{Binding DescriptionError}"
									   IsVisible="{Binding DescriptionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- ============ 2 · FİRMA BİLGİLERİ ============ -->
				<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
						CornerRadius="12" Padding="24,20">
					<StackPanel Spacing="18">

						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
							<Border Grid.Column="0" Width="26" Height="26" CornerRadius="8"
									Background="{DynamicResource AccentSolid}" VerticalAlignment="Center">
								<TextBlock Text="2" Foreground="{DynamicResource TextOnAccent}" FontSize="13" FontWeight="Bold"
										   HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
								<TextBlock Classes="display" Text="{DynamicResource Req.CompanyInfo}" FontSize="15.5"
										   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
								<TextBlock Text="{DynamicResource Req.CompanyHint}" FontSize="11" Foreground="{DynamicResource TextFaintAlt}"/>
							</StackPanel>
						</Grid>

						<Border Background="{DynamicResource SurfaceDivider}" Height="1"/>

						<Grid ColumnDefinitions="*,*" ColumnSpacing="18">
							<StackPanel Grid.Column="0">
								<TextBlock Classes="formLabel">
									<Run Text="{DynamicResource Req.CompanyName}"/>
									<Run Text=" *" Foreground="{DynamicResource DangerText}"/>
								</TextBlock>
								<TextBox Text="{Binding CompanyName}"/>
								<TextBlock Classes="fieldError" Text="{Binding CompanyNameError}"
										   IsVisible="{Binding CompanyNameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
							</StackPanel>
							<StackPanel Grid.Column="1">
								<TextBlock Classes="formLabel">
									<Run Text="{DynamicResource Field.TaxNo}"/>
									<Run Text=" *" Foreground="{DynamicResource DangerText}"/>
								</TextBlock>
								<TextBox Text="{Binding TaxNo}" MaxLength="10" PlaceholderText="{DynamicResource Req.TaxNoPlaceholder}"/>
								<TextBlock Classes="fieldError" Text="{Binding TaxNoError}"
										   IsVisible="{Binding TaxNoError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
							</StackPanel>
						</Grid>

						<Grid ColumnDefinitions="*,*" ColumnSpacing="18">
							<StackPanel Grid.Column="0">
								<TextBlock Classes="formLabel" Text="{DynamicResource Field.SapCode}"/>
								<TextBox Text="{Binding SapCariKodu}" PlaceholderText="{DynamicResource Req.SapPlaceholder}"/>
							</StackPanel>
							<StackPanel Grid.Column="1">
								<TextBlock Classes="formLabel" Text="{DynamicResource Field.CompanyType}"/>
								<ComboBox ItemsSource="{Binding CompanyTypeOptions}" SelectedItem="{Binding SelectedCompanyType}"
										  HorizontalAlignment="Stretch"/>
							</StackPanel>
						</Grid>
					</StackPanel>
				</Border>

				<!-- ============ 3 · DOSYA ============ -->
				<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
						CornerRadius="12" Padding="24,20">
					<StackPanel Spacing="16">

						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
							<Border Grid.Column="0" Width="26" Height="26" CornerRadius="8"
									Background="{DynamicResource AccentSolid}" VerticalAlignment="Center">
								<TextBlock Text="3" Foreground="{DynamicResource TextOnAccent}" FontSize="13" FontWeight="Bold"
										   HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
								<TextBlock Classes="display" Text="{DynamicResource Form.File}" FontSize="15.5"
										   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
								<TextBlock Text="{DynamicResource Req.AttachmentHint}" FontSize="11" Foreground="{DynamicResource TextFaintAlt}"/>
							</StackPanel>
						</Grid>

						<!-- Dosya seçilmemişken: davet eden boş alan -->
						<Border IsVisible="{Binding SelectedFileName, Converter={x:Static StringConverters.IsNullOrEmpty}}"
								Background="{DynamicResource SurfaceInputAlt}" BorderBrush="{DynamicResource BorderInput}" BorderThickness="1"
								CornerRadius="10" Padding="24,22">
							<StackPanel Spacing="12" HorizontalAlignment="Center">
								<Path Stroke="{DynamicResource TextDisabledSoft}" StrokeThickness="1.6" Fill="Transparent"
									  Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center"
									  Data="M12 16V4M12 4L7.5 8.5M12 4l4.5 4.5M4 16v2.5A1.5 1.5 0 0 0 5.5 20h13a1.5 1.5 0 0 0 1.5-1.5V16"/>
								<TextBlock Text="{DynamicResource Req.FileTypes}"
										   FontSize="11.5" Foreground="{DynamicResource TextFaintAlt}" HorizontalAlignment="Center"/>
								<Button Classes="flat" HorizontalAlignment="Center" Click="OnPickFileClick">
									<Border Background="{DynamicResource SurfaceButton}" BorderBrush="{DynamicResource BorderStrongAlt}" BorderThickness="1"
											CornerRadius="8" Padding="18,9">
										<TextBlock Text="{DynamicResource Form.ChooseFile}" Foreground="{DynamicResource TextBody}" FontSize="12.5"
												   FontWeight="SemiBold"/>
									</Border>
								</Button>
							</StackPanel>
						</Border>

						<!-- Dosya seçilmişken: dosya adı, değiştir ve kaldır -->
						<Border IsVisible="{Binding SelectedFileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
								Background="{DynamicResource SurfaceSubtleBlue}" BorderBrush="{DynamicResource AccentSoftBorder}" BorderThickness="1"
								CornerRadius="10" Padding="14,12">
							<Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
								<Path Grid.Column="0" Stroke="{DynamicResource AccentBase}" StrokeThickness="1.8" Fill="Transparent"
									  Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
									  Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6"/>
								<TextBlock Grid.Column="1" Text="{Binding SelectedFileName}" FontSize="12.5"
										   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
										   TextTrimming="CharacterEllipsis"/>
								<Button Grid.Column="2" Classes="flat" Click="OnPickFileClick" VerticalAlignment="Center">
									<TextBlock Text="{DynamicResource Form.Change}" Foreground="{DynamicResource AccentBase}" FontSize="11.5"/>
								</Button>
								<Button Grid.Column="3" Classes="flat" Command="{Binding ClearFileCommand}" VerticalAlignment="Center">
									<TextBlock Text="{DynamicResource Form.Remove}" Foreground="{DynamicResource DangerBase}" FontSize="11.5"/>
								</Button>
							</Grid>
						</Border>
					</StackPanel>
				</Border>

				<!-- Kısa özet; ayrıntı ilgili alanın altında gösteriliyor -->
				<Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
						Background="{DynamicResource DangerSoftBg}" BorderBrush="{DynamicResource DangerSoftBorder}" BorderThickness="1"
						CornerRadius="10" Padding="14,11">
					<TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerTextAlt}"
							   FontSize="12.5" TextWrapping="Wrap"/>
				</Border>

				<Border IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
						Background="{DynamicResource SuccessSoftBg}" BorderBrush="{DynamicResource SuccessSoftBorder}" BorderThickness="1"
						CornerRadius="10" Padding="14,11">
					<TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource SuccessBase}"
							   FontSize="12.5" TextWrapping="Wrap"/>
				</Border>

			</StackPanel>
		</ScrollViewer>

		<!-- ==================== SAĞ: ÖZET + SÜREÇ ==================== -->
		<StackPanel Grid.Column="1" Spacing="14" VerticalAlignment="Top" Margin="0,0,0,24">

			<!--
			  Canlı özet: kullanıcı formda aşağı indikçe üstte ne yazdığını unutuyor.
			  Alanlar ObservableProperty olduğu için buradaki değerler yazdıkça güncellenir.
			-->
			<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
					CornerRadius="12" Padding="18,16">
				<StackPanel Spacing="14">
					<TextBlock Classes="sectionLabel" Text="{DynamicResource Form.Summary}"/>

					<StackPanel Spacing="3">
						<TextBlock Classes="summaryLabel" Text="{DynamicResource Req.SubjectShort}"/>
						<TextBlock Classes="summaryValue" Text="{Binding Title}"
								   IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						<TextBlock Classes="summaryEmpty" Text="—"
								   IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
					</StackPanel>

					<StackPanel Spacing="3">
						<TextBlock Classes="summaryLabel" Text="{DynamicResource Doc.Company}"/>
						<TextBlock Classes="summaryValue" Text="{Binding CompanyName}"
								   IsVisible="{Binding CompanyName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						<TextBlock Classes="summaryEmpty" Text="—"
								   IsVisible="{Binding CompanyName, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
					</StackPanel>

					<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
						<StackPanel Grid.Column="0" Spacing="3">
							<TextBlock Classes="summaryLabel" Text="{DynamicResource Field.Type}"/>
							<TextBlock Classes="summaryValue" Text="{Binding Type}"
									   IsVisible="{Binding Type, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
							<TextBlock Classes="summaryEmpty" Text="—"
									   IsVisible="{Binding Type, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
						</StackPanel>
						<StackPanel Grid.Column="1" Spacing="3">
							<TextBlock Classes="summaryLabel" Text="{DynamicResource Req.EstimatedAmount}"/>
							<TextBlock Classes="summaryValue" FontWeight="SemiBold"
									   IsVisible="{Binding EstimatedAmountText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
								<Run Text="{Binding EstimatedAmountText}"/>
								<Run Text=" "/>
								<Run Text="{Binding SelectedCurrency}"/>
							</TextBlock>
							<TextBlock Classes="summaryEmpty" Text="—"
									   IsVisible="{Binding EstimatedAmountText, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
						</StackPanel>
					</Grid>
				</StackPanel>
			</Border>

			<!--
			  Talebi açan kişi çoğu zaman "gönderdim, şimdi ne olacak?" diye soruyor.
			  Onay zinciri burada, gönderme butonunun hemen yanında yazılı.
			-->
			<Border Background="{DynamicResource SurfaceSubtle}" BorderBrush="{DynamicResource BorderInput}" BorderThickness="1"
					CornerRadius="12" Padding="18,16">
				<StackPanel Spacing="12">
					<TextBlock Classes="sectionLabel" Text="{DynamicResource Req.AfterSubmit}"/>

					<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
						<Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentSolid}"
								VerticalAlignment="Top" Margin="0,1,0,0">
							<TextBlock Text="1" Foreground="{DynamicResource TextOnAccent}" FontSize="10" FontWeight="Bold"
									   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<TextBlock Grid.Column="1" Text="{DynamicResource Req.Step1}"
								   FontSize="11.5" Foreground="{DynamicResource TextLabel}" TextWrapping="Wrap"/>
					</Grid>

					<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
						<Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentMutedStrong}"
								VerticalAlignment="Top" Margin="0,1,0,0">
							<TextBlock Text="2" Foreground="{DynamicResource TextOnAccent}" FontSize="10" FontWeight="Bold"
									   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<TextBlock Grid.Column="1" Text="{DynamicResource Req.Step2}"
								   FontSize="11.5" Foreground="{DynamicResource TextLabel}" TextWrapping="Wrap"/>
					</Grid>

					<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
						<Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentMutedAlt}"
								VerticalAlignment="Top" Margin="0,1,0,0">
							<TextBlock Text="3" Foreground="{DynamicResource TextOnAccent}" FontSize="10" FontWeight="Bold"
									   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<TextBlock Grid.Column="1" Text="{DynamicResource Req.Step3}"
								   FontSize="11.5" Foreground="{DynamicResource TextLabel}" TextWrapping="Wrap"/>
					</Grid>

					<Border Background="{DynamicResource SurfaceDivider}" Height="1"/>

					<TextBlock Text="{DynamicResource Req.NotifyHint}"
							   FontSize="11" Foreground="{DynamicResource TextFaintAlt}" TextWrapping="Wrap"/>
				</StackPanel>
			</Border>

			<!-- Aksiyon çubuğu: kaydırmayla kaybolmasın diye sağ panelde sabit -->
			<StackPanel Spacing="8">
				<Button Classes="flat" HorizontalAlignment="Stretch"
						Command="{Binding SubmitCommand}" IsEnabled="{Binding !IsBusy}">
					<Border Background="{DynamicResource AccentSolid}" CornerRadius="9" Padding="18,12">
						<TextBlock Text="{Binding SubmitButtonText}" Foreground="{DynamicResource TextOnAccent}"
								   FontSize="13" FontWeight="SemiBold"
								   HorizontalAlignment="Center"/>
					</Border>
				</Button>
				<Button Classes="flat" HorizontalAlignment="Stretch"
						IsVisible="{Binding IsEditMode}" Command="{Binding CancelCommand}">
					<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderInput}" BorderThickness="1"
							CornerRadius="9" Padding="18,11">
						<TextBlock Text="{DynamicResource Form.Cancel}" Foreground="{DynamicResource TextLabel}" FontSize="12.5"
								   HorizontalAlignment="Center"/>
					</Border>
				</Button>
			</StackPanel>

		</StackPanel>
	</Grid>

</UserControl>
