<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="700"
             x:Class="Sys.UI.Views.NewRequestView"
             x:DataType="vm:NewRequestViewModel">

	<Design.DataContext>
		<vm:NewRequestViewModel />
	</Design.DataContext>

	<!-- Alan bazlı hata mesajları ilgili kutunun hemen altında gösterilir (Classes="fieldError"). -->
	<ScrollViewer>
		<StackPanel Margin="0,0,20,20" Spacing="10" MaxWidth="600">

			<Button Classes="flat" HorizontalAlignment="Left" IsVisible="{Binding IsEditMode}" Command="{Binding CancelCommand}">
				<Border Background="#6B7280" CornerRadius="4" Padding="10,4">
					<TextBlock Text="← Geri" Foreground="White" FontSize="12"/>
				</Border>
			</Button>

			<TextBlock Text="Talebi Düzenle" FontSize="16" FontWeight="Bold" Foreground="#A32D2D" IsVisible="{Binding IsEditMode}"/>

			<TextBlock Text="SAS / YK Referans No"/>
			<TextBox Text="{Binding RequestRefNo}"/>

			<TextBlock Text="Konu / Başlık *"/>
			<TextBox Text="{Binding Title}"/>
			<TextBlock Classes="fieldError" Text="{Binding TitleError}"
                       IsVisible="{Binding TitleError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

			<TextBlock Text="Sözleşme Türü"/>
			<ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding Type}" HorizontalAlignment="Stretch"/>
			<TextBlock Classes="fieldError" Text="{Binding TypeError}"
                       IsVisible="{Binding TypeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

			<TextBlock Text="Tahmini Bedel"/>
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
				<TextBox Grid.Column="0" Text="{Binding EstimatedAmountText}"
						 LostFocus="OnAmountLostFocus" TextChanged="OnAmountTextChanged"/>
				<ComboBox Grid.Column="1" Width="130"
						  ItemsSource="{Binding CurrencyOptions}" SelectedItem="{Binding SelectedCurrency}"/>
			</Grid>
			<TextBlock Classes="fieldError" Text="{Binding AmountError}"
                       IsVisible="{Binding AmountError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

			<TextBlock Text="İşin Tanımı *"/>
			<TextBox Text="{Binding Description}" AcceptsReturn="True" Height="80" TextWrapping="Wrap"/>
			<TextBlock Classes="fieldError" Text="{Binding DescriptionError}"
                       IsVisible="{Binding DescriptionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

			<TextBlock Text="Firma Adı *"/>
			<TextBox Text="{Binding CompanyName}"/>
			<TextBlock Classes="fieldError" Text="{Binding CompanyNameError}"
                       IsVisible="{Binding CompanyNameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

			<TextBlock Text="Vergi No *"/>
			<TextBox Text="{Binding TaxNo}"/>
			<TextBlock Classes="fieldError" Text="{Binding TaxNoError}"
                       IsVisible="{Binding TaxNoError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

			<TextBlock Text="SAP Cari Kodu"/>
			<TextBox Text="{Binding SapCariKodu}" PlaceholderText="C-XXXXX (yoksa boş bırakın)"/>

			<TextBlock Text="Firma Türü"/>
			<ComboBox ItemsSource="{Binding CompanyTypeOptions}" SelectedItem="{Binding SelectedCompanyType}" HorizontalAlignment="Stretch"/>

			<TextBlock Text="Sözleşme Dosyası"/>
			<StackPanel Orientation="Horizontal" Spacing="10">
				<Button Content="📎 Dosya Seç" Click="OnPickFileClick"/>
				<TextBlock Text="{Binding SelectedFileName}" VerticalAlignment="Center" Foreground="Gray"/>
				<Button Content="Kaldır" FontSize="11" Command="{Binding ClearFileCommand}"
                        IsVisible="{Binding SelectedFileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
			</StackPanel>

			<!-- Artık yalnızca kısa bir özet; ayrıntı ilgili alanın altında gösteriliyor -->
			<TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
			<TextBlock Text="{Binding SuccessMessage}" Foreground="Green" TextWrapping="Wrap"/>

			<StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
				<Button Content="{Binding SubmitButtonText}" Command="{Binding SubmitCommand}" IsEnabled="{Binding !IsBusy}"/>
			</StackPanel>

		</StackPanel>
	</ScrollViewer>

</UserControl>