<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="760"
             x:Class="Sys.UI.Views.NewRequestView"
             x:DataType="vm:NewRequestViewModel">

	<Design.DataContext>
		<vm:NewRequestViewModel />
	</Design.DataContext>

	<UserControl.Styles>
		<!--
		  Form stilleri bu ekranla sınırlı tutuluyor: TextBox/ComboBox için global bir
		  stil yazmak diğer tüm ekranların girdi kutularını da değiştirirdi.
		-->
		<Style Selector="TextBlock.formLabel">
			<Setter Property="FontSize" Value="11.5"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="#5B6472"/>
			<Setter Property="Margin" Value="0,0,0,5"/>
		</Style>
		<Style Selector="TextBlock.formHint">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="#A3ABB8"/>
			<Setter Property="Margin" Value="2,5,0,0"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
		<Style Selector="TextBox">
			<Setter Property="Padding" Value="11,9"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderBrush" Value="#DFE5EE"/>
			<Setter Property="Background" Value="#FBFCFE"/>
		</Style>
		<Style Selector="TextBox:focus">
			<Setter Property="Background" Value="White"/>
		</Style>
		<Style Selector="ComboBox">
			<Setter Property="Padding" Value="11,8"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderBrush" Value="#DFE5EE"/>
			<Setter Property="Background" Value="#FBFCFE"/>
		</Style>

		<!-- Sağ paneldeki özet satırları -->
		<Style Selector="TextBlock.summaryLabel">
			<Setter Property="FontSize" Value="9.5"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="#93A4BC"/>
			<Setter Property="LetterSpacing" Value="0.6"/>
		</Style>
		<Style Selector="TextBlock.summaryValue">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="#1A2E4A"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
		<Style Selector="TextBlock.summaryEmpty">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="#C4CBD6"/>
		</Style>
	</UserControl.Styles>

	<!--
	  İki sütun: solda form, sağda sabit kalan özet paneli. Sağ panel ScrollViewer'ın
	  DIŞINDA olduğu için form kaydırılırken yerinde duruyor; kullanıcı uzun formda
	  aşağı indiğinde ne girdiğini ve sonrasında ne olacağını görmeye devam ediyor.
	-->
	<Grid ColumnSpacing="22" Margin="0,0,20,0">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" MinWidth="460"/>
			<ColumnDefinition Width="300"/>
		</Grid.ColumnDefinitions>

		<!-- ==================== SOL: FORM ==================== -->
		<ScrollViewer Grid.Column="0">
			<StackPanel Spacing="16" Margin="0,0,4,24">

				<!-- Düzenleme modu bandı: sıradan bir talep girişiyle karışmasın -->
				<Border IsVisible="{Binding IsEditMode}"
						Background="#FDECEA" BorderBrush="#F0C9C1" BorderThickness="1"
						CornerRadius="10" Padding="16,12">
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
						<StackPanel Grid.Column="0" Spacing="2">
							<TextBlock Text="Talebi Düzenle" FontSize="14" FontWeight="Bold" Foreground="#A32D2D"/>
							<TextBlock Text="Değişiklikleri kaydettiğinizde talep yeniden onaya gönderilir."
									   FontSize="11.5" Foreground="#9B3B25" TextWrapping="Wrap"/>
						</StackPanel>
						<Button Grid.Column="1" Classes="flat" VerticalAlignment="Center" Command="{Binding CancelCommand}">
							<Border Background="White" BorderBrush="#F0C9C1" BorderThickness="1"
									CornerRadius="7" Padding="12,6">
								<TextBlock Text="← Vazgeç" Foreground="#A32D2D" FontSize="12"/>
							</Border>
						</Button>
					</Grid>
				</Border>

				<!--
				  Yenileme bandı. Form kaynak sözleşmenin verisiyle dolu geldiği için
				  kullanıcının bunun boş bir form OLMADIĞINI bilmesi gerekiyor; aksi
				  halde dolu alanları kendi girdiği sanılabilir. Kaynak sözleşmenin
				  numarası ve bitiş tarihi de burada, hangi dönemi yenilediği açık olsun.
				-->
				<Border IsVisible="{Binding IsRenewal}"
						Background="#EAF4EC" BorderBrush="#C3DFC9" BorderThickness="1"
						CornerRadius="10" Padding="16,12">
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
						<StackPanel Grid.Column="0" Spacing="3">
							<TextBlock Text="Sözleşme Yenileme" FontSize="14" FontWeight="Bold" Foreground="#2E6B3E"/>
							<StackPanel Orientation="Horizontal" Spacing="5">
								<TextBlock Text="Kaynak sözleşme:" FontSize="11.5" Foreground="#3F7A4F"/>
								<TextBlock Text="{Binding RenewalSourceLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="#2E6B3E"/>
								<TextBlock Text="·" FontSize="11.5" Foreground="#8FB89A"/>
								<TextBlock Text="bitiş" FontSize="11.5" Foreground="#3F7A4F"/>
								<TextBlock Text="{Binding RenewalSourceEndText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#2E6B3E"/>
							</StackPanel>
							<TextBlock Text="Alanlar kaynak sözleşmeden dolduruldu. Kontrol edip değişenleri güncelleyin; kaynak sözleşme olduğu gibi kalır."
									   FontSize="11.5" Foreground="#3F7A4F" TextWrapping="Wrap"/>
						</StackPanel>
						<Button Grid.Column="1" Classes="flat" VerticalAlignment="Center" Command="{Binding CancelCommand}">
							<Border Background="White" BorderBrush="#C3DFC9" BorderThickness="1"
									CornerRadius="7" Padding="12,6">
								<TextBlock Text="← Vazgeç" Foreground="#2E6B3E" FontSize="12"/>
							</Border>
						</Button>
					</Grid>
				</Border>

				<!-- ============ 1 · TALEP BİLGİLERİ ============ -->
				<Border Background="White" BorderBrush="#E3E7EE" BorderThickness="1"
						CornerRadius="12" Padding="24,20">
					<StackPanel Spacing="18">

						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
							<Border Grid.Column="0" Width="26" Height="26" CornerRadius="8"
									Background="#2D6EA8" VerticalAlignment="Center">
								<TextBlock Text="1" Foreground="White" FontSize="13" FontWeight="Bold"
										   HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
								<TextBlock Classes="display" Text="Talep Bilgileri" FontSize="15.5"
										   FontWeight="SemiBold" Foreground="#1A2E4A"/>
								<TextBlock Text="Yıldızlı (*) alanlar zorunludur." FontSize="11" Foreground="#A3ABB8"/>
							</StackPanel>
						</Grid>

						<Border Background="#EDF1F6" Height="1"/>

						<Grid ColumnDefinitions="*,*" ColumnSpacing="18">
							<StackPanel Grid.Column="0">
								<TextBlock Classes="formLabel" Text="SAS / YK REFERANS NO"/>
								<TextBox Text="{Binding RequestRefNo}" PlaceholderText="Örn. 2026-0142"/>
							</StackPanel>
							<StackPanel Grid.Column="1">
								<TextBlock Classes="formLabel">
									<Run Text="SÖZLEŞME TÜRÜ"/>
									<Run Text=" *" Foreground="#D14343"/>
								</TextBlock>
								<ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding Type}"
										  HorizontalAlignment="Stretch"/>
								<TextBlock Classes="fieldError" Text="{Binding TypeError}"
										   IsVisible="{Binding TypeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
							</StackPanel>
						</Grid>

						<StackPanel>
							<TextBlock Classes="formLabel">
								<Run Text="KONU / BAŞLIK"/>
								<Run Text=" *" Foreground="#D14343"/>
							</TextBlock>
							<TextBox Text="{Binding Title}" PlaceholderText="Talebin kısa ve ayırt edici başlığı"/>
							<TextBlock Classes="fieldError" Text="{Binding TitleError}"
									   IsVisible="{Binding TitleError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						</StackPanel>

						<StackPanel>
							<TextBlock Classes="formLabel" Text="TAHMİNİ BEDEL"/>
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
								<TextBox Grid.Column="0" Text="{Binding EstimatedAmountText}"
										 PlaceholderText="0,00"
										 LostFocus="OnAmountLostFocus" TextChanged="OnAmountTextChanged"/>
								<ComboBox Grid.Column="1" Width="128"
										  ItemsSource="{Binding CurrencyOptions}" SelectedItem="{Binding SelectedCurrency}"/>
							</Grid>
							<TextBlock Classes="fieldError" Text="{Binding AmountError}"
									   IsVisible="{Binding AmountError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
							<TextBlock Classes="formHint"
									   Text="Yaklaşık bir tutar yeterli. Kesin bedel, sözleşme yaratılırken kalem kalem girilir."/>
						</StackPanel>

						<StackPanel>
							<TextBlock Classes="formLabel">
								<Run Text="İŞİN TANIMI"/>
								<Run Text=" *" Foreground="#D14343"/>
							</TextBlock>
							<TextBox Text="{Binding Description}" AcceptsReturn="True" Height="120"
									 TextWrapping="Wrap" AcceptsTab="False"
									 PlaceholderText="Talebin kapsamını, gerekçesini ve beklenen çıktıyı yazın."/>
							<TextBlock Classes="fieldError" Text="{Binding DescriptionError}"
									   IsVisible="{Binding DescriptionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- ============ 2 · FİRMA BİLGİLERİ ============ -->
				<Border Background="White" BorderBrush="#E3E7EE" BorderThickness="1"
						CornerRadius="12" Padding="24,20">
					<StackPanel Spacing="18">

						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
							<Border Grid.Column="0" Width="26" Height="26" CornerRadius="8"
									Background="#2D6EA8" VerticalAlignment="Center">
								<TextBlock Text="2" Foreground="White" FontSize="13" FontWeight="Bold"
										   HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
								<TextBlock Classes="display" Text="Firma Bilgileri" FontSize="15.5"
										   FontWeight="SemiBold" Foreground="#1A2E4A"/>
								<TextBlock Text="Sözleşmenin karşı tarafı." FontSize="11" Foreground="#A3ABB8"/>
							</StackPanel>
						</Grid>

						<Border Background="#EDF1F6" Height="1"/>

						<Grid ColumnDefinitions="*,*" ColumnSpacing="18">
							<StackPanel Grid.Column="0">
								<TextBlock Classes="formLabel">
									<Run Text="FİRMA ADI"/>
									<Run Text=" *" Foreground="#D14343"/>
								</TextBlock>
								<TextBox Text="{Binding CompanyName}"/>
								<TextBlock Classes="fieldError" Text="{Binding CompanyNameError}"
										   IsVisible="{Binding CompanyNameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
							</StackPanel>
							<StackPanel Grid.Column="1">
								<TextBlock Classes="formLabel">
									<Run Text="VERGİ NO"/>
									<Run Text=" *" Foreground="#D14343"/>
								</TextBlock>
								<TextBox Text="{Binding TaxNo}" MaxLength="10" PlaceholderText="10 haneli"/>
								<TextBlock Classes="fieldError" Text="{Binding TaxNoError}"
										   IsVisible="{Binding TaxNoError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
							</StackPanel>
						</Grid>

						<Grid ColumnDefinitions="*,*" ColumnSpacing="18">
							<StackPanel Grid.Column="0">
								<TextBlock Classes="formLabel" Text="SAP CARİ KODU"/>
								<TextBox Text="{Binding SapCariKodu}" PlaceholderText="C-XXXXX (yoksa boş bırakın)"/>
							</StackPanel>
							<StackPanel Grid.Column="1">
								<TextBlock Classes="formLabel" Text="FİRMA TÜRÜ"/>
								<ComboBox ItemsSource="{Binding CompanyTypeOptions}" SelectedItem="{Binding SelectedCompanyType}"
										  HorizontalAlignment="Stretch"/>
							</StackPanel>
						</Grid>
					</StackPanel>
				</Border>

				<!-- ============ 3 · DOSYA ============ -->
				<Border Background="White" BorderBrush="#E3E7EE" BorderThickness="1"
						CornerRadius="12" Padding="24,20">
					<StackPanel Spacing="16">

						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
							<Border Grid.Column="0" Width="26" Height="26" CornerRadius="8"
									Background="#2D6EA8" VerticalAlignment="Center">
								<TextBlock Text="3" Foreground="White" FontSize="13" FontWeight="Bold"
										   HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
								<TextBlock Classes="display" Text="Dosya" FontSize="15.5"
										   FontWeight="SemiBold" Foreground="#1A2E4A"/>
								<TextBlock Text="İsteğe bağlı — taslak, teklif veya şartname." FontSize="11" Foreground="#A3ABB8"/>
							</StackPanel>
						</Grid>

						<!-- Dosya seçilmemişken: davet eden boş alan -->
						<Border IsVisible="{Binding SelectedFileName, Converter={x:Static StringConverters.IsNullOrEmpty}}"
								Background="#FAFBFD" BorderBrush="#DFE5EE" BorderThickness="1"
								CornerRadius="10" Padding="24,22">
							<StackPanel Spacing="12" HorizontalAlignment="Center">
								<Path Stroke="#B8C2D0" StrokeThickness="1.6" Fill="Transparent"
									  Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center"
									  Data="M12 16V4M12 4L7.5 8.5M12 4l4.5 4.5M4 16v2.5A1.5 1.5 0 0 0 5.5 20h13a1.5 1.5 0 0 0 1.5-1.5V16"/>
								<TextBlock Text="PDF, Word, Excel veya görsel"
										   FontSize="11.5" Foreground="#A3ABB8" HorizontalAlignment="Center"/>
								<Button Classes="flat" HorizontalAlignment="Center" Click="OnPickFileClick">
									<Border Background="#EEF1F6" BorderBrush="#C9D3E0" BorderThickness="1"
											CornerRadius="8" Padding="18,9">
										<TextBlock Text="Dosya Seç" Foreground="#3D4654" FontSize="12.5"
												   FontWeight="SemiBold"/>
									</Border>
								</Button>
							</StackPanel>
						</Border>

						<!-- Dosya seçilmişken: dosya adı, değiştir ve kaldır -->
						<Border IsVisible="{Binding SelectedFileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
								Background="#F5F9FD" BorderBrush="#C4DCF2" BorderThickness="1"
								CornerRadius="10" Padding="14,12">
							<Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
								<Path Grid.Column="0" Stroke="#2D6EA8" StrokeThickness="1.8" Fill="Transparent"
									  Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
									  Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6"/>
								<TextBlock Grid.Column="1" Text="{Binding SelectedFileName}" FontSize="12.5"
										   Foreground="#1A2E4A" VerticalAlignment="Center"
										   TextTrimming="CharacterEllipsis"/>
								<Button Grid.Column="2" Classes="flat" Click="OnPickFileClick" VerticalAlignment="Center">
									<TextBlock Text="Değiştir" Foreground="#2D6EA8" FontSize="11.5"/>
								</Button>
								<Button Grid.Column="3" Classes="flat" Command="{Binding ClearFileCommand}" VerticalAlignment="Center">
									<TextBlock Text="Kaldır" Foreground="#A32D2D" FontSize="11.5"/>
								</Button>
							</Grid>
						</Border>
					</StackPanel>
				</Border>

				<!-- Kısa özet; ayrıntı ilgili alanın altında gösteriliyor -->
				<Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
						Background="#FDECEA" BorderBrush="#F0C9C1" BorderThickness="1"
						CornerRadius="10" Padding="14,11">
					<TextBlock Text="{Binding ErrorMessage}" Foreground="#9B3B25"
							   FontSize="12.5" TextWrapping="Wrap"/>
				</Border>

				<Border IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
						Background="#E6F4E7" BorderBrush="#A9D6B0" BorderThickness="1"
						CornerRadius="10" Padding="14,11">
					<TextBlock Text="{Binding SuccessMessage}" Foreground="#1A6B2A"
							   FontSize="12.5" TextWrapping="Wrap"/>
				</Border>

			</StackPanel>
		</ScrollViewer>

		<!-- ==================== SAĞ: ÖZET + SÜREÇ ==================== -->
		<StackPanel Grid.Column="1" Spacing="14" VerticalAlignment="Top" Margin="0,0,0,24">

			<!--
			  Canlı özet: kullanıcı formda aşağı indikçe üstte ne yazdığını unutuyor.
			  Alanlar ObservableProperty olduğu için buradaki değerler yazdıkça güncellenir.
			-->
			<Border Background="White" BorderBrush="#E3E7EE" BorderThickness="1"
					CornerRadius="12" Padding="18,16">
				<StackPanel Spacing="14">
					<TextBlock Classes="sectionLabel" Text="ÖZET"/>

					<StackPanel Spacing="3">
						<TextBlock Classes="summaryLabel" Text="KONU"/>
						<TextBlock Classes="summaryValue" Text="{Binding Title}"
								   IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						<TextBlock Classes="summaryEmpty" Text="—"
								   IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
					</StackPanel>

					<StackPanel Spacing="3">
						<TextBlock Classes="summaryLabel" Text="FİRMA"/>
						<TextBlock Classes="summaryValue" Text="{Binding CompanyName}"
								   IsVisible="{Binding CompanyName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						<TextBlock Classes="summaryEmpty" Text="—"
								   IsVisible="{Binding CompanyName, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
					</StackPanel>

					<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
						<StackPanel Grid.Column="0" Spacing="3">
							<TextBlock Classes="summaryLabel" Text="TÜR"/>
							<TextBlock Classes="summaryValue" Text="{Binding Type}"
									   IsVisible="{Binding Type, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
							<TextBlock Classes="summaryEmpty" Text="—"
									   IsVisible="{Binding Type, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
						</StackPanel>
						<StackPanel Grid.Column="1" Spacing="3">
							<TextBlock Classes="summaryLabel" Text="TAHMİNİ BEDEL"/>
							<TextBlock Classes="summaryValue" FontWeight="SemiBold"
									   IsVisible="{Binding EstimatedAmountText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
								<Run Text="{Binding EstimatedAmountText}"/>
								<Run Text=" "/>
								<Run Text="{Binding SelectedCurrency}"/>
							</TextBlock>
							<TextBlock Classes="summaryEmpty" Text="—"
									   IsVisible="{Binding EstimatedAmountText, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
						</StackPanel>
					</Grid>
				</StackPanel>
			</Border>

			<!--
			  Talebi açan kişi çoğu zaman "gönderdim, şimdi ne olacak?" diye soruyor.
			  Onay zinciri burada, gönderme butonunun hemen yanında yazılı.
			-->
			<Border Background="#F7F9FC" BorderBrush="#DFE5EE" BorderThickness="1"
					CornerRadius="12" Padding="18,16">
				<StackPanel Spacing="12">
					<TextBlock Classes="sectionLabel" Text="GÖNDERDİKTEN SONRA"/>

					<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
						<Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#2D6EA8"
								VerticalAlignment="Top" Margin="0,1,0,0">
							<TextBlock Text="1" Foreground="White" FontSize="10" FontWeight="Bold"
									   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<TextBlock Grid.Column="1" Text="SYB talebi inceler ve sözleşmeyi hazırlar."
								   FontSize="11.5" Foreground="#5B6472" TextWrapping="Wrap"/>
					</Grid>

					<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
						<Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#7FA3C9"
								VerticalAlignment="Top" Margin="0,1,0,0">
							<TextBlock Text="2" Foreground="White" FontSize="10" FontWeight="Bold"
									   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<TextBlock Grid.Column="1" Text="SYB son kontrolü yapar."
								   FontSize="11.5" Foreground="#5B6472" TextWrapping="Wrap"/>
					</Grid>

					<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
						<Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#A9C0D9"
								VerticalAlignment="Top" Margin="0,1,0,0">
							<TextBlock Text="3" Foreground="White" FontSize="10" FontWeight="Bold"
									   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<TextBlock Grid.Column="1" Text="Yönetim (YK) onayıyla sözleşme yürürlüğe girer."
								   FontSize="11.5" Foreground="#5B6472" TextWrapping="Wrap"/>
					</Grid>

					<Border Background="#EDF1F6" Height="1"/>

					<TextBlock Text="Her adımda bildirim alırsınız. Talep reddedilirse gerekçesi Sözleşmeler ekranında görünür."
							   FontSize="11" Foreground="#A3ABB8" TextWrapping="Wrap"/>
				</StackPanel>
			</Border>

			<!-- Aksiyon çubuğu: kaydırmayla kaybolmasın diye sağ panelde sabit -->
			<StackPanel Spacing="8">
				<Button Classes="flat" HorizontalAlignment="Stretch"
						Command="{Binding SubmitCommand}" IsEnabled="{Binding !IsBusy}">
					<Border Background="#2D6EA8" CornerRadius="9" Padding="18,12">
						<TextBlock Text="{Binding SubmitButtonText}" Foreground="White"
								   FontSize="13" FontWeight="SemiBold"
								   HorizontalAlignment="Center"/>
					</Border>
				</Button>
				<Button Classes="flat" HorizontalAlignment="Stretch"
						IsVisible="{Binding IsEditMode}" Command="{Binding CancelCommand}">
					<Border Background="White" BorderBrush="#DFE5EE" BorderThickness="1"
							CornerRadius="9" Padding="18,11">
						<TextBlock Text="Vazgeç" Foreground="#5B6472" FontSize="12.5"
								   HorizontalAlignment="Center"/>
					</Border>
				</Button>
			</StackPanel>

		</StackPanel>
	</Grid>

</UserControl>
