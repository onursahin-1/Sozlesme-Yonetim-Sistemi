<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sys.UI.ViewModels"
             x:Class="Sys.UI.Views.ArchiveView"
             x:DataType="vm:ArchiveViewModel">

    <Grid ColumnDefinitions="320,*" Margin="24">

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="Arşiv" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="Sona eren ve feshedilen sözleşmeler — salt okunur" FontSize="12" Foreground="Gray" Margin="0,0,0,12" TextWrapping="Wrap"/>
            <TextBlock Text="Henüz arşivlenmiş sözleşme yok." IsVisible="{Binding !AvailableContracts.Count}" Foreground="Gray"/>
            <ListBox ItemsSource="{Binding AvailableContracts}"
                     SelectedItem="{Binding SelectedContract}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="2" Margin="0,4">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CompanyName}" FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="16">

                <TextBlock Text="Detayları görmek için soldan bir sözleşme seçin."
                           IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNull}}"
                           Foreground="Gray"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <Border IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Background="#F0F0F0" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding DetailTitle}" FontSize="18" FontWeight="Bold" Foreground="Black"/>
                        <TextBlock Text="{Binding DetailCompany}" Foreground="Black"/>
                        <TextBlock Text="{Binding DetailStatus}" Foreground="Black"/>
                        <TextBlock Text="{Binding DetailTotal}" Foreground="Black"/>
                        <TextBlock Text="{Binding DetailStart}" Foreground="Black"/>
                        <TextBlock Text="{Binding DetailEnd}" Foreground="Black"/>
                    </StackPanel>
                </Border>

                <Border IsVisible="{Binding HasTerminationInfo}"
                        Background="#FBE4E4" BorderBrush="#A32D2D" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Fesih Bilgisi" FontWeight="Bold" Foreground="#A32D2D"/>
                        <TextBlock Text="{Binding TerminationInfo}" Foreground="Black" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <StackPanel IsVisible="{Binding Items.Count}">
                    <TextBlock Text="Kalemler" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4">
                                    <Grid ColumnDefinitions="2*,*,*,*">
                                        <TextBlock Grid.Column="0" Text="{Binding Description}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Quantity}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding UnitPrice}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding LineTotal}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel IsVisible="{Binding Attachments.Count}">
                    <TextBlock Text="Dosyalar" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Attachments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4">
                                    <TextBlock Text="{Binding FileName}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel IsVisible="{Binding ApprovalLogs.Count}">
                    <TextBlock Text="Aşama Geçmişi" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding ApprovalLogs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4">
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="Bold">
                                            <Run Text="{Binding StepNumber}"/>
                                            <Run Text=". Adım — "/>
                                            <Run Text="{Binding StepName}"/>
                                            <Run Text=" — "/>
                                            <Run Text="{Binding Decision}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" FontStyle="Italic"/>
                                        <TextBlock Text="{Binding ActionDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" FontSize="11" Foreground="Gray"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>