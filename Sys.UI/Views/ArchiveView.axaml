<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sys.UI.ViewModels"
             x:Class="Sys.UI.Views.ArchiveView"
             x:DataType="vm:ArchiveViewModel">

	<!-- Renkli butonlar Classes="flat" kullanır; stil tanımı App.axaml içindedir. -->
	<Grid ColumnDefinitions="320,*" Margin="24">

		<!--
		  Sol: arşivlenmiş sözleşmeler.
		  DockPanel kullanılıyor (eskiden StackPanel'di): StackPanel çocuklarına sınırsız
		  yükseklik verdiği için ListBox tüm kayıtlar kadar uzuyor ve kendi kaydırma
		  çubuğu devreye girmiyordu. Arşiv zamanla sürekli büyüyen bir liste olduğundan
		  bu er geç sorun çıkaracaktı.
		-->
		<DockPanel Grid.Column="0" Margin="0,0,16,0">
			<!-- Başlık burada tekrar yazılmıyor; kabuk (ShellView) zaten üstte gösteriyor. -->
			<TextBlock DockPanel.Dock="Top"
					   Text="Sona eren ve feshedilen sözleşmeler — salt okunur"
					   FontSize="12" Foreground="Gray" Margin="0,0,0,12" TextWrapping="Wrap"/>
			<TextBlock DockPanel.Dock="Top" Text="Henüz arşivlenmiş sözleşme yok."
					   IsVisible="{Binding !AvailableContracts.Count}" Foreground="Gray"/>
			<ListBox ItemsSource="{Binding AvailableContracts}"
                     SelectedItem="{Binding SelectedContract}">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<StackPanel Spacing="2" Margin="0,4">
							<TextBlock Text="{Binding Title}" FontWeight="Bold"/>
							<TextBlock Text="{Binding CompanyName}" FontSize="11" Foreground="Gray"/>
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</DockPanel>

		<ScrollViewer Grid.Column="1">
			<StackPanel Spacing="16">

				<TextBlock Text="Detayları görmek için soldan bir sözleşme seçin."
                           IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNull}}"
                           Foreground="Gray"/>

				<TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

				<Button Classes="flat" HorizontalAlignment="Left"
						IsVisible="{Binding CanPrint}"
						Click="OnPrintClick"
						ToolTip.Tip="Sözleşme künyesini PDF olarak kaydeder ve açar">
					<Border Background="#2D6EA8" CornerRadius="4" Padding="12,6">
						<TextBlock Text="🖨 Yazdır" Foreground="White" FontSize="12"/>
					</Border>
				</Button>

				<!-- Künye kartı: sözleşme detay ekranıyla aynı düzen ve stiller -->
				<Border IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}"
						Background="White" BorderBrush="#D0D8E4" BorderThickness="1"
						CornerRadius="10" Padding="20">
					<StackPanel Spacing="14">

						<Grid ColumnDefinitions="*,Auto">
							<StackPanel Grid.Column="0" Spacing="3">
								<TextBlock Text="{Binding DetailTitle}" FontSize="19" FontWeight="Bold"
										   Foreground="#1A2E4A" TextWrapping="Wrap"/>
								<TextBlock Text="{Binding DetailNo}" FontSize="12" Foreground="#8A94A6"/>
							</StackPanel>
							<Border Grid.Column="1" VerticalAlignment="Top" Margin="12,2,0,0"
									Background="{Binding DetailStatusBgHex}" CornerRadius="10" Padding="10,4">
								<TextBlock Text="{Binding DetailStatus}" Foreground="{Binding DetailStatusColorHex}"
										   FontSize="11" FontWeight="Bold"/>
							</Border>
						</Grid>

						<Border Background="#EDF1F6" Height="1"/>

						<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
							  ColumnSpacing="24" RowSpacing="14">

							<StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="FİRMA"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailCompany}"/>
							</StackPanel>
							<StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="SAP CARİ"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailSapCariKodu}"/>
							</StackPanel>

							<StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="VERGİ NO"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailTaxNo}"/>
							</StackPanel>
							<StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="TÜR"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailType}"/>
							</StackPanel>

							<StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="BEDEL"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailTotal}"/>
							</StackPanel>
							<StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="ÖDEME PERİYODU"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailPeriod}"/>
							</StackPanel>

							<StackPanel Grid.Row="3" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="BAŞLANGIÇ"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailStart}"/>
							</StackPanel>
							<StackPanel Grid.Row="3" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="BİTİŞ"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailEnd}"/>
							</StackPanel>

							<StackPanel Grid.Row="4" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="TALEP EDEN"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailRequester}"/>
							</StackPanel>
							<StackPanel Grid.Row="4" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="DEPARTMAN"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailDepartment}"/>
							</StackPanel>
						</Grid>

					</StackPanel>
				</Border>

				<Border IsVisible="{Binding HasTerminationInfo}"
                        Background="#FBE4E4" BorderBrush="#A32D2D" BorderThickness="1"
						CornerRadius="10" Padding="20">
					<StackPanel Spacing="6">
						<TextBlock Text="FESİH BİLGİSİ" FontSize="10" FontWeight="Bold" Foreground="#A32D2D"/>
						<TextBlock Text="{Binding TerminationInfo}" Foreground="#1A2E4A" FontSize="12.5" TextWrapping="Wrap"/>
					</StackPanel>
				</Border>

				<!-- Sözleşme detay ekranıyla aynı iki sütunlu yerleşim -->
				<Grid ColumnDefinitions="330,*" ColumnSpacing="16">

					<StackPanel Grid.Column="0" VerticalAlignment="Top">
						<Border IsVisible="{Binding Steps.Count}"
								Background="White" BorderBrush="#D0D8E4" BorderThickness="1"
								CornerRadius="10" Padding="20">
							<StackPanel Spacing="12">
								<TextBlock Text="SÜREÇ ADIMLARI" FontSize="10" FontWeight="Bold" Foreground="#8A94A6"/>

								<ItemsControl ItemsSource="{Binding Steps}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:ContractStepViewModel">
											<Grid ColumnDefinitions="Auto,*">

												<Grid Grid.Column="0" RowDefinitions="Auto,*" Width="22">
													<Border Grid.Row="0" Width="18" Height="18" CornerRadius="9"
															Background="{Binding IconBgHex}"
															BorderBrush="{Binding IconBorderHex}" BorderThickness="1.5"
															HorizontalAlignment="Center">
														<TextBlock Text="{Binding Icon}" FontSize="10" FontWeight="Bold"
																   Foreground="{Binding IconColorHex}"
																   HorizontalAlignment="Center" VerticalAlignment="Center"/>
													</Border>
													<Border Grid.Row="1" Width="2" MinHeight="14"
															Background="{Binding ConnectorColorHex}"
															HorizontalAlignment="Center"/>
												</Grid>

												<StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
													<TextBlock Text="{Binding Label}" FontSize="12.5"
															   Foreground="{Binding LabelColorHex}"
															   FontWeight="{Binding LabelWeight}"
															   TextWrapping="Wrap"/>
													<TextBlock Text="{Binding DateText}" FontSize="10.5" Foreground="#9CA3AF"
															   IsVisible="{Binding HasDate}"/>
													<TextBlock Text="{Binding Note}" FontSize="11" Foreground="#7A5C10"
															   FontStyle="Italic" TextWrapping="Wrap"
															   IsVisible="{Binding HasNote}"/>
												</StackPanel>
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>
					</StackPanel>

					<StackPanel Grid.Column="1" Spacing="16">

						<Border IsVisible="{Binding Items.Count}"
								Background="White" BorderBrush="#D0D8E4" BorderThickness="1"
								CornerRadius="10" Padding="20">
							<StackPanel Spacing="10">
								<TextBlock Text="KALEMLER" FontSize="10" FontWeight="Bold" Foreground="#8A94A6"/>

								<Grid ColumnDefinitions="2*,Auto,*,*" ColumnSpacing="12">
									<TextBlock Grid.Column="0" Text="Açıklama" FontSize="11" FontWeight="Bold" Foreground="#8A94A6"/>
									<TextBlock Grid.Column="1" Text="Miktar" FontSize="11" FontWeight="Bold" Foreground="#8A94A6" Width="70" TextAlignment="Right"/>
									<TextBlock Grid.Column="2" Text="Birim Fiyat" FontSize="11" FontWeight="Bold" Foreground="#8A94A6" TextAlignment="Right"/>
									<TextBlock Grid.Column="3" Text="Tutar" FontSize="11" FontWeight="Bold" Foreground="#8A94A6" TextAlignment="Right"/>
								</Grid>
								<Border Background="#EDF1F6" Height="1"/>

								<ItemsControl ItemsSource="{Binding Items}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border BorderBrush="#EDF1F6" BorderThickness="0,0,0,1" Padding="0,7">
												<Grid ColumnDefinitions="2*,Auto,*,*" ColumnSpacing="12">
													<TextBlock Grid.Column="0" Text="{Binding Description}" FontSize="12.5"
															   Foreground="#1A2E4A" TextWrapping="Wrap"/>
													<TextBlock Grid.Column="1" FontSize="12.5" Foreground="#4B5563"
															   Width="70" TextAlignment="Right">
														<Run Text="{Binding Quantity}"/>
														<Run Text=" "/>
														<Run Text="{Binding Unit}"/>
													</TextBlock>
													<TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:N2}}"
															   FontSize="12.5" Foreground="#4B5563" TextAlignment="Right"/>
													<TextBlock Grid.Column="3" Text="{Binding LineTotal, StringFormat={}{0:N2}}"
															   FontSize="12.5" Foreground="#1A2E4A" FontWeight="Bold" TextAlignment="Right"/>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>

						<Border IsVisible="{Binding Attachments.Count}"
								Background="White" BorderBrush="#D0D8E4" BorderThickness="1"
								CornerRadius="10" Padding="20">
							<StackPanel Spacing="10">
								<TextBlock Text="DOSYALAR" FontSize="10" FontWeight="Bold" Foreground="#8A94A6"/>
								<ItemsControl ItemsSource="{Binding Attachments}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border BorderBrush="#EDF1F6" BorderThickness="0,0,0,1" Padding="0,7">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="12.5"
															   Foreground="#1A2E4A" VerticalAlignment="Center"/>
													<Button Grid.Column="1" Content="Aç"
															Command="{Binding $parent[UserControl].((vm:ArchiveViewModel)DataContext).OpenAttachmentCommand}"
															CommandParameter="{Binding}"/>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>

					</StackPanel>
				</Grid>

			</StackPanel>
		</ScrollViewer>

	</Grid>
</UserControl>
