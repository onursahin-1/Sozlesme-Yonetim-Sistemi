<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:conv="using:Sys.UI.Converters"
             x:Class="Sys.UI.Views.ArchiveView"
             x:DataType="vm:ArchiveViewModel">

	<UserControl.Styles>
		<!-- Kart zaten görsel birim; ListBoxItem'ın kendi dolgusu/vurgusu kaldırılıyor. -->
		<Style Selector="ListBox">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="0"/>
		</Style>
		<Style Selector="ListBoxItem">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0"/>
		</Style>
		<Style Selector="ListBoxItem /template/ ContentPresenter">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="CornerRadius" Value="8"/>
		</Style>
	</UserControl.Styles>

	<!-- Renkli butonlar Classes="flat" kullanır; stil tanımı App.axaml içindedir. -->
	<Grid ColumnDefinitions="340,*" Margin="24">

		<!--
		  Sol: arşivlenmiş kayıtlar.
		  DockPanel kullanılıyor (eskiden StackPanel'di): StackPanel çocuklarına sınırsız
		  yükseklik verdiği için ListBox tüm kayıtlar kadar uzuyor ve kendi kaydırma
		  çubuğu devreye girmiyordu.
		-->
		<DockPanel Grid.Column="0" Margin="0,0,16,0">

			<!-- Başlık burada tekrar yazılmıyor; kabuk (ShellView) zaten üstte gösteriyor. -->
			<TextBlock DockPanel.Dock="Top"
					   Text="Süresi dolan, feshedilen ve reddedilen kayıtlar — salt okunur"
					   FontSize="12" Foreground="#8A94A6" Margin="0,0,0,10" TextWrapping="Wrap"/>

			<Border DockPanel.Dock="Top" Background="White" BorderBrush="#DDE3EC" BorderThickness="1"
					CornerRadius="8" Margin="0,0,0,10">
				<Grid ColumnDefinitions="Auto,*">
					<Path Grid.Column="0" Stroke="#A3ABB8" StrokeThickness="2" Fill="Transparent"
						  Width="13" Height="13" Stretch="Uniform" Margin="11,0,0,0"
						  VerticalAlignment="Center"
						  Data="M11 11L15 15M12.5 7.5A5 5 0 1 1 2.5 7.5a5 5 0 0 1 10 0z"/>
					<TextBox Grid.Column="1" Text="{Binding SearchText}"
							 PlaceholderText="Başlık, firma veya no ile ara..."
							 Background="Transparent" BorderThickness="0"
							 Padding="9,8" FontSize="12"/>
				</Grid>
			</Border>

			<!-- Arşivde neyin neden bulunduğunu ayırt edebilmek için durum filtreleri -->
			<WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
				<Button Classes="flat" Command="{Binding SetFilterCommand}" CommandParameter="tumu"
						Margin="0,0,6,6">
					<Border CornerRadius="14" Padding="12,5"
							Background="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Background}, ConverterParameter=tumu}">
						<TextBlock Text="Tümü" FontSize="11.5" FontWeight="SemiBold"
								   Foreground="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Foreground}, ConverterParameter=tumu}"/>
					</Border>
				</Button>
				<Button Classes="flat" Command="{Binding SetFilterCommand}" CommandParameter="tamamlandi"
						Margin="0,0,6,6">
					<Border CornerRadius="14" Padding="12,5"
							Background="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Background}, ConverterParameter=tamamlandi}">
						<TextBlock Text="Süresi Doldu" FontSize="11.5" FontWeight="SemiBold"
								   Foreground="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Foreground}, ConverterParameter=tamamlandi}"/>
					</Border>
				</Button>
				<Button Classes="flat" Command="{Binding SetFilterCommand}" CommandParameter="feshedildi"
						Margin="0,0,6,6">
					<Border CornerRadius="14" Padding="12,5"
							Background="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Background}, ConverterParameter=feshedildi}">
						<TextBlock Text="Feshedildi" FontSize="11.5" FontWeight="SemiBold"
								   Foreground="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Foreground}, ConverterParameter=feshedildi}"/>
					</Border>
				</Button>
				<Button Classes="flat" Command="{Binding SetFilterCommand}" CommandParameter="reddedildi"
						Margin="0,0,6,6">
					<Border CornerRadius="14" Padding="12,5"
							Background="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Background}, ConverterParameter=reddedildi}">
						<TextBlock Text="Reddedildi" FontSize="11.5" FontWeight="SemiBold"
								   Foreground="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Foreground}, ConverterParameter=reddedildi}"/>
					</Border>
				</Button>
			</WrapPanel>

			<!-- Sayfalama: arşiv sürekli büyüdüğü için liste 10'arlı sayfalanır -->
			<Border DockPanel.Dock="Bottom" IsVisible="{Binding ShowPager}" Margin="0,10,0,0">
				<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
					<Button Classes="flat" IsEnabled="{Binding CanGoPrevious}" Command="{Binding PreviousPageCommand}">
						<Border Background="#EEF1F6" BorderBrush="#DDE3EC" BorderThickness="1"
								CornerRadius="6" Padding="10,5">
							<TextBlock Text="‹" Foreground="#3D4654" FontSize="12"/>
						</Border>
					</Button>
					<TextBlock Text="{Binding PageInfoText}" VerticalAlignment="Center"
							   FontSize="11.5" Foreground="#8A94A6"/>
					<Button Classes="flat" IsEnabled="{Binding CanGoNext}" Command="{Binding NextPageCommand}">
						<Border Background="#EEF1F6" BorderBrush="#DDE3EC" BorderThickness="1"
								CornerRadius="6" Padding="10,5">
							<TextBlock Text="›" Foreground="#3D4654" FontSize="12"/>
						</Border>
					</Button>
				</StackPanel>
			</Border>

			<StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,20,0,0" IsVisible="{Binding IsEmpty}">
				<TextBlock Text="Bu filtrelerle eşleşen arşiv kaydı yok." Foreground="#8A94A6"
						   FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"/>
				<Button Classes="flat" HorizontalAlignment="Center" Command="{Binding ClearFiltersCommand}"
						IsVisible="{Binding HasActiveFilters}">
					<Border Background="#EEF1F6" BorderBrush="#DDE3EC" BorderThickness="1"
							CornerRadius="6" Padding="12,6">
						<TextBlock Text="Filtreleri temizle" Foreground="#3D4654" FontSize="11.5"/>
					</Border>
				</Button>
			</StackPanel>

			<ListBox ItemsSource="{Binding AvailableContracts}"
                     SelectedItem="{Binding SelectedContract}">
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="vm:ContractCardViewModel">
						<Border Background="White" BorderBrush="#E3E7EE" BorderThickness="1"
								CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
							<StackPanel Spacing="6">
								<TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5"
										   Foreground="#1A2E4A" TextWrapping="Wrap"/>
								<TextBlock Text="{Binding CompanyName}" FontSize="11" Foreground="#8A94A6"
										   TextWrapping="Wrap"/>
								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
									<!-- Rozet: kaydın arşive neden düştüğünü tek bakışta gösterir -->
									<Border Grid.Column="0" Background="{Binding StatusBgHex}"
											CornerRadius="9" Padding="8,2" VerticalAlignment="Center">
										<TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColorHex}"
												   FontSize="10" FontWeight="Bold"/>
									</Border>
									<TextBlock Grid.Column="1" Text="{Binding ArchiveDateText}" FontSize="10.5"
											   Foreground="#A3ABB8" VerticalAlignment="Center"
											   HorizontalAlignment="Right"/>
								</Grid>
							</StackPanel>
						</Border>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</DockPanel>

		<ScrollViewer Grid.Column="1">
			<StackPanel Spacing="16">

				<TextBlock Text="Detayları görmek için soldan bir sözleşme seçin."
                           IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNull}}"
                           Foreground="Gray"/>

				<TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

				<!--
				  İki ayrı işlem: "Yazdır" belgeyi doğrudan yazıcıya gönderir,
				  "PDF Kaydet" ise dosya olarak diske yazar. Eskiden tek bir "Yazdır"
				  butonu vardı ve aslında yalnızca kaydedip görüntüleyicide açıyordu.
				-->
				<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left"
							IsVisible="{Binding CanPrint}">
					<Button Classes="flat" Command="{Binding PrintCommand}"
							ToolTip.Tip="Sözleşme künyesini varsayılan yazıcıya gönderir">
						<Border Background="#2D6EA8" CornerRadius="8" Padding="14,9">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Path Stroke="White" StrokeThickness="1.7" Fill="Transparent"
									  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
									  Data="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2M6 14h12v8H6z"/>
								<TextBlock Text="Yazdır" Foreground="White" FontSize="12.5"
										   FontWeight="SemiBold" VerticalAlignment="Center"/>
							</StackPanel>
						</Border>
					</Button>
					<Button Classes="flat" Click="OnExportPdfClick"
							ToolTip.Tip="Sözleşme künyesini PDF dosyası olarak kaydeder">
						<Border Background="White" BorderBrush="#C9D3E0" BorderThickness="1"
								CornerRadius="8" Padding="14,8">
							<TextBlock Text="PDF Kaydet" Foreground="#3D4654" FontSize="12.5"/>
						</Border>
					</Button>
				</StackPanel>

				<!-- Künye kartı: sözleşme detay ekranıyla aynı düzen ve stiller -->
				<Border IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}"
						Background="White" BorderBrush="#D0D8E4" BorderThickness="1"
						CornerRadius="10" Padding="20">
					<StackPanel Spacing="14">

						<Grid ColumnDefinitions="*,Auto">
							<StackPanel Grid.Column="0" Spacing="3">
								<TextBlock Text="{Binding DetailTitle}" FontSize="19" FontWeight="Bold"
										   Foreground="#1A2E4A" TextWrapping="Wrap"/>
								<TextBlock Text="{Binding DetailNo}" FontSize="12" Foreground="#8A94A6"/>
							</StackPanel>
							<Border Grid.Column="1" VerticalAlignment="Top" Margin="12,2,0,0"
									Background="{Binding DetailStatusBgHex}" CornerRadius="10" Padding="10,4">
								<TextBlock Text="{Binding DetailStatus}" Foreground="{Binding DetailStatusColorHex}"
										   FontSize="11" FontWeight="Bold"/>
							</Border>
						</Grid>

						<Border Background="#EDF1F6" Height="1"/>

						<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
							  ColumnSpacing="24" RowSpacing="14">

							<StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="FİRMA"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailCompany}"/>
							</StackPanel>
							<StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="SAP CARİ"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailSapCariKodu}"/>
							</StackPanel>

							<StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="VERGİ NO"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailTaxNo}"/>
							</StackPanel>
							<StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="TÜR"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailType}"/>
							</StackPanel>

							<StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="BEDEL"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailTotal}"/>
							</StackPanel>
							<StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="ÖDEME PERİYODU"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailPeriod}"/>
							</StackPanel>

							<StackPanel Grid.Row="3" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="BAŞLANGIÇ"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailStart}"/>
							</StackPanel>
							<StackPanel Grid.Row="3" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="BİTİŞ"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailEnd}"/>
							</StackPanel>

							<StackPanel Grid.Row="4" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="TALEP EDEN"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailRequester}"/>
							</StackPanel>
							<StackPanel Grid.Row="4" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="DEPARTMAN"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailDepartment}"/>
							</StackPanel>
						</Grid>

					</StackPanel>
				</Border>

				<Border IsVisible="{Binding HasTerminationInfo}"
                        Background="#FBE4E4" BorderBrush="#A32D2D" BorderThickness="1"
						CornerRadius="10" Padding="20">
					<StackPanel Spacing="6">
						<TextBlock Text="FESİH BİLGİSİ" FontSize="10" FontWeight="Bold" Foreground="#A32D2D"/>
						<TextBlock Text="{Binding TerminationInfo}" Foreground="#1A2E4A" FontSize="12.5" TextWrapping="Wrap"/>
					</StackPanel>
				</Border>

				<!-- Fesih bilgisi kutusunun karşılığı: reddedilerek kapatılan talepler için -->
				<Border IsVisible="{Binding HasRejectionInfo}"
						Background="#FBE4E4" BorderBrush="#A32D2D" BorderThickness="1"
						CornerRadius="10" Padding="20">
					<StackPanel Spacing="6">
						<TextBlock Text="RED BİLGİSİ" FontSize="10" FontWeight="Bold" Foreground="#A32D2D"/>
						<TextBlock Text="{Binding RejectionInfo}" Foreground="#1A2E4A" FontSize="12.5" TextWrapping="Wrap"/>
					</StackPanel>
				</Border>

				<!-- Sözleşme detay ekranıyla aynı iki sütunlu yerleşim -->
				<Grid ColumnDefinitions="330,*" ColumnSpacing="16">

					<StackPanel Grid.Column="0" VerticalAlignment="Top">
						<Border IsVisible="{Binding Steps.Count}"
								Background="White" BorderBrush="#D0D8E4" BorderThickness="1"
								CornerRadius="10" Padding="20">
							<StackPanel Spacing="12">
								<TextBlock Text="SÜREÇ ADIMLARI" FontSize="10" FontWeight="Bold" Foreground="#8A94A6"/>

								<ItemsControl ItemsSource="{Binding Steps}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:ContractStepViewModel">
											<Grid ColumnDefinitions="Auto,*">

												<Grid Grid.Column="0" RowDefinitions="Auto,*" Width="22">
													<Border Grid.Row="0" Width="18" Height="18" CornerRadius="9"
															Background="{Binding IconBgHex}"
															BorderBrush="{Binding IconBorderHex}" BorderThickness="1.5"
															HorizontalAlignment="Center">
														<TextBlock Text="{Binding Icon}" FontSize="10" FontWeight="Bold"
																   Foreground="{Binding IconColorHex}"
																   HorizontalAlignment="Center" VerticalAlignment="Center"/>
													</Border>
													<Border Grid.Row="1" Width="2" MinHeight="14"
															Background="{Binding ConnectorColorHex}"
															HorizontalAlignment="Center"/>
												</Grid>

												<StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
													<TextBlock Text="{Binding Label}" FontSize="12.5"
															   Foreground="{Binding LabelColorHex}"
															   FontWeight="{Binding LabelWeight}"
															   TextWrapping="Wrap"/>
													<TextBlock Text="{Binding DateText}" FontSize="10.5" Foreground="#9CA3AF"
															   IsVisible="{Binding HasDate}"/>
													<TextBlock Text="{Binding Note}" FontSize="11" Foreground="#7A5C10"
															   FontStyle="Italic" TextWrapping="Wrap"
															   IsVisible="{Binding HasNote}"/>
												</StackPanel>
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>
					</StackPanel>

					<StackPanel Grid.Column="1" Spacing="16">

						<Border IsVisible="{Binding Items.Count}"
								Background="White" BorderBrush="#D0D8E4" BorderThickness="1"
								CornerRadius="10" Padding="20">
							<StackPanel Spacing="10">
								<TextBlock Text="KALEMLER" FontSize="10" FontWeight="Bold" Foreground="#8A94A6"/>

								<Grid ColumnDefinitions="2*,Auto,*,*" ColumnSpacing="12">
									<TextBlock Grid.Column="0" Text="Açıklama" FontSize="11" FontWeight="Bold" Foreground="#8A94A6"/>
									<TextBlock Grid.Column="1" Text="Miktar" FontSize="11" FontWeight="Bold" Foreground="#8A94A6" Width="70" TextAlignment="Right"/>
									<TextBlock Grid.Column="2" Text="Birim Fiyat" FontSize="11" FontWeight="Bold" Foreground="#8A94A6" TextAlignment="Right"/>
									<TextBlock Grid.Column="3" Text="Tutar" FontSize="11" FontWeight="Bold" Foreground="#8A94A6" TextAlignment="Right"/>
								</Grid>
								<Border Background="#EDF1F6" Height="1"/>

								<ItemsControl ItemsSource="{Binding Items}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border BorderBrush="#EDF1F6" BorderThickness="0,0,0,1" Padding="0,7">
												<Grid ColumnDefinitions="2*,Auto,*,*" ColumnSpacing="12">
													<TextBlock Grid.Column="0" Text="{Binding Description}" FontSize="12.5"
															   Foreground="#1A2E4A" TextWrapping="Wrap"/>
													<TextBlock Grid.Column="1" FontSize="12.5" Foreground="#4B5563"
															   Width="70" TextAlignment="Right">
														<Run Text="{Binding Quantity}"/>
														<Run Text=" "/>
														<Run Text="{Binding Unit}"/>
													</TextBlock>
													<TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:N2}}"
															   FontSize="12.5" Foreground="#4B5563" TextAlignment="Right"/>
													<TextBlock Grid.Column="3" Text="{Binding LineTotal, StringFormat={}{0:N2}}"
															   FontSize="12.5" Foreground="#1A2E4A" FontWeight="Bold" TextAlignment="Right"/>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>

						<Border IsVisible="{Binding Attachments.Count}"
								Background="White" BorderBrush="#D0D8E4" BorderThickness="1"
								CornerRadius="10" Padding="20">
							<StackPanel Spacing="10">
								<TextBlock Text="DOSYALAR" FontSize="10" FontWeight="Bold" Foreground="#8A94A6"/>
								<ItemsControl ItemsSource="{Binding Attachments}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border BorderBrush="#EDF1F6" BorderThickness="0,0,0,1" Padding="0,7">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="12.5"
															   Foreground="#1A2E4A" VerticalAlignment="Center"/>
													<Button Grid.Column="1" Content="Aç"
															Command="{Binding $parent[UserControl].((vm:ArchiveViewModel)DataContext).OpenAttachmentCommand}"
															CommandParameter="{Binding}"/>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>

					</StackPanel>
				</Grid>

			</StackPanel>
		</ScrollViewer>

	</Grid>
</UserControl>
