<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sys.UI.ViewModels"
             xmlns:conv="using:Sys.UI.Converters"
             x:Class="Sys.UI.Views.ArchiveView"
             x:DataType="vm:ArchiveViewModel">

	<UserControl.Styles>
		<!-- Kart zaten görsel birim; ListBoxItem'ın kendi dolgusu/vurgusu kaldırılıyor. -->
		<Style Selector="ListBox">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="0"/>
		</Style>
		<Style Selector="ListBoxItem">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0"/>
		</Style>
		<Style Selector="ListBoxItem /template/ ContentPresenter">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="CornerRadius" Value="8"/>
		</Style>
	</UserControl.Styles>

	<!-- Renkli butonlar Classes="flat" kullanır; stil tanımı App.axaml içindedir. -->
	<Grid ColumnDefinitions="340,*" Margin="24">

		<!--
		  Sol: arşivlenmiş kayıtlar.
		  DockPanel kullanılıyor (eskiden StackPanel'di): StackPanel çocuklarına sınırsız
		  yükseklik verdiği için ListBox tüm kayıtlar kadar uzuyor ve kendi kaydırma
		  çubuğu devreye girmiyordu.
		-->
		<DockPanel Grid.Column="0" Margin="0,0,16,0">

			<!-- Başlık burada tekrar yazılmıyor; kabuk (ShellView) zaten üstte gösteriyor. -->
			<TextBlock DockPanel.Dock="Top"
					   Text="{DynamicResource Arc.Subtitle}"
					   FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10" TextWrapping="Wrap"/>

			<!--
			  Arama kutusunun yanındaki Excel butonu LİSTEYE ait (aşağıdaki Yazdır /
			  PDF Kaydet ise seçili tek sözleşmeye). Ekrandaki filtre ve arama aynen
			  uygulanır, görünen sayfa değil eşleşen tüm kayıtlar aktarılır.
			-->
			<Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,10">
				<Border Grid.Column="0" Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderButton}" BorderThickness="1"
						CornerRadius="8">
					<Grid ColumnDefinitions="Auto,*">
						<Path Grid.Column="0" Stroke="{DynamicResource TextFaintAlt}" StrokeThickness="2" Fill="Transparent"
							  Width="13" Height="13" Stretch="Uniform" Margin="11,0,0,0"
							  VerticalAlignment="Center"
							  Data="M11 11L15 15M12.5 7.5A5 5 0 1 1 2.5 7.5a5 5 0 0 1 10 0z"/>
						<TextBox Grid.Column="1" Text="{Binding SearchText}"
								 PlaceholderText="{DynamicResource Arc.SearchPlaceholder}"
								 Background="Transparent" BorderThickness="0"
								 Padding="9,8" FontSize="12"/>
					</Grid>
				</Border>

				<Button Grid.Column="1" Classes="flat" Click="OnExportExcelClick"
						ToolTip.Tip="{DynamicResource Arc.ExcelHint}">
					<Border Background="{DynamicResource SuccessSoftBgAlt}" BorderBrush="{DynamicResource SuccessSoftBorder}" BorderThickness="1"
							CornerRadius="8" Padding="11,9">
						<Path Stroke="{DynamicResource SuccessBase}" StrokeThickness="1.8" Fill="Transparent"
							  Width="14" Height="14" Stretch="Uniform"
							  Data="M12 3v12M12 15l-4.5-4.5M12 15l4.5-4.5M4 17v2.5A1.5 1.5 0 0 0 5.5 21h13a1.5 1.5 0 0 0 1.5-1.5V17"/>
					</Border>
				</Button>
			</Grid>

			<!-- Arşivde neyin neden bulunduğunu ayırt edebilmek için durum filtreleri -->
			<WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
				<Button Classes="flat" Command="{Binding SetFilterCommand}" CommandParameter="tumu"
						Margin="0,0,6,6">
					<Border CornerRadius="14" Padding="12,5"
							Background="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Background}, ConverterParameter=tumu}">
						<TextBlock Text="{DynamicResource Common.All}" FontSize="11.5" FontWeight="SemiBold"
								   Foreground="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Foreground}, ConverterParameter=tumu}"/>
					</Border>
				</Button>
				<Button Classes="flat" Command="{Binding SetFilterCommand}" CommandParameter="tamamlandi"
						Margin="0,0,6,6">
					<Border CornerRadius="14" Padding="12,5"
							Background="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Background}, ConverterParameter=tamamlandi}">
						<TextBlock Text="{DynamicResource Arc.Expired}" FontSize="11.5" FontWeight="SemiBold"
								   Foreground="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Foreground}, ConverterParameter=tamamlandi}"/>
					</Border>
				</Button>
				<Button Classes="flat" Command="{Binding SetFilterCommand}" CommandParameter="feshedildi"
						Margin="0,0,6,6">
					<Border CornerRadius="14" Padding="12,5"
							Background="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Background}, ConverterParameter=feshedildi}">
						<TextBlock Text="{DynamicResource Card.StatusTerminated}" FontSize="11.5" FontWeight="SemiBold"
								   Foreground="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Foreground}, ConverterParameter=feshedildi}"/>
					</Border>
				</Button>
				<Button Classes="flat" Command="{Binding SetFilterCommand}" CommandParameter="reddedildi"
						Margin="0,0,6,6">
					<Border CornerRadius="14" Padding="12,5"
							Background="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Background}, ConverterParameter=reddedildi}">
						<TextBlock Text="{DynamicResource Card.StatusRejected}" FontSize="11.5" FontWeight="SemiBold"
								   Foreground="{Binding SelectedFilter, Converter={x:Static conv:FilterStateBrushConverter.Foreground}, ConverterParameter=reddedildi}"/>
					</Border>
				</Button>
			</WrapPanel>

			<!-- Sayfalama: arşiv sürekli büyüdüğü için liste 10'arlı sayfalanır -->
			<Border DockPanel.Dock="Bottom" IsVisible="{Binding ShowPager}" Margin="0,10,0,0">
				<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
					<Button Classes="flat" IsEnabled="{Binding CanGoPrevious}" Command="{Binding PreviousPageCommand}">
						<Border Background="{DynamicResource SurfaceButton}" BorderBrush="{DynamicResource BorderButton}" BorderThickness="1"
								CornerRadius="6" Padding="10,5">
							<TextBlock Text="‹" Foreground="{DynamicResource TextBody}" FontSize="12"/>
						</Border>
					</Button>
					<TextBlock Text="{Binding PageInfoText}" VerticalAlignment="Center"
							   FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
					<Button Classes="flat" IsEnabled="{Binding CanGoNext}" Command="{Binding NextPageCommand}">
						<Border Background="{DynamicResource SurfaceButton}" BorderBrush="{DynamicResource BorderButton}" BorderThickness="1"
								CornerRadius="6" Padding="10,5">
							<TextBlock Text="›" Foreground="{DynamicResource TextBody}" FontSize="12"/>
						</Border>
					</Button>
				</StackPanel>
			</Border>

			<StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,20,0,0" IsVisible="{Binding IsEmpty}">
				<TextBlock Text="{DynamicResource Arc.NoMatch}" Foreground="{DynamicResource TextMuted}"
						   FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"/>
				<Button Classes="flat" HorizontalAlignment="Center" Command="{Binding ClearFiltersCommand}"
						IsVisible="{Binding HasActiveFilters}">
					<Border Background="{DynamicResource SurfaceButton}" BorderBrush="{DynamicResource BorderButton}" BorderThickness="1"
							CornerRadius="6" Padding="12,6">
						<TextBlock Text="{DynamicResource Common.ClearFilters}" Foreground="{DynamicResource TextBody}" FontSize="11.5"/>
					</Border>
				</Button>
			</StackPanel>

			<ListBox ItemsSource="{Binding AvailableContracts}"
                     SelectedItem="{Binding SelectedContract}">
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="vm:ContractCardViewModel">
						<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
								CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
							<StackPanel Spacing="6">
								<TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5"
										   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
								<TextBlock Text="{Binding CompanyName}" FontSize="11" Foreground="{DynamicResource TextMuted}"
										   TextWrapping="Wrap"/>
								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
									<!-- Rozet: kaydın arşive neden düştüğünü tek bakışta gösterir -->
									<Border Grid.Column="0" Background="{Binding StatusBgHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
											CornerRadius="9" Padding="8,2" VerticalAlignment="Center">
										<TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
												   FontSize="10" FontWeight="Bold"/>
									</Border>
									<TextBlock Grid.Column="1" Text="{Binding ArchiveDateText}" FontSize="10.5"
											   Foreground="{DynamicResource TextFaintAlt}" VerticalAlignment="Center"
											   HorizontalAlignment="Right"/>
								</Grid>
							</StackPanel>
						</Border>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</DockPanel>

		<ScrollViewer Grid.Column="1">
			<StackPanel Spacing="16">

				<TextBlock Text="{DynamicResource Arc.PickToSeeDetail}"
                           IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNull}}"
                           Foreground="Gray"/>

				<TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

				<!--
				  İki ayrı işlem: "Yazdır" belgeyi doğrudan yazıcıya gönderir,
				  "PDF Kaydet" ise dosya olarak diske yazar. Eskiden tek bir "Yazdır"
				  butonu vardı ve aslında yalnızca kaydedip görüntüleyicide açıyordu.
				-->
				<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left"
							IsVisible="{Binding CanPrint}">
					<!--
					  Yenile: süresi dolmuş bir sözleşmeden yeni dönem talebi açar.
					  Arşiv, yenilemenin en çok başlatılacağı yer — kullanıcı zaten
					  "geçen dönemki sözleşme neydi" diye buraya bakıyor.
					-->
					<Button Classes="flat" IsVisible="{Binding CanRenew}" Command="{Binding RenewCommand}"
							ToolTip.Tip="{DynamicResource Doc.RenewHint}">
						<Border Background="{DynamicResource SuccessSoftBgAlt2}" BorderBrush="{DynamicResource SuccessSoftBorderAlt}" BorderThickness="1"
								CornerRadius="8" Padding="14,8">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Path Stroke="{DynamicResource SuccessText}" StrokeThickness="1.7" Fill="Transparent"
									  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
									  Data="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z M14 3v5h5 M12 12v5 M9.5 14.5h5"/>
								<TextBlock Text="{DynamicResource Doc.Renew}" Foreground="{DynamicResource SuccessText}" FontSize="12.5"
										   FontWeight="SemiBold" VerticalAlignment="Center"/>
							</StackPanel>
						</Border>
					</Button>
					<Button Classes="flat" Command="{Binding PrintCommand}"
							ToolTip.Tip="{DynamicResource Doc.PrintHint}">
						<Border Background="{DynamicResource AccentSolid}" CornerRadius="8" Padding="14,9">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Path Stroke="{DynamicResource TextOnAccent}" StrokeThickness="1.7" Fill="Transparent"
									  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
									  Data="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2M6 14h12v8H6z"/>
								<TextBlock Text="{DynamicResource Doc.Print}" Foreground="{DynamicResource TextOnAccent}" FontSize="12.5"
										   FontWeight="SemiBold" VerticalAlignment="Center"/>
							</StackPanel>
						</Border>
					</Button>
					<Button Classes="flat" Click="OnExportPdfClick"
							ToolTip.Tip="{DynamicResource Doc.SavePdfHint}">
						<Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderStrongAlt}" BorderThickness="1"
								CornerRadius="8" Padding="14,8">
							<TextBlock Text="{DynamicResource Doc.SavePdf}" Foreground="{DynamicResource TextBody}" FontSize="12.5"/>
						</Border>
					</Button>
				</StackPanel>

				<!-- Künye kartı: sözleşme detay ekranıyla aynı düzen ve stiller -->
				<Border IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}"
						Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
						CornerRadius="10" Padding="20">
					<StackPanel Spacing="14">

						<Grid ColumnDefinitions="*,Auto">
							<StackPanel Grid.Column="0" Spacing="3">
								<TextBlock Text="{Binding DetailTitle}" FontSize="19" FontWeight="Bold"
										   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
								<TextBlock Text="{Binding DetailNo}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
							</StackPanel>
							<Border Grid.Column="1" VerticalAlignment="Top" Margin="12,2,0,0"
									Background="{Binding DetailStatusBgHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}" CornerRadius="10" Padding="10,4">
								<TextBlock Text="{Binding DetailStatus}" Foreground="{Binding DetailStatusColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
										   FontSize="11" FontWeight="Bold"/>
							</Border>
						</Grid>

						<Border Background="{DynamicResource SurfaceDivider}" Height="1"/>

						<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
							  ColumnSpacing="24" RowSpacing="14">

							<StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="{DynamicResource Doc.Company}"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailCompany}"/>
							</StackPanel>
							<StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="{DynamicResource Doc.SapCode}"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailSapCariKodu}"/>
							</StackPanel>

							<StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="{DynamicResource Field.TaxNo}"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailTaxNo}"/>
							</StackPanel>
							<StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="{DynamicResource Field.Type}"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailType}"/>
							</StackPanel>

							<StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="{DynamicResource List.ColAmount}"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailTotal}"/>
							</StackPanel>
							<StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="{DynamicResource Field.PaymentPeriod}"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailPeriod}"/>
							</StackPanel>

							<StackPanel Grid.Row="3" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="{DynamicResource Field.StartDate}"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailStart}"/>
							</StackPanel>
							<StackPanel Grid.Row="3" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="{DynamicResource Field.EndDate}"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailEnd}"/>
							</StackPanel>

							<StackPanel Grid.Row="4" Grid.Column="0" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="{DynamicResource Field.Requester}"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailRequester}"/>
							</StackPanel>
							<StackPanel Grid.Row="4" Grid.Column="1" Spacing="2">
								<TextBlock Classes="fieldLabel" Text="{DynamicResource Doc.Department}"/>
								<TextBlock Classes="fieldValue" Text="{Binding DetailDepartment}"/>
							</StackPanel>
						</Grid>

					</StackPanel>
				</Border>

				<Border IsVisible="{Binding HasTerminationInfo}"
                        Background="{DynamicResource DangerSoftBgFaint5}" BorderBrush="{DynamicResource DangerBase}" BorderThickness="1"
						CornerRadius="10" Padding="20">
					<StackPanel Spacing="6">
						<TextBlock Text="{DynamicResource Arc.TerminationInfo}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DangerBase}"/>
						<TextBlock Text="{Binding TerminationInfo}" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" TextWrapping="Wrap"/>
					</StackPanel>
				</Border>

				<!-- Fesih bilgisi kutusunun karşılığı: reddedilerek kapatılan talepler için -->
				<Border IsVisible="{Binding HasRejectionInfo}"
						Background="{DynamicResource DangerSoftBgFaint5}" BorderBrush="{DynamicResource DangerBase}" BorderThickness="1"
						CornerRadius="10" Padding="20">
					<StackPanel Spacing="6">
						<TextBlock Text="{DynamicResource Arc.RejectionInfo}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DangerBase}"/>
						<TextBlock Text="{Binding RejectionInfo}" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" TextWrapping="Wrap"/>
					</StackPanel>
				</Border>

				<!-- Sözleşme detay ekranıyla aynı iki sütunlu yerleşim -->
				<Grid ColumnDefinitions="330,*" ColumnSpacing="16">

					<StackPanel Grid.Column="0" VerticalAlignment="Top">
						<Border IsVisible="{Binding Steps.Count}"
								Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
								CornerRadius="10" Padding="20">
							<StackPanel Spacing="12">
								<TextBlock Text="{DynamicResource Doc.ProcessSteps}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>

								<ItemsControl ItemsSource="{Binding Steps}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:ContractStepViewModel">
											<Grid ColumnDefinitions="Auto,*">

												<Grid Grid.Column="0" RowDefinitions="Auto,*" Width="22">
													<Border Grid.Row="0" Width="18" Height="18" CornerRadius="9"
															Background="{Binding IconBgHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
															BorderBrush="{Binding IconBorderHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}" BorderThickness="1.5"
															HorizontalAlignment="Center">
														<TextBlock Text="{Binding Icon}" FontSize="10" FontWeight="Bold"
																   Foreground="{Binding IconColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
																   HorizontalAlignment="Center" VerticalAlignment="Center"/>
													</Border>
													<Border Grid.Row="1" Width="2" MinHeight="14"
															Background="{Binding ConnectorColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
															HorizontalAlignment="Center"/>
												</Grid>

												<StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
													<TextBlock Text="{Binding Label}" FontSize="12.5"
															   Foreground="{Binding LabelColorHex, Converter={x:Static conv:ThemeBrushConverter.Instance}}"
															   FontWeight="{Binding LabelWeight}"
															   TextWrapping="Wrap"/>
													<TextBlock Text="{Binding DateText}" FontSize="10.5" Foreground="{DynamicResource TextFaint}"
															   IsVisible="{Binding HasDate}"/>
													<TextBlock Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource WarningTextAlt}"
															   FontStyle="Italic" TextWrapping="Wrap"
															   IsVisible="{Binding HasNote}"/>
												</StackPanel>
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>
					</StackPanel>

					<StackPanel Grid.Column="1" Spacing="16">

						<Border IsVisible="{Binding Items.Count}"
								Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
								CornerRadius="10" Padding="20">
							<StackPanel Spacing="10">
								<TextBlock Text="{DynamicResource Doc.Items}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>

								<Grid ColumnDefinitions="2*,Auto,*,*" ColumnSpacing="12">
									<TextBlock Grid.Column="0" Text="{DynamicResource Doc.Description}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
									<TextBlock Grid.Column="1" Text="{DynamicResource Doc.Quantity}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Width="70" TextAlignment="Right"/>
									<TextBlock Grid.Column="2" Text="{DynamicResource Doc.UnitPrice}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" TextAlignment="Right"/>
									<TextBlock Grid.Column="3" Text="{DynamicResource Doc.LineTotal}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" TextAlignment="Right"/>
								</Grid>
								<Border Background="{DynamicResource SurfaceDivider}" Height="1"/>

								<ItemsControl ItemsSource="{Binding Items}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border BorderBrush="{DynamicResource SurfaceDivider}" BorderThickness="0,0,0,1" Padding="0,7">
												<Grid ColumnDefinitions="2*,Auto,*,*" ColumnSpacing="12">
													<TextBlock Grid.Column="0" Text="{Binding Description}" FontSize="12.5"
															   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
													<TextBlock Grid.Column="1" FontSize="12.5" Foreground="{DynamicResource TextBodyAlt}"
															   Width="70" TextAlignment="Right">
														<Run Text="{Binding Quantity}"/>
														<Run Text=" "/>
														<Run Text="{Binding Unit}"/>
													</TextBlock>
													<TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:N2}}"
															   FontSize="12.5" Foreground="{DynamicResource TextBodyAlt}" TextAlignment="Right"/>
													<TextBlock Grid.Column="3" Text="{Binding LineTotal, StringFormat={}{0:N2}}"
															   FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" TextAlignment="Right"/>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>

						<Border IsVisible="{Binding Attachments.Count}"
								Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
								CornerRadius="10" Padding="20">
							<StackPanel Spacing="10">
								<TextBlock Text="{DynamicResource Doc.Files}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
								<ItemsControl ItemsSource="{Binding Attachments}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border BorderBrush="{DynamicResource SurfaceDivider}" BorderThickness="0,0,0,1" Padding="0,7">
												<Grid ColumnDefinitions="*,Auto">
													<TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="12.5"
															   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
													<Button Grid.Column="1" Content="{DynamicResource Field.Open}"
															Command="{Binding $parent[UserControl].((vm:ArchiveViewModel)DataContext).OpenAttachmentCommand}"
															CommandParameter="{Binding}"/>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>

					</StackPanel>
				</Grid>

			</StackPanel>
		</ScrollViewer>

	</Grid>
</UserControl>
